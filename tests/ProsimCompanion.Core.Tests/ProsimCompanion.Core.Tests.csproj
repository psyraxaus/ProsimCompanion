<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- windows10 TFM so the WinRT-consuming ProsimCompanion.Speech project is referenceable
         (plain net10.0-windows suffices for the rest). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- CA1707: Method_Name_Underscores is the xunit naming convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- Concrete DI container for options-binding regression tests (BuildServiceProvider). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded flights (session JSONL + .expected.txt phase timeline) replayed through the
         phase engine by FlightReplayTests — every real flight dropped here is a regression test. -->
    <None Include="Flight\Recordings\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- App: the /api/status DTO assembly (StatusApiEndpoints.BuildStatus) is tested here. -->
    <ProjectReference Include="..\..\src\ProsimCompanion.App\ProsimCompanion.App.csproj" />
    <ProjectReference Include="..\..\src\ProsimCompanion.Audio\ProsimCompanion.Audio.csproj" />
    <ProjectReference Include="..\..\src\ProsimCompanion.Core\ProsimCompanion.Core.csproj" />
    <ProjectReference Include="..\..\src\ProsimCompanion.Gsx\ProsimCompanion.Gsx.csproj" />
    <ProjectReference Include="..\..\src\ProsimCompanion.Prosim\ProsimCompanion.Prosim.csproj" />
    <ProjectReference Include="..\..\src\ProsimCompanion.Sim\ProsimCompanion.Sim.csproj" />
    <ProjectReference Include="..\..\src\ProsimCompanion.Speech\ProsimCompanion.Speech.csproj" />
  </ItemGroup>

</Project>
