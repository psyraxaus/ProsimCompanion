<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compatibility spike (Package 0 of the PANELS page, 2026-10-27): proves whether the
       .NET Framework-targeted SkalarkiIO SDK 5.1 loads and runs in-process on .NET 10, and
       records what the SDK really sends (device presence, scanState burst, licence reply).
       NOT part of the solution build; never shipped. Needs the SDK in libs/skalarki/ (gitignored,
       user-supplied): run from the repo root with
         dotnet run -\-project tools/SkalarkiSpike -\- 10.0.1.21 53000 [-\-scan] [-\-all] [-\-seconds 20] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <SkalarkiLib>$(MSBuildThisFileDirectory)..\..\libs\skalarki</SkalarkiLib>
  </PropertyGroup>

  <Target Name="EnsureSkalarkiSdk" BeforeTargets="CoreCompile" Condition="!Exists('$(SkalarkiLib)\SkalarkiIO.SDK.dll')">
    <Error Text="SkalarkiIO.SDK.dll was not found in libs/skalarki/. Copy the SDK assemblies from the Profiler's Tools folder there (they are gitignored)." />
  </Target>

  <!-- The SDK and the .NET Framework support assemblies it was built against, copied beside
       the exe exactly as the app's SdkLoader would see them in the user's folder. -->
  <ItemGroup>
    <Reference Include="SkalarkiIO.SDK"><HintPath>$(SkalarkiLib)\SkalarkiIO.SDK.dll</HintPath></Reference>
    <Reference Include="SkalarkiIO.SDK.Telemetry"><HintPath>$(SkalarkiLib)\SkalarkiIO.SDK.Telemetry.dll</HintPath></Reference>
    <Reference Include="SkalarkiIO.SDK.Diagnostics.Logic"><HintPath>$(SkalarkiLib)\SkalarkiIO.SDK.Diagnostics.Logic.dll</HintPath></Reference>
    <Reference Include="System.Threading.Tasks.Dataflow"><HintPath>$(SkalarkiLib)\System.Threading.Tasks.Dataflow.dll</HintPath></Reference>
    <Reference Include="Microsoft.Diagnostics.Tracing.EventSource"><HintPath>$(SkalarkiLib)\Microsoft.Diagnostics.Tracing.EventSource.dll</HintPath></Reference>
  </ItemGroup>

</Project>
