<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assets-only package: source of _framework/blazor.web.js (what the Web SDK itself uses).
         Our WPF host copies the script from it because WinExe projects get no static-web-assets
         pipeline. Keep in step with the ASP.NET Core framework version. -->
    <PackageVersion Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!-- WASAPI per-app session volumes for the audio pillar; the speech pillar plays TTS
         through the same stack (docs/integrations/speech.md). Versions proven in Prosim2FO;
         keep the NAudio family aligned. -->
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="NAudio.Wasapi" Version="2.3.0" />
    <!-- Speech pillar (Phase 5): Google Chirp 3 HD TTS + SAPI5 last-resort synth. -->
    <PackageVersion Include="Google.Cloud.TextToSpeech.V1" Version="3.18.0" />
    <PackageVersion Include="System.Speech" Version="10.0.10" />
    <!-- Navigraph DFD SQLite (briefings). lib.e_sqlite3 pinned >= 3.53.3: GHSA-2m69-gcr7-jv3q. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <!-- WCF shims required by ProSimSDK.dll on modern .NET (versions proven in Prosim2FO). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageVersion Include="System.ServiceModel.Http" Version="10.0.652802" />
    <PackageVersion Include="System.ServiceModel.NetTcp" Version="10.0.652802" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="10.0.652802" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Build-time only: the in-repo Roslyn analyzer (PCGSX001, trigger-slot fence). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- Test-only packages -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

</Project>
