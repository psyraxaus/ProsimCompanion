{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "outDir": "com.prosimcompanion.streamdeck.sdPlugin/bin",
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
