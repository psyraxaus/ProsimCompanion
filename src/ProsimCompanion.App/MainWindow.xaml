<Window x:Class="ProsimCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProsimCompanion"
        Height="640" Width="560"
        ResizeMode="CanMinimize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="ProsimCompanion" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Configuration and all features live in the web UI:" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="WebUrlText" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" />
                <Button x:Name="OpenBrowserButton"
                        Content="Open Web UI"
                        Width="120" Height="28"
                        Margin="16,0,0,0"
                        Click="OpenBrowserButton_Click" />
            </StackPanel>

            <TextBlock Text="Subsystems" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ItemsControl x:Name="StatusList" Margin="0,6,0,0" />

            <!-- Deliberately the only settings surface in WPF (ADR-0001): if the web config is
                 broken, this card is how you fix it. -->
            <GroupBox Header="Web server" Margin="0,20,0,0" Padding="10">
                <StackPanel>
                    <CheckBox x:Name="LanCheckBox"
                              Content="Allow LAN access (other devices on your network)"
                              Checked="LanCheckBox_Toggled" Unchecked="LanCheckBox_Toggled" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Port:" VerticalAlignment="Center" />
                        <TextBox x:Name="PortBox" Width="80" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                        <Button x:Name="SaveWebButton" Content="Save" Width="80" Margin="16,0,0,0" Click="SaveWebButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="SaveHintText" FontStyle="Italic" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Access token:" VerticalAlignment="Center" />
                        <TextBox x:Name="TokenBox" Width="270" IsReadOnly="True" Margin="8,0,0,0" VerticalContentAlignment="Center" FontFamily="Consolas" />
                        <Button x:Name="RegenerateTokenButton" Content="Regenerate" Margin="8,0,0,0" Click="RegenerateTokenButton_Click" />
                    </StackPanel>
                    <Image x:Name="QrImage" Width="170" Height="170" HorizontalAlignment="Left" Margin="0,12,0,0"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="QrHintText" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
