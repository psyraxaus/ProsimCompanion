<Window x:Class="ProsimCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProsimCompanion"
        Height="380" Width="520"
        ResizeMode="CanMinimize">
    <StackPanel Margin="20">
        <TextBlock Text="ProsimCompanion" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Configuration and all features live in the web UI:" Margin="0,12,0,0" />
        <TextBlock x:Name="WebUrlText" FontFamily="Consolas" FontSize="14" Margin="0,4,0,0" />
        <Button x:Name="OpenBrowserButton"
                Content="Open Web UI"
                Width="140" Height="32"
                HorizontalAlignment="Left"
                Margin="0,10,0,20"
                Click="OpenBrowserButton_Click" />
        <TextBlock Text="Subsystems" FontWeight="SemiBold" />
        <ItemsControl x:Name="StatusList" Margin="0,6,0,0" />
    </StackPanel>
</Window>
