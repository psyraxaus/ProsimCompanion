{
  "id": "eng-1-fail",
  "title": "ENG 1 FAIL",
  "severity": "warning",
  "enabled": true,
  "phases": [ "Climb", "Cruise", "Descent", "Approach" ],
  "trigger": {
    "ewdText": [ "ENG 1 FAIL", "ENG 1 FLAME OUT" ],
    "condition": {
      "logic": "and",
      "conditions": [
        { "dataref": "aircraft.engines.1.running", "op": "equals", "value": 0 },
        { "dataref": "aircraft.engines.1.n2", "op": "lessThan", "value": 50 }
      ]
    },
    "logic": "any",
    "corroborate": "system.indicators.I_ENG_FAULT_1",
    "debounceSeconds": 2.0
  },
  "announce": "ECAM, engine 1 failure.",
  "actions": [
    {
      "kind": "action",
      "say": "Thrust lever 1, confirm idle.",
      "confirm": [ "idle", "thrust lever idle", "lever one idle", "set idle" ],
      "verify": { "dataref": "aircraft.engines.1.n1", "op": "lessThan", "value": 40 },
      "ack": "Thrust lever 1 idle.",
      "discrepancy": "I still show thrust on engine 1."
    },
    {
      "kind": "action",
      "say": "Engine 1 parameters, monitor. Confirm no relight.",
      "confirm": [ "no relight", "confirmed", "monitored", "roger" ]
    },
    {
      "kind": "action",
      "say": "If a relight is not achieved within the envelope, engine master 1, confirm, off.",
      "confirm": [ "off", "master off", "engine master off", "confirmed off" ],
      "condition": { "dataref": "aircraft.engines.1.running", "op": "equals", "value": 0 },
      "verify": { "dataref": "system.switches.S_ENG_MASTER_1", "op": "equals", "value": 0 },
      "ack": "Engine master 1 off.",
      "discrepancy": "Engine master 1 still shows on."
    },
    {
      "kind": "action",
      "say": "A.T.C., notify and request a lower level.",
      "confirm": [ "notified", "roger", "wilco", "will advise" ]
    }
  ],
  "status": [
    "Status. Engine 1 out.",
    "Single engine. Observe the maximum flight level and the drift-down as required.",
    "Refer to the Q.R.H. for the in-flight relight envelope.",
    "Consider a diversion and brief for a single-engine landing."
  ],
  "contextFlags": [ "engine1Out", "singleEngine", "abnormalLanding" ],
  "clearedWhen": { "dataref": "aircraft.engines.1.running", "op": "equals", "value": 1 }
}
