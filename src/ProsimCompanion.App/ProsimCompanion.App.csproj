<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10 TFM (not plain net10.0-windows): the speech pillar consumes WinRT
         Windows.Media.SpeechSynthesis, and the host's TargetPlatformVersion must be >= the
         library's. Proven combination in Prosim2FO. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ProsimCompanion</AssemblyName>
    <RootNamespace>ProsimCompanion.App</RootNamespace>
    <!-- App.xaml is compiled as a plain Page (below) so WPF does not generate a competing
         entry point / parameterless App construction; Program.cs owns startup. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>ProsimCompanion.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded Kestrel + Blazor host inside the WPF process (ADR-0001/0002). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assets-only: supplies _framework/blazor.web.js (copied below); nothing is compiled in. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- A WinExe host has no static-web-assets pipeline, so the Blazor interactivity script is
         copied from its source package and served as an ordinary static file. Without it, pages
         render but the interactive circuit never connects. -->
    <None Include="$(PkgMicrosoft_AspNetCore_App_Internal_Assets)\_framework\blazor.web.js"
          Link="wwwroot\_framework\blazor.web.js"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Same reason for the Web project's static assets (stylesheet, split-flap JS, favicon):
         no static-web-assets pipeline means no _content/ mapping, so they are copied into the
         host's wwwroot and served as ordinary static files. -->
    <None Include="..\ProsimCompanion.Web\wwwroot\**\*"
          Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProsimCompanion.Audio\ProsimCompanion.Audio.csproj" />
    <ProjectReference Include="..\ProsimCompanion.Core\ProsimCompanion.Core.csproj" />
    <ProjectReference Include="..\ProsimCompanion.Gsx\ProsimCompanion.Gsx.csproj" />
    <ProjectReference Include="..\ProsimCompanion.Prosim\ProsimCompanion.Prosim.csproj" />
    <ProjectReference Include="..\ProsimCompanion.Sim\ProsimCompanion.Sim.csproj" />
    <ProjectReference Include="..\ProsimCompanion.Speech\ProsimCompanion.Speech.csproj" />
    <ProjectReference Include="..\ProsimCompanion.Web\ProsimCompanion.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PreserveNewest so user edits to the deployed copy survive rebuilds. -->
    <Content Include="config\settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped default checklists (Prosim2FO-compatible JSON; user-editable, hot-reloaded). -->
    <Content Include="config\checklists\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped abnormal procedures + memory drills (Prosim2FO-compatible; user-editable). -->
    <Content Include="config\abnormals\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- SayIntentions ATC request phrasebook (user-editable). -->
    <Content Include="config\atc-requests.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
