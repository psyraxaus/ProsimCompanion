<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Protovision</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- Windows DPAPI for the API keys / tokens in settings.json (SecretProtector). Every call
         is guarded by OperatingSystem.IsWindows() so the assembly still loads elsewhere. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- The offline atlas for "what are we flying over?" (#153): Natural Earth + GeoNames,
         built by tools/build-atlas.js. 1.2 MB gzipped, read on the first question. -->
    <EmbeddedResource Include="Geo\Data\atlas.json.gz" />
    <!-- The ProSim dataref reference (repo root, see ProsimDataRefNames): the shipped switch list
         for the smart-button picker while ProSim is not connected (2026-10-17). -->
    <EmbeddedResource Include="..\..\Prosim_A322_Dataref.csv" Link="Aircraft\Switches\Prosim_A322_Dataref.csv" LogicalName="ProsimCompanion.Core.Aircraft.Switches.Prosim_A322_Dataref.csv" />
  </ItemGroup>

</Project>
