<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only: WinRT speech synthesis (Windows.Media.SpeechSynthesis) needs a
         windows10 TFM; SAPI5 (System.Speech) and NAudio playback are Windows-only too. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Google.Cloud.TextToSpeech.V1" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="System.Speech" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProsimCompanion.Core\ProsimCompanion.Core.csproj" />
  </ItemGroup>

</Project>
