@* Numeric field row with optional unit suffix. Generic over the numeric type so int and
   double settings bind without casts; a value the browser lets through that fails to parse
   re-renders the previous value rather than corrupting the draft. Supports @bind-Value.
   With Default set (ADR-0010) the row shows the out-of-the-box value and a reset button
   whenever the current value differs. *@
@typeparam TValue
@using System.Globalization

<div class="field">
    <label class="field-label" for="@_id">
        @Label
        @if (!string.IsNullOrEmpty(Hint))
        {
            <span class="field-hint">@Hint</span>
        }
    </label>
    <div class="field-control">
        <span class="number-row">
            <input id="@_id" type="number" class="number-input" inputmode="decimal"
                   step="@(Step ?? "any")" min="@Min" max="@Max"
                   value="@BindConverter.FormatValue(Value, CultureInfo.InvariantCulture)"
                   disabled="@Disabled" @onchange="OnChangedAsync" />
            @if (!string.IsNullOrEmpty(Suffix))
            {
                <span class="suffix">@Suffix</span>
            }
            @if (Default is not null)
            {
                @if (IsDefault)
                {
                    <span class="field-default" title="This is the default value">default</span>
                }
                else
                {
                    <button type="button" class="reset-btn" disabled="@Disabled"
                            title="@($"Reset to the default ({DefaultText}{(string.IsNullOrEmpty(Suffix) ? "" : " " + Suffix)})")"
                            aria-label="Reset to default"
                            @onclick="ResetAsync">↺ @DefaultText</button>
                }
            }
        </span>
    </div>
</div>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public TValue Value { get; set; } = default!;

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>The option's out-of-the-box value (typically <c>draft.Defaults.X</c>). Typed
    /// object on purpose: an unconstrained <c>TValue?</c> is not nullable for int/double, so
    /// "no default given" could not be told apart from a default of 0.</summary>
    [Parameter]
    public object? Default { get; set; }

    [Parameter]
    public string? Suffix { get; set; }

    [Parameter]
    public string? Step { get; set; }

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string DefaultText => Convert.ToString(Default, CultureInfo.InvariantCulture) ?? "";

    // Compared as formatted text so 30 and 30.0 read as the same default.
    private bool IsDefault => string.Equals(
        BindConverter.FormatValue(Value, CultureInfo.InvariantCulture)?.ToString(),
        DefaultText,
        StringComparison.Ordinal);

    private Task ResetAsync()
        => Default is TValue typed ? ValueChanged.InvokeAsync(typed) : Task.CompletedTask;

    private async Task OnChangedAsync(ChangeEventArgs e)
    {
        if (BindConverter.TryConvertTo<TValue>(e.Value?.ToString(), CultureInfo.InvariantCulture, out var parsed)
            && parsed is not null)
        {
            await ValueChanged.InvokeAsync(parsed);
        }
        else
        {
            // Revert the input to the last good value.
            StateHasChanged();
        }
    }
}
