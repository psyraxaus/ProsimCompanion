@* Card with an uppercase category-coloured title and optional right-aligned hint — the
   basic content container of the design language. An Advanced card (ADR-0010) collapses to
   its header while "Show advanced settings" is off. Every other card folds on its chevron
   (hub-usability pass, issue #199): the state lives in this browser (SectionFoldStore →
   localStorage), the body stays rendered but hidden so the fields keep their validity
   registrations, and DefaultFolded gives a rarely-needed card a closed first look. *@
@inherits StoreObserverComponent
@inject AdvancedSettingsStore AdvancedStore
@inject SectionFoldStore Folds
@inject IStringLocalizer T

@if (Advanced && !_showAdvanced)
{
    <section class="section section-folded">
        <div class="section-header">
            <h3 class="section-title">@Title</h3>
            <span class="section-hint">
                @T["fields.advanced.sectionFolded"] <button type="button" class="link-btn" @onclick="() => AdvancedStore.Set(true)">@T["fields.advanced.show"]</button>
            </span>
        </div>
    </section>
}
else
{
    var folded = Folds.IsFolded(_foldId, DefaultFolded);
    <section class="section @(folded ? "section-folded section-user-folded" : null)">
        <div class="section-header">
            <h3 class="section-title">
                <button type="button" class="section-fold" @onclick="() => Folds.Set(_foldId, !folded)"
                        aria-expanded="@(!folded)" title="@(folded ? T["fields.section.expand"].Value : T["fields.section.collapse"].Value)">
                    <span class="section-fold-chevron" aria-hidden="true">@(folded ? "▸" : "▾")</span>
                    <span>@Title</span>
                </button>
            </h3>
            @if (!string.IsNullOrEmpty(Hint))
            {
                <span class="section-hint">@Hint</span>
            }
        </div>
        <div class="section-body" hidden="@folded">
            @ChildContent
        </div>
    </section>
}

@code {
    private bool _showAdvanced;
    private string _foldId = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    /// <summary>True for a card that holds tuning constants only; it folds to its header
    /// until advanced settings are revealed.</summary>
    [Parameter]
    public bool Advanced { get; set; }

    /// <summary>Closed until this browser opens it once — for cards most installs never touch.</summary>
    [Parameter]
    public bool DefaultFolded { get; set; }

    /// <summary>A stable fold id when the title is not one (a numbered or named card); the
    /// title otherwise.</summary>
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Watch(AdvancedStore, show => _showAdvanced = show);
        Watch(Folds, _ => { });
    }

    protected override void OnParametersSet()
    {
        var id = Folds.IdFor(Id ?? Title);
        if (id == _foldId)
        {
            return;
        }

        if (_foldId.Length > 0)
        {
            Folds.Unregister(_foldId);
        }

        _foldId = id;
        Folds.Register(_foldId, DefaultFolded);
    }

    public override void Dispose()
    {
        if (_foldId.Length > 0)
        {
            Folds.Unregister(_foldId);
        }

        base.Dispose();
    }
}
