@* Select field row over (value, label) options. String-typed on purpose — enum settings
   convert at the page boundary where the JSON casing rules live. Supports @bind-Value. *@
<div class="field">
    <label class="field-label" for="@_id">
        @Label
        <FieldHint Hint="@Hint" More="@More" />
    </label>
    <div class="field-control">
        <select id="@_id" class="select" value="@Value" disabled="@Disabled" @onchange="OnChangedAsync">
            @foreach (var (value, label) in Options)
            {
                <option value="@value" selected="@(value == Value)">@label</option>
            }
        </select>
    </div>
</div>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    /// <summary>Longer explanation behind a "More" fold under the hint (ADR-0010).</summary>
    [Parameter]
    public string? More { get; set; }

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<(string Value, string Label)> Options { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    private Task OnChangedAsync(ChangeEventArgs e)
        => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
