@* First-run guidance on the Flight Status page (ADR-0010): while a connection every install
   needs is missing, dashes on the status cards told a new user nothing. One card lists the
   steps that still need doing, each linked to the exact settings section; it disappears by
   itself once ProSim and GSX are both talking. *@
@inherits StoreObserverComponent
@using ProsimCompanion.Core.Configuration
@inject ConnectionStatusStore Status
@inject IOptionsMonitor<ProsimOptions> ProsimOptions
@inject IOptionsMonitor<GsxOptions> GsxOptions
@inject ProsimSetupStore SetupStore
@inject IStringLocalizer T

@if (_steps.Count > 0)
{
    <Section Title="@T["gettingStarted.title"]" Hint="@T["gettingStarted.hint"]">
        <ol class="setup-steps">
            @foreach (var step in _steps)
            {
                <li>@(step.Text ?? T[step.TextId!, step.Args].Value) <a href="@step.Href">@T[step.LinkTextId]</a></li>
            }
        </ol>
    </Section>
}

@code {
    /// <summary>One step: a pack text id with its placeholder values, or a sentence another
    /// subsystem already wrote (<see cref="ConnectionStatusStore.ReasonOf"/>). Resolved at
    /// render time, so a language switch (ADR-0014) redraws the card without a refresh.</summary>
    private readonly record struct Step(string? TextId, string? Text, object[] Args, string Href, string LinkTextId);

    private List<Step> _steps = [];

    private int _setupMismatches;

    protected override void OnInitialized()
    {
        Watch(SetupStore, snapshot =>
        {
            _setupMismatches = snapshot.MismatchCount;
            Refresh();
        });
        WatchChanged(h => Status.Changed += h, h => Status.Changed -= h, Refresh);
    }

    private void Refresh()
    {
        var steps = new List<Step>();
        var states = Status.Snapshot().ToDictionary(pair => pair.Key, pair => pair.Value);

        if (string.IsNullOrWhiteSpace(ProsimOptions.CurrentValue.SdkPath))
        {
            steps.Add(new Step("gettingStarted.sdk", null, [], "settings", "gettingStarted.sdk.link"));
        }
        else if (states.GetValueOrDefault(Subsystems.Prosim) != ConnectionState.Connected)
        {
            // The subsystem's own reason wins (issue #158): "start ProSim" is wrong advice when
            // the SDK in the folder does not match the app.
            steps.Add(Status.ReasonOf(Subsystems.Prosim) is { } reason
                ? new Step(null, reason, [], "settings", "gettingStarted.prosim.link")
                : new Step("gettingStarted.prosim", null, [], "settings", "gettingStarted.prosim.link"));
        }
        else if (_setupMismatches > 0)
        {
            // The ProSim setup check (2026-10-06): the IOS options differ from what this app
            // wants. The card on Setup shows which, with Apply and the manual steps.
            steps.Add(new Step(_setupMismatches == 1 ? "gettingStarted.setupOne" : "gettingStarted.setupMany",
                null, [_setupMismatches], "settings", "gettingStarted.setup.link"));
        }

        if (!GsxOptions.CurrentValue.Enabled)
        {
            steps.Add(new Step("gettingStarted.gsxOff", null, [], "settings", "gettingStarted.gsxOff.link"));
        }
        else if (states.GetValueOrDefault(Subsystems.Gsx) != ConnectionState.Connected)
        {
            steps.Add(new Step("gettingStarted.gsx", null, [], "settings/gsx/status", "gettingStarted.gsx.link"));
        }

        _steps = steps;
    }
}
