@* Live voice-FO status + diagnostics, shown as the landing section of the First Officer tab
   (#18 — the former standalone /speech page): arbiter state, TTS providers with per-provider
   tests, LLM/mic component tests, arrival minima, speak test and recent utterances. *@
@inherits StoreObserverComponent
@inject SpeechStatusStore Status
@inject ISpeechControl SpeechControl
@inject ISpeechDiagnostics Diagnostics
@inject ArrivalMinimaStore Minima
@inject IAbnormalDialogueControl AbnormalControl
@inject IVoiceListeningControl ListeningControl
@inject UnmatchedUtteranceStore Unmatched
@inject IOptionsMonitor<SpeechOptions> SpeechMonitor
@inject IStringLocalizer T

@if (_view.ActiveAbnormal is { Length: > 0 } abnormal)
{
    @* The ECAM dialogue holds the mic exclusively — this button is the guaranteed way out
       when voice fails ("cancel ECAM" is the spoken equivalent). Issue #56. *@
    <div class="pill tone-warn" style="display:flex; gap:12px; align-items:center; justify-content:center; padding:10px; margin-bottom:12px;">
        <span>@T["speechStatus.ecam.running", abnormal]</span>
        <button type="button" class="btn secondary" @onclick="CancelAbnormal">@T["speechStatus.ecam.cancel"]</button>
    </div>
}

@if (_view.CabinCalling)
{
    <div class="pill tone-warn" style="display:block; text-align:center; padding:10px; margin-bottom:12px;"
         title="@T["speechStatus.cabinCalling.title"]">
        @T["speechStatus.cabinCalling.text"]
    </div>
}

<Section Title="@T["speechStatus.fo.title"]" Hint="@T["speechStatus.fo.hint"]">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
        <span class="pill @(_view.Enabled ? "tone-ok" : "tone-neutral")">
            @(_view.Enabled ? T["speechStatus.fo.enabled"].Value : T["speechStatus.fo.disabled"].Value)
        </span>
        <span class="pill @(_view.SterileCockpit ? "tone-warn" : "tone-neutral")"
              title="@T["speechStatus.fo.sterileTitle"]">
            @(_view.SterileCockpit ? T["speechStatus.fo.sterile"].Value : T["speechStatus.fo.notSterile"].Value)
        </span>
        <span class="pill @(_view.ListeningPaused ? "tone-warn" : _view.Listening ? "tone-ok" : "tone-neutral")"
              title="@T["speechStatus.fo.listeningTitle"]">
            @(_view.ListeningPaused ? T["speechStatus.fo.paused"].Value : _view.Listening ? T["speechStatus.fo.listening"].Value : T["speechStatus.fo.notListening"].Value)
        </span>
        <button type="button" class="btn secondary" @onclick="ToggleListening"
                title="@T["speechStatus.fo.toggleTitle"]">
            @(_view.ListeningPaused ? T["speechStatus.fo.resume"].Value : T["speechStatus.fo.pause"].Value)
        </button>
        @if (_view.RecognizerEngine.Length > 0)
        {
            @* Engine reality (2026-09-20): the app fell back to the offline engine before
               take-off and nothing on the page said so. *@
            <span class="pill @(_view.RecognizerEngine == "whisper" ? "tone-ok" : "tone-warn")"
                  title="@_view.RecognizerDetail">
                @(_view.RecognizerEngine == "whisper" ? T["speechStatus.fo.earWhisper"].Value : T["speechStatus.fo.earOffline"].Value)
            </span>
        }
        <span class="pill tone-active">@T["speechStatus.fo.queue", _view.QueueDepth]</span>
        @if (_view.NowPlaying is { } playing)
        {
            <span class="pill tone-ok" title="@playing">@T["speechStatus.fo.speaking"]</span>
        }
    </div>
    @if (_view.NowPlaying is { } text)
    {
        <div class="field-hint" style="margin-top:8px;">“@text”</div>
    }
</Section>

<Section Title="@T["speechStatus.tts.title"]" Hint="@T["speechStatus.tts.hint"]">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr><th>#</th><th>@T["speechStatus.tts.colProvider"]</th><th>@T["speechStatus.tts.colState"]</th><th>@T["speechStatus.tts.colDetail"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var (provider, index) in _view.Providers.Select((p, i) => (p, i)))
                {
                    var (tone, label) = HealthPill(provider.Health);
                    <tr>
                        <td>@(index + 1)</td>
                        <td class="mono">@provider.Name</td>
                        <td><span class="pill @tone">@label</span></td>
                        <td>@provider.Detail</td>
                        <td>
                            <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                                    @onclick="() => TestProviderAsync(provider.Name)">
                                @(_runningTest == $"tts:{provider.Name}" ? T["speechStatus.tts.testing"].Value : T["speechStatus.tts.test"].Value)
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_ttsTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">@_ttsTestResult</div>
    }
</Section>

<Section Title="@T["speechStatus.tests.title"]" Hint="@T["speechStatus.tests.hint"]">
    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="TestLlmAsync">
            @(_runningTest == "llm" ? T["speechStatus.tts.testing"].Value : T["speechStatus.tests.llm"].Value)
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="TestMicAsync">
            @(_runningTest == "mic" ? T["speechStatus.tests.micListening"].Value : T["speechStatus.tests.mic"].Value)
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="TestNavDataAsync">
            @(_runningTest == "navdata" ? T["speechStatus.tts.testing"].Value : T["speechStatus.tests.navData"].Value)
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="WakeLlmAsync"
                title="@T["speechStatus.tests.wakeTitle"]">
            @(_runningTest == "wol" ? T["speechStatus.tests.sending"].Value : T["speechStatus.tests.wake"].Value)
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="ReconnectVoiceAsync"
                title="@T["speechStatus.tests.reconnectTitle"]">
            @(_runningTest == "reconnect" ? T["speechStatus.tests.checking"].Value : T["speechStatus.tests.reconnect"].Value)
        </button>
    </div>
    @if (_reconnectResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">@T["speechStatus.tests.resultVoice", _reconnectResult]</div>
    }
    @if (_llmTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">@T["speechStatus.tests.resultLlm", _llmTestResult]</div>
    }
    @if (_micTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">@T["speechStatus.tests.resultMic", _micTestResult]</div>
    }
    @if (_navDataTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">@T["speechStatus.tests.resultNavData", _navDataTestResult]</div>
    }
    @if (_wakeResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">@T["speechStatus.tests.resultWake", _wakeResult]</div>
    }
</Section>

<Section Title="@T["speechStatus.minima.title"]" Hint="@T["speechStatus.minima.hint"]">
    @if (_minima is { } set)
    {
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <span class="pill tone-ok">@KindLabel(set.Kind) @set.AltitudeFt.ToString("F0") ft</span>
            <button type="button" class="btn secondary" @onclick="ClearMinima">@T["speechStatus.minima.clear"]</button>
        </div>
    }
    else
    {
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
            <select class="cell-select" @bind="_minimaKind">
                <option value="@ArrivalMinimumKind.DecisionAltitude">@T["speechStatus.minima.da"]</option>
                <option value="@ArrivalMinimumKind.DecisionHeight">@T["speechStatus.minima.dh"]</option>
                <option value="@ArrivalMinimumKind.MinimumDescentAltitude">@T["speechStatus.minima.mda"]</option>
            </select>
            <input class="cell-input" style="width:110px;" type="number" min="0" max="20000"
                   placeholder="@T["speechStatus.minima.altitude"]" @bind="_minimaAltitude" />
            <button type="button" class="btn" disabled="@(_minimaAltitude <= 0)"
                    @onclick="SetMinima">@T["speechStatus.minima.set"]</button>
        </div>
        <div class="field-hint" style="margin-top:8px;">
            @T["speechStatus.minima.untilSet"]
        </div>
    }
</Section>

<Section Title="@T["speechStatus.speak.title"]" Hint="@T["speechStatus.speak.hint"]">
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <input class="cell-input" style="flex:1 1 280px;" placeholder="@T["speechStatus.speak.placeholder"]"
               @bind="_testText" @bind:event="oninput" />
        <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_testText)"
                @onclick="SpeakTest">@T["speechStatus.speak.button"]</button>
    </div>
</Section>

<Section Title="@T["speechStatus.unmatched.title"]" Hint="@T["speechStatus.unmatched.hint"]">
    @{
        var groups = _unmatched.Groups();
    }
    @if (!SpeechMonitor.CurrentValue.TrackUnmatched)
    {
        <div class="empty">@T["speechStatus.unmatched.trackingOff"]</div>
    }
    else if (groups.Count == 0)
    {
        <div class="empty">
            @T["speechStatus.unmatched.nothing"]
            @if (_unmatched.SuppressedTotal > 0)
            {
                <text> @T["speechStatus.unmatched.absorbed", _unmatched.SuppressedTotal]</text>
            }
        </div>
    }
    else
    {
        <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:8px;">
            <span class="pill tone-neutral" title="@T["speechStatus.unmatched.heardTitle"]">@T["speechStatus.unmatched.heard", _unmatched.Total]</span>
            <span class="pill @(groups.Any(g => g.Count >= 3) ? "tone-warn" : "tone-neutral")"
                  title="@T["speechStatus.unmatched.repeatedTitle"]">@T["speechStatus.unmatched.repeated", groups.Count(g => g.Count >= 3)]</span>
            @if (_unmatched.SuppressedTotal > 0)
            {
                <span class="pill tone-neutral" title="@T["speechStatus.unmatched.sterileTitle"]">@T["speechStatus.unmatched.sterile", _unmatched.SuppressedTotal]</span>
            }
            <button type="button" class="btn secondary" @onclick="ClearUnmatched">@T["speechStatus.unmatched.clear"]</button>
        </div>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>@T["speechStatus.unmatched.colPhrase"]</th><th>@T["speechStatus.unmatched.colCount"]</th><th>@T["speechStatus.unmatched.colWhere"]</th><th>@T["speechStatus.unmatched.colLast"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var group in groups)
                    {
                        <tr>
                            <td>@group.Example</td>
                            <td>
                                <span class="pill @(group.Count >= 3 ? "tone-warn" : "tone-neutral")">@group.Count</span>
                            </td>
                            <td class="mono" title="@T["speechStatus.unmatched.contextTitle"]">@string.Join(", ", group.Contexts)</td>
                            <td class="mono">@group.LastHeardUtc.ToString("HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="field-hint" style="margin-top:8px; max-width:720px;">
        @T["speechStatus.unmatched.teach", UserConfigPaths.Root, "commands.json", "atc-requests.json", "acceptedPhrases", "checklists\\", "voice.unmatched"]
    </div>
</Section>

<details class="diagnostics">
    <summary>@T["speechStatus.recent.summary"]</summary>
<Section Title="@T["speechStatus.recent.title"]" Hint="@T["speechStatus.recent.hint"]">
    @if (_view.RecentUtterances.Count == 0)
    {
        <div class="empty">@T["speechStatus.recent.nothing"]</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>@T["speechStatus.recent.colTime"]</th><th>@T["speechStatus.recent.colOutcome"]</th><th>@T["speechStatus.recent.colPriority"]</th><th>@T["speechStatus.recent.colTag"]</th><th>@T["speechStatus.recent.colText"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var utterance in _view.RecentUtterances)
                    {
                        <tr>
                            <td class="mono">@utterance.TimestampUtc.ToString("HH:mm:ss")</td>
                            <td><span class="pill @OutcomeTone(utterance.Outcome)">@utterance.Outcome</span></td>
                            <td>@utterance.Priority</td>
                            <td class="mono">@utterance.Source</td>
                            <td>@utterance.Text</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Section>
</details>

@code {
    private SpeechStatusSnapshot _view = SpeechStatusSnapshot.Empty;
    private UnmatchedUtteranceSnapshot _unmatched = UnmatchedUtteranceSnapshot.Empty;
    private string _testText = "";
    private ArrivalMinima? _minima;
    private ArrivalMinimumKind _minimaKind = ArrivalMinimumKind.DecisionAltitude;
    private double _minimaAltitude;

    private string? _runningTest;
    private string? _ttsTestResult;
    private string? _llmTestResult;
    private string? _micTestResult;
    private string? _navDataTestResult;
    private string? _wakeResult;
    private string? _reconnectResult;

    protected override void OnInitialized()
    {
        Watch(Status, snapshot => _view = snapshot);
        Watch(Minima, minima => _minima = minima);
        Watch(Unmatched, snapshot => _unmatched = snapshot);
    }

    // The list re-renders through the store's own change notification.
    private void ClearUnmatched() => Unmatched.Clear();

    private void SetMinima()
    {
        if (_minimaAltitude > 0)
        {
            Minima.Set(new ArrivalMinima(_minimaKind, _minimaAltitude));
        }
    }

    private void ClearMinima() => Minima.Clear();

    private static string KindLabel(ArrivalMinimumKind kind) => kind switch
    {
        ArrivalMinimumKind.DecisionAltitude => "DA",
        ArrivalMinimumKind.DecisionHeight => "DH",
        _ => "MDA",
    };

    private void SpeakTest()
    {
        if (!string.IsNullOrWhiteSpace(_testText))
        {
            SpeechControl.SpeakTest(_testText.Trim());
        }
    }

    // The banner disappears via the status-store update the cancellation itself triggers.
    private void CancelAbnormal() => AbnormalControl.CancelActiveDialogue();

    // Same store-driven re-render: the controller publishes ListeningPaused on every edge.
    private void ToggleListening() => ListeningControl.SetPaused(!ListeningControl.Paused);

    private Task TestProviderAsync(string providerName) => RunTestAsync(
        $"tts:{providerName}",
        // The Speak Test text doubles as the sample phrase when filled in.
        () => Diagnostics.TestTtsProviderAsync(
            providerName,
            string.IsNullOrWhiteSpace(_testText) ? "ProsimCompanion voice test." : _testText.Trim(),
            CancellationToken.None),
        result => _ttsTestResult = result);

    private Task TestLlmAsync() => RunTestAsync(
        "llm", () => Diagnostics.TestLlmAsync(CancellationToken.None), result => _llmTestResult = result);

    private Task TestMicAsync() => RunTestAsync(
        "mic", () => Diagnostics.TestMicrophoneAsync(CancellationToken.None), result => _micTestResult = result);

    private Task TestNavDataAsync() => RunTestAsync(
        "navdata", () => Diagnostics.TestNavDataAsync(CancellationToken.None), result => _navDataTestResult = result);

    private Task WakeLlmAsync() => RunTestAsync(
        "wol", () => Diagnostics.WakeLlmServerAsync(CancellationToken.None), result => _wakeResult = result);

    private Task ReconnectVoiceAsync() => RunTestAsync(
        "reconnect", () => Diagnostics.ReconnectVoiceServicesAsync(CancellationToken.None), result => _reconnectResult = result);

    private async Task RunTestAsync(string key, Func<Task<string>> test, Action<string> report)
    {
        _runningTest = key;
        try
        {
            report(await test());
        }
        catch (Exception)
        {
            report(T["speechStatus.tests.failed"]);
        }
        finally
        {
            _runningTest = null;
        }
    }

    private (string Tone, string Label) HealthPill(TtsProviderHealth health) => health switch
    {
        TtsProviderHealth.Healthy => ("tone-ok", T["speechStatus.tts.health.healthy"].Value),
        TtsProviderHealth.Failed => ("tone-warn", T["speechStatus.tts.health.coolingDown"].Value),
        TtsProviderHealth.Disabled => ("tone-neutral", T["speechStatus.tts.health.disabled"].Value),
        _ => ("tone-neutral", T["speechStatus.tts.health.untried"].Value),
    };

    private static string OutcomeTone(string outcome) => outcome switch
    {
        "Spoken" => "tone-ok",
        "Failed" => "tone-warn",
        "Suppressed" or "Deferred" => "tone-active",
        _ => "tone-neutral",
    };
}
