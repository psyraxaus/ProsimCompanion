@* Live voice-FO status + diagnostics, shown as the landing section of the First Officer tab
   (#18 — the former standalone /speech page): arbiter state, TTS providers with per-provider
   tests, LLM/mic component tests, arrival minima, speak test and recent utterances. *@
@inherits StoreObserverComponent
@inject SpeechStatusStore Status
@inject ISpeechControl SpeechControl
@inject ISpeechDiagnostics Diagnostics
@inject ArrivalMinimaStore Minima
@inject IAbnormalDialogueControl AbnormalControl
@inject IVoiceListeningControl ListeningControl

@if (_view.ActiveAbnormal is { Length: > 0 } abnormal)
{
    @* The ECAM dialogue holds the mic exclusively — this button is the guaranteed way out
       when voice fails ("cancel ECAM" is the spoken equivalent). Issue #56. *@
    <div class="pill tone-warn" style="display:flex; gap:12px; align-items:center; justify-content:center; padding:10px; margin-bottom:12px;">
        <span>ECAM DIALOGUE RUNNING — @abnormal</span>
        <button type="button" class="btn secondary" @onclick="CancelAbnormal">Cancel ECAM dialogue</button>
    </div>
}

@if (_view.CabinCalling)
{
    <div class="pill tone-warn" style="display:block; text-align:center; padding:10px; margin-bottom:12px;"
         title="The real ACP CAB-CALL light is read-only in the SDK — this banner is the flash substitute">
        CABIN CALLING — select CAB on the audio panel
    </div>
}

<Section Title="Voice First Officer" Hint="Arbiter, TTS chain and playback status">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
        <span class="pill @(_view.Enabled ? "tone-ok" : "tone-neutral")">
            @(_view.Enabled ? "Enabled" : "Disabled")
        </span>
        <span class="pill @(_view.SterileCockpit ? "tone-warn" : "tone-neutral")"
              title="Below the sterile ceiling in a workload phase, Low speech is dropped and Normal follows the configured policy">
            @(_view.SterileCockpit ? "Sterile cockpit" : "Not sterile")
        </span>
        <span class="pill @(_view.ListeningPaused ? "tone-warn" : _view.Listening ? "tone-ok" : "tone-neutral")"
              title="Engine truth: Listening means the recognizer is actually capturing; Paused is the pilot's ear-off latch (Stream Deck Voice Pause key / the button here)">
            @(_view.ListeningPaused ? "Voice paused" : _view.Listening ? "Listening" : "Not listening")
        </span>
        <button type="button" class="btn secondary" @onclick="ToggleListening"
                title="Mute the FO's ear while you talk to a real person — the FO still speaks. Silent: no acknowledgement either way. Cleared by an app restart">
            @(_view.ListeningPaused ? "Resume listening" : "Pause listening")
        </button>
        @if (_view.RecognizerEngine.Length > 0)
        {
            @* Engine reality (2026-09-20): the app fell back to the offline engine before
               take-off and nothing on the page said so. *@
            <span class="pill @(_view.RecognizerEngine == "whisper" ? "tone-ok" : "tone-warn")"
                  title="@_view.RecognizerDetail">
                @(_view.RecognizerEngine == "whisper" ? "Ear: whisper (LAN)" : "Ear: offline engine")
            </span>
        }
        <span class="pill tone-active">Queue @_view.QueueDepth</span>
        @if (_view.NowPlaying is { } playing)
        {
            <span class="pill tone-ok" title="@playing">Speaking</span>
        }
    </div>
    @if (_view.NowPlaying is { } text)
    {
        <div class="field-hint" style="margin-top:8px;">“@text”</div>
    }
</Section>

<Section Title="TTS Providers" Hint="Tried in order; a failed provider cools down 60 s. Test speaks with exactly that provider — no fallback">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr><th>#</th><th>Provider</th><th>State</th><th>Detail</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var (provider, index) in _view.Providers.Select((p, i) => (p, i)))
                {
                    var (tone, label) = HealthPill(provider.Health);
                    <tr>
                        <td>@(index + 1)</td>
                        <td class="mono">@provider.Name</td>
                        <td><span class="pill @tone">@label</span></td>
                        <td>@provider.Detail</td>
                        <td>
                            <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                                    @onclick="() => TestProviderAsync(provider.Name)">
                                @(_runningTest == $"tts:{provider.Name}" ? "Testing…" : "Test")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_ttsTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">@_ttsTestResult</div>
    }
</Section>

<Section Title="Component Tests" Hint="Verify the LLM endpoint, microphone and nav database without flying a sector">
    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="TestLlmAsync">
            @(_runningTest == "llm" ? "Testing…" : "Test LLM connection")
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="TestMicAsync">
            @(_runningTest == "mic" ? "Listening… speak now" : "Test microphone")
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="TestNavDataAsync">
            @(_runningTest == "navdata" ? "Testing…" : "Test nav data")
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="WakeLlmAsync"
                title="Sends the Wake-on-LAN magic packet to the configured LLM host — then verify with Test LLM connection">
            @(_runningTest == "wol" ? "Sending…" : "Wake LLM server")
        </button>
        <button type="button" class="btn secondary" disabled="@(_runningTest is not null)"
                @onclick="ReconnectVoiceAsync"
                title="Checks whisper and Kokoro now. Swaps recognition back to whisper if it answers and clears a Kokoro cooldown — the app also retries whisper every 30 s by itself">
            @(_runningTest == "reconnect" ? "Checking…" : "Reconnect voice services")
        </button>
    </div>
    @if (_reconnectResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">Voice services: @_reconnectResult</div>
    }
    @if (_llmTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">LLM: @_llmTestResult</div>
    }
    @if (_micTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">Microphone: @_micTestResult</div>
    }
    @if (_navDataTestResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">Nav data: @_navDataTestResult</div>
    }
    @if (_wakeResult is not null)
    {
        <div class="field-hint" style="margin-top:8px;">Wake-on-LAN: @_wakeResult</div>
    }
</Section>

<Section Title="Arrival Minima" Hint="No DH/MDA dataref exists — enter the briefed minima to arm the minimums callouts">
    @if (_minima is { } set)
    {
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <span class="pill tone-ok">@KindLabel(set.Kind) @set.AltitudeFt.ToString("F0") ft</span>
            <button type="button" class="btn secondary" @onclick="ClearMinima">Clear</button>
        </div>
    }
    else
    {
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
            <select class="cell-select" @bind="_minimaKind">
                <option value="@ArrivalMinimumKind.DecisionAltitude">DA (baro, ft MSL)</option>
                <option value="@ArrivalMinimumKind.DecisionHeight">DH (radio, ft)</option>
                <option value="@ArrivalMinimumKind.MinimumDescentAltitude">MDA (baro, ft MSL)</option>
            </select>
            <input class="cell-input" style="width:110px;" type="number" min="0" max="20000"
                   placeholder="Altitude ft" @bind="_minimaAltitude" />
            <button type="button" class="btn" disabled="@(_minimaAltitude <= 0)"
                    @onclick="SetMinima">Set</button>
        </div>
        <div class="field-hint" style="margin-top:8px;">
            Until set, "one hundred above"/"minimums" stay disabled (logged once per flight).
        </div>
    }
</Section>

<Section Title="Speak Test" Hint="Runs the full arbiter → TTS → playback path at Normal priority">
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <input class="cell-input" style="flex:1 1 280px;" placeholder="Something for the FO to say"
               @bind="_testText" @bind:event="oninput" />
        <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_testText)"
                @onclick="SpeakTest">Speak</button>
    </div>
</Section>

<details class="diagnostics">
    <summary>Diagnostics — recent utterances</summary>
<Section Title="Recent Utterances" Hint="Latest first — full history in the session event log">
    @if (_view.RecentUtterances.Count == 0)
    {
        <div class="empty">Nothing spoken yet.</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>Time (UTC)</th><th>Outcome</th><th>Priority</th><th>Tag</th><th>Text</th></tr>
                </thead>
                <tbody>
                    @foreach (var utterance in _view.RecentUtterances)
                    {
                        <tr>
                            <td class="mono">@utterance.TimestampUtc.ToString("HH:mm:ss")</td>
                            <td><span class="pill @OutcomeTone(utterance.Outcome)">@utterance.Outcome</span></td>
                            <td>@utterance.Priority</td>
                            <td class="mono">@utterance.Source</td>
                            <td>@utterance.Text</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Section>
</details>

@code {
    private SpeechStatusSnapshot _view = SpeechStatusSnapshot.Empty;
    private string _testText = "";
    private ArrivalMinima? _minima;
    private ArrivalMinimumKind _minimaKind = ArrivalMinimumKind.DecisionAltitude;
    private double _minimaAltitude;

    private string? _runningTest;
    private string? _ttsTestResult;
    private string? _llmTestResult;
    private string? _micTestResult;
    private string? _navDataTestResult;
    private string? _wakeResult;
    private string? _reconnectResult;

    protected override void OnInitialized()
    {
        Watch(Status, snapshot => _view = snapshot);
        Watch(Minima, minima => _minima = minima);
    }

    private void SetMinima()
    {
        if (_minimaAltitude > 0)
        {
            Minima.Set(new ArrivalMinima(_minimaKind, _minimaAltitude));
        }
    }

    private void ClearMinima() => Minima.Clear();

    private static string KindLabel(ArrivalMinimumKind kind) => kind switch
    {
        ArrivalMinimumKind.DecisionAltitude => "DA",
        ArrivalMinimumKind.DecisionHeight => "DH",
        _ => "MDA",
    };

    private void SpeakTest()
    {
        if (!string.IsNullOrWhiteSpace(_testText))
        {
            SpeechControl.SpeakTest(_testText.Trim());
        }
    }

    // The banner disappears via the status-store update the cancellation itself triggers.
    private void CancelAbnormal() => AbnormalControl.CancelActiveDialogue();

    // Same store-driven re-render: the controller publishes ListeningPaused on every edge.
    private void ToggleListening() => ListeningControl.SetPaused(!ListeningControl.Paused);

    private Task TestProviderAsync(string providerName) => RunTestAsync(
        $"tts:{providerName}",
        // The Speak Test text doubles as the sample phrase when filled in.
        () => Diagnostics.TestTtsProviderAsync(
            providerName,
            string.IsNullOrWhiteSpace(_testText) ? "ProsimCompanion voice test." : _testText.Trim(),
            CancellationToken.None),
        result => _ttsTestResult = result);

    private Task TestLlmAsync() => RunTestAsync(
        "llm", () => Diagnostics.TestLlmAsync(CancellationToken.None), result => _llmTestResult = result);

    private Task TestMicAsync() => RunTestAsync(
        "mic", () => Diagnostics.TestMicrophoneAsync(CancellationToken.None), result => _micTestResult = result);

    private Task TestNavDataAsync() => RunTestAsync(
        "navdata", () => Diagnostics.TestNavDataAsync(CancellationToken.None), result => _navDataTestResult = result);

    private Task WakeLlmAsync() => RunTestAsync(
        "wol", () => Diagnostics.WakeLlmServerAsync(CancellationToken.None), result => _wakeResult = result);

    private Task ReconnectVoiceAsync() => RunTestAsync(
        "reconnect", () => Diagnostics.ReconnectVoiceServicesAsync(CancellationToken.None), result => _reconnectResult = result);

    private async Task RunTestAsync(string key, Func<Task<string>> test, Action<string> report)
    {
        _runningTest = key;
        try
        {
            report(await test());
        }
        catch (Exception)
        {
            report("Test failed unexpectedly — see the Logs page.");
        }
        finally
        {
            _runningTest = null;
        }
    }

    private static (string Tone, string Label) HealthPill(TtsProviderHealth health) => health switch
    {
        TtsProviderHealth.Healthy => ("tone-ok", "Healthy"),
        TtsProviderHealth.Failed => ("tone-warn", "Cooling down"),
        TtsProviderHealth.Disabled => ("tone-neutral", "Disabled"),
        _ => ("tone-neutral", "Untried"),
    };

    private static string OutcomeTone(string outcome) => outcome switch
    {
        "Spoken" => "tone-ok",
        "Failed" => "tone-warn",
        "Suppressed" or "Deferred" => "tone-active",
        _ => "tone-neutral",
    };
}
