@using System.Globalization

@* CG envelope chart — faithful port of Prosim2GSX's WeightBalancePanel chart: the same
   wandb.png artwork (white envelope + limit lines on transparency, drawn for the dark card),
   the same axis ranges (%MAC 20–39 across, 35–78 t up), the same limit annotations
   (MTOW/MLW/MZFW) and rotated envelope-region labels at the same PNG-relative ratios, the
   same single live GW marker (red/white quadrant crosshair at (MACGW, GW), clamped to
   21–38 %MAC / 35–75 t, hidden with no data) and the same ZFW/GW MAC gauge bars below.
   Geometry uses CSS percentages of the image box, so it is resolution-independent exactly
   like the source's measured-ratio scheme. Colors are the source's own (the artwork is
   white-on-dark; this card is deliberately not theme-aware). *@

<div class="cg-chart">
    <div class="cg-wrap">
        <img class="cg-img" src="img/wandb.png" alt="" />

        @* Y-axis labels (left side, tonnes, every 5 t). *@
        @foreach (var t in LeftNumbers)
        {
            <div class="cg-axis cg-axis-y" style="left:0; top:@YCss(t);">@t</div>
        }

        @* Y-axis ticks every 1 t — long next to a numeric label, short between. *@
        @foreach (var t in LeftTicks)
        {
            <div class="@(t % 5 == 0 ? "cg-tick-long" : "cg-tick-short")"
                 style="left:0; top:@YCss(t);"></div>
        }

        @* X-axis gutter label + integer %MAC labels along the top. *@
        <div class="cg-axis cg-axis-x" style="left:-10px; top:-10px;">%MAC</div>
        @foreach (var m in TopNumbers)
        {
            <div class="cg-axis cg-axis-x" style="left:@XCss(m); top:-10px;">@m</div>
        }

        @* Limit-line annotations (same values + ratio positions as the source). *@
        <div class="cg-limit" style="@AnnotCss(0.47, 0.125)">MTOW = 73,500KG</div>
        <div class="cg-limit" style="@AnnotCss(0.43, 0.29)">MLW = 64,500KG</div>
        <div class="cg-limit" style="@AnnotCss(0.40, 0.37)">MZFW = 61,000KG</div>

        @* Envelope-region annotations, rotated per the source. *@
        <div class="cg-env cg-annot1" style="@AnnotCss(0.40, 0.56)">Operational Limits</div>
        <div class="cg-env cg-annot2" style="@AnnotCss(0.69, 0.56)">Take-Off Limits</div>
        <div class="cg-env cg-annot3" style="@AnnotCss(0.70, 0.66)">Zfw limit</div>
        <div class="cg-env cg-annot4" style="@AnnotCss(0.16, 0.64)">Zfw limit</div>
        <div class="cg-env cg-annot5" style="@AnnotCss(0.12, 0.80)">Take-Off Limits</div>

        @* Live GW marker — red+white quadrant crosshair at (MACGW, GW). *@
        @if (ShowGwDot)
        {
            <svg class="cg-dot" style="left:@DotLeftCss(); top:@DotTopCss();"
                 width="22" height="22" viewBox="0 0 22 22">
                <circle cx="11" cy="11" r="10" fill="#FFFFFF" stroke="#000" stroke-opacity="0.5" />
                <path d="M 11 1 A 10 10 0 0 1 21 11 L 11 11 Z" fill="#D81E1E" />
                <path d="M 11 21 A 10 10 0 0 1 1 11 L 11 11 Z" fill="#D81E1E" />
                <line x1="11" y1="-2" x2="11" y2="24" stroke="#FFFFFF" stroke-width="1.2" />
                <line x1="-2" y1="11" x2="24" y2="11" stroke="#FFFFFF" stroke-width="1.2" />
            </svg>
        }
    </div>

    @* ZFW (pink) and GW (orange) MAC gauge bars — full chart width, invisible track. *@
    <div class="cg-gauge"><div class="cg-gauge-zfw" style="width:@BarCss(ZfwCgMac)"></div></div>
    <div class="cg-gauge"><div class="cg-gauge-gw" style="width:@BarCss(GrossCgMac)"></div></div>
</div>

<style>
    .cg-chart {
        position: relative;
        width: 100%;
        padding: 28px 0 8px 0;
        text-align: center;
        background: #1a1a1a;
    }

    .cg-wrap {
        position: relative;
        display: inline-block;
        width: 80%;
        max-width: 100%;
    }

    .cg-img {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        pointer-events: none;
    }

    .cg-axis {
        position: absolute;
        font-family: Roboto, sans-serif;
        font-size: 14px;
        font-weight: 400;
        letter-spacing: 0.22px;
        color: #ffffff;
        white-space: nowrap;
        pointer-events: none;
        transform: translate(-50%, -50%) scale(0.7);
    }

    .cg-axis-y {
        width: 65px;
        text-align: right;
        transform: translate(-110%, -50%) scale(0.7);
    }

    .cg-tick-long,
    .cg-tick-short {
        position: absolute;
        height: 1px;
        background: #ffffff;
        pointer-events: none;
        transform: translate(-100%, -50%);
    }

    .cg-tick-long { width: 10px; }
    .cg-tick-short { width: 5px; }

    .cg-limit,
    .cg-env {
        position: absolute;
        font-size: 10px;
        color: #ffffff;
        white-space: nowrap;
        pointer-events: none;
        background: rgba(58, 61, 59, 0.7);
        padding: 0;
        transform: translate(-50%, -50%) scale(0.7);
    }

    .cg-annot1 { transform: translate(-50%, -50%) scale(0.8); }
    .cg-annot2 { transform: translate(-50%, -50%) scale(0.7) rotate(-43deg); }
    .cg-annot3 { transform: translate(-50%, -50%) scale(0.7) rotate(-60deg); }
    .cg-annot4 { transform: translate(-50%, -50%) scale(0.7) rotate(-85deg); }
    .cg-annot5 { transform: translate(-50%, -50%) scale(0.7) rotate(-110deg); }

    .cg-dot {
        position: absolute;
        pointer-events: none;
        overflow: visible;
    }

    .cg-gauge {
        position: relative;
        height: 5px;
        margin-top: 3px;
        background: transparent;
        width: 100%;
    }

    .cg-gauge-zfw,
    .cg-gauge-gw {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
    }

    .cg-gauge-zfw { background: #e91e63; }
    .cg-gauge-gw { background: #ff8a00; }
</style>

@code {
    // Axis ranges — identical to the source chart (A320 family, KG mode).
    private const int TopNumMin = 20;
    private const int TopNumMax = 39;
    private const int LeftNumMinKg = 35;
    private const int LeftNumMaxKg = 78;
    private const int AxisMacMin = 21;
    private const int AxisMacMax = 38;
    private const int DotRadius = 11;

    /// <summary>Gross weight, kg.</summary>
    [Parameter] public double GrossWeightKg { get; set; }

    /// <summary>Gross-weight CG, %MAC.</summary>
    [Parameter] public double GrossCgMac { get; set; }

    /// <summary>Zero-fuel weight, kg — the chart shows a single GW marker like the source;
    /// ZFW feeds the pink gauge bar and the tables outside this component.</summary>
    [Parameter] public double ZfwKg { get; set; }

    /// <summary>ZFW CG, %MAC.</summary>
    [Parameter] public double ZfwCgMac { get; set; }

    // X labels 21..38; Y labels 35,40..75; Y ticks 35..77 (source arrays, verbatim).
    private static IEnumerable<int> TopNumbers
        => Enumerable.Range(TopNumMin + 1, TopNumMax - TopNumMin - 1);

    private static IEnumerable<int> LeftNumbers
        => Enumerable.Range(0, (75 - LeftNumMinKg) / 5 + 1).Select(i => LeftNumMinKg + i * 5);

    private static IEnumerable<int> LeftTicks
        => Enumerable.Range(LeftNumMinKg, LeftNumMaxKg - LeftNumMinKg);

    private bool ShowGwDot => GrossWeightKg > 0 && GrossCgMac > 0;

    private static double XPct(double mac)
        => (mac - TopNumMin) / (TopNumMax - TopNumMin) * 100.0;

    private static double YPct(double tonnes)
        => (LeftNumMaxKg - tonnes) / (double)(LeftNumMaxKg - LeftNumMinKg) * 100.0;

    private static string XCss(double mac)
        => XPct(mac).ToString("F3", CultureInfo.InvariantCulture) + "%";

    // The −2px matches the source so labels align with their tick centres.
    private static string YCss(double tonnes)
        => $"calc({YPct(tonnes).ToString("F3", CultureInfo.InvariantCulture)}% - 2px)";

    private static string AnnotCss(double xRatio, double yRatio)
        => $"left:{(xRatio * 100).ToString("F1", CultureInfo.InvariantCulture)}%; "
            + $"top:{(yRatio * 100).ToString("F1", CultureInfo.InvariantCulture)}%;";

    private static double ClampMac(double mac)
        => !double.IsFinite(mac) || mac <= 0 ? AxisMacMin : Math.Clamp(mac, AxisMacMin, AxisMacMax);

    private string DotLeftCss()
        => $"calc({XPct(ClampMac(GrossCgMac)).ToString("F3", CultureInfo.InvariantCulture)}% - {DotRadius}px)";

    private string DotTopCss()
    {
        var tonnes = GrossWeightKg / 1000.0;
        tonnes = !double.IsFinite(tonnes) || tonnes <= 0 ? LeftNumMinKg : Math.Clamp(tonnes, LeftNumMinKg, 75);
        return $"calc({YPct(tonnes).ToString("F3", CultureInfo.InvariantCulture)}% - 2px - {DotRadius}px)";
    }

    private static string BarCss(double mac)
    {
        var fraction = !double.IsFinite(mac) || mac <= 0
            ? 0
            : (Math.Clamp(mac, AxisMacMin, AxisMacMax) - AxisMacMin) / (double)(AxisMacMax - AxisMacMin);
        return (fraction * 100).ToString("F2", CultureInfo.InvariantCulture) + "%";
    }
}
