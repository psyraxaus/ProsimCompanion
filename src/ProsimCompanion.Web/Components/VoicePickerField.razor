@* Voice picker over the LIVE voice lists of the connected providers, grouped by provider then
   region, with a details line for the chosen voice and an "Other voice id" escape hatch.
   Nothing is pre-populated: until a provider has answered, the list holds only the saved value
   (owner, 2026-10-12 — no defunct names from a built-in sheet). Values are provider:id
   (VoiceRef) unless PlainIds is set — the per-provider fallback fields store the bare id.
   Binds the text escape on INPUT like TextField so type-then-Save never loses the value (#20). *@
@using ProsimCompanion.Core.Speech
@using ProsimCompanion.Core.State
@inject IStringLocalizer T
<div class="field">
    <label class="field-label" for="@_id">
        @Label
        <FieldHint Hint="@Hint" More="@More" />
    </label>
    <div class="field-control">
        <select id="@_id" class="select" style="max-width:380px;" disabled="@Disabled" value="@SelectValue" @onchange="OnPickedAsync">
            @if (BlankLabel is not null)
            {
                <option value="" selected="@(SelectValue == "")">@BlankLabel</option>
            }
            else if (SelectValue == "")
            {
                <option value="" selected>@T["voicePicker.pick"]</option>
            }
            @if (ShowSavedOnly)
            {
                <option value="@Value.Trim()" selected>@SavedLabel</option>
            }
            @foreach (var group in Groups)
            {
                <optgroup label="@group.Label">
                    @foreach (var voice in group.Voices)
                    {
                        var key = KeyOf(voice);
                        <option value="@key" selected="@(key == SelectValue)">@voice.Label</option>
                    }
                </optgroup>
            }
            <option value="@CustomKey" selected="@(SelectValue == CustomKey)">@T["voicePicker.other"]</option>
        </select>
        @if (SelectValue == CustomKey)
        {
            <input type="text" class="text-input" style="margin-top:6px;" value="@Value" disabled="@Disabled"
                   placeholder="@(PlainIds ? T["voicePicker.placeholderPlain"].Value : T["voicePicker.placeholderRef"].Value)"
                   autocomplete="off" autocapitalize="off" spellcheck="false"
                   @oninput="OnTypedAsync" />
        }
        @if (Details is not null)
        {
            <div class="field-hint" style="margin-top:6px; max-width:560px;">@Details</div>
        }
        @if (Groups.Count == 0 && EmptyListHint is not null)
        {
            <div class="field-hint field-hint-warn" style="margin-top:6px; max-width:560px;">@EmptyListHint</div>
        }
    </div>
</div>

@code {
    private const string CustomKey = "__other__";
    private readonly string _id = $"f{Guid.NewGuid():N}";
    private bool _custom;

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    /// <summary>Longer explanation behind a "More" fold under the hint (ADR-0010).</summary>
    [Parameter]
    public string? More { get; set; }

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Provider · region groups; empty until a provider has answered.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<VoiceGroup> Groups { get; set; } = [];

    /// <summary>Store the bare voice id instead of provider:id — the per-provider fallback
    /// fields, whose provider is fixed.</summary>
    [Parameter]
    public bool PlainIds { get; set; }

    /// <summary>When set, a blank value is a listed choice with this label (crew voices: blank =
    /// the First Officer's voice). When null, blank shows a "Pick a voice" placeholder.</summary>
    [Parameter]
    public string? BlankLabel { get; set; }

    /// <summary>Shown under the picker while <see cref="Groups"/> is empty — where to get the
    /// list from.</summary>
    [Parameter]
    public string? EmptyListHint { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string KeyOf(VoiceEntry voice) => PlainIds ? voice.Id : voice.Value;

    /// <summary>The listed row for a value. A legacy plain id ("af_heart", no provider prefix)
    /// matches the first provider that lists that id — chain order, so Kokoro first — and the
    /// dropdown shows it as that row rather than dropping into the text box.</summary>
    private VoiceEntry? Find(string value)
    {
        var all = Groups.SelectMany(g => g.Voices);
        var direct = all.FirstOrDefault(v => string.Equals(KeyOf(v), value, StringComparison.OrdinalIgnoreCase));
        if (direct is not null || PlainIds || VoiceRef.Parse(value).HasProvider)
        {
            return direct;
        }

        return all.FirstOrDefault(v => string.Equals(v.Id, value, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsListed(string value) => Find(value) is not null;

    /// <summary>No list yet and a saved value: show it as the one choice rather than dropping
    /// into the text box (which would read as "something is wrong").</summary>
    private bool ShowSavedOnly => !_custom && Groups.Count == 0 && Value.Trim().Length > 0;

    private string SavedLabel
    {
        get
        {
            var value = Value.Trim();
            if (PlainIds)
            {
                var kokoro = KokoroVoices.Describe(value);
                return kokoro.Region != KokoroVoices.Other ? T["voicePicker.saved", kokoro.Label].Value : T["voicePicker.saved", value].Value;
            }

            var parsed = VoiceRef.Parse(value);
            if (parsed.HasProvider)
            {
                return T["voicePicker.savedWithProvider", parsed.Id, VoiceRef.DisplayName(parsed.Provider!)];
            }

            var legacy = KokoroVoices.Describe(value);
            return legacy.Region != KokoroVoices.Other ? T["voicePicker.saved", legacy.Label].Value : T["voicePicker.saved", value].Value;
        }
    }

    private string SelectValue
    {
        get
        {
            if (_custom) return CustomKey;
            var value = Value.Trim();
            if (value.Length == 0) return "";
            if (ShowSavedOnly) return value;
            var listed = Find(value);
            return listed is not null ? KeyOf(listed) : CustomKey;
        }
    }

    private string? Details
    {
        get
        {
            var value = Value.Trim();
            if (value.Length == 0) return null;

            var listed = Find(value);
            if (listed is not null) return listed.Blurb;

            var parsed = PlainIds ? new VoiceRef(null, value) : VoiceRef.Parse(value);
            if (parsed.HasProvider)
            {
                return T["voicePicker.notInProviderList", VoiceRef.DisplayName(parsed.Provider!), parsed.Id];
            }

            var kokoro = KokoroVoices.Describe(parsed.Id);
            if (kokoro.Region != KokoroVoices.Other)
            {
                return Groups.Count == 0 ? kokoro.Blurb : T["voicePicker.notInServerList", kokoro.Blurb].Value;
            }

            return T["voicePicker.plainId"];
        }
    }

    protected override void OnParametersSet()
    {
        // A discard or a refresh can make the current value a listed voice again — then the
        // text box closes. The flag only lives while the pilot is typing an id.
        if (_custom && Value.Trim().Length > 0 && IsListed(Value.Trim()))
        {
            _custom = false;
        }
    }

    private async Task OnPickedAsync(ChangeEventArgs e)
    {
        var picked = e.Value?.ToString() ?? "";
        if (picked == CustomKey)
        {
            _custom = true;
            // A listed voice would be misleading in the box, so start it blank.
            if (IsListed(Value.Trim()))
            {
                await ValueChanged.InvokeAsync("");
            }
            return;
        }

        _custom = false;
        await ValueChanged.InvokeAsync(picked);
    }

    private Task OnTypedAsync(ChangeEventArgs e)
        => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
