@* Live GSX status + controls, shown as the landing section of the GSX tab (#18 — the former
   standalone /gsx page): readiness, arrival gate, departure board, services mirror, menu
   snapshot, automation decisions and recent commands. Every row, lamp and text id is decided
   in GsxPresentation (the second adapter of the status-row seam Flight Status opened); this
   file renders its records and owns only its controls. *@
@inherits StoreObserverComponent
@inject GsxDiagnosticsStore Diagnostics
@inject DeiceRequestStore DeiceRequest
@inject IGsxGateControl GateControl
@inject IGsxDepartureControl DepartureControl
@inject IGsxSimbriefReloadControl SimbriefReload
@inject GateChoiceStore GateChoices
@inject IStringLocalizer T

<Section Title="@T["gsxSettings.status.title"]">
    @foreach (var row in GsxPresentation.StatusRows(_view))
    {
        if (row.Kind == StatusRowKind.Pill)
        {
            <div class="row">
                <span class="row-label">@T[row.LabelTextId]</span>
                <span class="pill @row.Tone">@Text(row.Value)</span>
            </div>
        }
        else
        {
            <div class="row">
                <span class="row-label">@T[row.LabelTextId]</span>
                <span class="row-value-mono">@Text(row.Value)</span>
            </div>
        }
    }
</Section>

<Section Title="@T["gsxSettings.arrivalGate.title"]">
    <div class="row">
        <span class="row-label">@T["gsxSettings.arrivalGate.request"]</span>
        <span class="row-value-mono">@Text(GsxPresentation.GateRequest(_view))</span>
    </div>
    <div style="display:flex; gap:8px; align-items:center; margin-top:8px; flex-wrap:wrap;">
        <input type="text" class="text-input" style="max-width:120px;" placeholder="@T["gsxSettings.arrivalGate.placeholder"]"
               autocomplete="off" autocapitalize="characters" spellcheck="false"
               @bind="_gateInput" />
        <button type="button" class="btn primary" @onclick="ArmGate">@T["gsxSettings.arrivalGate.arm"]</button>
        <button type="button" class="btn secondary" @onclick="GateControl.Cancel">@T["gsxSettings.arrivalGate.cancel"]</button>
    </div>
    @if (_gateChoice.Question is { } gateQuestion)
    {
        @* GSX split the gate into suffix variants (issue #156): pick one here, on the OFP page,
           or by telling the FO; the first goes out at taxi-in otherwise. *@
        <div class="field-hint" style="margin-top:8px;">@gateQuestion.Prompt</div>
        <div style="display:flex; gap:8px; align-items:center; margin-top:4px; flex-wrap:wrap;">
            @foreach (var candidate in GsxPresentation.GateVariants(_gateChoice))
            {
                var label = candidate.Label;
                <button type="button" class="btn secondary" @onclick="() => ChooseGateVariant(label)"
                        title="@Text(candidate.Tooltip)">
                    @candidate.Caption
                </button>
            }
        </div>
    }
</Section>

<Section Title="@T["gsxSettings.departureBoard.title"]">
    @{ var board = GsxPresentation.DepartureBoard(_view, DepartureControl.Started, DepartureControl.Complete); }
    <div style="display:flex; gap:8px; align-items:center; margin-bottom:8px; flex-wrap:wrap;">
        <button type="button" class="btn primary" @onclick="@(() => DepartureControl.Start("web"))"
                disabled="@board.StartDisabled">
            @T[board.StartTextId]
        </button>
        <button type="button" class="btn secondary" @onclick="DepartureControl.ForceNext"
                disabled="@board.CallNextDisabled"
                title="@T["gsxSettings.departureBoard.callNextTitle"]">
            @T["gsxSettings.departureBoard.callNext"]
        </button>
        <button type="button" class="btn secondary" @onclick="ReloadSimbrief" disabled="@_reloading"
                title="@T["gsxSettings.departureBoard.reloadSimbriefTitle"]">
            @(_reloading ? T["gsxSettings.departureBoard.reloadingSimbrief"].Value : T["gsxSettings.departureBoard.reloadSimbrief"].Value)
        </button>
    </div>
    @if (_reloadResult is { } reloadResult)
    {
        <div class="field-hint" style="margin-bottom:8px;">@Text(reloadResult)</div>
    }
    @if (board.SimbriefVerdict is { } simbrief)
    {
        @* The last reload verdict (issue #174). RowMissing = this GSX shows no SimBrief row on
           any page the walk read — said once per app session, never retried for that plan. *@
        <div class="field-hint" style="margin-bottom:8px;">
            @T["gsxSettings.departureBoard.simbriefReload"] @simbrief
        </div>
    }
    @if (board.Rows.Count == 0)
    {
        <div class="empty">@T["gsxSettings.departureBoard.noSequence"]</div>
    }
    @foreach (var row in board.Rows)
    {
        <div class="row row-with-detail">
            <span class="row-label">@row.ServiceId</span>
            <span class="@row.Lamp"></span>
            <span class="row-value">@T[row.StageTextId]</span>
            @* Hold reasons are full sentences — the row-with-detail track ellipsizes them;
               the hover title carries the whole thing. *@
            <span class="row-detail" title="@row.Detail">@(row.Detail ?? "")</span>
        </div>
    }
</Section>

<Section Title="@T["gsxSettings.deiceStatus.title"]" Hint="@T["gsxSettings.deiceStatus.hint"]">
    @{ var deice = GsxPresentation.Deice(_deice, _view, DateTimeOffset.UtcNow); }
    <div class="row row-with-detail">
        <span class="row-label">@T["gsxSettings.deiceStatus.verdict"]</span>
        <span class="@deice.Lamp"></span>
        <span class="row-value">@T[deice.VerdictTextId]</span>
        <span class="row-detail" title="@deice.Reason">@deice.Reason</span>
    </div>
    <div class="row">
        <span class="row-label">@T["gsxSettings.deiceStatus.inputs"]</span>
        <span class="row-value-mono">@deice.Inputs</span>
    </div>
    @if (deice.Question is { } question)
    {
        <div class="field-hint" style="margin:8px 0;">@question.Prompt</div>
        <div class="row">
            <span class="row-label">@T["gsxSettings.deiceStatus.question"]</span>
            <span class="row-value-mono" title="@T["gsxSettings.deiceStatus.questionTitle"]">
                @Text(question.State)
            </span>
        </div>
        <div style="display:flex; gap:8px; align-items:center; margin-bottom:8px; flex-wrap:wrap;">
            <button type="button" class="btn primary" @onclick='() => DeiceRequest.Accept("web")'>@T["gsxSettings.deiceStatus.request"]</button>
            <button type="button" class="btn secondary" @onclick='() => DeiceRequest.Decline("web", "declined on the Status board")'>@T["gsxSettings.deiceStatus.decline"]</button>
        </div>
    }
    <div class="row">
        <span class="row-label">@T["gsxSettings.deiceStatus.lvars"]</span>
        <span class="row-value-mono" title="@T["gsxSettings.deiceStatus.lvarsTitle"]">
            @Text(deice.Lvars)
        </span>
    </div>
</Section>

@* Raw diagnostics (ADR-0010): the wire tables are for triage, not for flying — folded so the
   status board above stays the page. *@
<details class="diagnostics">
    <summary>@T["gsxSettings.diagnostics.summary"]</summary>

<Section Title="@T["gsxSettings.services.title"]" Hint="@T["gsxSettings.services.hint"]">
    @if (_view.Services.Count == 0)
    {
        <div class="empty">@T["gsxSettings.services.none"]</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>@T["gsxSettings.services.service"]</th><th>@T["gsxSettings.services.wireState"]</th><th>@T["gsxSettings.services.mapped"]</th><th>@T["gsxSettings.services.stage"]</th><th>@T["gsxSettings.services.triggerable"]</th><th>@T["gsxSettings.services.progress"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var service in GsxPresentation.ServiceTable(_view))
                    {
                        <tr>
                            <td>@service.DisplayName</td>
                            <td class="mono">@service.WireState@(service.Waiting ? " " + T["gsxSettings.services.waiting"].Value : "")</td>
                            <td>@service.MappedState</td>
                            @* Stage is the latched view — diverging from Mapped after a quick
                               service finishes is the latch doing its job (issue #29). *@
                            <td>@T[service.StageTextId]</td>
                            <td>@(service.CanTrigger ? T["gsxSettings.services.yes"].Value : T["gsxSettings.services.no"].Value)</td>
                            <td>@service.ProgressText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Section>

<Section Title="@T["gsxSettings.menu.title"]" Hint="@T["gsxSettings.menu.hint"]">
    <GsxMenuCard />
</Section>

<Section Title="@T["gsxSettings.decisions.title"]" Hint="@T["gsxSettings.decisions.hint"]">
    @if (_view.RecentDecisions.Count == 0)
    {
        <div class="empty">@T["gsxSettings.decisions.none"]</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>@T["gsxSettings.decisions.time"]</th><th>@T["gsxSettings.decisions.action"]</th><th>@T["gsxSettings.decisions.reason"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var decision in GsxPresentation.Decisions(_view))
                    {
                        <tr>
                            <td class="mono" style="white-space:nowrap;">@decision.Time</td>
                            <td style="white-space:nowrap;">@decision.Action</td>
                            <td>@decision.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Section>

<Section Title="@T["gsxSettings.commands.title"]">
    @if (_view.RecentCommands.Count == 0)
    {
        <div class="empty">@T["gsxSettings.commands.none"]</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>@T["gsxSettings.commands.time"]</th><th>@T["gsxSettings.commands.verb"]</th><th>@T["gsxSettings.commands.args"]</th><th>@T["gsxSettings.commands.result"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var command in GsxPresentation.Commands(_view))
                    {
                        <tr>
                            <td class="mono" style="white-space:nowrap;">@command.Time</td>
                            <td class="mono">@command.Verb</td>
                            <td class="mono">@command.Args</td>
                            <td><span class="pill @command.Tone">@command.Code</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="field-hint" style="margin-top:8px;">
        @T["gsxSettings.commands.wireHintBefore"] <a href="settings/logs">@T["gsxSettings.commands.wireTrace"]</a> @T["gsxSettings.commands.wireHintMiddle"]
        <code>ProsimCompanion-wire-*.log</code> @T["gsxSettings.commands.wireHintAfter"]
    </div>
</Section>
</details>

@code {
    private GsxDiagnosticsSnapshot _view = GsxDiagnosticsSnapshot.Empty;
    private DeiceRequestSnapshot _deice = DeiceRequestSnapshot.Empty;
    private GateChoiceSnapshot _gateChoice = GateChoiceSnapshot.Empty;
    private string _gateInput = "";
    private bool _reloading;
    private DisplayText? _reloadResult;

    /// <summary>A presentation text in the page's language.</summary>
    private string Text(DisplayText text) => text.Resolve(T);

    // The suffix-variant buttons (issue #156): the store matches the label; the GSX gate
    // service sends the chosen stand.
    private void ChooseGateVariant(string label) => GateChoices.Choose(label, "web");

    private void ArmGate()
    {
        if (!string.IsNullOrWhiteSpace(_gateInput))
        {
            GateControl.RequestGate(_gateInput);
        }
    }

    /// <summary>The manual SimBrief reload (2026-10-09). The control decides whether now is
    /// a safe moment; the outcome line stays under the buttons until the next click.</summary>
    private async Task ReloadSimbrief()
    {
        if (_reloading)
        {
            return;
        }

        _reloading = true;
        _reloadResult = null;
        try
        {
            var outcome = await SimbriefReload.ReloadAsync("web");
            _reloadResult = GsxPresentation.ReloadOutcome(outcome);
        }
        finally
        {
            _reloading = false;
        }
    }

    protected override void OnInitialized()
    {
        Watch(Diagnostics, snapshot => _view = snapshot);
        Watch(DeiceRequest, snapshot => _deice = snapshot);
        Watch(GateChoices, snapshot => _gateChoice = snapshot);
    }
}
