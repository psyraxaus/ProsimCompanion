@* Text field row (monospace input per the design language). Supports @bind-Value. Binds on
   INPUT (per keystroke), not change: with blur-bound fields, type-then-click-Save could lose
   the value — the blur-triggered re-render races the DirtyBar click (observed live with the
   DFD path, #20).
   Kind (owner request 2026-10-13) checks the value against the shape the consumer needs and
   shows the mismatch under the field: red + aria-invalid for a value that can never work
   (and the page's Save goes grey through the cascaded FieldValidity), amber for advisory
   findings such as a path that is not there yet. A disabled field is shown but never blocks.
   The tally entry is keyed by Label (or TallyKey where a label repeats on a page) and is NOT
   cleared when the field leaves the screen: a red value in a section or fold the pilot has
   switched away from must still hold Save (review 2026-10-13); the page resets the tally.
   Path kinds also get a Browse… button — only when the browser runs on the sim PC (cascaded
   ClientContext) and the desktop shell offers its dialogs (INativeFilePicker registered):
   the Windows dialog opens on that PC's screen, so a tablet would see nothing (option 3).
   The dialog opens in the value's folder, else the field's expected folders (BrowseStartIn,
   evaluated at click time only — some probe the file system), else the system drive. *@
@using Microsoft.Extensions.DependencyInjection
@using ProsimCompanion.Core.Hosting
@inject IServiceProvider Services
@inject IStringLocalizer T
<div class="field">
    <label class="field-label" for="@_id">
        @Label
        <FieldHint Hint="@Hint" More="@More" />
    </label>
    <div class="field-control">
        <span class="text-row @(IsPathKind ? "path" : null)">
            <input id="@_id" type="@(Password ? "password" : "text")" class="text-input @ProblemClass" value="@Value"
                   placeholder="@Placeholder" disabled="@Disabled"
                   autocomplete="off" autocapitalize="off" spellcheck="false"
                   aria-invalid="@(_problem is { Blocking: true } ? "true" : null)"
                   aria-describedby="@(_problem is null ? null : _id + "-problem")"
                   @oninput="OnChangedAsync" />
            @if (CanBrowse)
            {
                <button type="button" class="browse-btn" disabled="@_browsing"
                        title="@BrowseTitle" @onclick="BrowseAsync">@(_browsing ? T["fields.text.browsing"].Value : T["fields.text.browse"].Value)</button>
            }
        </span>
        @if (_problem is { } problem)
        {
            <div id="@(_id + "-problem")" class="field-hint @(problem.Blocking ? "field-hint-error" : "field-hint-warn")"
                 role="@(problem.Blocking ? "alert" : "status")">@ProblemText(problem)</div>
        }
        @if (_browseProblem is not null)
        {
            <div class="field-hint field-hint-warn" role="status">@_browseProblem</div>
        }
    </div>
</div>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";
    private FieldProblem? _problem;
    private string? _browseProblem;
    private bool _browsing;
    private INativeFilePicker? _picker;

    [CascadingParameter]
    private FieldValidity? Validity { get; set; }

    [CascadingParameter]
    private ClientContext? Client { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    /// <summary>The name the field blocks a save under, shown in the DirtyBar when the
    /// field is off screen. Defaults to <see cref="Label"/>; set it where one label appears
    /// more than once on a page (the provider tabs' "Base URL"), else the fields would share
    /// one entry and the visible one could clear the hidden one's red.</summary>
    [Parameter]
    public string? TallyKey { get; set; }

    /// <summary>Longer explanation behind a "More" fold under the hint (ADR-0010).</summary>
    [Parameter]
    public string? More { get; set; }

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Password { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The shape the value must have; <see cref="TextFieldKind.Text"/> is unchecked.</summary>
    [Parameter]
    public TextFieldKind Kind { get; set; } = TextFieldKind.Text;

    /// <summary>Windows dialog filter for file kinds (<c>Certificates (*.pfx)|*.pfx</c>).
    /// Empty shows all files.</summary>
    [Parameter]
    public string? BrowseFilter { get; set; }

    /// <summary>Output-file kinds: the file name the Save dialog suggests.</summary>
    [Parameter]
    public string? BrowseFileName { get; set; }

    /// <summary>The folders this field's file is expected in (see <see cref="ExpectedFolders"/>),
    /// tried in order when the value gives no usable folder. A function, so the lists that
    /// probe the file system run at click time, never per render.</summary>
    [Parameter]
    public Func<IReadOnlyList<string>>? BrowseStartIn { get; set; }

    /// <summary>The kind's row: rule, dialog, title (see <see cref="FieldValidation.Describe"/>).</summary>
    private TextFieldKindInfo Spec => FieldValidation.Describe(Kind);

    private bool IsPathKind => Spec.IsPath;

    private bool CanBrowse => IsPathKind && !Disabled && Client?.IsLocal == true && _picker is { IsAvailable: true };

    private string BrowseTitle => Spec.IsPath ? T[Spec.BrowseTitleTextId].Value : "";

    /// <summary>The finding's sentence in the circuit's language: the validation table is
    /// static and carries ids, this is where the localizer is at hand.</summary>
    private string ProblemText(FieldProblem problem)
        => problem.Detail is null ? T[problem.TextId].Value : T[problem.TextId, problem.Detail].Value;

    private string? ProblemClass => _problem switch
    {
        { Blocking: true } => "invalid",
        { } => "warn",
        _ => null,
    };

    protected override void OnInitialized() => _picker = Services.GetService<INativeFilePicker>();

    protected override void OnParametersSet()
    {
        _problem = FieldValidation.Check(Kind, Value);
        Validity?.Report(TallyKey ?? Label, _problem is { Blocking: true } && !Disabled);
    }

    private Task OnChangedAsync(ChangeEventArgs e)
    {
        _browseProblem = null;
        return ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

    private async Task BrowseAsync()
    {
        if (_picker is null || _browsing || Spec.Dialog is not { } pickKind)
        {
            return;
        }

        // A folder list opens where its last entry is.
        var start = Spec.IsList
            ? Value.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).LastOrDefault()
            : Value;
        var fileName = BrowseFileName ?? (pickKind == NativePickKind.SaveFile && Value.Length > 0 ? System.IO.Path.GetFileName(SafePath.Unquote(Value)) : null);
        IReadOnlyList<string> startIn = [];
        try
        {
            startIn = BrowseStartIn?.Invoke() ?? [];
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // A probing list that fails only costs the better start folder.
        }

        _browsing = true;
        _browseProblem = null;
        try
        {
            var result = await _picker.PickAsync(new NativePickRequest(pickKind, Label, BrowseFilter, start, fileName, startIn), CancellationToken.None);
            if (result.Problem is not null)
            {
                _browseProblem = result.Problem;
                return;
            }

            if (result.Path is null)
            {
                return; // cancelled
            }

            var next = Spec.IsList && !string.IsNullOrWhiteSpace(Value)
                ? Value.Trim().TrimEnd(';', ' ') + ";" + result.Path
                : result.Path;
            await ValueChanged.InvokeAsync(next);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The picker already turns dialog failures into a problem line; this is the last
            // line before the circuit would fault over a Browse… click (degrade, not fail).
            _browseProblem = T["fields.text.browseFailed", ex.Message];
        }
        finally
        {
            _browsing = false;
        }
    }
}
