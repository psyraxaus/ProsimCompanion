@using ProsimCompanion.Core.Diagnostics.Ecam
@using ProsimCompanion.Core.Scenarios
@using ProsimCompanion.Core.Commands.Handlers
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject IStringLocalizer T
@* STATUS: cautions by system on the left, INOP SYS / DEGRADED / RECENT on the right, the
   counts and the bundle export in the memo strip, and the scenario row (issue #197) with
   its CLEAR ALL box — clickable like the GSX page's GPU box. *@
@{
    var memo = Snap.Memo;
    var (upH, upM) = EcamPresentation.UptimeParts(memo.Uptime);
    var inop = Snap.InopSystems;
    var degraded = Snap.Degraded;
    var recent = Snap.Recent.Take(8).ToList();
    var y = 58;
}
<div class="abs ecam-title" style="left:318px;top:14px">STATUS</div>

@if (Snap.Cautions.Count == 0)
{
    <div class="abs c-green" style="left:24px;top:58px">NORMAL</div>
}
else
{
    <EcamCautionList Cautions="@Snap.Cautions" Left="24" Top="58" MaxY="500" />
}

<div class="abs vline" style="left:440px;top:52px;height:466px"></div>

<div class="abs head-u" style="left:466px;top:@(y)px">INOP SYS</div>
@{ y += 24; }
@if (inop.Count == 0)
{
    <div class="abs c-green grp-ttl st-normal" style="left:466px;top:@(y)px">NONE</div>
    y += 22;
}
@foreach (var item in inop.Take(6))
{
    <div class="abs grp-ttl st-caution" style="left:466px;top:@(y)px">@item.ToUpperInvariant()</div>
    y += 22;
}
@{ y += 14; }
<div class="abs head-u" style="left:466px;top:@(y)px">DEGRADED</div>
@{ y += 24; }
@if (degraded.Count == 0)
{
    <div class="abs grp-ttl st-normal" style="left:466px;top:@(y)px">NONE</div>
    y += 22;
}
@foreach (var item in degraded.Take(4))
{
    <div class="abs grp-ttl st-caution" style="left:466px;top:@(y)px">@item.ToUpperInvariant()</div>
    y += 22;
}
@{ y += 14; }
<div class="abs head-u" style="left:466px;top:@(y)px">RECENT</div>
@{ y += 24; }
@foreach (var evt in recent)
{
    if (y > 500)
    {
        break;
    }

    <div class="abs act @EcamPresentation.StateClass(evt.State)" style="left:466px;top:@(y)px;font-size:15px;width:240px;white-space:nowrap;overflow:hidden">@EcamPresentation.Clock(evt.AtUtc) @evt.Text.ToUpperInvariant()</div>
    y += 22;
}

@* ---- scenario row (issue #197): state, the armed failure when shown, CLEAR ALL ---- *@
@{
    var scenario = Services.GetService<ScenarioStore>()?.Snapshot() ?? ScenarioSnapshot.Empty;
    var control = Services.GetService<IScenarioControl>();
    var scenarioState = scenario.State.ToUpperInvariant();
    var scenarioClass = scenario.State switch
    {
        "armed" or "fired" or "failed" => "c-amber",
        "off" => "c-grey",
        _ => "c-green",
    };
    var scenarioDetail = scenario.PlannedTitle is { } planned
        ? planned + (scenario.FailureName is { } fn ? " · " + fn : "")
        : scenario.LastClear ?? (scenario.InjectorAvailable ? "" : "SDK FAILURE API N/A");
}
<div class="abs head-u" style="left:24px;top:520px">SCENARIO</div>
<div class="abs grp-ttl @scenarioClass" style="left:150px;top:520px">@scenarioState</div>
<div class="abs act c-grey" style="left:24px;top:544px;font-size:14px;width:400px;white-space:nowrap;overflow:hidden">@scenarioDetail.ToUpperInvariant()</div>
<div class="abs svc-box @(control is null ? "c-grey" : "c-green clickable")" style="left:466px;top:516px"
     title="@(control is null ? null : T["diagnostics.status.scenarioClearAll"].Value)"
     role="@(control is null ? null : "button")" tabindex="@(control is null ? null : "0")"
     @onclick="ClearAllAsync" @onkeydown="OnClearKeyAsync">
    <div class="svc-title">FAILURES</div>
    <div class="svc-val">@(_clearBusy ? "…" : "CLEAR ALL")</div>
    <div class="svc-detail">@(_clearNote ?? "")</div>
</div>

<EcamMemoStrip Cells="@(new[]
{
    new EcamMemoCell("CAUTIONS", memo.CautionCount.ToString(System.Globalization.CultureInfo.InvariantCulture), null, memo.CautionCount > 0 ? "c-amber" : null),
    new EcamMemoCell("WARNINGS", memo.WarningCount.ToString(System.Globalization.CultureInfo.InvariantCulture), null, memo.WarningCount > 0 ? "c-amber" : null),
    new EcamMemoCell("BUNDLE", "EXPORT", memo.BundleReady ? "RDY" : null, null, null, BundleHref),
    new EcamMemoCell("PHASE", EcamPresentation.Or(memo.Phase, EcamTokens.NoData)),
})" />

@code {
    [Parameter, EditorRequired] public DiagnosticsSnapshot Snap { get; set; } = DiagnosticsSnapshot.Empty;

    /// <summary>The Logs page's bundle export link (relative, cookie-authenticated).</summary>
    [Parameter] public string? BundleHref { get; set; }

    private bool _clearBusy;
    private string? _clearNote;

    private Task OnClearKeyAsync(KeyboardEventArgs e)
        => e.Key is "Enter" or " " ? ClearAllAsync() : Task.CompletedTask;

    /// <summary>Clear every armed failure — unconditional (issue #197); the Speech pillar's
    /// one serialised write path owns it, this only asks.</summary>
    private async Task ClearAllAsync()
    {
        if (_clearBusy || Services.GetService<IScenarioControl>() is not { } control)
        {
            return;
        }

        _clearBusy = true;
        _clearNote = null;
        try
        {
            var result = await control.ClearAllAsync("status-page");
            _clearNote = result.Reason;
        }
        catch (Exception ex)
        {
            _clearNote = ex.Message;
        }
        finally
        {
            _clearBusy = false;
        }
    }
}
