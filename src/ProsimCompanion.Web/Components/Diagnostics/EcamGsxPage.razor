@using ProsimCompanion.Core.Diagnostics.Ecam
@* GSX: DOOR/OXY grammar. The hull with its door markers, the service boxes either side with
   dashed connectors to where each service really meets the aircraft (owner layout 2026-10-27:
   BOARDING over JETWAY and tied to it and to STAIRS; GPU and PUSHBACK on one trunk to the
   nose; CATERING beside the service door the GSX profile uses, 1R at the top or 4R at the
   bottom; REFUEL to the right wing), the three progress bars, the GSX memo. *@
@{
    var pg = Snap.Gsx;
    var memo = Snap.Memo;
    var (upH, upM) = EcamPresentation.UptimeParts(memo.Uptime);
    var pax = pg.Gauges.GetValueOrDefault("pax");
    var cargo = pg.Gauges.GetValueOrDefault("cargo");
    var fuel = pg.Gauges.GetValueOrDefault("fuel");
    var turnaround = pg.Readout("memo_turnaround");
    var gsxMemo = pg.Readout("memo_gsx");

    var boarding = pg.NodeOrNoData("boarding");
    var jetway = pg.NodeOrNoData("jetway");
    var gpu = pg.NodeOrNoData("gpu");
    var stairs = pg.NodeOrNoData("stairs");
    var pushback = pg.NodeOrNoData("pushback");
    var catering = pg.NodeOrNoData("catering");
    var refuel = pg.NodeOrNoData("refuel");
    var deice = pg.NodeOrNoData("deice");
    var cateringAft = pg.Readout("catering_door") == "4R";

    // Column rows: five on the left (BOARDING, JETWAY, GPU, STAIRS, PUSHBACK), the right
    // column uses the same rows (CATERING at row 0 or 4, REFUEL row 1, DEICE row 2).
    // Left column: BOARDING over JETWAY over STAIRS, tied by short vertical links. PUSHBACK and
    // GPU sit above the nose, where the tug and the ground-power cable really meet the aircraft
    // (owner mark-up 2026-10-27).
    // STAIRS is hidden altogether when GSX says the stand does not use them (owner request
    // 2026-10-27); it still shows as amber XX while nothing is known.
    var stairsInUse = stairs.State != DiagState.NotApplicable;
    var leftBoxes = stairsInUse
        ? new[] { ("BOARDING", boarding), ("JETWAY", jetway), ("STAIRS", stairs) }
        : new[] { ("BOARDING", boarding), ("JETWAY", jetway) };
    var rightBoxes = new (string Label, DiagNode Node, int Row)[]
    {
        ("CATERING", catering, cateringAft ? 3 : 0),
        ("REFUEL", refuel, 1),
        ("DEICE", deice, 2),
    };
    // Door connectors run onto the door itself (its centre column) and end with a dot.
    var toLeftEdge = DoorLeftX - BoxRight;
    var toRightEdge = RightBoxLeft - DoorRightX;
}
<div class="abs ecam-title" style="left:40px;top:14px">GSX</div>

@* The A320 from above: the owner's own three-view drawing, traced (A320TopView, 2026-10-27).
   The drawing's fuselage edges give the door-marker columns and where the connectors end. *@
<svg class="abs hull" style="left:@(HullLeft)px;top:@(HullTop)px" width="@HullWidth" height="@HullHeight"
     viewBox="0 0 @A320TopView.ViewBoxWidth @A320TopView.ViewBoxHeight" aria-hidden="true">
    <path class="hull-path" d="@A320TopView.Path" />
</svg>

@foreach (var (id, label, x, y, labelLeft) in Doors)
{
    var state = pg.Readout(id);
    if (state is null)
    {
        continue;
    }

    var open = state == "OPEN";
    <div class="abs door @(open ? "open st-caution" : "st-normal")" style="left:@(x)px;top:@(y)px"></div>
    if (open)
    {
        <div class="abs detail c-amber" style="left:@(labelLeft ? x - 38 : x + 13)px;top:@(y + 2)px;width:36px;@(labelLeft ? "text-align:right" : "")">@label</div>
    }
}

@* ---- left column ---- *@
@for (var i = 0; i < leftBoxes.Length; i++)
{
    var (label, node) = leftBoxes[i];
    <div class="abs svc-box @EcamPresentation.StateClass(node.State)" style="left:@(BoxLeft)px;top:@(RowTop(i))px">
        <div class="svc-title">@label</div>
        <div class="svc-val">@node.Value</div>
        <div class="svc-detail">@(node.Detail ?? "")</div>
    </div>
}

@* BOARDING ties to JETWAY (always) and JETWAY to STAIRS (when stairs are in use): short
   vertical links in the gap between the stacked boxes. *@
<EcamLink State="@DiagStates.Worse(boarding.State, jetway.State)" Left="@(ColumnMidX - 6)" Top="@(RowTop(0) + RowHeight)" Length="@(RowPitch - RowHeight)" Vertical="true" Arrow="false" />
@* JETWAY → door 1L (elbow up to the door row, dot on the door). *@
<EcamLink State="@jetway.State" Left="@BoxRight" Top="@(Door1LY - 6)" Width="@(toLeftEdge + 2)" Height="@(RowMid(1) - Door1LY + 12)"
          Points="@($"0,{RowMid(1) - Door1LY + 6} 26,{RowMid(1) - Door1LY + 6} 26,6 {toLeftEdge},6")" Arrow="false" />
<div class="abs link-dot @EcamPresentation.StateClass(jetway.State)" style="left:@(DoorLeftX - 4)px;top:@(Door1LY - 4)px"></div>

@if (stairsInUse)
{
    <EcamLink State="@DiagStates.Worse(boarding.State, stairs.State)" Left="@(ColumnMidX - 6)" Top="@(RowTop(1) + RowHeight)" Length="@(RowPitch - RowHeight)" Vertical="true" Arrow="false" />
    @* STAIRS → door 4L (elbow down to the aft door row, dot on the door). *@
    <EcamLink State="@stairs.State" Left="@BoxRight" Top="@(RowMid(2) - 6)" Width="@(toLeftEdge + 2)" Height="@(Door4LY - RowMid(2) + 12)"
              Points="@($"0,6 26,6 26,{Door4LY - RowMid(2) + 6} {toLeftEdge},{Door4LY - RowMid(2) + 6}")" Arrow="false" />
    <div class="abs link-dot @EcamPresentation.StateClass(stairs.State)" style="left:@(DoorLeftX - 4)px;top:@(Door4LY - 4)px"></div>
}

@* PUSHBACK and GPU above the nose: the tug at the nose tip, the ground-power cable on the
   right side of the forward fuselage. *@
<div class="abs svc-box top-box @EcamPresentation.StateClass(pushback.State)" style="left:@(PushBoxLeft)px;top:@(TopBoxTop)px">
    <div class="svc-title">PUSHBACK</div>
    <div class="svc-val">@pushback.Value</div>
    <div class="svc-detail">@(pushback.Detail ?? "")</div>
</div>
<div class="abs svc-box top-box @EcamPresentation.StateClass(gpu.State)" style="left:@(GpuBoxLeft)px;top:@(TopBoxTop)px">
    <div class="svc-title">GPU</div>
    <div class="svc-val">@gpu.Value</div>
    <div class="svc-detail">@(gpu.Detail ?? "")</div>
</div>
<EcamLink State="@pushback.State" Left="@(PushBoxLeft + TopBoxWidth)" Top="@(TopBoxTop + TopBoxHeight / 2 - 6)" Width="@(NoseX - PushBoxLeft - TopBoxWidth + 8)" Height="@(HullTop - TopBoxTop - TopBoxHeight / 2 + 8)"
          Points="@($"0,6 {NoseX - PushBoxLeft - TopBoxWidth},6 {NoseX - PushBoxLeft - TopBoxWidth},{HullTop - TopBoxTop - TopBoxHeight / 2 + 6}")" Arrow="false" />
<EcamLink State="@gpu.State" Left="@FuselageRightX" Top="@(TopBoxTop + TopBoxHeight)" Width="@(GpuBoxLeft + TopBoxWidth / 2 - FuselageRightX + 8)" Height="@(GpuY - TopBoxTop - TopBoxHeight + 8)"
          Points="@($"{GpuBoxLeft + TopBoxWidth / 2 - FuselageRightX},0 {GpuBoxLeft + TopBoxWidth / 2 - FuselageRightX},{GpuY - TopBoxTop - TopBoxHeight} 0,{GpuY - TopBoxTop - TopBoxHeight}")" Arrow="false" />

@* ---- right column ---- *@
@foreach (var (label, node, row) in rightBoxes)
{
    <div class="abs svc-box right-side @EcamPresentation.StateClass(node.State)" style="left:@(RightBoxLeft)px;top:@(RowTop(row))px">
        <div class="svc-title">@label</div>
        <div class="svc-val">@node.Value</div>
        <div class="svc-detail">@(node.Detail ?? "")</div>
    </div>
}

@* CATERING → door 1R (top) or door 4R (bottom, with an elbow up to the door row). *@
@if (cateringAft)
{
    <EcamLink State="@catering.State" Left="@DoorRightX" Top="@(Door4RY - 6)" Width="@(toRightEdge + 2)" Height="@(RowMid(3) - Door4RY + 12)"
              Points="@($"{toRightEdge},{RowMid(3) - Door4RY + 6} 40,{RowMid(3) - Door4RY + 6} 40,6 0,6")" Arrow="false" />
    <div class="abs link-dot @EcamPresentation.StateClass(catering.State)" style="left:@(DoorRightX - 4)px;top:@(Door4RY - 4)px"></div>
}
else
{
    <EcamLink State="@catering.State" Left="@DoorRightX" Top="@(Door1RY - 6)" Length="@toRightEdge" Arrow="false" />
    <div class="abs link-dot @EcamPresentation.StateClass(catering.State)" style="left:@(DoorRightX - 4)px;top:@(Door1RY - 4)px"></div>
}

@* REFUEL → the centre of the right wing just behind the engine (owner, 2026-10-27): a short
   drop beside the box, then one straight run at wing height that ends on the wing with a dot,
   so the eye reads the dot, not a bend, as the point. *@
<EcamLink State="@refuel.State" Left="@WingRightX" Top="@(RowMid(1) - 6)" Width="@(RightBoxLeft - WingRightX + 2)" Height="@(WingY - RowMid(1) + 12)"
          Points="@($"{RightBoxLeft - WingRightX},6 {RightBoxLeft - WingRightX - 14},6 {RightBoxLeft - WingRightX - 14},{WingY - RowMid(1) + 6} 0,{WingY - RowMid(1) + 6}")" Arrow="false" />
<div class="abs link-dot @EcamPresentation.StateClass(refuel.State)" style="left:@(WingRightX - 4)px;top:@(WingY - 4)px"></div>

<div class="abs hline" style="left:14px;top:420px;width:692px"></div>
@{
    var bars = new[] { ("PAX", pax, 24), ("CARGO", cargo, 256), ("FUEL", fuel, 488) };
}
@foreach (var (label, gauge, x) in bars)
{
    <div class="abs lbl" style="left:@(x)px;top:432px">@label</div>
    if (gauge?.Value is { } value && gauge.Max > 0)
    {
        var pct = Math.Clamp(value / gauge.Max * 100, 0, 100);
        <div class="abs bar-track st-normal" style="left:@(x)px;top:452px;width:200px"><div class="bar-fill" style="width:@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
        <div class="abs" style="left:@(x)px;top:472px"><span class="c-green">@FormatBar(value, gauge)</span> <span class="unit">@(gauge.Unit == EcamTokens.Units.Percent ? "" : gauge.Unit)@(gauge.Unit == EcamTokens.Units.Percent ? "" : " ")@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%</span></div>
    }
    else
    {
        <div class="abs bar-track st-na" style="left:@(x)px;top:452px;width:200px"></div>
        <div class="abs c-amber" style="left:@(x)px;top:472px">@EcamTokens.NoData</div>
    }
}

@if (pg.CautionLine is { } line)
{
    <div class="abs ecam-caution-line" style="top:506px">@line</div>
}

<EcamMemoStrip Cells="@(new[]
{
    new EcamMemoCell("GSX", gsxMemo ?? EcamTokens.NoData, pg.Readout("memo_gsx_detail"), gsxMemo is null or "RECONN" or "NO COUATL" ? "c-amber" : null),
    new EcamMemoCell("SMART BTN", pg.Readout("memo_smartbtn") ?? EcamTokens.NotApplicable),
    new EcamMemoCell("TURNAROUND", turnaround is null ? EcamTokens.NotApplicable : turnaround.Split(" H ")[0], turnaround is null ? null : "H " + turnaround.Split(" H ")[1]),
    new EcamMemoCell("PHASE", EcamPresentation.Or(memo.Phase, EcamTokens.NoData)),
})" />

@code {
    [Parameter, EditorRequired] public DiagnosticsSnapshot Snap { get; set; } = DiagnosticsSnapshot.Empty;

    // The traced drawing fitted between the service boxes: 294 px wide (its wingspan), which
    // the 1593:1713 aspect makes 316 px tall, centred on the stage's x = 360.
    private const int HullLeft = 213;
    private const int HullTop = 70;
    private const int HullWidth = 294;
    private const int HullHeight = 316;
    private const double HullScale = HullWidth / (double)A320TopView.ViewBoxWidth;

    // Service-box columns: 160 px boxes, rows of 84 px from y = 56 (a 24 px gap carries the
    // vertical ties between stacked boxes).
    private const int BoxLeft = 14;
    private const int BoxRight = BoxLeft + 160;
    private const int RightBoxLeft = 546;
    private const int RowPitch = 84;
    private const int RowHeight = 60;
    private const int FirstRowTop = 56;
    private const int ColumnMidX = BoxLeft + 80;

    // The two boxes above the nose.
    private const int TopBoxTop = 8;
    private const int TopBoxWidth = 112;
    private const int TopBoxHeight = 50;
    private const int PushBoxLeft = 236;
    private const int GpuBoxLeft = 384;

    private static int RowTop(int row) => FirstRowTop + row * RowPitch;
    private static int RowMid(int row) => RowTop(row) + RowHeight / 2;

    // Fuselage sides in stage px, from the drawing's own edges (door markers hug them).
    private static readonly int FuselageLeftX = HullLeft + (int)Math.Round(A320TopView.FuselageLeft * HullScale);
    private static readonly int FuselageRightX = HullLeft + (int)Math.Round(A320TopView.FuselageRight * HullScale);

    private static int HullY(int drawingY) => HullTop + (int)Math.Round(drawingY * HullScale);
    private static int HullX(int drawingX) => HullLeft + (int)Math.Round(drawingX * HullScale);

    // Where the connectors land: the anchor table (A320Anchors, drawing units) scaled into the
    // hull box, so every line follows the drawing at any window size.
    private static readonly int Door1LY = HullY(A320Anchors.Door1L.Y);
    private static readonly int Door1RY = HullY(A320Anchors.Door1R.Y);
    private static readonly int Door4LY = HullY(A320Anchors.Door4L.Y);
    private static readonly int Door4RY = HullY(A320Anchors.Door4R.Y);
    private static readonly int DoorLeftX = HullX(A320Anchors.Door1L.X);
    private static readonly int DoorRightX = HullX(A320Anchors.Door1R.X);
    private static readonly int NoseX = HullX(A320Anchors.NoseTip.X);
    private static readonly int GpuY = HullY(A320Anchors.GpuReceptacle.Y);
    private static readonly int WingRightX = HullX(A320Anchors.RefuelPanel.X);
    private static readonly int WingY = HullY(A320Anchors.RefuelPanel.Y);

    // Marker positions on the hull (stage px): (readout id, label, x, y, label on the left?).
    // The y values are the drawing's door positions in its own units.
    private static readonly (string Id, string Label, int X, int Y, bool LabelLeft)[] Doors =
    [
        // The four doors the drawing has: markers sit exactly on its rectangles. The rest sit
        // on the fuselage line (left markers hang outside it, right ones inside).
        ("door_1l", "1L", HullX(A320Anchors.Door1LRect.X), HullY(A320Anchors.Door1LRect.Y), true),
        ("door_1r", "1R", HullX(A320Anchors.Door1RRect.X), HullY(A320Anchors.Door1RRect.Y), false),
        ("door_2l", "2L", HullX(A320Anchors.Door2L.X) - 7, HullY(A320Anchors.Door2L.Y), true),
        ("door_2r", "2R", HullX(A320Anchors.Door2R.X), HullY(A320Anchors.Door2R.Y), false),
        ("door_3l", "3L", HullX(A320Anchors.Door3L.X) - 7, HullY(A320Anchors.Door3L.Y), true),
        ("door_3r", "3R", HullX(A320Anchors.Door3R.X), HullY(A320Anchors.Door3R.Y), false),
        ("door_4l", "4L", HullX(A320Anchors.Door4LRect.X), HullY(A320Anchors.Door4LRect.Y), true),
        ("door_4r", "4R", HullX(A320Anchors.Door4RRect.X), HullY(A320Anchors.Door4RRect.Y), false),
        ("door_fwd_cgo", "FWD CGO", HullX(A320Anchors.CargoForward.X), HullY(A320Anchors.CargoForward.Y), false),
        ("door_aft_cgo", "AFT CGO", HullX(A320Anchors.CargoAft.X), HullY(A320Anchors.CargoAft.Y), false),
        ("door_bulk", "BULK", HullX(A320Anchors.CargoBulk.X), HullY(A320Anchors.CargoBulk.Y), false),
    ];

    private static string FormatBar(double value, DiagGauge gauge)
    {
        var culture = System.Globalization.CultureInfo.InvariantCulture;
        if (gauge.Unit == EcamTokens.Units.Percent)
        {
            return value.ToString("0", culture);
        }

        var format = gauge.Unit == EcamTokens.Units.Tonnes ? "0.0" : "0";
        return $"{value.ToString(format, culture)} / {gauge.Max.ToString(format, culture)}";
    }
}
