@using ProsimCompanion.Core.Diagnostics.Ecam
@* GSX: DOOR/OXY grammar. The hull with its door markers, the service boxes either side with
   dashed connectors to where each service really meets the aircraft (owner layout 2026-10-27:
   BOARDING over JETWAY and tied to it and to STAIRS; GPU and PUSHBACK on one trunk to the
   nose; CATERING beside the service door the GSX profile uses, 1R at the top or 4R at the
   bottom; REFUEL to the right wing), the three progress bars, the GSX memo. *@
@{
    var pg = Snap.Gsx;
    var memo = Snap.Memo;
    var (upH, upM) = EcamPresentation.UptimeParts(memo.Uptime);
    var pax = pg.Gauges.GetValueOrDefault("pax");
    var cargo = pg.Gauges.GetValueOrDefault("cargo");
    var fuel = pg.Gauges.GetValueOrDefault("fuel");
    var turnaround = pg.Readout("memo_turnaround");
    var gsxMemo = pg.Readout("memo_gsx");

    var boarding = pg.NodeOrNoData("boarding");
    var jetway = pg.NodeOrNoData("jetway");
    var gpu = pg.NodeOrNoData("gpu");
    var stairs = pg.NodeOrNoData("stairs");
    var pushback = pg.NodeOrNoData("pushback");
    var catering = pg.NodeOrNoData("catering");
    var refuel = pg.NodeOrNoData("refuel");
    var deice = pg.NodeOrNoData("deice");
    var cateringAft = pg.Readout("catering_door") == "4R";

    // Column rows: five on the left (BOARDING, JETWAY, GPU, STAIRS, PUSHBACK), the right
    // column uses the same rows (CATERING at row 0 or 4, REFUEL row 1, DEICE row 2).
    var leftBoxes = new[] { ("BOARDING", boarding), ("JETWAY", jetway), ("GPU", gpu), ("STAIRS", stairs), ("PUSHBACK", pushback) };
    var rightBoxes = new (string Label, DiagNode Node, int Row)[]
    {
        ("CATERING", catering, cateringAft ? 4 : 0),
        ("REFUEL", refuel, 1),
        ("DEICE", deice, 2),
    };
    var toLeftEdge = FuselageLeftX - BoxRight;
    var toRightEdge = RightBoxLeft - FuselageRightX;
    var trunkState = DiagStates.Worse(gpu.State, pushback.State);
}
<div class="abs ecam-title" style="left:40px;top:14px">GSX</div>

@* The A320 from above: the owner's own three-view drawing, traced (A320TopView, 2026-10-27).
   The drawing's fuselage edges give the door-marker columns and where the connectors end. *@
<svg class="abs hull" style="left:@(HullLeft)px;top:@(HullTop)px" width="@HullWidth" height="@HullHeight"
     viewBox="0 0 @A320TopView.ViewBoxWidth @A320TopView.ViewBoxHeight" aria-hidden="true">
    <path class="hull-path" d="@A320TopView.Path" />
</svg>

@foreach (var (id, label, x, y, labelLeft) in Doors)
{
    var state = pg.Readout(id);
    if (state is null)
    {
        continue;
    }

    var open = state == "OPEN";
    <div class="abs door @(open ? "open st-caution" : "st-normal")" style="left:@(x)px;top:@(y)px"></div>
    if (open)
    {
        <div class="abs detail c-amber" style="left:@(labelLeft ? x - 38 : x + 13)px;top:@(y + 2)px;width:36px;@(labelLeft ? "text-align:right" : "")">@label</div>
    }
}

@* ---- left column ---- *@
@for (var i = 0; i < leftBoxes.Length; i++)
{
    var (label, node) = leftBoxes[i];
    <div class="abs svc-box @EcamPresentation.StateClass(node.State)" style="left:@(BoxLeft)px;top:@(RowTop(i))px">
        <div class="svc-title">@label</div>
        <div class="svc-val">@node.Value</div>
        <div class="svc-detail">@(node.Detail ?? "")</div>
    </div>
}

@* BOARDING ties to JETWAY (always) and down to STAIRS (when stairs are in use) along a trunk
   outside the column, with a stub into each box. *@
<EcamLink State="@DiagStates.Worse(boarding.State, jetway.State)" Left="@(OuterTrunkX - 6)" Top="@(RowMid(0) - 6)" Length="@(BoxLeft - OuterTrunkX + 6)" Arrow="false" />
<EcamLink State="@DiagStates.Worse(boarding.State, jetway.State)" Left="@(OuterTrunkX - 6)" Top="@RowMid(0)" Length="@(RowMid(1) - RowMid(0))" Vertical="true" Arrow="false" />
<EcamLink State="@DiagStates.Worse(boarding.State, jetway.State)" Left="@(OuterTrunkX - 6)" Top="@(RowMid(1) - 6)" Length="@(BoxLeft - OuterTrunkX + 6)" Arrow="false" />
@if (stairs.State != DiagState.NotApplicable)
{
    <EcamLink State="@DiagStates.Worse(boarding.State, stairs.State)" Left="@(OuterTrunkX - 6)" Top="@RowMid(1)" Length="@(RowMid(3) - RowMid(1))" Vertical="true" Arrow="false" />
    <EcamLink State="@DiagStates.Worse(boarding.State, stairs.State)" Left="@(OuterTrunkX - 6)" Top="@(RowMid(3) - 6)" Length="@(BoxLeft - OuterTrunkX + 6)" Arrow="false" />
}

@* JETWAY → door 1L (elbow up to the door row). *@
<EcamLink State="@jetway.State" Left="@BoxRight" Top="@(Door1LY - 6)" Width="@(toLeftEdge + 2)" Height="@(RowMid(1) - Door1LY + 12)"
          Points="@($"0,{RowMid(1) - Door1LY + 6} 26,{RowMid(1) - Door1LY + 6} 26,6 {toLeftEdge},6")" Arrow="false" />

@* STAIRS → the hull at its own row. *@
<EcamLink State="@stairs.State" Left="@BoxRight" Top="@(RowMid(3) - 6)" Length="@toLeftEdge" Arrow="false" />

@* GPU and PUSHBACK share one trunk that ends at the nose. *@
<EcamLink State="@gpu.State" Left="@BoxRight" Top="@(RowMid(2) - 6)" Length="@(InnerTrunkX - BoxRight)" Arrow="false" />
<EcamLink State="@pushback.State" Left="@BoxRight" Top="@(RowMid(4) - 6)" Length="@(InnerTrunkX - BoxRight)" Arrow="false" />
<EcamLink State="@trunkState" Left="@(InnerTrunkX - 6)" Top="@NoseY" Length="@(RowMid(4) - NoseY)" Vertical="true" Arrow="false" />
<EcamLink State="@trunkState" Left="@(InnerTrunkX - 6)" Top="@(NoseY - 6)" Length="@(FuselageLeftX - InnerTrunkX + 6)" Arrow="false" />

@* ---- right column ---- *@
@foreach (var (label, node, row) in rightBoxes)
{
    <div class="abs svc-box right-side @EcamPresentation.StateClass(node.State)" style="left:@(RightBoxLeft)px;top:@(RowTop(row))px">
        <div class="svc-title">@label</div>
        <div class="svc-val">@node.Value</div>
        <div class="svc-detail">@(node.Detail ?? "")</div>
    </div>
}

@* CATERING → door 1R (top) or door 4R (bottom, with an elbow up to the door row). *@
@if (cateringAft)
{
    <EcamLink State="@catering.State" Left="@FuselageRightX" Top="@(Door4RY - 6)" Width="@(toRightEdge + 2)" Height="@(RowMid(4) - Door4RY + 12)"
              Points="@($"{toRightEdge},{RowMid(4) - Door4RY + 6} 40,{RowMid(4) - Door4RY + 6} 40,6 0,6")" Arrow="false" />
}
else
{
    <EcamLink State="@catering.State" Left="@FuselageRightX" Top="@(Door1RY - 6)" Length="@toRightEdge" Arrow="false" />
}

@* REFUEL → the right wing (the refuel panel sits under it). *@
<EcamLink State="@refuel.State" Left="@WingRightX" Top="@(RowMid(1) - 6)" Width="@(RightBoxLeft - WingRightX + 2)" Height="@(WingY - RowMid(1) + 12)"
          Points="@($"{RightBoxLeft - WingRightX},6 60,6 60,{WingY - RowMid(1) + 6} 0,{WingY - RowMid(1) + 6}")" Arrow="false" />

<div class="abs hline" style="left:14px;top:420px;width:692px"></div>
@{
    var bars = new[] { ("PAX", pax, 24), ("CARGO", cargo, 256), ("FUEL", fuel, 488) };
}
@foreach (var (label, gauge, x) in bars)
{
    <div class="abs lbl" style="left:@(x)px;top:432px">@label</div>
    if (gauge?.Value is { } value && gauge.Max > 0)
    {
        var pct = Math.Clamp(value / gauge.Max * 100, 0, 100);
        <div class="abs bar-track st-normal" style="left:@(x)px;top:452px;width:200px"><div class="bar-fill" style="width:@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
        <div class="abs" style="left:@(x)px;top:472px"><span class="c-green">@FormatBar(value, gauge)</span> <span class="unit">@(gauge.Unit == EcamTokens.Units.Percent ? "" : gauge.Unit)@(gauge.Unit == EcamTokens.Units.Percent ? "" : " ")@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%</span></div>
    }
    else
    {
        <div class="abs bar-track st-na" style="left:@(x)px;top:452px;width:200px"></div>
        <div class="abs c-amber" style="left:@(x)px;top:472px">@EcamTokens.NoData</div>
    }
}

@if (pg.CautionLine is { } line)
{
    <div class="abs ecam-caution-line" style="top:506px">@line</div>
}

<EcamMemoStrip Cells="@(new[]
{
    new EcamMemoCell("GSX", gsxMemo ?? EcamTokens.NoData, pg.Readout("memo_gsx_detail"), gsxMemo is null or "RECONN" or "NO COUATL" ? "c-amber" : null),
    new EcamMemoCell("SMART BTN", pg.Readout("memo_smartbtn") ?? EcamTokens.NotApplicable),
    new EcamMemoCell("TURNAROUND", turnaround is null ? EcamTokens.NotApplicable : turnaround.Split(" H ")[0], turnaround is null ? null : "H " + turnaround.Split(" H ")[1]),
    new EcamMemoCell("PHASE", EcamPresentation.Or(memo.Phase, EcamTokens.NoData)),
})" />

@code {
    [Parameter, EditorRequired] public DiagnosticsSnapshot Snap { get; set; } = DiagnosticsSnapshot.Empty;

    // The traced drawing fitted between the service boxes: 294 px wide (its wingspan), which
    // the 1593:1713 aspect makes 316 px tall, centred on the stage's x = 360.
    private const int HullLeft = 213;
    private const int HullTop = 56;
    private const int HullWidth = 294;
    private const int HullHeight = 316;
    private const double HullScale = HullWidth / (double)A320TopView.ViewBoxWidth;

    // Service-box columns: 160 px boxes, five rows of 68 px from y = 56.
    private const int BoxLeft = 14;
    private const int BoxRight = BoxLeft + 160;
    private const int RightBoxLeft = 546;
    private const int RowPitch = 68;
    private const int RowHeight = 60;
    private const int FirstRowTop = 56;

    // The BOARDING tie runs outside the left column; the GPU/PUSHBACK trunk between it and the hull.
    private const int OuterTrunkX = 7;
    private const int InnerTrunkX = 236;

    private static int RowTop(int row) => FirstRowTop + row * RowPitch;
    private static int RowMid(int row) => RowTop(row) + RowHeight / 2;

    // Fuselage sides in stage px, from the drawing's own edges (door markers hug them).
    private static readonly int FuselageLeftX = HullLeft + (int)Math.Round(A320TopView.FuselageLeft * HullScale);
    private static readonly int FuselageRightX = HullLeft + (int)Math.Round(A320TopView.FuselageRight * HullScale);

    private static int HullY(int drawingY) => HullTop + (int)Math.Round(drawingY * HullScale);
    private static int HullX(int drawingX) => HullLeft + (int)Math.Round(drawingX * HullScale);

    // Where the connectors land: door rows, the nose, the right wing's refuel panel.
    private static readonly int Door1LY = HullY(215);
    private static readonly int Door1RY = HullY(215);
    private static readonly int Door4RY = HullY(1310);
    private static readonly int NoseY = HullY(330);
    private static readonly int WingRightX = HullX(1180);
    private static readonly int WingY = HullY(820);

    // Marker positions on the hull (stage px): (readout id, label, x, y, label on the left?).
    // The y values are the drawing's door positions in its own units.
    private static readonly (string Id, string Label, int X, int Y, bool LabelLeft)[] Doors =
    [
        ("door_1l", "1L", FuselageLeftX - 8, HullY(215), true),
        ("door_1r", "1R", FuselageRightX, HullY(215), false),
        ("door_2l", "2L", FuselageLeftX - 8, HullY(820), true),
        ("door_2r", "2R", FuselageRightX, HullY(820), false),
        ("door_3l", "3L", FuselageLeftX - 8, HullY(900), true),
        ("door_3r", "3R", FuselageRightX, HullY(900), false),
        ("door_4l", "4L", FuselageLeftX - 8, HullY(1310), true),
        ("door_4r", "4R", FuselageRightX, HullY(1310), false),
        ("door_fwd_cgo", "FWD CGO", FuselageRightX, HullY(470), false),
        ("door_aft_cgo", "AFT CGO", FuselageRightX, HullY(1180), false),
        ("door_bulk", "BULK", FuselageRightX, HullY(1400), false),
    ];

    private static string FormatBar(double value, DiagGauge gauge)
    {
        var culture = System.Globalization.CultureInfo.InvariantCulture;
        if (gauge.Unit == EcamTokens.Units.Percent)
        {
            return value.ToString("0", culture);
        }

        var format = gauge.Unit == EcamTokens.Units.Tonnes ? "0.0" : "0";
        return $"{value.ToString(format, culture)} / {gauge.Max.ToString(format, culture)}";
    }
}
