@* Root document for the Blazor web UI. Styling is inline for now (no static-asset pipeline
   needed from a WinExe host); a proper stylesheet/theming pass is roadmapped with the web shell. *@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ProsimCompanion</title>
    <base href="/" />
    <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: Canvas;
            color: CanvasText;
        }
        .shell { display: flex; min-height: 100vh; }
        .sidebar {
            width: 220px;
            flex-shrink: 0;
            padding: 1rem;
            border-right: 1px solid color-mix(in srgb, CanvasText 15%, transparent);
        }
        .sidebar .brand { font-size: 1.15rem; font-weight: 600; margin-bottom: 1rem; }
        .sidebar a {
            display: block;
            padding: 0.45rem 0.6rem;
            border-radius: 6px;
            color: inherit;
            text-decoration: none;
        }
        .sidebar a:hover { background: color-mix(in srgb, CanvasText 8%, transparent); }
        .sidebar a.active { background: color-mix(in srgb, CanvasText 14%, transparent); font-weight: 600; }
        main { flex: 1; padding: 1.5rem 2rem; max-width: 900px; }
        table { border-collapse: collapse; }
        th, td { text-align: left; padding: 0.4rem 1rem 0.4rem 0; }
        .badge { padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.85rem; }
        .badge.connected { background: #1a7f37; color: #fff; }
        .badge.connecting { background: #9a6700; color: #fff; }
        .badge.disconnected { background: #cf222e; color: #fff; }
        .badge.disabled { background: color-mix(in srgb, CanvasText 25%, transparent); }
        label { display: block; margin-top: 0.9rem; font-weight: 600; }
        input {
            margin-top: 0.25rem;
            padding: 0.4rem 0.5rem;
            width: 100%;
            max-width: 420px;
            border: 1px solid color-mix(in srgb, CanvasText 30%, transparent);
            border-radius: 6px;
            background: Field;
            color: FieldText;
        }
        button {
            margin-top: 1.2rem;
            padding: 0.5rem 1.2rem;
            border: none;
            border-radius: 6px;
            background: #0969da;
            color: #fff;
            cursor: pointer;
        }
        button:hover { filter: brightness(1.1); }
        .hint { opacity: 0.75; font-size: 0.9rem; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
