@* Root document for the Blazor web UI. Styling lives in wwwroot/css/app.css (served as a
   plain static file — a WinExe host has no static-web-assets pipeline); runtime theme
   overrides are injected into the head by the ThemeStyle component via HeadOutlet. *@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1a2035" />
    <title>ProsimCompanion</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="css/app.css" />
    @* Per-page stylesheets for the Prosim2GSX-parity page rebuilds (kept out of app.css so
       page work stays independently editable; the host serves plain static files). *@
    <link rel="stylesheet" href="css/pages/init.css" />
    <link rel="stylesheet" href="css/pages/perf.css" />
    <link rel="stylesheet" href="css/pages/checklists.css" />
    <link rel="stylesheet" href="css/pages/loadsheet.css" />
    <link rel="stylesheet" href="css/pages/fuel.css" />
    <link rel="stylesheet" href="css/pages/ofp.css" />
    <link rel="stylesheet" href="css/pages/flightstatus.css" />
    <link rel="stylesheet" href="css/pages/wnb.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    @* Custom circuit-reconnect overlay: blazor.web.js adopts this element (by id) instead of
       its default dialog and toggles the components-reconnect-* classes on it. app.js watches
       those classes and recovers automatically (retry / reload) — the links are a fallback. *@
    <div id="components-reconnect-modal" class="components-reconnect-hide">
        <div>
            <div class="reconnect-showing">Connection to ProsimCompanion lost — reconnecting…</div>
            <div class="reconnect-failed">Server unreachable — retrying automatically… <a href="">Reload now</a></div>
            <div class="reconnect-rejected">Session expired — reloading…</div>
        </div>
    </div>

    <script src="js/app.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
