@* Root document for the Blazor web UI. Styling lives in wwwroot/css/app.css (served as a
   plain static file — a WinExe host has no static-web-assets pipeline); runtime theme
   overrides are injected into the head by the ThemeStyle component via HeadOutlet. *@
@using System.Reflection
@using Microsoft.AspNetCore.Http
@using ProsimCompanion.Core.Hosting
@using ProsimCompanion.Core.Localization
@using ProsimCompanion.Web.Localization
@inject LanguagePackCatalog Languages
@inject UiLanguageStore UiLanguage
<!DOCTYPE html>
<html lang="@Language">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1a2035" />
    <title>ProsimCompanion</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    @* Installable web app (issue #150, ADR-0013): manifest + Apple home-screen tags. No service
       worker on purpose — Blazor Server needs its live circuit, so there is no offline mode. *@
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    @* "black" (opaque), NOT "black-translucent": with the see-through bar iPadOS gives the
       home-screen app a web view one status-bar short (owner's iPad, 2026-10-03: screen 820,
       window 788, safe-top 32) and places it at the top — a black band the height of the
       status bar under the footer that no CSS can reach. Opaque: iOS paints the bar, the view
       starts below it at the right height. iOS freezes this at "Add to Home Screen" time, so
       an upgrade needs the icon deleted and added again (manual chapter 7). *@
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Companion" />
    <meta name="application-name" content="ProsimCompanion" />
    <link rel="stylesheet" href="css/app.css?v=@AssetVersion" />
    @* Per-page stylesheets for the Prosim2GSX-parity page rebuilds (kept out of app.css so
       page work stays independently editable; the host serves plain static files). *@
    <link rel="stylesheet" href="css/pages/init.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/perf.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/checklists.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/loadsheet.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/fuel.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/fuellog.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/ofp.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/flightstatus.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/wnb.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/ops.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/monitor.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/pages/diagnostics.css?v=@AssetVersion" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes IsLocalClient="IsLocalClient" BrowserLanguages="BrowserLanguages" @rendermode="InteractiveServer" />

    @* Custom circuit-reconnect overlay: blazor.web.js adopts this element (by id) instead of
       its default dialog and toggles the components-reconnect-* classes on it. app.js watches
       those classes and recovers automatically (retry / reload) — the links are a fallback.
       Static markup (no circuit), so the texts resolve here from the request's language. *@
    <div id="components-reconnect-modal" class="components-reconnect-hide">
        <div>
            <div class="reconnect-showing">@Text("app.reconnect.showing")</div>
            <div class="reconnect-failed">@Text("app.reconnect.failed") <a href="">@Text("app.reconnect.reloadNow")</a></div>
            <div class="reconnect-rejected">@Text("app.reconnect.rejected")</div>
        </div>
    </div>

    <script src="js/app.js?v=@AssetVersion"></script>
    <script src="js/ecam.js?v=@AssetVersion"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    /// <summary>The first HTTP request, available only in this static root. Whether it came
    /// from this PC decides if the path fields may offer the sim PC's own Browse… dialog.</summary>
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private bool IsLocalClient
        => LocalClient.IsLocal(HttpContext?.Connection.RemoteIpAddress, LocalClient.HostAddresses());

    // The browser's own language list (ADR-0014), read once from the first request and handed
    // to the circuit through Routes; the "follow the browser" default resolves against it.
    private string[] BrowserLanguages
        => [.. AcceptLanguage.Parse(HttpContext?.Request.Headers.AcceptLanguage.ToString())];

    private string? _language;

    /// <summary>The language this document renders in: the configured one, else the browser's.</summary>
    private string Language => _language ??= Languages.Resolve(UiLanguage.Configured, BrowserLanguages);

    private string Text(string textId) => Languages.Lookup(Language, textId, out _);

    // Cache-buster for our own static assets (2026-09-20: after the beta.4 update the sim
    // PC's browser kept the previous app.css and drew the header logo at its intrinsic
    // size). The version changes on every release, so a new build always gets fresh CSS/JS;
    // blazor.web.js and the framework files ship their own fingerprinting.
    private static readonly string AssetVersion = Uri.EscapeDataString(
        (typeof(App).Assembly.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?
            .InformationalVersion ?? "0").Split('+')[0]);
}
