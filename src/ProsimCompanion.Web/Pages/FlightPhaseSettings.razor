@page "/settings/flight-phase"
@layout SettingsLayout
@using ProsimCompanion.Core.Flight
@inherits SettingsPageBase
@inject IOptionsMonitor<FlightStateOptions> Monitor
@inject IStringLocalizer T

<PageTitle>@T["flightPhase.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["flightPhase.heading"]</h1>

@* Every threshold is one <OptionField Draft For /> line (C3, 2026-10-19): the unit, the floor
   and the texts are declared on the FlightStateOptions property beside its proven default. *@
<div class="panel" style="padding-bottom:96px;">

    <Section Title="@T["flightPhase.speeds.title"]" Hint="@T["flightPhase.speeds.hint"]">
        <OptionField Draft="_o" For="o => o.TaxiSpeedMaxKt" />
        <OptionField Draft="_o" For="o => o.RolloutCompleteKt" />
        <OptionField Draft="_o" For="o => o.PushbackMaxGroundSpeedKt" />
        <OptionField Draft="_o" For="o => o.ParkedGroundSpeedKt" />
    </Section>

    <Section Title="@T["flightPhase.vertical.title"]">
        <OptionField Draft="_o" For="o => o.InitialClimbCeilingRaFt" />
        <OptionField Draft="_o" For="o => o.ClimbDescentVsFpm" />
        <OptionField Draft="_o" For="o => o.ApproachRaCeilingFt" />
        <OptionField Draft="_o" For="o => o.GoAroundVsFpm" />
        <OptionField Draft="_o" For="o => o.DescentEntryVsFpm" />
        <OptionField Draft="_o" For="o => o.DescentExitVsFpm" />
    </Section>

    <Section Title="@T["flightPhase.cruise.title"]" Hint="@T["flightPhase.cruise.hint"]">
        <OptionField Draft="_o" For="o => o.CruiseLevelToleranceFt" />
        <OptionField Draft="_o" For="o => o.CruiseFloorNoFmsFt" />
    </Section>

    <Section Title="@T["flightPhase.ground.title"]">
        <OptionField Draft="_o" For="o => o.GroundContactAgreeSamples" />
        <OptionField Draft="_o" For="o => o.TurnaroundHoldSeconds" />
        <OptionField Draft="_o" For="o => o.HeartbeatSeconds" />
    </Section>

    <Section Title="@T["flightPhase.pause.title"]" Hint="@T["flightPhase.pause.hint"]">
        <OptionField Draft="_o" For="o => o.PauseGraceSeconds" />
        <OptionField Draft="_o" For="o => o.PauseSamePositionMetres" />
        <OptionField Draft="_o" For="o => o.PauseSameFuelKg" />
    </Section>

    <Section Title="@T["flightPhase.settle.title"]" Hint="@T["flightPhase.settle.hint"]">
        <OptionField Draft="_o" For="o => o.DefaultDebounceSeconds" />
        <OptionField Draft="_o" For="o => o.CruiseSettleSeconds" />
        <OptionField Draft="_o" For="o => o.DescentToCruiseSettleSeconds" />
        <OptionField Draft="_o" For="o => o.CruiseToClimbSettleSeconds" />
        <OptionField Draft="_o" For="o => o.DescentToClimbSettleSeconds" />
        <OptionField Draft="_o" For="o => o.GoAroundSettleSeconds" />
        <OptionField Draft="_o" For="o => o.DepartureRegressionSeconds" />
        <OptionField Draft="_o" For="o => o.FirstAirborneClassificationSeconds" />
    </Section>

    <Section Title="@T["flightPhase.recorder.title"]" Hint="@T["flightPhase.recorder.hint"]">
        <OptionField Draft="_o" For="o => o.RecordSamples" />
        <OptionField Draft="_o" For="o => o.SampleIntervalSeconds" />
        <OptionField Draft="_o" For="o => o.SampleKeepAliveSeconds" />
    </Section>

    <Section Title="@T["flightPhase.rules.title"]" Hint="@T["flightPhase.rules.hint"]">
        <div style="overflow-x:auto;">
            <table class="rule-table" style="width:100%; border-collapse:collapse; font-size:12px;">
                <thead>
                    <tr>
                        <th style="text-align:left; padding:4px 6px;">@T["flightPhase.rules.set"]</th>
                        <th style="text-align:left; padding:4px 6px;">@T["flightPhase.rules.rule"]</th>
                        <th style="text-align:left; padding:4px 6px;">@T["flightPhase.rules.from"]</th>
                        <th style="text-align:left; padding:4px 6px;">@T["flightPhase.rules.to"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (set, rule) in Rules)
                    {
                        <tr style="border-top:1px solid var(--border);">
                            <td style="padding:3px 6px; white-space:nowrap;">@set</td>
                            <td style="padding:3px 6px; white-space:nowrap;"><code>@rule.Id</code></td>
                            <td style="padding:3px 6px;">@FromText(rule)</td>
                            <td style="padding:3px 6px; white-space:nowrap;">@(rule.To?.ToString() ?? T["flightPhase.rules.hold"].Value)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Section>

</div>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private OptionsDraft<FlightStateOptions> _o = default!;

    // The phase names in the From/To columns are the FlightPhase enum members, as the log and
    // the probes name them — only the set labels and the "any"/"hold" words are pack text.
    private IEnumerable<(string Set, PhaseRule Rule)> Rules =>
        FlightPhaseRules.Ground.Select(r => (T["flightPhase.rules.ground"].Value, r))
            .Concat(FlightPhaseRules.Airborne.Select(r => (T["flightPhase.rules.airborne"].Value, r)));

    private string FromText(PhaseRule rule)
        => rule.From is null ? T["flightPhase.rules.any"].Value : string.Join(", ", rule.From.OrderBy(p => (int)p));

    protected override void OnInitialized()
    {
        _o = Draft(Monitor);
    }
}
