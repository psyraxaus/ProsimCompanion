@page "/settings"
@layout SettingsLayout
@using ProsimCompanion.Core.Profiles
@inherits SettingsPageBase
@inject IOptionsMonitor<GsxOptions> GsxMonitor
@inject IOptionsMonitor<SpeechOptions> SpeechMonitor
@inject IOptionsMonitor<AudioOptions> AudioMonitor
@inject IOptionsMonitor<ProsimOptions> ProsimMonitor
@inject IOptionsMonitor<WebUiOptions> WebUiMonitor
@inject IOptionsMonitor<BriefingOptions> BriefingMonitor
@inject IOptionsMonitor<CommandApiOptions> CommandApiMonitor
@inject IOptionsMonitor<WeatherOptions> WeatherMonitor
@inject IOptionsMonitor<UpdateCheckOptions> UpdateCheckMonitor
@inject IOptionsMonitor<WakeTargetsOptions> WakeMonitor
@inject IWakeOnLanControl WakeControl
@inject ProfileGsxMirror ProfileMirror
@inject WebListenerStatus ListenerStatus
@inject ProsimSetupStore SetupStore
@inject IProsimSetupCheck SetupCheck
@inject ConnectionStatusStore Status
@inject IStringLocalizer T
@using ProsimCompanion.Core.State
@using ProsimCompanion.Core.Aircraft.Setup

<PageTitle>@T["setup.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["setup.heading"]</h1>

@* The landing page of the settings hub (ADR-0010): the three pillar master switches and the
   connections every install needs. Everything here used to be spread over four tabs — the
   GSX switch sat at the bottom of "Connection & Timeouts". *@

<Section Title="@T["setup.features.title"]" Hint="@T["setup.features.hint"]">
    <BoolField Label="@T["setup.features.gsx.label"]" Hint="@T["setup.features.gsx.hint"]"
               @bind-Value="_gsx.Value.Enabled" />
    <BoolField Label="@T["setup.features.speech.label"]" Hint="@T["setup.features.speech.hint"]"
               @bind-Value="_speech.Value.Enabled" />
    <BoolField Label="@T["setup.features.audio.label"]" Hint="@T["setup.features.audio.hint"]"
               @bind-Value="_audio.Value.Enabled" />
</Section>

<Section Title="@T["setup.prosim.title"]">
    <TextField Label="@T["setup.prosim.host.label"]" Hint="@T["setup.prosim.host.hint"]" Kind="TextFieldKind.Host" Placeholder="@T["setup.prosim.host.placeholder"]"
               @bind-Value="_prosim.Value.Host" />
    <TextField Label="@T["setup.prosim.sdk.label"]" Hint="@T["setup.prosim.sdk.hint"]" Kind="TextFieldKind.FolderPath" BrowseStartIn="ExpectedFolders.ProSimSdk"
               @bind-Value="_prosim.Value.SdkPath" />
    <TextField Label="@T["setup.prosim.api.label"]" Hint="@T["setup.prosim.api.hint"]" Password="true"
               @bind-Value="ApiKeyInput" />
    <SecretUnreadableHint Path="prosim:apiKey" />
    <AdvancedFields>
        <NumberField Label="@T["setup.prosim.reconnect.label"]" Hint="@T["setup.prosim.reconnect.hint"]" Suffix="ms" Min="500"
                     @bind-Value="_prosim.Value.ReconnectIntervalMs"
                     Default="_prosim.Defaults.ReconnectIntervalMs" />
    </AdvancedFields>
</Section>

@* The ProSim setup check (owner request 2026-10-06). ProSim's IOS options are datarefs
   (system.config.*): the app reads the ones it depends on at every connection and shows which
   differ. It changes nothing on its own — "Apply recommended" is the only write, and every
   written value is read back. "Keep as is" per row silences that row for good. *@
<Section Title="@T["setup.setupCheck.title"]" Hint="@SetupCheckHint">
    <BoolField Label="@T["setup.setupCheck.enabled.label"]"
               Hint="@T["setup.setupCheck.enabled.hint"]"
               More="@T["setup.setupCheck.enabled.more"]"
               @bind-Value="_prosim.Value.SetupCheckEnabled" />
    @if (!_prosim.Value.SetupCheckEnabled)
    {
        <div class="field-hint">@T["setup.setupCheck.off"]</div>
    }
    else if (!_setup.HasReading)
    {
        <div class="field-hint">
            @(ProsimConnected ? T["setup.setupCheck.reading"].Value : T["setup.setupCheck.waitConnect"].Value)
        </div>
    }
    else
    {
        <div class="setup-rows">
            @foreach (var item in _setup.Items)
            {
                var kept = IsKept(item.DataRef);
                <div class="row row-with-detail setup-row @(kept ? "setup-row-kept" : "")" title="@item.Why">
                    <span class="row-label">@item.Label</span>
                    <label class="setup-keep" title="@T["setup.setupCheck.keepTitle"]">
                        <input type="checkbox" class="checkbox" checked="@kept"
                               @onchange="e => SetKept(item.DataRef, e.Value is true)" />
                        @T["setup.setupCheck.keep"]
                    </label>
                    <span class="pill @Tone(item)">@Verdict(item)</span>
                    <span class="row-detail">@Detail(item)</span>
                </div>
            }
        </div>
        <div class="row-actions setup-actions">
            @if (_setupNote is not null)
            {
                <span class="pill tone-neutral" title="@_setupNote">@_setupNote</span>
            }
            <button type="button" class="btn secondary" disabled="@(_setup.Busy || !ProsimConnected)"
                    @onclick="RefreshSetup" title="@T["setup.setupCheck.readAgainTitle"]">
                @(_setup.Busy ? T["setup.setupCheck.readingShort"].Value : T["setup.setupCheck.readAgain"].Value)
            </button>
            <button type="button" class="btn secondary" disabled="@(_setup.MismatchCount == 0)"
                    @onclick="() => _showHow = !_showHow" title="@T["setup.setupCheck.howTitle"]">
                @(_showHow ? T["setup.setupCheck.hideSteps"].Value : T["setup.setupCheck.showHow"].Value)
            </button>
            <button type="button" class="btn" disabled="@(_setup.Busy || _setup.MismatchCount == 0 || !ProsimConnected)"
                    @onclick="ApplySetup"
                    title="@T["setup.setupCheck.applyTitle"]">
                @(_setup.Busy ? T["setup.setupCheck.applying"].Value : _setup.MismatchCount > 0 ? T["setup.setupCheck.applyCount", _setup.MismatchCount].Value : T["setup.setupCheck.apply"].Value)
            </button>
        </div>
        @if (_showHow && _setup.MismatchCount > 0)
        {
            <ol class="setup-steps" style="margin-top:10px;">
                @foreach (var item in _setup.Items.Where(row => row.NeedsWrite))
                {
                    <li>
                        @T["setup.setupCheck.howStep.open"] <b>@item.IosPath</b> @T["setup.setupCheck.howStep.setTo"] <b>@Pretty(item.Recommended)</b>
                        @T["setup.setupCheck.howStep.now", Pretty(item.Actual)] @item.Why
                    </li>
                }
            </ol>
        }
    }
</Section>

<Section Title="@T["setup.navData.title"]" Hint="@T["setup.navData.hint"]">
    <TextField Label="@T["setup.navData.dfd.label"]" Hint="@T["setup.navData.dfd.hint"]" Kind="TextFieldKind.FileOrFolderPath" BrowseStartIn="ExpectedFolders.ProSimNavdata" BrowseFilter="Navigation database (*.s3db)|*.s3db|All files (*.*)|*.*"
               @bind-Value="_briefing.Value.DfdPath" />
</Section>

@* ActiveSky weather source (Phase 6) and the update check — settings.json only until the
   2026-10-08 audit. *@
<Section Title="@T["setup.weather.title"]" Hint="@T["setup.weather.hint"]">
    <TextField Label="@T["setup.weather.snapshot.label"]" Hint="@T["setup.weather.snapshot.hint"]" Kind="TextFieldKind.FilePath" BrowseStartIn="ExpectedFolders.ActiveSky" BrowseFilter="Snapshot (current_wx_snapshot.txt)|current_wx_snapshot.txt|Text files (*.txt)|*.txt" More="@T["setup.weather.snapshot.more"]"
               Placeholder="@T["setup.weather.snapshot.placeholder"]"
               @bind-Value="_weather.Value.ActiveSkySnapshotPath" />
    <BoolField Label="@T["setup.weather.useApi.label"]" Hint="@T["setup.weather.useApi.hint"]"
               @bind-Value="_weather.Value.UseActiveSkyApi" />
    <AdvancedFields>
        <TextField Label="@T["setup.weather.apiHost.label"]" Hint="@T["setup.weather.apiHost.hint"]" Placeholder="@T["setup.weather.apiHost.placeholder"]" Kind="TextFieldKind.Host" Disabled="@(!_weather.Value.UseActiveSkyApi)"
                   @bind-Value="_weather.Value.ActiveSkyApiHost" />
        <NumberField Label="@T["setup.weather.apiPort.label"]" Min="1" Max="65535" Disabled="@(!_weather.Value.UseActiveSkyApi)"
                     @bind-Value="_weather.Value.ActiveSkyApiPort"
                     Default="_weather.Defaults.ActiveSkyApiPort" />
        <NumberField Label="@T["setup.weather.apiTimeout.label"]" Hint="@T["setup.weather.apiTimeout.hint"]" Suffix="s" Min="1" Max="30"
                     Disabled="@(!_weather.Value.UseActiveSkyApi)"
                     @bind-Value="_weather.Value.ActiveSkyApiTimeoutSeconds"
                     Default="_weather.Defaults.ActiveSkyApiTimeoutSeconds" />
    </AdvancedFields>
</Section>

<Section Title="@T["setup.web.title"]" Hint="@T["setup.web.hint"]">
    <NumberField Label="@T["setup.web.port.label"]" Hint="@T["setup.web.port.hint"]" Min="1024" Max="65535"
                 @bind-Value="_webUi.Value.Port"
                 Default="_webUi.Defaults.Port" />
    <BoolField Label="@T["setup.web.lan.label"]" Hint="@T["setup.web.lan.hint"]" More="@T["setup.web.lan.more"]"
               @bind-Value="_webUi.Value.BindToAllInterfaces" />

    @* The optional HTTPS listener (issue #150, ADR-0013, design A). Here and not in the desktop
       window on purpose: a wrong value cannot lock anyone out, because HTTP keeps serving. *@
    <div class="label-caps" style="margin:14px 0 6px;">@T["setup.web.httpsHeading"]</div>
    <BoolField Label="@T["setup.web.https.label"]"
               Hint="@T["setup.web.https.hint"]"
               More="@T["setup.web.https.more"]"
               @bind-Value="_webUi.Value.Https.Enabled" />
    <NumberField Label="@T["setup.web.httpsPort.label"]" Hint="@T["setup.web.httpsPort.hint"]" Min="1024" Max="65535"
                 Disabled="@(!_webUi.Value.Https.Enabled)"
                 @bind-Value="_webUi.Value.Https.Port"
                 Default="_webUi.Defaults.Https.Port" />
    <TextField Label="@T["setup.web.pfx.label"]" Hint="@T["setup.web.pfx.hint"]" Kind="TextFieldKind.FilePath" BrowseStartIn="ExpectedFolders.AppStateFolder" BrowseFilter="Certificates (*.pfx;*.p12)|*.pfx;*.p12" Placeholder="@T["setup.web.pfx.placeholder"]"
               Disabled="@(!_webUi.Value.Https.Enabled)"
               @bind-Value="_webUi.Value.Https.PfxPath" />
    <TextField Label="@T["setup.web.pfxPassword.label"]" Hint="@T["setup.web.pfxPassword.hint"]" Password="true"
               Disabled="@(!_webUi.Value.Https.Enabled)"
               @bind-Value="_webUi.Value.Https.PfxPassword" />
    <SecretUnreadableHint Path="webUi:https:pfxPassword" />
    <div class="field" style="align-items:center;">
        <label class="field-label">
            @T["setup.web.status"]
            <FieldHint Hint="@HttpsStatusHint" />
        </label>
        <div class="field-control">
            <span class="pill @HttpsTone">@HttpsLabel</span>
        </div>
    </div>
    <div class="field-hint" style="max-width:640px;">
        @T["setup.web.tabletHintBefore"] <code>docs\manual\07-tablet-install.md</code> @T["setup.web.tabletHintAfter"]
    </div>
</Section>

<Section Title="@T["setup.streamDeck.title"]" Hint="@T["setup.streamDeck.hint"]">
    <BoolField Label="@T["setup.streamDeck.commandApi.label"]" Hint="@T["setup.streamDeck.commandApi.hint"]" More="@T["setup.streamDeck.commandApi.more"]"
               @bind-Value="_commandApi.Value.Enabled" />
    <div class="field-hint" style="max-width:560px;">
        @T["setup.streamDeck.pairHint"]
    </div>
</Section>

@* Wake-on-LAN (owner idea 2026-10-08): one list of PCs instead of one switch per feature.
   The old briefing.llmWakeOnLan block is migrated into the list on this page's first load
   (MigrateLegacyWake) and saved with the dirty bar. *@
@for (var i = 0; i < _wake.Value.Targets.Count; i++)
{
    var index = i;
    var target = _wake.Value.Targets[index];
    var title = string.IsNullOrWhiteSpace(target.Name) ? T["setup.wake.titleNumbered", index + 1].Value : T["setup.wake.titleNamed", target.Name].Value;
    <Section Title="@title" Hint="@T["setup.wake.hint"]">
        <div class="field" style="align-items:center;">
            <label class="field-label">@T["setup.wake.row"]</label>
            <div class="field-control" style="display:flex; align-items:center; gap:10px; justify-content:flex-end;">
                <span class="pill @(target.Enabled ? "tone-ok" : "tone-neutral")">@(target.Enabled ? T["setup.wake.atStartup"].Value : T["setup.wake.sendNowOnly"].Value)</span>
                <button type="button" class="btn secondary" style="padding:4px 10px;" title="@T["setup.wake.removeTitle"]"
                        @onclick="() => _wake.Value.Targets.RemoveAt(index)">@T["setup.wake.remove"]</button>
            </div>
        </div>
        <TextField Label="@T["setup.wake.name.label"]" Hint="@T["setup.wake.name.hint"]" Placeholder="@T["setup.wake.name.placeholder"]"
                   @bind-Value="target.Name" />
        <BoolField Label="@T["setup.wake.enabled.label"]" Hint="@T["setup.wake.enabled.hint"]"
                   @bind-Value="target.Enabled" />
        <TextField Label="@T["setup.wake.mac.label"]" Hint="@T["setup.wake.mac.hint"]" Kind="TextFieldKind.Mac" Placeholder="AA:BB:CC:DD:EE:FF" More="@T["setup.wake.mac.more"]"
                   @bind-Value="target.MacAddress" />
        <AdvancedFields>
            <TextField Label="@T["setup.wake.broadcast.label"]" Hint="@T["setup.wake.broadcast.hint"]" Kind="TextFieldKind.IpAddress" Placeholder="255.255.255.255"
                       @bind-Value="target.BroadcastAddress" />
            <NumberField Label="@T["setup.wake.port.label"]" Hint="@T["setup.wake.port.hint"]" Min="1" Max="65535"
                         @bind-Value="target.Port" />
        </AdvancedFields>
        <div class="field" style="align-items:center;">
            <label class="field-label">
                @T["setup.wake.sendNow"]
                <FieldHint Hint="@T["setup.wake.sendNowHint"]" />
            </label>
            <div class="field-control" style="display:flex; align-items:center; gap:10px; justify-content:flex-end; flex-wrap:wrap;">
                <span class="field-hint" style="margin:0;">@(_wakeResults.TryGetValue(index, out var line) ? line : "")</span>
                <button type="button" class="btn primary" style="padding:4px 12px;" disabled="@string.IsNullOrWhiteSpace(target.MacAddress)"
                        @onclick="() => SendWake(index)">@T["setup.wake.sendNow"]</button>
            </div>
        </div>
    </Section>
}

<Section Title="@T["setup.wake.list.title"]" Hint="@T["setup.wake.list.hint"]">
    @if (_wake.Value.Targets.Count == 0)
    {
        <div class="field-hint">@T["setup.wake.list.none"]</div>
    }
    <div style="margin:8px 0 4px;">
        <button type="button" class="btn primary" @onclick="AddWakeTarget">@T["setup.wake.list.add"]</button>
    </div>
</Section>

<Section Title="@T["setup.updates.title"]" Hint="@T["setup.updates.hint"]">
    <BoolField Label="@T["setup.updates.check.label"]" Hint="@T["setup.updates.check.hint"]"
               @bind-Value="_updateCheck.Value.Enabled" />
    <NumberField Label="@T["setup.updates.interval.label"]" Suffix="h" Min="1" Max="168"
                 Disabled="@(!_updateCheck.Value.Enabled)"
                 @bind-Value="_updateCheck.Value.IntervalHours"
                 Default="_updateCheck.Defaults.IntervalHours" />
</Section>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private OptionsDraft<GsxOptions> _gsx = default!;
    private OptionsDraft<SpeechOptions> _speech = default!;
    private OptionsDraft<AudioOptions> _audio = default!;
    private OptionsDraft<ProsimOptions> _prosim = default!;
    private OptionsDraft<WebUiOptions> _webUi = default!;
    private OptionsDraft<BriefingOptions> _briefing = default!;
    private OptionsDraft<CommandApiOptions> _commandApi = default!;
    private OptionsDraft<WeatherOptions> _weather = default!;
    private OptionsDraft<UpdateCheckOptions> _updateCheck = default!;
    private OptionsDraft<WakeTargetsOptions> _wake = default!;
    private readonly Dictionary<int, string> _wakeResults = [];
    private bool _gsxChanged;

    // ---- the HTTPS listener's live state (ADR-0013): what the host actually bound at start.
    private WebListenerSnapshot Listener => ListenerStatus.Snapshot();

    private string HttpsLabel => Listener.HttpsUp
        ? (Listener.HttpsWarningOnly ? T["setup.web.httpsLabel.onWarning"].Value : T["setup.web.httpsLabel.on"].Value)
        : Listener.HttpsEnabled ? T["setup.web.httpsLabel.failed"].Value : T["setup.web.httpsLabel.off"].Value;

    private string HttpsTone => Listener.HttpsUp
        ? (Listener.HttpsWarningOnly ? "tone-warn" : "tone-ok")
        : Listener.HttpsEnabled ? "tone-bad" : "tone-neutral";

    private string HttpsStatusHint => Listener.HttpsUp
        ? Listener.HttpsUrl + (Listener.HttpsProblem is { } warning ? " — " + warning : "")
        : Listener.HttpsProblem ?? (_webUi.Value.Https.Enabled && !Listener.HttpsEnabled
            ? T["setup.web.httpsHint.saved"].Value
            : T["setup.web.httpsHint.off", Listener.HttpUrl.Length > 0 ? Listener.HttpUrl : "localhost:" + _webUi.Value.Port].Value);

    // The bound options keep an unset API key as null; the input works in "" terms.
    private string ApiKeyInput
    {
        get => _prosim.Value.ApiKey ?? "";
        set => _prosim.Value.ApiKey = value.Length == 0 ? null : value;
    }

    protected override void OnInitialized()
    {
        _gsx = Draft(GsxMonitor);
        _speech = Draft(SpeechMonitor);
        _audio = Draft(AudioMonitor);
        _prosim = Draft(ProsimMonitor);
        _webUi = Draft(WebUiMonitor);
        _briefing = Draft(BriefingMonitor);
        _commandApi = Draft(CommandApiMonitor);
        _weather = Draft(WeatherMonitor);
        _updateCheck = Draft(UpdateCheckMonitor);
        _wake = Draft(WakeMonitor);
        MigrateLegacyWake();

        Watch(SetupStore, snapshot => _setup = snapshot);
        WatchChanged(h => Status.Changed += h, h => Status.Changed -= h, () => _prosimConnected = ProsimConnectedNow());
    }

    protected override void OnBeforeSave()
    {
        _prosim.Value.Host = _prosim.Value.Host.Trim();
        _prosim.Value.SdkPath = _prosim.Value.SdkPath.Trim();
        // Trim quotes too — Explorer's "Copy as path" wraps the path in them.
        _briefing.Value.DfdPath = _briefing.Value.DfdPath.Trim().Trim('"');
        _weather.Value.ActiveSkySnapshotPath = _weather.Value.ActiveSkySnapshotPath.Trim().Trim('"');
        _weather.Value.ActiveSkyApiHost = _weather.Value.ActiveSkyApiHost.Trim();
        foreach (var target in _wake.Value.Targets)
        {
            target.Name = target.Name.Trim();
            target.MacAddress = target.MacAddress.Trim();
            target.BroadcastAddress = target.BroadcastAddress.Trim();
        }
        _gsxChanged = _gsx.IsDirty;
        _prosimChanged = _prosim.IsDirty;
    }

    // The gsx master switch is part of the per-profile gsx block: a save that changed it must
    // mirror into the active profile exactly as the GSX pages do, or the next profile match
    // would silently flip it back.
    protected override void OnAfterSave()
    {
        if (_gsxChanged)
        {
            ProfileMirror.MirrorActiveProfile();
        }

        // A changed keep list (or GSX feature switch) changes the rows: read again so the card
        // shows the new verdicts without waiting for the next ProSim connection.
        if ((_prosimChanged || _gsxChanged) && _prosim.Value.SetupCheckEnabled)
        {
            _ = SetupCheck.RefreshAsync();
        }
    }

    // A discard reloads the live options, which may still carry only the legacy block —
    // re-synthesize so the row keeps showing (same pattern as the PTT bindings).
    protected override void OnDiscarded() => MigrateLegacyWake();

    // ---- Wake-on-LAN card ----

    /// <summary>One-way migration of <c>briefing.llmWakeOnLan</c> into the targets list
    /// (2026-10-08): an enabled legacy block with a MAC that no row carries becomes a row,
    /// and the legacy switch goes off. Both drafts dirty, so the bar prompts for the save
    /// that persists it; until then the startup module still honours the legacy block.
    /// The row's name is a settings.json value the log echoes, so it stays English.</summary>
    private void MigrateLegacyWake()
    {
        var legacy = _briefing.Value.LlmWakeOnLan;
        if (!legacy.Enabled || string.IsNullOrWhiteSpace(legacy.MacAddress))
        {
            return;
        }

        var known = _wake.Value.Targets.Any(t =>
            string.Equals(NormalizeMac(t.MacAddress), NormalizeMac(legacy.MacAddress), StringComparison.OrdinalIgnoreCase));
        if (!known)
        {
            _wake.Value.Targets.Add(new WakeTarget
            {
                Name = "Language-model PC",
                Enabled = true,
                MacAddress = legacy.MacAddress.Trim(),
                BroadcastAddress = legacy.BroadcastAddress,
                Port = legacy.Port,
            });
        }

        legacy.Enabled = false;
    }

    private static string NormalizeMac(string mac)
        => mac.Replace(":", "", StringComparison.Ordinal).Replace("-", "", StringComparison.Ordinal).Replace(" ", "", StringComparison.Ordinal).Trim();

    private void AddWakeTarget()
        => _wake.Value.Targets.Add(new WakeTarget { Name = $"PC {_wake.Value.Targets.Count + 1}" });

    private void SendWake(int index)
    {
        if (index < _wake.Value.Targets.Count)
        {
            _wakeResults[index] = WakeControl.Send(_wake.Value.Targets[index]);
        }
    }

    // ---- ProSim setup check card ----
    private ProsimSetupSnapshot _setup = ProsimSetupSnapshot.Empty;
    private bool _prosimConnected;
    private bool _prosimChanged;
    private bool _showHow;
    private string? _setupNote;
    private Timer? _setupNoteTimer;

    private bool ProsimConnected => _prosimConnected;

    private bool ProsimConnectedNow() => Status.Snapshot()
        .FirstOrDefault(pair => pair.Key == Subsystems.Prosim).Value == ConnectionState.Connected;

    private string SetupCheckHint => _setup.HasReading
        ? T["setup.setupCheck.hintRead", _setup.ProsimVersion ?? "", _setup.CheckedAtUtc!.Value.ToLocalTime().ToString("HH:mm:ss")].Value
        : T["setup.setupCheck.hintIdle"].Value;

    private bool IsKept(string dataRef)
        => _prosim.Value.SetupCheckIgnore.Contains(dataRef, StringComparer.OrdinalIgnoreCase);

    private void SetKept(string dataRef, bool kept)
    {
        var list = _prosim.Value.SetupCheckIgnore;
        list.RemoveAll(name => string.Equals(name, dataRef, StringComparison.OrdinalIgnoreCase));
        if (kept)
        {
            list.Add(dataRef);
        }
    }

    private static string Tone(ProsimSetupItem item) => item.Status switch
    {
        ProsimSetupStatus.Ok => "tone-ok",
        ProsimSetupStatus.Mismatch => "tone-warn",
        _ => "tone-neutral",
    };

    private string Verdict(ProsimSetupItem item) => item.Status switch
    {
        ProsimSetupStatus.Ok => T["setup.setupCheck.verdict.ok"].Value,
        ProsimSetupStatus.Mismatch => T["setup.setupCheck.verdict.change"].Value,
        ProsimSetupStatus.NotPresent => T["setup.setupCheck.verdict.notAvailable"].Value,
        ProsimSetupStatus.Ignored => T["setup.setupCheck.verdict.kept"].Value,
        _ => "—",
    };

    private string Detail(ProsimSetupItem item) => item.Status switch
    {
        ProsimSetupStatus.Mismatch => T["setup.setupCheck.detail.mismatch", Pretty(item.Actual), Pretty(item.Recommended)].Value,
        ProsimSetupStatus.NotPresent => T["setup.setupCheck.detail.notPresent"].Value,
        ProsimSetupStatus.Unknown => "",
        _ => Pretty(item.Actual),
    };

    /// <summary>Tick-box datarefs read "true"/"false"; the IOS shows a tick, so say on/off.</summary>
    private string Pretty(string? value) => value?.ToLowerInvariant() switch
    {
        null or "" => "—",
        "true" => T["setup.setupCheck.value.on"].Value,
        "false" => T["setup.setupCheck.value.off"].Value,
        _ => value,
    };

    private Task RefreshSetup() => RunSetupAction(async () =>
        await SetupCheck.RefreshAsync() ? T["setup.setupCheck.result.read"].Value : T["setup.setupCheck.result.notConnected"].Value);

    private Task ApplySetup() => RunSetupAction(async () =>
        (await SetupCheck.ApplyRecommendedAsync()).Summary);

    private async Task RunSetupAction(Func<Task<string>> action)
    {
        try
        {
            _setupNote = await action();
        }
        catch (Exception)
        {
            _setupNote = T["setup.setupCheck.result.failed"];
        }

        _setupNoteTimer?.Dispose();
        _setupNoteTimer = new Timer(_ => _ = InvokeAsync(() =>
        {
            _setupNote = null;
            StateHasChanged();
        }), null, 8000, Timeout.Infinite);
    }

    public override void Dispose()
    {
        _setupNoteTimer?.Dispose();
        base.Dispose();
    }
}
