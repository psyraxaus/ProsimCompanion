@page "/day"
@using Microsoft.Extensions.DependencyInjection
@using ProsimCompanion.Core.Day
@inherits StoreObserverComponent
@inject IServiceProvider Services
@inject IStringLocalizer T

<PageTitle>@T["day.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["day.heading"]</h1>

@* Layout (ADR-0011): the day status card with block / duty as big figures on the left,
   the legs as a timeline rail on the right. *@
<div class="ops-page">

    <section class="section ops-card ops-main">
        <div class="section-header">
            <h3 class="section-title">@T["day.title"]</h3>
            @if (_store is not null && _snapshot.View is { } v)
            {
                <span class="pill @(v.Active ? "tone-active" : "tone-neutral")">@v.State</span>
            }
        </div>
        <div class="section-body ops-body">
            @if (_store is null)
            {
                <div class="empty">@T["day.notWired"]</div>
            }
            else if (_snapshot.View is not { } view)
            {
                <div class="ops-figures">
                    <div class="ops-figure">
                        <span class="label-caps">@T["day.status"]</span>
                        <span class="figure ops-text-figure">@T["day.noDay"]</span>
                    </div>
                </div>
                <div class="ops-actions">
                    <button type="button" class="btn primary" disabled="@(_control is null)" @onclick="StartDay">
                        @T["day.start"]
                    </button>
                </div>
                <div class="ops-note">
                    @T["day.startHint"]
                </div>
            }
            else
            {
                <div class="ops-route">
                    <div class="ops-route-end">
                        <span class="label-caps">@T["day.from"]</span>
                        <span class="figure figure-xl">@(view.From ?? "----")</span>
                    </div>
                    <span class="ops-route-arrow" aria-hidden="true">→</span>
                    <div class="ops-route-end">
                        <span class="label-caps">@T["day.to"]</span>
                        <span class="figure figure-xl">@(view.To ?? "----")</span>
                    </div>
                    <div class="ops-route-leg">
                        <span class="label-caps">@T["day.leg"]</span>
                        <span class="figure">@view.LegIndex<span class="figure-unit">@T["day.legOf", view.LegCount]</span></span>
                        <span class="ops-item-sub">@T["day.legsCompleted", view.LegsCompleted]</span>
                    </div>
                </div>

                <div class="ops-figures">
                    @* h:mm digits + a small unit, like every other EFB figure — the spoken
                       "1 hour 42 minutes" ellipsized in the cell (Mario, 2026-10-10). *@
                    <div class="ops-figure">
                        <span class="label-caps">@T["day.block"]</span>
                        <span class="figure figure-lg glow" title="@DayMath.FormatHoursMinutes(view.BlockMinutes)">@DayMath.FormatClock(view.BlockMinutes)<span class="figure-unit">HRS</span></span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">@T["day.duty"]</span>
                        <span class="figure figure-lg" title="@DayMath.FormatHoursMinutes(view.DutyMinutes)">@DayMath.FormatClock(view.DutyMinutes)<span class="figure-unit">HRS</span></span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">@T["day.schedule"]</span>
                        @if (view.DelayMinutes is { } delay)
                        {
                            <span class="figure figure-lg @(delay > 0 ? "ops-bad" : delay < 0 ? "glow" : null)">
                                @(delay > 0 ? $"+{delay}" : delay < 0 ? $"−{-delay}" : "0")<span class="figure-unit">min</span>
                            </span>
                            <span class="ops-item-sub">@(delay > 0 ? T["day.behind"].Value : delay < 0 ? T["day.ahead"].Value : T["day.onSchedule"].Value)</span>
                        }
                        else
                        {
                            <span class="figure figure-lg">—</span>
                        }
                    </div>
                </div>

                <div class="ops-actions">
                    @if (view.Active)
                    {
                        <button type="button" class="btn primary" disabled="@(_control is null)" @onclick="EndDay">
                            @T["day.end"]
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn primary" disabled="@(_control is null)" @onclick="StartDay">
                            @T["day.start"]
                        </button>
                    }
                </div>
                <div class="ops-note">
                    @T["day.figuresNote"]
                </div>
            }
        </div>
    </section>

    @if (_store is not null && _snapshot.Legs.Count > 0)
    {
        <section class="section ops-card ops-side">
            <div class="section-header"><h3 class="section-title">@T["day.legs"]</h3></div>
            <div class="section-body">
                <ol class="ops-timeline">
                    @foreach (var leg in _snapshot.Legs)
                    {
                        var current = _snapshot.View is { } cv && cv.LegIndex == leg.Index;
                        <li class="ops-step @(leg.Completed ? "done" : current ? "active" : "pending")">
                            <span class="ops-step-dot" aria-hidden="true"></span>
                            <div class="ops-step-text">
                                <span class="ops-step-name">@T["day.legName", leg.Index, leg.From ?? "?", leg.To ?? "?"]</span>
                                <span class="ops-step-sub">
                                    @if (!string.IsNullOrWhiteSpace(leg.FlightNo))
                                    {
                                        <text>@leg.FlightNo · </text>
                                    }
                                    @if (leg.BlockMinutes is { } block)
                                    {
                                        <text>@T["day.blockMin", block] · </text>
                                    }
                                    @(leg.Completed ? (leg.Landed ? T["day.legState.landed"].Value : T["day.legState.noLanding"].Value) : current ? T["day.legState.inProgress"].Value : T["day.legState.planned"].Value)
                                </span>
                                <div class="ops-item-pills">
                                    @if (leg.Stabilized is { } stab)
                                    {
                                        <span class="pill @(stab ? "tone-ok" : "tone-bad")">@(stab ? T["day.legState.stabilized"].Value : T["day.legState.unstable"].Value)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(leg.Deviation))
                                    {
                                        <span class="pill tone-bad">@leg.Deviation</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </section>
    }

</div>

@code {
    private DayStatusStore? _store;
    private IDayControl? _control;
    private DaySnapshot _snapshot = DaySnapshot.Empty;

    protected override void OnInitialized()
    {
        // Optional resolution: the page renders a friendly notice (instead of a DI crash)
        // in builds where day mode is not yet wired — degrade, not fail.
        _store = Services.GetService<DayStatusStore>();
        _control = Services.GetService<IDayControl>();
        if (_store is { } store)
        {
            WatchChanged(h => store.Changed += h, h => store.Changed -= h,
                () => _snapshot = store.Snapshot());
        }
    }

    private void StartDay()
    {
        _control?.StartDay();
        RefreshNow();
    }

    private void EndDay()
    {
        _control?.EndDay();
        RefreshNow();
    }

    private void RefreshNow()
    {
        if (_store is not null)
        {
            _snapshot = _store.Snapshot();
        }
    }
}
