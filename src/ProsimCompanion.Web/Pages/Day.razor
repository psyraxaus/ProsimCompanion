@page "/day"
@using Microsoft.Extensions.DependencyInjection
@using ProsimCompanion.Core.Day
@inherits StoreObserverComponent
@inject IServiceProvider Services

<PageTitle>Duty Day — ProsimCompanion</PageTitle>
<h1 class="sr-only">Duty Day</h1>

@* Layout (ADR-0011): the day status card with block / duty as big figures on the left,
   the legs as a timeline rail on the right. *@
<div class="ops-page">

    <section class="section ops-card ops-main">
        <div class="section-header">
            <h3 class="section-title">Company Day Mode</h3>
            @if (_store is not null && _snapshot.View is { } v)
            {
                <span class="pill @(v.Active ? "tone-active" : "tone-neutral")">@v.State</span>
            }
        </div>
        <div class="section-body ops-body">
            @if (_store is null)
            {
                <div class="empty">Company day mode is not wired into this build (see WIRING-DAY.md).</div>
            }
            else if (_snapshot.View is not { } view)
            {
                <div class="ops-figures">
                    <div class="ops-figure">
                        <span class="label-caps">Status</span>
                        <span class="figure ops-text-figure">No duty day</span>
                    </div>
                </div>
                <div class="ops-actions">
                    <button type="button" class="btn primary" disabled="@(_control is null)" @onclick="StartDay">
                        Start duty day
                    </button>
                </div>
                <div class="ops-note">
                    Say "start duty day", or press the button. With day mode enabled and auto-start on,
                    a day also begins at the first Preflight. Drop a rotations/*.json file for a planned day.
                </div>
            }
            else
            {
                <div class="ops-route">
                    <div class="ops-route-end">
                        <span class="label-caps">From</span>
                        <span class="figure figure-xl">@(view.From ?? "----")</span>
                    </div>
                    <span class="ops-route-arrow" aria-hidden="true">→</span>
                    <div class="ops-route-end">
                        <span class="label-caps">To</span>
                        <span class="figure figure-xl">@(view.To ?? "----")</span>
                    </div>
                    <div class="ops-route-leg">
                        <span class="label-caps">Leg</span>
                        <span class="figure">@view.LegIndex<span class="figure-unit">of @view.LegCount</span></span>
                        <span class="ops-item-sub">@view.LegsCompleted completed</span>
                    </div>
                </div>

                <div class="ops-figures">
                    <div class="ops-figure">
                        <span class="label-caps">Block</span>
                        <span class="figure figure-lg glow">@DayMath.FormatHoursMinutes(view.BlockMinutes)</span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">Duty</span>
                        <span class="figure figure-lg">@DayMath.FormatHoursMinutes(view.DutyMinutes)</span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">Schedule</span>
                        @if (view.DelayMinutes is { } delay)
                        {
                            <span class="figure figure-lg @(delay > 0 ? "ops-bad" : delay < 0 ? "glow" : null)">
                                @(delay > 0 ? $"+{delay}" : delay < 0 ? $"−{-delay}" : "0")<span class="figure-unit">min</span>
                            </span>
                            <span class="ops-item-sub">@(delay > 0 ? "behind" : delay < 0 ? "ahead" : "on schedule")</span>
                        }
                        else
                        {
                            <span class="figure figure-lg">—</span>
                        }
                    </div>
                </div>

                <div class="ops-actions">
                    @if (view.Active)
                    {
                        <button type="button" class="btn primary" disabled="@(_control is null)" @onclick="EndDay">
                            End duty day
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn primary" disabled="@(_control is null)" @onclick="StartDay">
                            Start duty day
                        </button>
                    }
                </div>
                <div class="ops-note">
                    Block and duty figures are convenience tracking of what was flown — not a
                    flight-time-limitations calculation.
                </div>
            }
        </div>
    </section>

    @if (_store is not null && _snapshot.Legs.Count > 0)
    {
        <section class="section ops-card ops-side">
            <div class="section-header"><h3 class="section-title">Legs</h3></div>
            <div class="section-body">
                <ol class="ops-timeline">
                    @foreach (var leg in _snapshot.Legs)
                    {
                        var current = _snapshot.View is { } cv && cv.LegIndex == leg.Index;
                        <li class="ops-step @(leg.Completed ? "done" : current ? "active" : "pending")">
                            <span class="ops-step-dot" aria-hidden="true"></span>
                            <div class="ops-step-text">
                                <span class="ops-step-name">Leg @leg.Index · @(leg.From ?? "?") → @(leg.To ?? "?")</span>
                                <span class="ops-step-sub">
                                    @if (!string.IsNullOrWhiteSpace(leg.FlightNo))
                                    {
                                        <text>@leg.FlightNo · </text>
                                    }
                                    @if (leg.BlockMinutes is { } block)
                                    {
                                        <text>@block min block · </text>
                                    }
                                    @(leg.Completed ? (leg.Landed ? "landed" : "no landing") : current ? "in progress" : "planned")
                                </span>
                                <div class="ops-item-pills">
                                    @if (leg.Stabilized is { } stab)
                                    {
                                        <span class="pill @(stab ? "tone-ok" : "tone-bad")">@(stab ? "stabilized" : "unstable")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(leg.Deviation))
                                    {
                                        <span class="pill tone-bad">@leg.Deviation</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </section>
    }

</div>

@code {
    private DayStatusStore? _store;
    private IDayControl? _control;
    private DaySnapshot _snapshot = DaySnapshot.Empty;

    protected override void OnInitialized()
    {
        // Optional resolution: the page renders a friendly notice (instead of a DI crash)
        // in builds where day mode is not yet wired — degrade, not fail.
        _store = Services.GetService<DayStatusStore>();
        _control = Services.GetService<IDayControl>();
        if (_store is { } store)
        {
            WatchChanged(h => store.Changed += h, h => store.Changed -= h,
                () => _snapshot = store.Snapshot());
        }
    }

    private void StartDay()
    {
        _control?.StartDay();
        RefreshNow();
    }

    private void EndDay()
    {
        _control?.EndDay();
        RefreshNow();
    }

    private void RefreshNow()
    {
        if (_store is not null)
        {
            _snapshot = _store.Snapshot();
        }
    }
}
