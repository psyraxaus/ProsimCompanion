@page "/settings/appearance"
@layout SettingsLayout
@using Microsoft.Extensions.Logging
@using ProsimCompanion.Core.Theming
@using ProsimCompanion.Web.Theming
@inherits StoreObserverComponent
@inject ThemeCatalog Themes
@inject ThemeLogoStore Logos
@inject AirlineLogoStore AirlineLogos
@inject IOptionsMonitor<WebUiOptions> WebUi
@inject SettingsWriter Writer
@inject ILogger<AppearanceSettings> Logger
@inject IJSRuntime JS
@using Microsoft.JSInterop

<PageTitle>Appearance — ProsimCompanion</PageTitle>
<h1 class="sr-only">Appearance</h1>

@* Owner decision 2026-09-20: the header theme picker moved here. A click applies the theme
   at once and writes webUi.theme to settings.json (the same option, no second store). The
   airline logos are the pilot's own files under %LOCALAPPDATA% — real airline marks are
   trademarks, so the app ships none and the installer refuses to (build-installer.ps1). *@

<div class="panel" style="padding-bottom:24px;">
    <Section Title="Theme" Hint="Click a theme to apply it now. Your own JSON themes in the user config folder appear after the built-in ones.">
        @if (_message is not null)
        {
            <div class="field-hint" style="margin-bottom:8px;">@_message</div>
        }
        <div class="theme-grid">
            @foreach (var name in Themes.ListNames())
            {
                var theme = Themes.Get(name);
                var active = string.Equals(name, ActiveThemeName, StringComparison.OrdinalIgnoreCase);
                var logoSlug = Logos.FindFile(name) is null ? null : ThemeLogoStore.Slug(name);
                <div class="theme-swatch @(active ? "active" : null)">
                    <button type="button" class="theme-swatch-pick" title="Apply @name" @onclick="() => Apply(name)">
                        <span class="swatch-bars" aria-hidden="true">
                            <span style="background:@theme.Colors.HeaderBackground"></span>
                            <span style="background:@theme.Colors.ContentBackground"></span>
                            <span style="background:@theme.Colors.SectionBackground"></span>
                            <span style="background:@theme.Colors.PrimaryColor"></span>
                            <span style="background:@theme.Colors.AccentColor"></span>
                        </span>
                        <span class="swatch-name">@name @(active ? "· active" : "")</span>
                    </button>
                    @if (logoSlug is not null)
                    {
                        <img class="swatch-logo" src="api/theme-logo/@(logoSlug)?v=@Logos.Version" alt="@name logo" />
                    }
                    <div class="swatch-actions">
                        <label class="btn secondary" title="PNG, SVG, JPG or WEBP up to 512 KB — shown in the header while this theme is active">
                            @(logoSlug is null ? "Add logo" : "Replace logo")
                            <InputFile accept=".png,.svg,.jpg,.jpeg,.webp" OnChange="args => UploadAsync(name, args)" />
                        </label>
                        @if (logoSlug is not null)
                        {
                            <button type="button" class="btn secondary" @onclick="() => RemoveLogo(name)">Remove</button>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="field-hint" style="margin-top:12px; max-width:640px;">
            Logos are your own files. They stay on this PC in
            <code>%LOCALAPPDATA%\ProsimCompanion\config\themes\logos</code> and are never part of the app or
            the installer. The header shows the active theme's logo when one is set.
        </div>
    </Section>

    @* Header extras (issue #133): the NEXT SERVICE button for home cockpits that do not use
       the INT/RAD switch. Applies at once, like the theme — no dirty bar. *@
    <Section Title="Header" Hint="What the top bar shows on every page">
        <BoolField Label="Show NEXT SERVICE button in the header"
                   Hint="Calls the next departure service now — the INT/RAD smart button, on every page."
                   More="The button names the next service and why it is holding. It is greyed until the departure sequence has started, and after it completes. Same action as Settings → Ground Services → Call next service now, the Stream Deck key and the voice command 'next service'."
                   Value="@WebUi.CurrentValue.ShowNextServiceInHeader"
                   ValueChanged="SetShowNextService" />
    </Section>

    @* Screen keep-awake and the installable app (issue #150, ADR-0013, design A). Per DEVICE:
       the choice lives in this browser's localStorage, not in settings.json — whether a
       tablet's screen stays on is that tablet's business. The state pill is live from app.js. *@
    <Section Title="Screen &amp; Install" Hint="For this device only — the tablet or PC you are reading this on">
        <div class="field">
            <label class="field-label" for="keep-awake">
                Keep the screen awake
                <span class="pill @WakeTone" style="margin-left:10px; vertical-align:middle;">@WakeLabel</span>
                <FieldHint Hint="Stops this device's screen from sleeping while the app is open. Stored on this device only."
                           More="@WakeMore" />
                @if (_wake?.State == "needs-https")
                {
                    <div class="field-hint">Only a secure page can keep the screen awake. Open the app over HTTPS — <a href="settings">HTTPS setup</a> (Setup → Web Interface).</div>
                }
            </label>
            <div class="field-control">
                <input id="keep-awake" type="checkbox" class="checkbox" checked="@(_wake?.Wanted ?? false)"
                       disabled="@(_wake is null)" @onchange="SetKeepAwake" />
            </div>
        </div>
        <div class="field">
            <label class="field-label">
                Install as an app
                <FieldHint Hint="Add ProsimCompanion to the home screen for a full-screen app without the browser bars."
                           More="iPad: open the app in Safari, tap Share, then 'Add to Home Screen'. Android / Chrome: menu → 'Install app'. There is no offline mode — the app needs the sim PC. Full steps: docs/manual/07-tablet-install.md in the install folder." />
            </label>
            <div class="field-control">
                <span class="pill @(_wake?.Standalone == true ? "tone-ok" : "tone-neutral")">@(_wake?.Standalone == true ? "INSTALLED" : "IN BROWSER")</span>
            </div>
        </div>
        @if (_wake is not null)
        {
            <div class="field-hint label-caps" style="margin-top:4px;">This device: @DeviceLine</div>
            <div class="field-hint" style="margin-top:6px;">
                The switch is stored per address: on at <code>https://…:5321</code> does not carry over from <code>http://…:5320</code>. iPadOS ignores every wake lock in <strong>Low Power Mode</strong>.
            </div>
            @if (_wake.Wanted)
            {
                <div class="field" style="align-items:center; margin-top:4px;">
                    <label class="field-label">
                        Lock diagnostics
                        <FieldHint Hint="@WakeDiagnostics" />
                    </label>
                    <div class="field-control">
                        <button type="button" class="btn secondary" style="padding:4px 10px;" @onclick="RetryWake">Request again</button>
                    </div>
                </div>
            }
        }
    </Section>

    @* Airline logos for the pop-out Flight Monitor (owner request 2026-09-23): keyed by the
       OFP's ICAO airline code so the board shows the right mark whatever theme is active. *@
    <Section Title="Airline logos" Hint="For the pop-out Flight Monitor board — matched to the flight plan's airline code">
        @if (_airlineMessage is not null)
        {
            <div class="field-hint" style="margin-bottom:8px;">@_airlineMessage</div>
        }
        <div class="airline-logo-add">
            <label class="field-label" for="airline-code">Airline ICAO code</label>
            <input id="airline-code" class="number-input mono" style="width:6em; text-transform:uppercase;" maxlength="4"
                   placeholder="KLM" @bind="_airlineCode" @bind:event="oninput" />
            <label class="btn secondary @(AirlineLogoStore.Slug(_airlineCode) is null ? "disabled" : null)"
                   title="PNG, SVG, JPG or WEBP up to 512 KB — shown on the Flight Monitor when the OFP's airline matches">
                Add logo
                <InputFile accept=".png,.svg,.jpg,.jpeg,.webp" OnChange="UploadAirlineAsync" disabled="@(AirlineLogoStore.Slug(_airlineCode) is null)" />
            </label>
        </div>
        @{
            var airlineSlugs = AirlineLogos.Files.ListSlugs();
        }
        @if (airlineSlugs.Count == 0)
        {
            <div class="field-hint">No airline logos yet. Type the airline's ICAO code (the one SimBrief shows, e.g. KLM, BAW, DLH) and add its logo.</div>
        }
        else
        {
            <div class="theme-grid">
                @foreach (var slug in airlineSlugs)
                {
                    <div class="theme-swatch">
                        <div class="swatch-name" style="padding:8px 10px 0;">@slug.ToUpperInvariant()</div>
                        <img class="swatch-logo" src="api/airline-logo/@(slug)?v=@AirlineLogos.Files.Version" alt="@slug logo" />
                        <div class="swatch-actions">
                            <button type="button" class="btn secondary" @onclick="() => RemoveAirlineLogo(slug)">Remove</button>
                        </div>
                    </div>
                }
            </div>
        }
        <div class="field-hint" style="margin-top:12px; max-width:640px;">
            Stored in <code>%LOCALAPPDATA%\ProsimCompanion\config\themes\logos\airlines</code>, never part of the app.
            The Flight Monitor shows the logo whose code equals the OFP's airline code; without one it shows the code itself.
        </div>
    </Section>
</div>

@code {
    private string? _message;

    private string ActiveThemeName => Themes.Get(WebUi.CurrentValue.Theme).Name;

    private IDisposable? _webUiSubscription;

    // ---- screen keep-awake (issue #150): the browser owns the state; this page only shows it.
    private sealed record WakeInfo(bool Wanted, string State, bool Secure, bool Supported, bool Standalone, string Scheme, string UserAgent,
        string? LastError = null, string? LastErrorAt = null, string? AcquiredAt = null, string? ReleasedAt = null, int Attempts = 0);

    /// <summary>What the browser said, for the test flight: attempts, the last refusal with its
    /// text, when the lock was last granted and last let go (all device clock, UTC).</summary>
    private string WakeDiagnostics
    {
        get
        {
            if (_wake is null)
            {
                return "";
            }

            var parts = new List<string> { $"{_wake.Attempts} request(s)" };
            if (_wake.AcquiredAt is { } got)
            {
                parts.Add($"granted {got}");
            }

            if (_wake.ReleasedAt is { } let)
            {
                parts.Add($"released {let}");
            }

            if (_wake.LastError is { } err)
            {
                parts.Add($"last refusal {_wake.LastErrorAt}: {err}");
            }

            return string.Join(" · ", parts) + ". If the screen still sleeps with the pill ACTIVE and no release shown, the OS overrode the lock (Low Power Mode, or Guided Access / a Screen Time limit).";
        }
    }

    private async Task RetryWake()
    {
        await JS.InvokeVoidAsync("prosimCompanion.wakeLock.retry");
        _wake = await JS.InvokeAsync<WakeInfo>("prosimCompanion.wakeLock.describe");
    }

    private WakeInfo? _wake;
    private DotNetObjectReference<AppearanceSettings>? _wakeRef;

    private string WakeLabel => _wake?.State switch
    {
        "active" => "ACTIVE",
        "requesting" => "REQUESTING",
        "needs-https" => "NEEDS HTTPS",
        "not-supported" => "NOT SUPPORTED",
        null => "…",
        _ => "OFF",
    };

    private string WakeTone => _wake?.State switch
    {
        "active" => "tone-ok",
        "requesting" => "tone-active",
        "needs-https" or "not-supported" => "tone-warn",
        _ => "tone-neutral",
    };

    private string WakeMore => _wake?.State switch
    {
        "not-supported" => "This browser has no Screen Wake Lock. Safari 16.4+, Chrome and Edge have it; a secure page is still required.",
        _ => "The browser drops the lock when the page is hidden and the app takes it again when you come back. A low battery can make the browser refuse — the pill then reads REQUESTING until the next try.",
    };

    private string DeviceLine
    {
        get
        {
            if (_wake is null)
            {
                return "";
            }

            var ua = _wake.UserAgent;
            var browser = ua.Contains("CriOS", StringComparison.Ordinal) || ua.Contains("Chrome", StringComparison.Ordinal) ? "Chrome"
                : ua.Contains("Safari", StringComparison.Ordinal) ? "Safari"
                : ua.Contains("Firefox", StringComparison.Ordinal) ? "Firefox" : "Browser";
            var device = ua.Contains("iPad", StringComparison.Ordinal) || (ua.Contains("Macintosh", StringComparison.Ordinal) && ua.Contains("Mobile", StringComparison.Ordinal)) ? "iPad"
                : ua.Contains("iPhone", StringComparison.Ordinal) ? "iPhone"
                : ua.Contains("Android", StringComparison.Ordinal) ? "Android"
                : ua.Contains("Windows", StringComparison.Ordinal) ? "Windows" : "device";
            return $"{browser} on {device} · {_wake.Scheme} · {(_wake.Standalone ? "standalone" : "browser tab")}";
        }
    }

    protected override void OnInitialized()
    {
        WatchChanged(h => Logos.Changed += h, h => Logos.Changed -= h, () => { });
        // The header toggle writes settings.json and the option reloads a beat later — the
        // checkbox must follow the reloaded value, not the pre-click one.
        _webUiSubscription = WebUi.OnChange(options => _ = InvokeAsync(StateHasChanged));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _wake = await JS.InvokeAsync<WakeInfo>("prosimCompanion.wakeLock.describe");
            _wakeRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("prosimCompanion.wakeLock.subscribe", _wakeRef);
            StateHasChanged();
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Wake lock interop unavailable (prerender or an old app.js)");
        }
    }

    [JSInvokable]
    public async Task OnWakeLockState(string state)
    {
        if (_wake is not null)
        {
            // Re-read the facts (times, last error) rather than patching the state alone.
            try
            {
                _wake = await JS.InvokeAsync<WakeInfo>("prosimCompanion.wakeLock.describe");
            }
            catch (JSException)
            {
                _wake = _wake with { State = state, Wanted = state != "off" || _wake.Wanted };
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetKeepAwake(ChangeEventArgs e)
    {
        var wanted = e.Value is bool b && b;
        if (_wake is not null)
        {
            _wake = _wake with { Wanted = wanted, State = wanted ? _wake.State : "off" };
        }

        await JS.InvokeVoidAsync("prosimCompanion.wakeLock.setWanted", wanted);
        _wake = await JS.InvokeAsync<WakeInfo>("prosimCompanion.wakeLock.describe");
    }

    public override void Dispose()
    {
        base.Dispose();
        _webUiSubscription?.Dispose();
        if (_wakeRef is not null)
        {
            try
            {
                _ = JS.InvokeVoidAsync("prosimCompanion.wakeLock.unsubscribe", _wakeRef);
            }
            catch (Exception)
            {
                // The circuit is already gone.
            }

            _wakeRef.Dispose();
        }
    }

    private void Apply(string name)
    {
        if (!string.Equals(name, WebUi.CurrentValue.Theme, StringComparison.Ordinal))
        {
            Writer.Set<WebUiOptions, string>(o => o.Theme, name);
            _message = $"Theme set to {name}.";
        }
    }

    private void SetShowNextService(bool show)
        => Writer.Set<WebUiOptions, bool>(o => o.ShowNextServiceInHeader, show);

    private async Task UploadAsync(string themeName, InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(ThemeLogoStore.MaxBytes);
            await Logos.SaveAsync(themeName, args.File.Name, stream, CancellationToken.None);
            _message = $"Logo for {themeName} saved.";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException)
        {
            // OpenReadStream throws IOException past the size cap; the store names the format
            // and size rules itself. Either way the pilot reads why, not a stack trace.
            _message = $"Logo for {themeName} not saved: {ex.Message}";
            Logger.LogWarning(ex, "Theme logo upload for {Theme} rejected", themeName);
        }
    }

    private void RemoveLogo(string themeName)
    {
        _message = Logos.Remove(themeName) ? $"Logo for {themeName} removed." : $"{themeName} has no logo.";
    }

    private string _airlineCode = "";
    private string? _airlineMessage;

    private async Task UploadAirlineAsync(InputFileChangeEventArgs args)
    {
        var code = _airlineCode.Trim().ToUpperInvariant();
        if (AirlineLogoStore.Slug(code) is null)
        {
            _airlineMessage = "Type the airline's 2–4 character code first (e.g. KLM).";
            return;
        }

        try
        {
            await using var stream = args.File.OpenReadStream(ThemeLogoStore.MaxBytes);
            await AirlineLogos.Files.SaveAsync(code, args.File.Name, stream, CancellationToken.None);
            _airlineMessage = $"Logo for {code} saved.";
            _airlineCode = "";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException)
        {
            _airlineMessage = $"Logo for {code} not saved: {ex.Message}";
            Logger.LogWarning(ex, "Airline logo upload for {Airline} rejected", code);
        }
    }

    private void RemoveAirlineLogo(string slug)
    {
        _airlineMessage = AirlineLogos.Files.Remove(slug) ? $"Logo {slug.ToUpperInvariant()} removed." : "Nothing to remove.";
    }
}
