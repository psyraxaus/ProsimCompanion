@page "/techlog"
@using Microsoft.Extensions.DependencyInjection
@using ProsimCompanion.Core.TechLog
@inherits StoreObserverComponent
@inject IServiceProvider Services
@inject IStringLocalizer T

<PageTitle>@T["techLog.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["techLog.heading"]</h1>

@* Layout (ADR-0011): the defect list as glass rows on the left, the raise-a-defect form on
   the right. Advisory only — the app never grounds the aircraft. *@
<div class="ops-page">

    <section class="section ops-card ops-main">
        <div class="section-header">
            <h3 class="section-title">@T["techLog.title"]</h3>
            @if (_techLog is not null)
            {
                <span class="pill @(!_techLog.IsEnabled ? "tone-neutral" : _open.Count == 0 ? "tone-ok" : _open.Any(_techLog.IsOverdue) ? "tone-bad" : "tone-warn")">
                    @(!_techLog.IsEnabled ? T["techLog.pill.switchedOff"].Value : _open.Count == 0 ? T["techLog.pill.clean"].Value : T["techLog.pill.open", _open.Count].Value)
                </span>
            }
        </div>
        <div class="section-body ops-body">
            @if (_techLog is null)
            {
                <div class="empty">@T["techLog.notWired"]</div>
            }
            else
            {
                <div class="ops-figures">
                    <div class="ops-figure">
                        <span class="label-caps">@T["techLog.figures.openItems"]</span>
                        <span class="figure figure-lg @(_open.Count > 0 ? "glow" : null)">@_open.Count</span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">@T["techLog.figures.onFile"]</span>
                        <span class="figure figure-lg">@_defects.Count</span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">@T["techLog.figures.overdue"]</span>
                        <span class="figure figure-lg @(_open.Any(_techLog.IsOverdue) ? "ops-bad" : null)">@_open.Count(_techLog.IsOverdue)</span>
                    </div>
                </div>

                @if (_defects.Count == 0)
                {
                    <div class="empty">@T["techLog.cleanNoDefects"]</div>
                }
                <div class="ops-list">
                    @foreach (var defect in _defects)
                    {
                        var overdue = _techLog.IsOverdue(defect);
                        <div class="ops-item inset @(defect.IsOpen ? (overdue ? "bad" : "open") : "closed")">
                            <div class="ops-item-main">
                                <span class="ops-item-title">@defect.Title</span>
                                <span class="ops-item-sub mono">@defect.MelReference · CAT @defect.Category · @defect.Status</span>
                                <div class="ops-item-pills">
                                    @if (!string.IsNullOrWhiteSpace(defect.Placard))
                                    {
                                        <span class="pill tone-warn">@defect.Placard</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(defect.System))
                                    {
                                        <span class="pill tone-neutral" title="@T["techLog.item.systemTag"]">@defect.System</span>
                                    }
                                    @if (defect.IsOpen)
                                    {
                                        <span class="pill @(overdue ? "tone-bad" : "tone-neutral")">@(overdue ? T["techLog.item.overduePrefix"].Value : "")@_techLog.DaysPhrase(defect)</span>
                                        <span class="pill tone-neutral">@T["techLog.item.sectorsCarried", defect.SectorsCarried]</span>
                                    }
                                    else
                                    {
                                        <span class="pill tone-ok">@T["techLog.item.rectified"]</span>
                                    }
                                </div>
                            </div>
                            <div class="ops-item-actions">
                                @if (defect.IsOpen)
                                {
                                    <button type="button" class="btn primary" @onclick="() => Rectify(defect.Id)">@T["techLog.item.rectify"]</button>
                                }
                                <button type="button" class="btn secondary" @onclick="() => Remove(defect.Id)">@T["techLog.item.remove"]</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="ops-note">
                    @T["techLog.advisoryNote"]
                </div>
            }
        </div>
    </section>

    @if (_techLog is not null)
    {
        <section class="section ops-card ops-side">
            <div class="section-header"><h3 class="section-title">@T["techLog.form.title"]</h3></div>
            <div class="section-body ops-form">
                <label class="ops-field">
                    <span class="label-caps">@T["techLog.form.defectTitle"]</span>
                    <input class="text-input" @bind="_title" placeholder="@T["techLog.form.defectTitlePlaceholder"]" />
                </label>
                <label class="ops-field">
                    <span class="label-caps">@T["techLog.form.category"]</span>
                    <select class="select" @bind="_category">
                        <option value="A">@T["techLog.form.categoryOption", "A", _techLog.RepairDaysForCategory(MelCategory.A)]</option>
                        <option value="B">@T["techLog.form.categoryOption", "B", _techLog.RepairDaysForCategory(MelCategory.B)]</option>
                        <option value="C">@T["techLog.form.categoryOption", "C", _techLog.RepairDaysForCategory(MelCategory.C)]</option>
                        <option value="D">@T["techLog.form.categoryOption", "D", _techLog.RepairDaysForCategory(MelCategory.D)]</option>
                    </select>
                </label>
                <label class="ops-field">
                    <span class="label-caps">@T["techLog.form.melReference"]</span>
                    <input class="text-input" @bind="_melReference" placeholder="@T["techLog.form.melReferencePlaceholder"]" />
                </label>
                <label class="ops-field">
                    <span class="label-caps">@T["techLog.form.implications"]</span>
                    <input class="text-input" @bind="_implications" placeholder="@T["techLog.form.implicationsPlaceholder"]" />
                </label>
                <label class="ops-field">
                    <span class="label-caps">@T["techLog.form.placard"]</span>
                    <input class="text-input" @bind="_placard" placeholder="@T["techLog.form.placardPlaceholder"]" />
                </label>
                <label class="ops-field">
                    <span class="label-caps">@T["techLog.form.system"]</span>
                    <input class="text-input" @bind="_system" placeholder="@T["techLog.form.systemPlaceholder"]" />
                    <span class="field-hint">@T["techLog.form.systemHint"]</span>
                </label>
                <button type="button" class="btn primary" disabled="@string.IsNullOrWhiteSpace(_title)" @onclick="Raise">
                    @T["techLog.form.enter"]
                </button>
            </div>
        </section>
    }

</div>

@code {
    private ITechLogService? _techLog;
    private IReadOnlyList<TechLogDefect> _defects = [];
    private IReadOnlyList<TechLogDefect> _open = [];

    private string _title = "";
    private string _category = "C";
    private string _melReference = "";
    private string _implications = "";
    private string _placard = "";
    private string _system = "";

    protected override void OnInitialized()
    {
        // Optional resolution: the page renders a friendly notice (instead of a DI crash)
        // in builds where the tech log is not yet wired — degrade, not fail.
        _techLog = Services.GetService<ITechLogService>();
        if (_techLog is { } techLog)
        {
            WatchChanged(h => techLog.Changed += h, h => techLog.Changed -= h, Refresh);
        }
    }

    private void Refresh()
    {
        if (_techLog is null)
        {
            return;
        }

        _defects = _techLog.Defects;
        _open = _techLog.OpenDefects;
    }

    private void Raise()
    {
        if (_techLog is null || string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        var category = _category switch
        {
            "A" => MelCategory.A,
            "B" => MelCategory.B,
            "D" => MelCategory.D,
            _ => MelCategory.C,
        };
        var draft = _techLog.NewDraft("manual", _title, category);
        if (!string.IsNullOrWhiteSpace(_melReference))
        {
            draft.MelReference = _melReference.Trim();
        }

        draft.OperationalImplications = _implications.Trim();
        draft.Placard = string.IsNullOrWhiteSpace(_placard) ? null : _placard.Trim();
        draft.System = string.IsNullOrWhiteSpace(_system) ? null : _system.Trim();
        _techLog.RaiseDefect(draft);

        _title = "";
        _melReference = "";
        _implications = "";
        _placard = "";
        _system = "";
        Refresh();
    }

    private void Rectify(string id)
    {
        _techLog?.RectifyDefect(id);
        Refresh();
    }

    private void Remove(string id)
    {
        _techLog?.RemoveDefect(id);
        Refresh();
    }
}
