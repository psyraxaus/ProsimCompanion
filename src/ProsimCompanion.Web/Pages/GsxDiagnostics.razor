@page "/gsx"
@using ProsimCompanion.Core.State
@implements IDisposable
@inject GsxDiagnosticsStore Diagnostics
@inject IGsxGateControl GateControl
@inject IGsxDepartureControl DepartureControl

<h1>GSX diagnostics</h1>

<p>
    Readiness: <span class="badge @ReadinessClass(_view.Readiness)">@_view.Readiness</span>
    &nbsp;·&nbsp; Automation phase: <strong>@_view.AutomationPhase</strong>
    &nbsp;·&nbsp; Capabilities: @(_view.Capabilities.Count == 0 ? "—" : string.Join(", ", _view.Capabilities))
</p>
<p>
    Airport: <strong>@(_view.AirportIcao ?? "—")</strong>
    &nbsp;·&nbsp; Gate context: <strong>@(_view.GateContextKey ?? "—")</strong>
    &nbsp;·&nbsp; Session: <code>@(_view.StartupSid ?? "—")</code>
</p>

<h2>Arrival gate</h2>
<p>@(_view.GateRequest ?? "No gate request armed.")</p>
<div style="display:flex; gap:0.6rem; align-items:center;">
    <input @bind="_gateInput" placeholder="e.g. B12" style="width:120px;" />
    <button @onclick="ArmGate">Arm gate</button>
    <button @onclick="GateControl.Cancel" style="background:#57606a;">Cancel</button>
</div>

<h2>Departure status board</h2>
<div style="display:flex; gap:0.6rem; align-items:center; margin:0.4rem 0 0.8rem;">
    <button @onclick="DepartureControl.Start" disabled="@DepartureControl.Started" style="margin-top:0;">
        @(DepartureControl.Complete ? "Departure complete" : DepartureControl.Started ? "Departure running" : "Start departure services")
    </button>
    <button @onclick="DepartureControl.ForceNext"
            disabled="@(!DepartureControl.Started || DepartureControl.Complete)"
            style="margin-top:0; background:#9a6700;"
            title="Call the next departure service now, bypassing its activation rule — the INT/RAD smart button. Works on Manual entries too.">
        Call next service now
    </button>
</div>
@if (_view.ServiceBoard.Count == 0)
{
    <p class="hint">No departure sequence evaluated yet.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Service</th><th>Status</th><th>Detail</th></tr>
        </thead>
        <tbody>
            @foreach (var row in _view.ServiceBoard)
            {
                <tr>
                    <td>@row.ServiceId</td>
                    <td><span class="badge @StageClass(row.Stage)">@StageLabel(row.Stage)</span></td>
                    <td>@(row.Detail ?? "")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Services</h2>
@if (_view.Services.Count == 0)
{
    <p class="hint">No services mirrored yet (GSX not connected, or no aircraft/gate context).</p>
}
else
{
    <table>
        <thead>
            <tr><th>Service</th><th>Wire state</th><th>Mapped</th><th>Triggerable</th><th>Progress</th></tr>
        </thead>
        <tbody>
            @foreach (var service in _view.Services.OrderBy(s => s.Id))
            {
                <tr>
                    <td>@service.DisplayName</td>
                    <td><code>@(service.SemanticState ?? "—")</code>@(service.Waiting ? " (waiting)" : "")</td>
                    <td>@service.MappedState</td>
                    <td>@(service.CanTrigger ? "yes" : "no")</td>
                    <td>@(service.ProgressText ?? "")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Menu</h2>
@if (!_view.MenuShown)
{
    <p class="hint">No menu shown (menuShown = false).</p>
}
else
{
    <p><strong>@_view.MenuTitle</strong></p>
    <ol start="0">
        @foreach (var entry in _view.MenuEntries)
        {
            <li><code>@entry</code></li>
        }
    </ol>
}

<h2>Automation decisions</h2>
@if (_view.RecentDecisions.Count == 0)
{
    <p class="hint">No automation decisions yet.</p>
}
else
{
    <table style="font-size:0.85rem;">
        <thead>
            <tr><th>Time</th><th>Action</th><th>Reason</th></tr>
        </thead>
        <tbody>
            @foreach (var decision in _view.RecentDecisions)
            {
                <tr>
                    <td style="white-space:nowrap;">@decision.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                    <td style="white-space:nowrap;">@decision.Action</td>
                    <td>@decision.Reason</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent commands</h2>
@if (_view.RecentCommands.Count == 0)
{
    <p class="hint">No commands sent this session.</p>
}
else
{
    <table style="font-family:Consolas, monospace; font-size:0.85rem;">
        <thead>
            <tr><th>Time</th><th>Verb</th><th>Args</th><th>Result</th></tr>
        </thead>
        <tbody>
            @foreach (var command in _view.RecentCommands)
            {
                <tr>
                    <td style="white-space:nowrap;">@command.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                    <td>@command.Verb</td>
                    <td>@command.Args</td>
                    <td><span class="badge @(command.Ok ? "connected" : "disconnected")">@command.Code</span></td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="hint">
    Full wire frames are captured when <code>logging.wireTrace</code> is enabled — see
    <code>ProsimCompanion-wire-*.log</code> (CMTrace format) next to the main log.
</p>

@code {
    private GsxDiagnosticsSnapshot _view = GsxDiagnosticsSnapshot.Empty;
    private Timer? _timer;
    private string _gateInput = "";

    private void ArmGate()
    {
        if (!string.IsNullOrWhiteSpace(_gateInput))
        {
            GateControl.RequestGate(_gateInput);
        }
    }

    protected override void OnInitialized()
    {
        _view = Diagnostics.Snapshot();
        _timer = new Timer(_ => _ = InvokeAsync(() =>
        {
            _view = Diagnostics.Snapshot();
            StateHasChanged();
        }), null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
    }

    public void Dispose() => _timer?.Dispose();

    private static string ReadinessClass(string readiness) => readiness switch
    {
        "Ready" => "connected",
        "ConnectedGsxNotRunning" => "connecting",
        _ => "disconnected",
    };

    public static string StageLabel(GsxServiceStage stage) => stage switch
    {
        GsxServiceStage.Waiting => "Waiting",
        GsxServiceStage.Held => "Holding",
        GsxServiceStage.Skipped => "Skipped",
        GsxServiceStage.Called => "Called",
        GsxServiceStage.Requested => "Requested",
        GsxServiceStage.Active => "Active",
        GsxServiceStage.Completed => "Completed",
        _ => stage.ToString(),
    };

    public static string StageClass(GsxServiceStage stage) => stage switch
    {
        GsxServiceStage.Completed => "connected",
        GsxServiceStage.Active or GsxServiceStage.Requested or GsxServiceStage.Called => "connecting",
        _ => "disabled",
    };
}
