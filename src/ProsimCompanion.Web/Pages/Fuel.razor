@page "/fuel"
@using System.Globalization
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Core.Aircraft.Ofp
@inherits StoreObserverComponent
@inject IProsimDataRefs DataRefs
@inject OfpStore Ofp
@inject IEfbInitOverrides Overrides
@inject HoldingTimeStore Holding
@inject FuelDecisionStore Decision
@inject DisplayUnitService Units
@inject IStringLocalizer T
@using ProsimCompanion.Core.Fuel

@* Markup and styling ported from Prosim2GSX's web FuelPanel (FuelPanel.tsx /
   FuelPanel.module.css); dataref plumbing is ProsimCompanion's own. *@

<PageTitle>@T["fuel.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["fuel.heading"]</h1>

@{
    var inTanks = _fuelTotal.Value;
    // The planned figure is the same one the GSX refuel loads (2026-09-19): the INIT FUEL
    // RAMP override first, then the OFP, then the EFB planned fuel.
    var figure = EffectiveBlockFuel.Resolve(Overrides.Snapshot(), Ofp.Current, _plannedFuel.Value);
    var planned = figure.Kg;
    var plannedLabel = figure.Source == BlockFuelSource.Override ? T["fuel.summary.plannedInitModCaps"].Value : T["fuel.summary.plannedCaps"].Value;
    var capacity = TotalCapacityKg();
    var delta = inTanks - planned;
}

@* Layout (ADR-0011): Fuel Summary and Tank Breakdown as two glass cards side by side; the
   in-tanks figure is the hero number. The green/amber/red state bands are unchanged. *@
<div class="fuel-page">

    @* ── FUEL SUMMARY ───────────────────────────────────────── *@
    <section class="section fuel-card">
        <div class="section-header">
            <h3 class="section-title">@T["fuel.summary.title"]</h3>
            <span class="section-hint">@T["fuel.summary.hint", FmtW(capacity), UnitU, SpecificGravity.ToString("F2", CultureInfo.InvariantCulture)]</span>
        </div>
        <div class="section-body fuel-body">
        <div class="fuel-hero">
            <span class="label-caps">@T["fuel.summary.inTanks"]</span>
            <span class="figure figure-xl glow">@FmtW(inTanks)<span class="figure-unit">@UnitU</span></span>
        </div>

        <div class="fuel-capacity-bar" role="img" aria-label="@T["fuel.summary.capacityAria", Units.FromKg(inTanks).ToString("F0", CultureInfo.InvariantCulture), Units.FromKg(capacity).ToString("F0", CultureInfo.InvariantCulture), Units.UnitLabel]">
            <div class="fuel-capacity-fill @CapacityClass(delta, planned)"
                 style="width:@PercentCss(inTanks, capacity)"></div>
            <span class="fuel-capacity-label">@FmtW(inTanks) / @FmtW(capacity) @UnitU</span>
        </div>

        <div class="fuel-summary-grid">
            <div class="fuel-summary-header">@plannedLabel (@UnitU)</div>
            <div class="fuel-summary-header">@T["fuel.summary.inTanksCaps"] (@UnitU)</div>
            <div class="fuel-summary-value">@FmtW(planned)</div>
            <div class="fuel-summary-value">@FmtW(inTanks)</div>

            <div class="fuel-summary-header">@T["fuel.summary.plannedCaps"] (L)</div>
            <div class="fuel-summary-header">@T["fuel.summary.inTanksCaps"] (L)</div>
            <div class="fuel-summary-value">@FmtNum(planned / SpecificGravity)</div>
            <div class="fuel-summary-value">@FmtNum(inTanks / SpecificGravity)</div>
        </div>

        <div class="fuel-delta-row inset @DeltaClass(delta, planned)">
            <span class="fuel-delta-label label-caps">@T["fuel.delta.label"]</span>
            <span class="fuel-delta-value">
                @(planned > 0 ? $"{(delta >= 0 ? "+" : "")}{FmtW(delta)} {UnitU}" : T["fuel.delta.noFlightPlan"].Value)
            </span>
            @if (planned > 0)
            {
                <span class="fuel-delta-tag">@DeltaTag(delta)</span>
            }
        </div>
        </div>
    </section>

    @* ── TANK BREAKDOWN ─────────────────────────────────────── *@
    @* Order matches the airframe layout (left to right, looking from behind
       the aircraft): outer wing → inner wing → centre → inner → outer.
       Rendered top-to-bottom for readability. *@
    <section class="section fuel-card">
        <div class="section-header">
            <h3 class="section-title">@T["fuel.tanks.title"]</h3>
            <span class="section-hint">@T["fuel.tanks.hint"]</span>
        </div>
        <div class="section-body fuel-body">
        @foreach (var tank in Tanks())
        {
            <div class="fuel-tank-row">
                <div class="fuel-tank-label">@tank.Name</div>
                <div class="fuel-tank-bar" role="img"
                     aria-label="@T["fuel.tanks.aria", tank.Name, Units.FromKg(tank.AmountKg).ToString("F0", CultureInfo.InvariantCulture), Units.FromKg(tank.CapacityKg).ToString("F0", CultureInfo.InvariantCulture), Units.UnitLabel]">
                    <div class="fuel-tank-fill"
                         style="width:@(tank.Percent.ToString("F1", CultureInfo.InvariantCulture))%"></div>
                </div>
                <div class="fuel-tank-value">@FmtW(tank.AmountKg) / @FmtW(tank.CapacityKg) @UnitU</div>
            </div>
        }
        </div>
    </section>

    @* ── FUEL PLAN BREAKDOWN + HOLDING (issue #183) ─────────────────────── *@
    @if (Ofp.Current is { } plan && (plan.FuelTripKg > 0 || plan.FuelFinalReserveKg > 0 || plan.FuelPlanRampKg > 0))
    {
        <section class="section fuel-card">
            <div class="section-header">
                <h3 class="section-title">@T["fuel.plan.title"]</h3>
                <span class="section-hint">@T["fuel.plan.hint", FmtW(inTanks), UnitU]</span>
            </div>
            <div class="section-body fuel-body">
                <div class="fuel-plan-grid">
                    @foreach (var row in PlanRows(plan))
                    {
                        <div class="fuel-plan-label">@row.Label</div>
                        <div class="fuel-plan-value">@FmtW(row.Kg) @UnitU</div>
                    }
                </div>
                @if (_holding is { } holding)
                {
                    <div class="fuel-delta-row inset @(holding.DivertNow ? "fuel-delta-red" : holding.AvailableMinutes < 15 ? "fuel-delta-amber" : "fuel-delta-green")">
                        <span class="fuel-delta-label label-caps">@T["fuel.plan.holding"]</span>
                        <span class="fuel-delta-value">@HoldingTimeCalculator.Figure(holding)</span>
                        <span class="fuel-delta-tag">@T["fuel.plan.holdingDetail", FmtW(Math.Max(0, holding.HoldingFuelKg)), UnitU, holding.AtUtc.ToLocalTime().ToString("HH:mm")]</span>
                    </div>
                }
                @if (_decision?.Advice is { } advice)
                {
                    <div class="fuel-plan-advice">
                        <span class="label-caps">@T["fuel.plan.advice"]</span>
                        <span>@FuelDecisionAdvisor.Spoken(advice)</span>
                        @if (_decision.AppliedExtraKg is { } applied)
                        {
                            <span class="fuel-delta-tag">@T["fuel.plan.applied", FmtW(applied), UnitU]</span>
                        }
                    </div>
                }
            </div>
        </section>
    }

</div>

@code {
    private Core.Fuel.HoldingEstimate? _holding;
    private FuelDecisionSnapshot? _decision;

    private sealed record PlanRow(string Label, double Kg);

    /// <summary>The SimBrief breakdown, zero rows left out.</summary>
    private IEnumerable<PlanRow> PlanRows(OfpData plan)
    {
        var rows = new (string Id, double Kg)[]
        {
            ("fuel.plan.taxi", plan.FuelTaxiKg), ("fuel.plan.trip", plan.FuelTripKg), ("fuel.plan.contingency", plan.FuelContingencyKg),
            ("fuel.plan.alternate", plan.FuelAlternateKg), ("fuel.plan.finalReserve", plan.FuelFinalReserveKg),
            ("fuel.plan.plannedHolding", plan.FuelHoldingKg), ("fuel.plan.extra", plan.FuelExtraKg),
            ("fuel.plan.discretionary", plan.FuelDiscretionaryKg), ("fuel.plan.block", plan.FuelPlanRampKg),
        };
        foreach (var (id, kg) in rows)
        {
            if (kg > 0)
            {
                yield return new PlanRow(T[id].Value, kg);
            }
        }
    }

    // Prosim2GSX's Fuel tab convention: litres derived at SG 0.80.
    private const double SpecificGravity = 0.80;

    // Capacity-bar colour bands (Prosim2GSX FuelPanel). Wider tolerance than
    // the delta indicator because the bar shows physical fuel quantity
    // (100 kg over plan is fine to look "green"); the delta indicator is the
    // operator-facing alert.
    private const double CapacityOverAmberKg = 200;
    private const double CapacityUnderRedKg = 100;

    // Delta-indicator colour bands. Tighter — any overage above the spec's
    // 100 kg threshold flips the indicator amber so the operator catches it.
    private const double DeltaAmberKg = 100;
    private const double DeltaRedKg = 100;

    private IDataRefSubscription<double> _fuelTotal = default!;
    private IDataRefSubscription<double> _fuelCenter = default!;
    private IDataRefSubscription<double> _fuelCenterCap = default!;
    private IDataRefSubscription<double> _fuelLeftInner = default!;
    private IDataRefSubscription<double> _fuelLeftInnerCap = default!;
    private IDataRefSubscription<double> _fuelLeftOuter = default!;
    private IDataRefSubscription<double> _fuelLeftOuterCap = default!;
    private IDataRefSubscription<double> _fuelRightInner = default!;
    private IDataRefSubscription<double> _fuelRightInnerCap = default!;
    private IDataRefSubscription<double> _fuelRightOuter = default!;
    private IDataRefSubscription<double> _fuelRightOuterCap = default!;
    private IDataRefSubscription<double> _plannedFuel = default!;
    private Timer? _refresh;

    private sealed record TankRow(string Name, double AmountKg, double CapacityKg)
    {
        public double Percent => CapacityKg > 0 ? Math.Clamp(AmountKg / CapacityKg * 100.0, 0, 100) : 0;
    }

    protected override void OnInitialized()
    {
        _fuelTotal = DataRefs.Subscribe(ProsimDataRefNames.FuelTotal);
        _fuelCenter = DataRefs.Subscribe(ProsimDataRefNames.FuelCenter);
        _fuelCenterCap = DataRefs.Subscribe(ProsimDataRefNames.FuelCenterCapacity);
        _fuelLeftInner = DataRefs.Subscribe(ProsimDataRefNames.FuelLeftInner);
        _fuelLeftInnerCap = DataRefs.Subscribe(ProsimDataRefNames.FuelLeftInnerCapacity);
        _fuelLeftOuter = DataRefs.Subscribe(ProsimDataRefNames.FuelLeftOuter);
        _fuelLeftOuterCap = DataRefs.Subscribe(ProsimDataRefNames.FuelLeftOuterCapacity);
        _fuelRightInner = DataRefs.Subscribe(ProsimDataRefNames.FuelRightInner);
        _fuelRightInnerCap = DataRefs.Subscribe(ProsimDataRefNames.FuelRightInnerCapacity);
        _fuelRightOuter = DataRefs.Subscribe(ProsimDataRefNames.FuelRightOuter);
        _fuelRightOuterCap = DataRefs.Subscribe(ProsimDataRefNames.FuelRightOuterCapacity);
        _plannedFuel = DataRefs.Subscribe(ProsimDataRefNames.EfbPlannedFuel);

        WatchChanged(h => Units.Changed += h, h => Units.Changed -= h, () => { });
        WatchChanged(h => Overrides.Changed += h, h => Overrides.Changed -= h, () => { });
        WatchChanged(h => Ofp.Changed += h, h => Ofp.Changed -= h, () => { });
        Watch(Holding, estimate => _holding = estimate);
        Watch(Decision, snapshot => _decision = snapshot);

        // Live instrument view — a 1 s repaint matches the datarefs' Normal cadence.
        _refresh = new Timer(_ => _ = InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public override void Dispose()
    {
        base.Dispose();
        _refresh?.Dispose();
        foreach (var sub in new[]
        {
            _fuelTotal, _fuelCenter, _fuelCenterCap, _fuelLeftInner, _fuelLeftInnerCap,
            _fuelLeftOuter, _fuelLeftOuterCap, _fuelRightInner, _fuelRightInnerCap,
            _fuelRightOuter, _fuelRightOuterCap, _plannedFuel,
        })
        {
            sub.Dispose();
        }
    }

    private double TotalCapacityKg()
        => _fuelCenterCap.Value
            + _fuelLeftInnerCap.Value + _fuelLeftOuterCap.Value
            + _fuelRightInnerCap.Value + _fuelRightOuterCap.Value;

    private IEnumerable<TankRow> Tanks()
    {
        // Airframe order, matching Prosim2GSX's Fuel tab.
        yield return new TankRow(T["fuel.tanks.leftOuter"], _fuelLeftOuter.Value, _fuelLeftOuterCap.Value);
        yield return new TankRow(T["fuel.tanks.leftInner"], _fuelLeftInner.Value, _fuelLeftInnerCap.Value);
        yield return new TankRow(T["fuel.tanks.centre"], _fuelCenter.Value, _fuelCenterCap.Value);
        yield return new TankRow(T["fuel.tanks.rightInner"], _fuelRightInner.Value, _fuelRightInnerCap.Value);
        yield return new TankRow(T["fuel.tanks.rightOuter"], _fuelRightOuter.Value, _fuelRightOuterCap.Value);
    }

    // Uppercase unit label for the panel's all-caps typography ("KG" / "LB").
    private string UnitU => Units.UnitLabel.ToUpperInvariant();

    // Prosim2GSX's fmtKg convention (locale-grouped, no decimals), converted
    // to the display unit. Litres stay litres — SG applies to kg, so litres
    // are always derived from the kg figure via FmtNum below.
    private string FmtW(double kg) => Units.FromKg(kg).ToString("N0", CultureInfo.InvariantCulture);

    private static string FmtNum(double n) => n.ToString("N0", CultureInfo.InvariantCulture);

    private static string PercentCss(double amount, double capacity)
        // Clamped — if the dataref ever overshoots capacity (refuel target
        // above usable, simulator quirk), the bar caps at 100% rather than
        // blowing the layout.
        => (capacity > 0 ? Math.Clamp(amount / capacity * 100.0, 0, 100) : 0)
            .ToString("F1", CultureInfo.InvariantCulture) + "%";

    // Capacity-bar colour. Only meaningful when a plan exists; with no plan
    // the bar stays neutral (slate-blue) so the panel doesn't mislead by
    // showing red/amber for a deliberately empty aircraft.
    private static string CapacityClass(double delta, double planned) => planned <= 0
        ? "fuel-capacity-fill-neutral"
        : delta > CapacityOverAmberKg ? "fuel-capacity-fill-amber"
        : delta < -CapacityUnderRedKg ? "fuel-capacity-fill-red"
        : "fuel-capacity-fill-green";

    // Delta-row colour. Same suppression rule — no plan means no delta to
    // colour-code.
    private static string DeltaClass(double delta, double planned) => planned <= 0
        ? "fuel-delta-neutral"
        : delta > DeltaAmberKg ? "fuel-delta-amber"
        : delta < -DeltaRedKg ? "fuel-delta-red"
        : "fuel-delta-green";

    private string DeltaTag(double delta) =>
        delta > DeltaAmberKg ? T["fuel.delta.over"].Value : delta < -DeltaRedKg ? T["fuel.delta.under"].Value : T["fuel.delta.ok"].Value;
}
