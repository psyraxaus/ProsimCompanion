@page "/settings"
@using System.Text.Json.Nodes
@using Microsoft.Extensions.Options
@using ProsimCompanion.Core.Configuration
@inject IOptionsMonitor<ProsimOptions> ProsimMonitor
@inject IOptionsMonitor<WebUiOptions> WebUiMonitor
@inject IOptionsMonitor<GsxOptions> GsxMonitor
@inject JsonSettingsFile SettingsFile

<h1>Settings</h1>

<EditForm Model="this" OnValidSubmit="Save" FormName="settings">
    <h2>ProSim</h2>

    <label for="prosim-host">Host</label>
    <InputText id="prosim-host" @bind-Value="ProsimHost" />
    <div class="hint">Hostname or IP of the machine running ProSim System.</div>

    <label for="prosim-sdk">SDK path</label>
    <InputText id="prosim-sdk" @bind-Value="ProsimSdkPath" />
    <div class="hint">Folder containing ProSimSDK.dll (loaded at runtime, never bundled).</div>

    <h2>Web UI</h2>

    <label for="web-port">Port</label>
    <InputNumber id="web-port" @bind-Value="WebPort" />
    <div class="hint">Takes effect after restarting the application.</div>

    <h2>GSX departure services</h2>
    <div class="hint" style="max-width:640px;">
        Row order is the call order. Each service's <strong>activation</strong> gates it on the
        service before it: <em>Previous called</em> runs services side by side (the next call
        goes out as soon as GSX confirms the previous one), <em>Previous completed</em> is a
        strict chain, <em>All earlier completed</em> is the classic board-last barrier, and
        <em>Manual</em> waits for you (INT/RAD, the GSX menu, or the button on the GSX page).
        The first callable row always starts immediately. Changes apply from the next
        sequencing evaluation — safe to edit between flights, best not mid-departure.
    </div>

    <table style="margin-top:0.8rem;">
        <thead>
            <tr><th>#</th><th>Service</th><th>Activation</th><th>Runs on</th><th></th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < DepartureServices.Count; i++)
            {
                var index = i;
                var row = DepartureServices[index];
                <tr>
                    <td>@(index + 1)</td>
                    <td>
                        <select @bind="row.Service">
                            @foreach (var id in ServiceIds)
                            {
                                <option value="@id">@id</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select @bind="row.Activation">
                            @foreach (var (value, label) in ActivationLabels)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select @bind="row.Constraint">
                            @foreach (var (value, label) in ConstraintLabels)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </td>
                    <td style="white-space:nowrap;">
                        <button type="button" class="row-btn" disabled="@(index == 0)" title="Move up"
                                @onclick="() => Move(index, -1)">▲</button>
                        <button type="button" class="row-btn" disabled="@(index == DepartureServices.Count - 1)" title="Move down"
                                @onclick="() => Move(index, +1)">▼</button>
                        <button type="button" class="row-btn" style="background:#cf222e;" title="Remove"
                                @onclick="() => DepartureServices.RemoveAt(index)">✕</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="button" class="row-btn" style="margin-top:0.5rem;" @onclick="AddService">Add service</button>

    <div>
        <button type="submit">Save</button>
    </div>

    @if (_saved)
    {
        <p role="status">Settings saved to @SettingsFile.Path</p>
    }
</EditForm>

<style>
    select {
        margin-top: 0.25rem;
        padding: 0.35rem 0.4rem;
        border: 1px solid color-mix(in srgb, CanvasText 30%, transparent);
        border-radius: 6px;
        background: Field;
        color: FieldText;
    }
    .row-btn {
        margin-top: 0;
        padding: 0.3rem 0.6rem;
        background: #57606a;
    }
    .row-btn:disabled { opacity: 0.4; cursor: default; }
</style>

@code {
    private bool _saved;

    private static readonly string[] ServiceIds =
        ["Refueling", "Catering", "Water", "Lavatory", "Cleaning", "Boarding", "GPU", "DeIce"];

    private static readonly (GsxServiceActivation Value, string Label)[] ActivationLabels =
    [
        (GsxServiceActivation.Skip, "Skip / ignore"),
        (GsxServiceActivation.Manual, "Manual by user"),
        (GsxServiceActivation.AfterCalled, "Previous called"),
        (GsxServiceActivation.AfterRequested, "Previous requested"),
        (GsxServiceActivation.AfterActive, "Previous active"),
        (GsxServiceActivation.AfterPrevCompleted, "Previous completed"),
        (GsxServiceActivation.AfterAllCompleted, "All earlier completed"),
    ];

    private static readonly (GsxServiceConstraint Value, string Label)[] ConstraintLabels =
    [
        (GsxServiceConstraint.Always, "Every leg"),
        (GsxServiceConstraint.FirstLeg, "First leg only"),
        (GsxServiceConstraint.TurnAround, "Turnarounds only"),
    ];

    public string ProsimHost { get; set; } = "";

    public string ProsimSdkPath { get; set; } = "";

    public int WebPort { get; set; }

    public List<DepartureServiceStep> DepartureServices { get; set; } = [];

    protected override void OnInitialized()
    {
        var prosim = ProsimMonitor.CurrentValue;
        ProsimHost = prosim.Host;
        ProsimSdkPath = prosim.SdkPath;
        WebPort = WebUiMonitor.CurrentValue.Port;
        // Editable copies — the options instances are shared with the running automation.
        DepartureServices = GsxMonitor.CurrentValue.DepartureServices
            .Select(step => new DepartureServiceStep(step.Service, step.Activation, step.Constraint))
            .ToList();
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= DepartureServices.Count)
        {
            return;
        }
        (DepartureServices[index], DepartureServices[target]) = (DepartureServices[target], DepartureServices[index]);
    }

    private void AddService() => DepartureServices.Add(new DepartureServiceStep(
        ServiceIds.FirstOrDefault(id => !DepartureServices.Any(s => s.Service.Equals(id, StringComparison.OrdinalIgnoreCase)))
            ?? ServiceIds[0],
        GsxServiceActivation.Manual));

    private void Save()
    {
        SettingsFile.Update(root =>
        {
            var prosim = JsonSettingsFile.GetOrCreateSection(root, ProsimOptions.SectionName);
            prosim["host"] = ProsimHost;
            prosim["sdkPath"] = ProsimSdkPath;

            var webUi = JsonSettingsFile.GetOrCreateSection(root, WebUiOptions.SectionName);
            webUi["port"] = WebPort;

            var gsx = JsonSettingsFile.GetOrCreateSection(root, GsxOptions.SectionName);
            var steps = new JsonArray();
            foreach (var step in DepartureServices.Where(s => !string.IsNullOrWhiteSpace(s.Service)))
            {
                steps.Add(new JsonObject
                {
                    ["service"] = step.Service,
                    ["activation"] = System.Text.Json.JsonNamingPolicy.CamelCase.ConvertName(step.Activation.ToString()),
                    ["constraint"] = System.Text.Json.JsonNamingPolicy.CamelCase.ConvertName(step.Constraint.ToString()),
                });
            }
            gsx["departureServices"] = steps;
        });
        _saved = true;
    }
}
