    /// <summary>Empty-value default first, then every detected device; a saved device that is
    /// not currently detected (unplugged, renamed) stays selectable so opening the page never
    /// silently rewrites the setting.</summary>
    private IReadOnlyList<(string, string)> DeviceOptions(
        string defaultLabel, IReadOnlyList<string> devices, string current)
    {
        var options = new List<(string, string)> { ("", defaultLabel) };
        foreach (var name in devices)
        {
            options.Add((name, name));
        }

        if (!string.IsNullOrWhiteSpace(current)
            && !devices.Contains(current, StringComparer.OrdinalIgnoreCase))
        {
            options.Add((current, T["speechSettings.devices.notDetected", current].Value));
        }

        return options;
    }

    private IReadOnlyList<JoystickDeviceView> _joysticks = [];
    /// <summary>Set listens for joystick buttons only when this is ticked: the winmm joystick
    /// layer crashed the app on 2026-10-11 from this page's own device listing, so the page
    /// touches it only on the pilot's say-so. Defaults to on when a binding already names a
    /// joystick.</summary>
    private bool _listenJoysticks;
    private bool _scanning;
    private string? _scanMessage;
    private string? _capturing;
    private string? _captureMessage;

    /// <summary>"Key: capslock" / "VIRPIL Constellation — button 3" / "(unset)".</summary>
    private string BindingText(PttBindingOptions binding)
    {
        if (!binding.IsSet)
        {
            return T["speechSettings.binding.unset"];
        }

        if (binding.Kind.Equals("keyboard", StringComparison.OrdinalIgnoreCase))
        {
            return T["speechSettings.binding.keyboard", binding.Key];
        }

        var device = string.IsNullOrWhiteSpace(binding.JoystickDeviceName)
            ? T["speechSettings.binding.joystick", binding.JoystickDevice ?? 0].Value
            : binding.JoystickDeviceName;
        return T["speechSettings.binding.button", device, binding.Button ?? 0];
    }

    /// <summary>Prosim2FO's Set process: capture the next key OR button and assign the whole
    /// binding, whichever the user presses first. Mutates the draft's typed binding, so the
    /// dirty bar reflects the capture automatically.</summary>
    private async Task SetBindingAsync(string target)
    {
        _capturing = target;
        _captureMessage = null;
        try
        {
            var result = await PttCapture.CaptureAsync(
                includeJoysticks: _listenJoysticks, TimeSpan.FromSeconds(10), CancellationToken.None);
            if (result is null)
            {
                _captureMessage = T["speechSettings.capture.nothingPressed"];
                return;
            }

            var binding = target == "atc" ? _speech.Value.AtcMuteBinding : _speech.Value.PttBinding;
            if (result.IsJoystick)
            {
                _joysticks = await PttCapture.ScanJoysticksAsync(CancellationToken.None); // the pressed device is connected — relist
                binding.Kind = "joystickButton";
                binding.Key = "";
                binding.JoystickDevice = result.JoystickId;
                binding.JoystickDeviceName = _joysticks.FirstOrDefault(j => j.Id == result.JoystickId)?.Name ?? "";
                binding.Button = result.JoystickButton;
            }
            else
            {
                binding.Kind = "keyboard";
                binding.Key = result.KeyName ?? "";
                binding.JoystickDevice = null;
                binding.JoystickDeviceName = "";
                binding.Button = null;
            }

            _captureMessage = T["speechSettings.capture.bound",
                target == "atc" ? T["speechSettings.capture.atcPtt"].Value : T["speechSettings.capture.foPtt"].Value,
                BindingText(binding)];
        }
        catch (Exception)
        {
            _captureMessage = T["speechSettings.capture.failed"];
        }
        finally
        {
            _capturing = null;
        }
    }

    private static bool IsJoystick(PttBindingOptions binding)
        => binding.IsSet && binding.Kind.Equals("joystickButton", StringComparison.OrdinalIgnoreCase);

    private async Task ScanJoysticksAsync()
    {
        _scanning = true;
        _scanMessage = T["speechSettings.scan.scanning"];
        try
        {
            _joysticks = await PttCapture.ScanJoysticksAsync(CancellationToken.None);
            _scanMessage = _joysticks.Count == 0
                ? T["speechSettings.scan.none"].Value
                : T["speechSettings.scan.found", string.Join(", ", _joysticks.Select(j => $"{j.Name} (id {j.Id})"))].Value;
        }
        catch (Exception)
        {
            _scanMessage = T["speechSettings.scan.failed"];
        }
        finally
        {
            _scanning = false;
        }
    }

    private void ClearBinding(PttBindingOptions binding)
    {
        binding.Kind = "";
        binding.Key = "";
        binding.JoystickDevice = null;
        binding.JoystickDeviceName = "";
        binding.Button = null;
        _captureMessage = null;
    }

    /// <summary>One-way migration: pre-binding configs carried flat key/joystick fields; the
    /// first page load synthesizes bindings from them (joystick wins when both were set —
    /// hardware buttons were the deliberate choice). The synthesized binding dirties the
    /// draft, so the bar prompts for the save that persists it; the legacy keys are blanked
    /// at save time in <see cref="OnBeforeSave"/>.</summary>
    private static void MigrateLegacyBindings(SpeechOptions draft)
    {
        if (!draft.PttBinding.IsSet)
        {
            if (draft.PttJoystickButton is not null)
            {
                draft.PttBinding = new PttBindingOptions
                {
                    Kind = "joystickButton",
                    JoystickDevice = draft.PttJoystickDevice,
                    JoystickDeviceName = draft.PttJoystickDeviceName,
                    Button = draft.PttJoystickButton,
                };
            }
            else if (!string.IsNullOrWhiteSpace(draft.PttKey))
            {
                draft.PttBinding = new PttBindingOptions { Kind = "keyboard", Key = draft.PttKey.Trim() };
            }
        }

        if (!draft.AtcMuteBinding.IsSet)
        {
            if (draft.AtcMuteJoystickButton is not null)
            {
                draft.AtcMuteBinding = new PttBindingOptions
                {
                    Kind = "joystickButton",
                    JoystickDevice = draft.AtcMuteJoystickDevice,
                    JoystickDeviceName = draft.AtcMuteJoystickDeviceName,
                    Button = draft.AtcMuteJoystickButton,
                };
            }
            else if (!string.IsNullOrWhiteSpace(draft.AtcMuteKey))
            {
                draft.AtcMuteBinding = new PttBindingOptions { Kind = "keyboard", Key = draft.AtcMuteKey.Trim() };
            }
        }
    }

