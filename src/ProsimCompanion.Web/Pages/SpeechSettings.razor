@page "/settings/speech"
@page "/speech"
@using System.Text.Json
@using System.Text.Json.Serialization
@implements IDisposable
@inject IOptionsMonitor<SpeechOptions> SpeechMonitor
@inject IOptionsMonitor<BriefingOptions> BriefingMonitor
@inject JsonSettingsFile SettingsFile
@inject IAudioDeviceCatalog DeviceCatalog
@inject IPttInputCapture PttCapture

<PageTitle>First Officer — ProsimCompanion</PageTitle>
<h1 class="sr-only">First Officer</h1>

<div class="settings-panel" style="padding-bottom:96px;">
    <div class="settings-body">
        <div class="rail-column">
            <div class="rail-header"><span class="rail-header-context">First Officer</span></div>
            <nav class="rail-nav sticky-rail">
                @foreach (var (key, label) in Sections)
                {
                    <button type="button" class="rail-item @(_section == key ? "active" : null)"
                            @onclick="() => _section = key">@label</button>
                }
            </nav>
        </div>
        <div class="settings-content">

            @if (_section == "status")
            {
                <SpeechStatusPanel />
            }
            else if (_section == "general")
            {
                <Section Title="Voice First Officer" Hint="TTS chain: Kokoro → Google → WinRT → SAPI5">
                    <BoolField Label="Enabled"
                               Hint="Master switch for the speech pillar — arbiter, TTS and playback"
                               @bind-Value="_draft.Enabled" />
                    <BoolField Label="Local only"
                               Hint="Hard mode: network providers (Kokoro, Google) are excluded from every path — synthesis never leaves this machine"
                               @bind-Value="_draft.LocalOnly" />
                </Section>

                <Section Title="Playback">
                    <SelectField Label="Output device"
                                 Options="OutputDeviceOptions()"
                                 Hint="Playback devices found on this machine; System default follows Windows"
                                 @bind-Value="_draft.OutputDevice" />
                    <NumberField Label="Volume" Suffix="%" Min="0" Max="100"
                                 Hint="Applied client-side, so it works for every provider"
                                 @bind-Value="_draft.Volume" />
                    <BoolField Label="Intercom filter"
                               Hint="300–3000 Hz band-pass + soft clip so the FO sounds like a headset, not a narrator"
                               @bind-Value="_draft.IntercomFilter" />
                </Section>
            }
            else if (_section == "recognition")
            {
                <Section Title="Recognition & Push-to-Talk"
                         Hint="How the FO listens. On a network (VATSIM/IVAO/SayIntentions) bind YOUR transmit key as the ATC-mute key so the FO never hears what you say to ATC">
                    <SelectField Label="Listening mode" Options="RecognitionModeOptions"
                                 Hint="Push-to-talk: the FO listens only while the FO PTT is held — use a DIFFERENT key/button than your ATC transmit. Continuous: the FO listens whenever a command window is open, except while the ATC-mute key is held"
                                 @bind-Value="_draft.RecognitionMode" />
                    <TextField Label="FO push-to-talk key"
                               Hint="Key name (e.g. capslock, F13, rightctrl) or decimal VK code; empty = unbound. Never your ATC PTT — this one talks to the First Officer"
                               @bind-Value="_draft.PttKey" />
                    <SelectField Label="FO PTT joystick device" Options="@JoystickOptions(_draft.PttJoystickDevice, _draft.PttJoystickDeviceName)"
                                 Hint="Controllers detected on this machine (sticks, yokes, HOTAS) — bound by device name, so re-plugged hardware keeps working"
                                 @bind-Value="FoJoystickDeviceKey" />
                    <NumberField Label="FO PTT joystick button" Min="-1" Max="31"
                                 Hint="Button index 0–31 on that device; −1 = unbound. Detect below fills this for you"
                                 @bind-Value="PttJoystickButtonDraft" />
                    <TextField Label="ATC-mute key"
                               Hint="Bind the SAME key you transmit to ATC with — while held, the FO ignores everything it hears (works in both modes)"
                               @bind-Value="_draft.AtcMuteKey" />
                    <SelectField Label="ATC-mute joystick device" Options="@JoystickOptions(_draft.AtcMuteJoystickDevice, _draft.AtcMuteJoystickDeviceName)"
                                 Hint="If you transmit to ATC with a stick/yoke button instead of a key, bind that button here"
                                 @bind-Value="AtcJoystickDeviceKey" />
                    <NumberField Label="ATC-mute joystick button" Min="-1" Max="31"
                                 Hint="Button index 0–31 on that device; −1 = unbound"
                                 @bind-Value="AtcMuteJoystickButtonDraft" />
                    <div style="margin:8px 0;">
                        <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                                @onclick='() => DetectAsync("fo")'>
                            @(_capturing == "fo" ? "Press the key or button now…" : "Detect FO PTT")
                        </button>
                        <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                                @onclick='() => DetectAsync("atc")'>
                            @(_capturing == "atc" ? "Press the key or button now…" : "Detect ATC-mute")
                        </button>
                        @if (_captureMessage is not null)
                        {
                            <span class="field-hint" style="margin-left:8px;">@_captureMessage</span>
                        }
                    </div>
                    <div class="field-hint" style="max-width:640px;">
                        Detect listens for ten seconds and binds whatever you press — a keyboard
                        key or any joystick button, for either binding. Remember to save afterwards.
                    </div>
                    <TextField Label="LAN faster-whisper URL"
                               Hint="e.g. http://192.168.1.50:8000 — empty uses the offline System.Speech engine"
                               @bind-Value="_draft.AsrBaseUrl" />
                    <SelectField Label="Input device"
                                 Options="InputDeviceOptions()"
                                 Hint="Microphones found on this machine; Default follows the Windows capture device"
                                 @bind-Value="_draft.InputDevice" />
                </Section>
            }
            else if (_section == "sterile")
            {
                <Section Title="Sterile Cockpit" Hint="Workload phases below the ceiling gate non-essential speech">
                    <BoolField Label="Enabled" @bind-Value="_draft.SterileEnabled" />
                    <NumberField Label="Ceiling" Suffix="ft MSL" Min="1000"
                                 Hint="Sterile in InitialClimb/Climb/Descent/Approach below this altitude; cruise and ground phases are never sterile"
                                 @bind-Value="_draft.SterileCockpitCeilingFt" />
                    <BoolField Label="Drop Low-priority speech"
                               Hint="Advisories are discarded while sterile (never replayed)"
                               @bind-Value="_draft.SterileSuppressLow" />
                    <SelectField Label="Normal-priority policy" Options="NormalPolicyOptions"
                                 Hint="Allow is the safe default — Normal carries checklists and briefings, which are required during a low-altitude approach"
                                 @bind-Value="NormalPolicyKey" />
                    <BoolField Label="Exempt cabin reports"
                               Hint="cabin.*-tagged speech passes while sterile — cabin-ready calls below the ceiling are operationally expected"
                               @bind-Value="_draft.SterileExemptCabinReports" />
                </Section>
            }
            else if (_section == "kokoro")
            {
                <Section Title="Kokoro (local neural TTS)" Hint="A kokoro-fastapi instance on this machine or the LAN">
                    <TextField Label="Base URL"
                               Hint="e.g. http://192.168.1.50:8880 — empty disables the provider"
                               @bind-Value="_draft.KokoroBaseUrl" />
                    <TextField Label="Model" @bind-Value="_draft.KokoroModel" />
                    <TextField Label="Voice" Hint="e.g. bm_george" @bind-Value="_draft.KokoroVoice" />
                    <NumberField Label="Timeout" Suffix="ms" Min="200"
                                 Hint="Kept tight on purpose — a sleeping host falls through to the next provider instead of stalling a callout"
                                 @bind-Value="_draft.KokoroTimeoutMs" />
                    <NumberField Label="Cache cap per voice" Suffix="MB" Min="0"
                                 Hint="0 = unlimited"
                                 @bind-Value="_draft.KokoroMaxCacheMbPerVoice" />
                </Section>
            }
            else if (_section == "google")
            {
                <Section Title="Google Cloud TTS (Chirp 3 HD)" Hint="Paid neural voices — cached and budget-guarded">
                    <TextField Label="Service-account key file"
                               Hint="Path to the JSON key; empty disables the provider. The key is never logged"
                               @bind-Value="_draft.GoogleKeyFilePath" />
                    <TextField Label="Voice" Hint="e.g. en-AU-Chirp3-HD-Charon" @bind-Value="_draft.GoogleVoice" />
                    <NumberField Label="Monthly character budget" Min="0"
                                 Hint="Synthesis stops for the month at this figure and falls through to offline voices (free tier is 1,000,000). 0 disables enforcement"
                                 @bind-Value="_draft.GoogleMonthlyCharBudget" />
                </Section>
            }
            else if (_section == "briefing")
            {
                <Section Title="Briefings" Hint="Departure/arrival briefings composed from nav data + weather; the deterministic template is always the floor">
                    <SelectField Label="Procedure source" Options="ProcedureSourceOptions"
                                 Hint="Auto walks FMS plan → SayIntentions flight.json → the manual entries below, per field"
                                 @bind-Value="ProcedureSourceKey" />
                    <BoolField Label="Verify numbers in LLM output"
                               Hint="Every figure the LLM writes is checked against the source facts; a failed retry falls back to the template"
                               @bind-Value="_briefingDraft.VerifyNumbers" />
                    <div class="field-hint" style="max-width:640px;">
                        The Navigraph DFD database path lives on App Settings → Nav Data.
                    </div>
                </Section>

                <Section Title="Manual Procedure Overrides" Hint="Used when the FMS/flight.json tiers can't resolve a field (or always, in Manual mode)">
                    <TextField Label="Departure airport" Hint="ICAO, e.g. YSSY" @bind-Value="_briefingDraft.DepartureAirport" />
                    <TextField Label="Departure runway" Hint="e.g. 16R" @bind-Value="_briefingDraft.DepartureRunway" />
                    <TextField Label="SID" Hint="Identifier, e.g. FISHA1" @bind-Value="_briefingDraft.DepartureSid" />
                    <TextField Label="Arrival airport" Hint="ICAO, e.g. YMML" @bind-Value="_briefingDraft.ArrivalAirport" />
                    <TextField Label="Arrival runway" Hint="e.g. 34" @bind-Value="_briefingDraft.ArrivalRunway" />
                    <TextField Label="STAR" Hint="Identifier, e.g. RAZZI4" @bind-Value="_briefingDraft.ArrivalStar" />
                    <TextField Label="Approach" Hint="DFD identifier, e.g. I16R. Empty auto-fills the top-ranked published approach (ILS first); ask the FO &quot;which approach&quot; to hear the candidates"
                               @bind-Value="_briefingDraft.ArrivalApproach" />
                </Section>

                <Section Title="Minima Capture" Hint="During the arrival brief the FO asks for the minimums, reads them back, and arms the callouts on confirmation">
                    <BoolField Label="Interactive capture"
                               Hint="A value already entered on the First Officer Status card skips the dialogue. Works best with the LAN transcription engine"
                               @bind-Value="_briefingDraft.MinimaCaptureEnabled" />
                    <NumberField Label="Listen timeout" Suffix="s" Min="5"
                                 @bind-Value="_briefingDraft.MinimaListenTimeoutSeconds" />
                    <NumberField Label="Max retries" Min="0"
                                 Hint="Failed or unconfirmed attempts before the brief proceeds &quot;not briefed&quot;"
                                 @bind-Value="_briefingDraft.MinimaMaxRetries" />
                </Section>

                <Section Title="Missed-Approach Re-brief" Hint="After a go-around, the FO speaks the published missed-approach legs">
                    <BoolField Label="Enabled"
                               Hint="Waits for the delay AND gear-up (the crew flies first); degrades to a prompt when the DFD has no legs"
                               @bind-Value="_briefingDraft.MissedApproachRebriefEnabled" />
                    <NumberField Label="Delay" Suffix="s" Min="0"
                                 @bind-Value="_briefingDraft.MissedApproachDelaySeconds" />
                    <NumberField Label="Hard ceiling" Suffix="s" Min="0"
                                 Hint="Speaks at this point even if gear-up is never seen"
                                 @bind-Value="_briefingDraft.MissedApproachHardCeilingSeconds" />
                </Section>

                <Section Title="LLM Styling" Hint="One OpenAI-compatible endpoint for the whole app (briefing and debrief prose)">
                    <BoolField Label="Enabled"
                               Hint="Off = deterministic templates only, nothing leaves this machine"
                               @bind-Value="_briefingDraft.LlmEnabled" />
                    <TextField Label="Base URL"
                               Hint="OpenAI-compatible API root, e.g. http://localhost:3000/api or https://api.openai.com/v1"
                               @bind-Value="_briefingDraft.LlmBaseUrl" />
                    <TextField Label="API key"
                               Hint="Stored in config/settings.json, never logged; empty for keyless local servers"
                               @bind-Value="_briefingDraft.LlmApiKey" />
                    <TextField Label="Model"
                               Hint="Model name the endpoint expects (e.g. gpt-4o-mini, llama3.1). Empty disables LLM styling even when enabled"
                               @bind-Value="_briefingDraft.LlmModel" />
                    <NumberField Label="Max tokens" Min="64"
                                 @bind-Value="_briefingDraft.LlmMaxTokens" />
                    <NumberField Label="Timeout" Suffix="s" Min="5"
                                 Hint="Per call — a styled composition may make two (ask + strict re-ask)"
                                 @bind-Value="_briefingDraft.LlmTimeoutSeconds" />
                    <div class="field-hint" style="max-width:640px;">
                        Save, then use "Test LLM connection" on the Speech page to verify the
                        endpoint round-trips.
                    </div>
                </Section>
            }
            else if (_section == "windows")
            {
                <Section Title="Windows Voices" Hint="Offline fallbacks — always available">
                    <TextField Label="WinRT voice"
                               Hint="Display name or id; empty uses the system default. WinRT reaches the Windows 11 neural &quot;Natural&quot; voices"
                               @bind-Value="_draft.WinRtVoice" />
                    <TextField Label="SAPI5 voice"
                               Hint="Last-resort voice; empty uses the system default"
                               @bind-Value="_draft.SapiVoice" />
                </Section>
            }
            else
            {
                <Section Title="Advanced">
                    <TextField Label="TTS cache folder"
                               Hint="Empty uses %LOCALAPPDATA%\ProsimCompanion\cache\tts. Cached per provider and voice; the usage counter lives here too"
                               @bind-Value="_draft.CacheFolder" />
                </Section>
            }

        </div>
    </div>
</div>

<DirtyBar Visible="@(IsDirty || _barMessage is not null)"
          Message="@(_barMessage ?? "You have unsaved changes")"
          Tone="_barTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private static readonly (string Key, string Label)[] Sections =
    [
        ("status", "Status"),
        ("general", "General"),
        ("recognition", "Recognition & PTT"),
        ("sterile", "Sterile Cockpit"),
        ("kokoro", "Kokoro"),
        ("google", "Google"),
        ("briefing", "Briefings & LLM"),
        ("windows", "Windows Voices"),
        ("advanced", "Advanced"),
    ];

    private static readonly IReadOnlyList<(string, string)> RecognitionModeOptions =
    [
        ("pushToTalk", "Push-to-talk (dedicated FO key)"),
        ("continuous", "Continuous (ATC-mute while transmitting)"),
    ];

    private static readonly IReadOnlyList<(string, string)> ProcedureSourceOptions =
    [
        ("auto", "Auto (FMS → flight.json → manual)"),
        ("manual", "Manual entries only"),
        ("flightJson", "SayIntentions flight.json only"),
    ];

    private static readonly IReadOnlyList<(string, string)> NormalPolicyOptions =
    [
        ("allow", "Allow (speak normally)"),
        ("defer", "Defer (replay when sterile ends)"),
        ("suppress", "Suppress (drop)"),
    ];

    private static readonly JsonSerializerOptions DraftJson = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new JsonStringEnumConverter(JsonNamingPolicy.CamelCase) },
    };

    private string _section = "status";
    private SpeechOptions _draft = new();
    private BriefingOptions _briefingDraft = new();
    private string _baseline = "";
    private string _briefingBaseline = "";
    private string? _barMessage;
    private DirtyBar.MessageTone _barTone = DirtyBar.MessageTone.Unsaved;
    private Timer? _savedMessageTimer;

    private bool IsDirty => Serialize(_draft) != _baseline
        || JsonSerializer.Serialize(_briefingDraft, DraftJson) != _briefingBaseline;

    private IReadOnlyList<string> _captureDevices = [];
    private IReadOnlyList<string> _renderDevices = [];

    private IReadOnlyList<(string, string)> InputDeviceOptions() =>
        DeviceOptions("Default capture device", _captureDevices, _draft.InputDevice);

    private IReadOnlyList<(string, string)> OutputDeviceOptions() =>
        DeviceOptions("System default", _renderDevices, _draft.OutputDevice);

    /// <summary>Empty-value default first, then every detected device; a saved device that is
    /// not currently detected (unplugged, renamed) stays selectable so opening the page never
    /// silently rewrites the setting.</summary>
    private static IReadOnlyList<(string, string)> DeviceOptions(
        string defaultLabel, IReadOnlyList<string> devices, string current)
    {
        var options = new List<(string, string)> { ("", defaultLabel) };
        foreach (var name in devices)
        {
            options.Add((name, name));
        }

        if (!string.IsNullOrWhiteSpace(current)
            && !devices.Contains(current, StringComparer.OrdinalIgnoreCase))
        {
            options.Add((current, $"{current} (not currently detected)"));
        }

        return options;
    }

    private IReadOnlyList<JoystickDeviceView> _joysticks = [];
    private string? _capturing;
    private string? _captureMessage;

    private string FoJoystickDeviceKey
    {
        get => (_draft.PttJoystickDevice ?? -1).ToString();
        set => (_draft.PttJoystickDevice, _draft.PttJoystickDeviceName) = ParseJoystickSelection(value);
    }

    private string AtcJoystickDeviceKey
    {
        get => (_draft.AtcMuteJoystickDevice ?? -1).ToString();
        set => (_draft.AtcMuteJoystickDevice, _draft.AtcMuteJoystickDeviceName) = ParseJoystickSelection(value);
    }

    /// <summary>Selection → (id, product name). The name is what actually binds at runtime
    /// (ids shuffle on re-plug); the id is kept as display key and fallback.</summary>
    private (int?, string) ParseJoystickSelection(string value)
    {
        if (!int.TryParse(value, out var id) || id < 0)
        {
            return (null, "");
        }

        return (id, _joysticks.FirstOrDefault(j => j.Id == id)?.Name ?? "");
    }

    private IReadOnlyList<(string, string)> JoystickOptions(int? currentId, string currentName)
    {
        var options = new List<(string, string)> { ("-1", "Unbound") };
        foreach (var joystick in _joysticks)
        {
            options.Add((joystick.Id.ToString(), $"{joystick.Id}: {joystick.Name}"));
        }

        if (currentId is { } current && _joysticks.All(j => j.Id != current))
        {
            var label = string.IsNullOrWhiteSpace(currentName) ? $"Joystick {current}" : currentName;
            options.Add((current.ToString(), $"{current}: {label} (not currently connected)"));
        }

        return options;
    }

    private async Task DetectAsync(string target)
    {
        _capturing = target;
        _captureMessage = null;
        try
        {
            var result = await PttCapture.CaptureAsync(
                includeJoysticks: true, TimeSpan.FromSeconds(10), CancellationToken.None);
            var label = target == "atc" ? "ATC-mute" : "FO PTT";
            if (result is null)
            {
                _captureMessage = "Nothing pressed within ten seconds.";
            }
            else if (result.IsJoystick)
            {
                _joysticks = PttCapture.GetJoysticks(); // the pressed device is connected — relist
                var name = _joysticks.FirstOrDefault(j => j.Id == result.JoystickId)?.Name ?? "";
                if (target == "atc")
                {
                    _draft.AtcMuteJoystickDevice = result.JoystickId;
                    _draft.AtcMuteJoystickButton = result.JoystickButton;
                    _draft.AtcMuteJoystickDeviceName = name;
                }
                else
                {
                    _draft.PttJoystickDevice = result.JoystickId;
                    _draft.PttJoystickButton = result.JoystickButton;
                    _draft.PttJoystickDeviceName = name;
                }

                var shown = string.IsNullOrWhiteSpace(name) ? $"joystick {result.JoystickId}" : name;
                _captureMessage = $"{label} bound to {shown}, button {result.JoystickButton}.";
            }
            else if (target == "atc")
            {
                _draft.AtcMuteKey = result.KeyName ?? "";
                _captureMessage = $"ATC-mute key set to \"{result.KeyName}\".";
            }
            else
            {
                _draft.PttKey = result.KeyName ?? "";
                _captureMessage = $"FO PTT key set to \"{result.KeyName}\".";
            }
        }
        catch (Exception)
        {
            _captureMessage = "Detection failed — see the Logs page.";
        }
        finally
        {
            _capturing = null;
        }
    }

    private int AtcMuteJoystickButtonDraft
    {
        get => _draft.AtcMuteJoystickButton ?? -1;
        set => _draft.AtcMuteJoystickButton = value < 0 ? null : value;
    }

    private int PttJoystickButtonDraft
    {
        get => _draft.PttJoystickButton ?? -1;
        set => _draft.PttJoystickButton = value < 0 ? null : value;
    }

    private string ProcedureSourceKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_briefingDraft.ProcedureSource.ToString());
        set => _briefingDraft.ProcedureSource = Enum.TryParse<ProcedureSourceMode>(value, ignoreCase: true, out var parsed)
            ? parsed : ProcedureSourceMode.Auto;
    }

    private string NormalPolicyKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_draft.SterileNormalPolicy.ToString());
        set => _draft.SterileNormalPolicy = Enum.TryParse<SterileNormalPolicy>(value, ignoreCase: true, out var parsed)
            ? parsed : SterileNormalPolicy.Allow;
    }

    protected override void OnInitialized()
    {
        LoadDraft();
        _captureDevices = DeviceCatalog.GetCaptureDeviceNames();
        _renderDevices = DeviceCatalog.GetRenderDeviceNames();
        _joysticks = PttCapture.GetJoysticks();
    }

    private void LoadDraft()
    {
        // JSON round-trip clone — the options instance is shared with the running service
        // and must never be edited in place.
        _draft = JsonSerializer.Deserialize<SpeechOptions>(
            JsonSerializer.Serialize(SpeechMonitor.CurrentValue, DraftJson), DraftJson) ?? new SpeechOptions();
        _baseline = Serialize(_draft);
        _briefingDraft = JsonSerializer.Deserialize<BriefingOptions>(
            JsonSerializer.Serialize(BriefingMonitor.CurrentValue, DraftJson), DraftJson) ?? new BriefingOptions();
        _briefingBaseline = JsonSerializer.Serialize(_briefingDraft, DraftJson);
    }

    private static string Serialize(SpeechOptions options) => JsonSerializer.Serialize(options, DraftJson);

    private void Discard()
    {
        LoadDraft();
        _barMessage = null;
    }

    private void Save()
    {
        try
        {
            var draft = _draft;
            var briefingDraft = _briefingDraft;
            SettingsFile.Update(root =>
            {
                var briefing = JsonSettingsFile.GetOrCreateSection(root, BriefingOptions.SectionName);
                // dfdPath deliberately not written here — App Settings → Nav Data owns it,
                // and a stale draft on this page must not clobber a save made there.
                briefing["procedureSource"] = JsonNamingPolicy.CamelCase.ConvertName(briefingDraft.ProcedureSource.ToString());
                briefing["verifyNumbers"] = briefingDraft.VerifyNumbers;
                briefing["departureAirport"] = briefingDraft.DepartureAirport.Trim().ToUpperInvariant();
                briefing["departureRunway"] = briefingDraft.DepartureRunway.Trim().ToUpperInvariant();
                briefing["departureSid"] = briefingDraft.DepartureSid.Trim().ToUpperInvariant();
                briefing["arrivalAirport"] = briefingDraft.ArrivalAirport.Trim().ToUpperInvariant();
                briefing["arrivalRunway"] = briefingDraft.ArrivalRunway.Trim().ToUpperInvariant();
                briefing["arrivalStar"] = briefingDraft.ArrivalStar.Trim().ToUpperInvariant();
                briefing["arrivalApproach"] = briefingDraft.ArrivalApproach.Trim().ToUpperInvariant();
                briefing["minimaCaptureEnabled"] = briefingDraft.MinimaCaptureEnabled;
                briefing["minimaListenTimeoutSeconds"] = briefingDraft.MinimaListenTimeoutSeconds;
                briefing["minimaMaxRetries"] = briefingDraft.MinimaMaxRetries;
                briefing["missedApproachRebriefEnabled"] = briefingDraft.MissedApproachRebriefEnabled;
                briefing["missedApproachDelaySeconds"] = briefingDraft.MissedApproachDelaySeconds;
                briefing["missedApproachHardCeilingSeconds"] = briefingDraft.MissedApproachHardCeilingSeconds;
                briefing["llmEnabled"] = briefingDraft.LlmEnabled;
                briefing["llmBaseUrl"] = briefingDraft.LlmBaseUrl.Trim();
                briefing["llmApiKey"] = briefingDraft.LlmApiKey.Trim();
                briefing["llmModel"] = briefingDraft.LlmModel.Trim();
                briefing["llmMaxTokens"] = briefingDraft.LlmMaxTokens;
                briefing["llmTimeoutSeconds"] = briefingDraft.LlmTimeoutSeconds;

                var speech = JsonSettingsFile.GetOrCreateSection(root, SpeechOptions.SectionName);

                speech["enabled"] = draft.Enabled;
                speech["localOnly"] = draft.LocalOnly;

                speech["recognitionMode"] = draft.RecognitionMode.Trim();
                speech["pttKey"] = draft.PttKey.Trim();
                speech["atcMuteKey"] = draft.AtcMuteKey.Trim();
                speech["pttJoystickDevice"] = draft.PttJoystickDevice;
                speech["pttJoystickButton"] = draft.PttJoystickButton;
                speech["pttJoystickDeviceName"] = draft.PttJoystickDeviceName.Trim();
                speech["atcMuteJoystickDevice"] = draft.AtcMuteJoystickDevice;
                speech["atcMuteJoystickButton"] = draft.AtcMuteJoystickButton;
                speech["atcMuteJoystickDeviceName"] = draft.AtcMuteJoystickDeviceName.Trim();
                speech["asrBaseUrl"] = draft.AsrBaseUrl.Trim();
                speech["inputDevice"] = draft.InputDevice.Trim();

                speech["sterileEnabled"] = draft.SterileEnabled;
                speech["sterileCockpitCeilingFt"] = draft.SterileCockpitCeilingFt;
                speech["sterileSuppressLow"] = draft.SterileSuppressLow;
                speech["sterileNormalPolicy"] = JsonNamingPolicy.CamelCase.ConvertName(draft.SterileNormalPolicy.ToString());
                speech["sterileExemptCabinReports"] = draft.SterileExemptCabinReports;

                speech["kokoroBaseUrl"] = draft.KokoroBaseUrl.Trim();
                speech["kokoroModel"] = draft.KokoroModel.Trim();
                speech["kokoroVoice"] = draft.KokoroVoice.Trim();
                speech["kokoroTimeoutMs"] = draft.KokoroTimeoutMs;
                speech["kokoroMaxCacheMbPerVoice"] = draft.KokoroMaxCacheMbPerVoice;

                speech["googleKeyFilePath"] = draft.GoogleKeyFilePath.Trim();
                speech["googleVoice"] = draft.GoogleVoice.Trim();
                speech["googleMonthlyCharBudget"] = draft.GoogleMonthlyCharBudget;

                speech["winRtVoice"] = draft.WinRtVoice.Trim();
                speech["sapiVoice"] = draft.SapiVoice.Trim();

                speech["outputDevice"] = draft.OutputDevice.Trim();
                speech["volume"] = draft.Volume;
                speech["intercomFilter"] = draft.IntercomFilter;
                speech["cacheFolder"] = draft.CacheFolder.Trim();
            });

            _baseline = Serialize(_draft);
            _briefingBaseline = JsonSerializer.Serialize(_briefingDraft, DraftJson);
            _barMessage = "Saved.";
            _barTone = DirtyBar.MessageTone.Info;
            _savedMessageTimer?.Dispose();
            _savedMessageTimer = new Timer(_ => _ = InvokeAsync(() =>
            {
                _barMessage = null;
                _barTone = DirtyBar.MessageTone.Unsaved;
                StateHasChanged();
            }), null, TimeSpan.FromSeconds(1.5), Timeout.InfiniteTimeSpan);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _barMessage = $"Save failed: {ex.Message}";
            _barTone = DirtyBar.MessageTone.Error;
        }
    }

    public void Dispose() => _savedMessageTimer?.Dispose();
}
