@page "/settings/speech/{Section?}"
@page "/speech"
@layout SettingsLayout
@using System.Text.Json
@inherits SettingsPageBase
@inject IOptionsMonitor<SpeechOptions> SpeechMonitor
@inject IOptionsMonitor<BriefingOptions> BriefingMonitor
@inject IOptionsMonitor<McduOptions> McduMonitor
@inject IOptionsMonitor<VoicesOptions> VoicesMonitor
@inject IOptionsMonitor<GroundCrewOptions> GroundCrewMonitor
@inject IOptionsMonitor<CabinOptions> CabinMonitor
@inject IOptionsMonitor<AccentOptions> AccentsMonitor
@inject IOptionsMonitor<SayIntentionsOptions> SayIntentionsMonitor
@inject IOptionsMonitor<SopOptions> SopMonitor
@inject IOptionsMonitor<PersonaOptions> PersonaMonitor
@inject IOptionsMonitor<CompanyOptions> CompanyMonitor
@inject IOptionsMonitor<DebriefOptions> DebriefMonitor
@inject IOptionsMonitor<DayOptions> DayMonitor
@inject IOptionsMonitor<TechLogOptions> TechLogMonitor
@inject IOptionsMonitor<LogbookOptions> LogbookMonitor
@inject IOptionsMonitor<AbnormalsOptions> AbnormalsMonitor
@inject IAudioDeviceCatalog DeviceCatalog
@inject IPttInputCapture PttCapture
@inject IElevenLabsVoiceCatalog ElevenLabsVoices
@inject ITtsUsageReadout TtsUsage

<PageTitle>Voice First Officer — ProsimCompanion</PageTitle>
<h1 class="sr-only">Voice First Officer</h1>

@* Sections are URL-driven (settings/speech/{section}, ADR-0010); the rail lives in
   SettingsLayout. The speech master switch moved to Setup with the other pillar switches;
   Kokoro / Google / Windows voices / cache folder merged into one Voice Providers section. *@

<LlmHealthBanner />

@if (CurrentSection == "status")
{
    <SpeechStatusPanel />
}
else if (CurrentSection == "general")
{
    <Section Title="Voice First Officer" Hint="Voices are tried in order: Kokoro, ElevenLabs, Google, then Windows">
        <BoolField Label="Local only" Hint="Never use network voices. Speech never leaves this PC." More="Kokoro, ElevenLabs and Google are skipped on every path."
                   @bind-Value="_speech.Value.LocalOnly" />
        <SelectField Label="Your seat" Hint="The seat you fly from. The First Officer works the other side." More="Left: the FO uses the right MCDU, EFIS and controls. Right: the FO uses the captain's side. The MCDU side changes after an app restart." Options="PilotSeatOptions"
                     @bind-Value="_speech.Value.PilotSeat" />
        <BoolField Label="Engine &amp; flap call responses" Hint="The FO answers your engine start and flap calls." More="Flap calls are checked against the placard speeds. Verbal only: the FO never moves the levers."
                   @bind-Value="_speech.Value.EngineFlapCallouts" />
        <BoolField Label="Engine start monitoring" Hint="The FO calls each engine start: starting, available, both stabilized." More="Read from the engine data on the ground, once per start. No pilot call needed."
                   @bind-Value="_speech.Value.EngineStartCallouts" />
    </Section>

    <Section Title="Human Pacing" Hint="Button presses at a human tempo" Advanced="true">
        <BoolField Label="Humanize button timing" Hint="Add small human pauses between button presses." More="Off: the minimum delays only."
                   @bind-Value="_speech.Value.Humanize.Enabled" />
        <NumberField Label="Tempo" Hint="1.0 is normal, 2.0 is twice as slow." Step="0.1" Min="0.25" Max="4"
                     Disabled="@(!_speech.Value.Humanize.Enabled)"
                     @bind-Value="_speech.Value.Humanize.Tempo"
                     Default="_speech.Defaults.Humanize.Tempo" />
    </Section>

    <Section Title="Playback">
        <SelectField Label="Output device" Hint="Where the First Officer's voice plays."
                     Options="OutputDeviceOptions()"
                     @bind-Value="_speech.Value.OutputDevice" />
        <NumberField Label="Volume" Suffix="%" Min="0" Max="100"
                     @bind-Value="_speech.Value.Volume"
                     Default="_speech.Defaults.Volume" />
        <BoolField Label="Intercom filter" Hint="Make the FO sound like a headset, not a narrator."
                   @bind-Value="_speech.Value.IntercomFilter" />
    </Section>
}
else if (CurrentSection == "persona")
{
    @* FO persona (Phase 7, 2026-08-08) — settings.json only until the 2026-10-08 audit. *@
    <Section Title="FO Persona" Hint="Wording and tone only. A number, a callout or a checklist line is never changed">
        <BoolField Label="Enabled" Hint="Let the persona colour what the FO says." More="With the language model off, the only effect is varied acknowledgements."
                   @bind-Value="_persona.Value.Enabled" />
        <TextField Label="Name" Hint="Woven into the model's style prompt (&quot;Your name is …&quot;). Empty = unnamed." Placeholder="e.g. Sam"
                   Disabled="@(!_persona.Value.Enabled)"
                   @bind-Value="_persona.Value.Name" />
        <SelectField Label="Experience" Hint="How seasoned the FO sounds." Options="PersonaExperienceOptions"
                     Disabled="@(!_persona.Value.Enabled)"
                     @bind-Value="_persona.Value.Experience" />
        <SelectField Label="Formality" Hint="How formal the FO is with you." Options="PersonaFormalityOptions"
                     Disabled="@(!_persona.Value.Enabled)"
                     @bind-Value="_persona.Value.Formality" />
        <NumberField Label="Chattiness" Hint="0 keeps everything short. 3 allows natural warmth." More="&quot;Quiet please&quot; silences chatter for the session whatever this says." Min="0" Max="3"
                     Disabled="@(!_persona.Value.Enabled)"
                     @bind-Value="_persona.Value.Chattiness"
                     Default="_persona.Defaults.Chattiness" />
    </Section>

    <Section Title="What the Persona Styles" Hint="Each one is verified against the facts; the plain text is always the fallback">
        <BoolField Label="Briefings" Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.StyleBriefings" />
        <BoolField Label="Debrief" Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.StyleDebrief" />
        <BoolField Label="Advisories" Hint="Flow and weather advisories pass through the model before they are spoken." More="Only when the restyle returns within the time below; otherwise the plain text speaks."
                   Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.StyleAdvisories" />
        <BoolField Label="Vary acknowledgements" Hint="Pick &quot;are you sure&quot; / &quot;say again&quot; lines at random from phrases.json instead of in turn."
                   Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.VaryAcknowledgements" />
        <AdvancedFields>
            <NumberField Label="Advisory restyle budget" Hint="Time the model gets to restyle one advisory. The plain text speaks when it runs out." Suffix="ms" Min="500" Step="100"
                         Disabled="@(!_persona.Value.Enabled || !_persona.Value.StyleAdvisories)"
                         @bind-Value="_persona.Value.StyleTimeoutMs"
                         Default="_persona.Defaults.StyleTimeoutMs" />
        </AdvancedFields>
        <div class="field-hint" style="max-width:640px;">
            The phrase pools themselves are in <code>config\phrases.json</code> under
            <code>%LOCALAPPDATA%\ProsimCompanion</code> — edit the file, the FO reloads it.
        </div>
    </Section>
}
else if (CurrentSection == "listening")
{
    <Section Title="Recognition & Push-to-Talk" Hint="How the First Officer hears you">
        <SelectField Label="Listening mode" Hint="Push-to-talk: the FO listens only while your FO key is held." More="Continuous: the FO listens whenever it expects a reply, except while the ATC key is held. On a network (VATSIM, IVAO, SayIntentions) always bind your ATC transmit key below, so the FO never hears what you say to ATC." Options="RecognitionModeOptions"
                     @bind-Value="_speech.Value.RecognitionMode" />
        <div class="field">
            <label class="field-label">
                FO push-to-talk
                <span class="field-hint">The key or button that talks to the First Officer. Never your ATC key.</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.PttBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("fo")'>
                        @(_capturing == "fo" ? "Press the key or button now…" : "Set")
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.PttBinding)'>Clear</button>
                    <span title="Lights while the bound input is held"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.OwnPttPressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        <div class="field">
            <label class="field-label">
                ATC push-to-talk (mute)
                <span class="field-hint">The key or button you use to talk to ATC. While it is held, the FO does not listen.</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.AtcMuteBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("atc")'>
                        @(_capturing == "atc" ? "Press the key or button now…" : "Set")
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.AtcMuteBinding)'>Clear</button>
                    <span title="Lights while the bound input is held"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.AtcMutePressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        <SelectField Label="ATC mute from a ProSim switch" Hint="A sidestick or hand-mic PTT switch in ProSim. While it reads pushed, the FO does not listen — same as the key or button above, and it needs no joystick on this PC."
                     More="Bind your button to the switch in ProSim (it can live on another PC). Choosing a SayIntentions push-to-talk switch on the SayIntentions section sets this to the same switch when it is still Off."
                     Options="PttSwitchOptions"
                     @bind-Value="_speech.Value.AtcMuteSource" />
        @if (_captureMessage is not null)
        {
            <div class="field-hint">@_captureMessage</div>
        }
        <BoolField Label="Also listen for joystick buttons" Hint="Off: Set captures a keyboard key only. On: Set also watches the joystick buttons on this PC."
                   More="Windows' joystick layer has crashed the app on some PCs (2026-09-20, 2026-10-10, 2026-10-11 — the last time just from listing the devices when this page opened). The page now talks to it only while this is on or when you press Scan. A ProSim switch (above, and on the SayIntentions section) needs no joystick on this PC."
                   @bind-Value="_listenJoysticks" />
        <div class="field">
            <label class="field-label">
                Joysticks on this PC
                <span class="field-hint">@(_joysticks.Count == 0 ? "Not scanned." : string.Join(", ", _joysticks.Select(j => $"{j.Name} (id {j.Id})")))</span>
            </label>
            <div class="field-control">
                <button type="button" class="btn secondary" disabled="@(_capturing is not null || _scanMessage == "Scanning…")"
                        @onclick="ScanJoysticksAsync">Scan for joysticks</button>
                @if (_scanMessage is not null)
                {
                    <span class="field-hint">@_scanMessage</span>
                }
            </div>
        </div>
        <div class="field-hint" style="max-width:640px;">
            Set waits ten seconds for a key (and a joystick button when ticked above). Save
            afterwards; the lamps light for the saved bindings only.
        </div>
        <SelectField Label="Input device" Hint="The microphone the FO listens on."
                     Options="InputDeviceOptions()"
                     @bind-Value="_speech.Value.InputDevice" />
        <BoolField Label="Track phrases the FO did not understand" Hint="Keep what you said that nothing acted on, so you can add the commands you actually use." More="Listed under Heard but not understood on the Voice status page and written to the session log as voice.unmatched. Off: nothing is kept; the log's ASR trail still shows every utterance."
                   @bind-Value="_speech.Value.TrackUnmatched" />
        <AdvancedFields>
            <NumberField Label="Phrase match score" Hint="How close a heard phrase must be to a known one before the FO acts on it." More="0.5 Levenshtein + 0.5 DoubleMetaphone. Lower hears more, mis-hears more." Step="0.05" Min="0.3" Max="1"
                         @bind-Value="_speech.Value.SnappingThreshold"
                         Default="_speech.Defaults.SnappingThreshold" />
            <NumberField Label="Ask 'did you mean' below" Hint="A match between the score above and this one makes the FO ask 'Did you mean …?' instead of acting." More="Set it equal to the match score to never ask." Step="0.05" Min="0.3" Max="1"
                         @bind-Value="_speech.Value.ConfirmBelowScore"
                         Default="_speech.Defaults.ConfirmBelowScore" />
            <NumberField Label="Offline engine confidence" Hint="Minimum confidence the Windows engine must report. Not used with a LAN server." Step="0.05" Min="0" Max="1"
                         @bind-Value="_speech.Value.RecognitionConfidenceThreshold"
                         Default="_speech.Defaults.RecognitionConfidenceThreshold" />
        </AdvancedFields>
    </Section>

    <Section Title="Speech Recognition Server" Hint="A transcription server on your network. Empty uses the offline Windows engine">
        <TextField Label="LAN ASR URL" Hint="Server address, for example http://192.168.1.50:8000."
                   @bind-Value="_speech.Value.AsrBaseUrl" />
        <SelectField Label="LAN ASR server flavour" Hint="Must match the server type running at that address." More="The wrong type answers 404 to everything while the health check stays green. A warning is logged when that happens." Options="AsrApiOptions"
                     Disabled="@(string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl))"
                     @bind-Value="AsrApiKey" />
        <SelectField Label="Voice activity detection" Hint="How the FO decides you are speaking." More="Silero ignores engine noise and the FO's own voice and hears quiet commands. RMS is the older energy gate and the fallback if the Silero model cannot load. Applies from the next listening start. Further knobs (vadMinSpeechMs, vadPreRollMs, vadMaxUtteranceMs) are file-only in settings.json." Options="VadEngineOptions"
                     Disabled="@(string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl))"
                     @bind-Value="_speech.Value.VadEngine" />
        <BoolField Label="Ignore the microphone while the FO speaks" Hint="On: the FO cannot hear its own voice from the cockpit speakers and answer itself. Off only if you must talk over the FO."
                   More="Also drops a transcript that repeats what the FO just said, whatever the timing. On 2026-10-10 a VBAN loop put the FO on the speakers and it chatted with itself for minutes."
                   @bind-Value="_speech.Value.MuteMicWhileSpeaking" />
        <AdvancedFields>
            <NumberField Label="Microphone tail after the FO speaks" Hint="How long the microphone stays ignored after the FO's last word. Raise it for a loud, echoey cockpit; lower it if your quick replies are missed." Suffix="ms" Min="0" Max="3000" Step="50"
                         Disabled="@(!_speech.Value.MuteMicWhileSpeaking)"
                         @bind-Value="_speech.Value.MicTailAfterSpeakingMs"
                         Default="_speech.Defaults.MicTailAfterSpeakingMs" />
            <NumberField Label="VAD threshold" Hint="Raise it if noise triggers the FO. Lower it if quiet commands are missed." Step="0.05" Min="0.1" Max="0.95"
                         Disabled="@(!SileroSelected)"
                         @bind-Value="_speech.Value.VadThreshold"
                         Default="_speech.Defaults.VadThreshold" />
            <NumberField Label="End-of-utterance silence" Hint="Silence that ends your sentence. Raise it if pauses split your sentences." Suffix="ms" Min="200" Step="50"
                         Disabled="@(!SileroSelected)"
                         @bind-Value="_speech.Value.VadEndSilenceMs"
                         Default="_speech.Defaults.VadEndSilenceMs" />
        </AdvancedFields>
    </Section>

    <Section Title="Interphone Transmit" Hint="Crew calls follow the captain's audio panel">
        <BoolField Label="ACP transmit gating" Hint="Calls to ground or cabin need INT or CAB selected on the audio panel." More="Moving the selector away mid-call hangs up. Off, or an older ProSim: calls are always accepted."
                   @bind-Value="_speech.Value.AcpTransmitGating" />
        <BoolField Label="Require the INT key pressed" Hint="Ground calls also need the INT key held while you speak." More="Leave off unless your panel has the key."
                   Disabled="@(!_speech.Value.AcpTransmitGating)"
                   @bind-Value="_speech.Value.AcpIntKeyRequired" />
    </Section>
}
else if (CurrentSection == "sterile")
{
    <Section Title="Sterile Cockpit" Hint="A quiet cockpit during the busy phases">
        <BoolField Label="Enabled" Hint="The FO holds non-essential speech below the ceiling." @bind-Value="_speech.Value.SterileEnabled" />
        <NumberField Label="Ceiling" Hint="Sterile below this altitude in climb, descent and approach." More="Cruise and ground are never sterile." Suffix="ft MSL" Min="1000"
                     Disabled="@(!_speech.Value.SterileEnabled)"
                     @bind-Value="_speech.Value.SterileCockpitCeilingFt"
                     Default="_speech.Defaults.SterileCockpitCeilingFt" />
        <BoolField Label="Drop Low-priority speech" Hint="Advisories are dropped while sterile, never replayed."
                   Disabled="@(!_speech.Value.SterileEnabled)"
                   @bind-Value="_speech.Value.SterileSuppressLow" />
        <SelectField Label="Normal-priority policy" Hint="What happens to normal speech while sterile." More="Allow is the safe default. Checklists and briefings are normal priority and are needed on a low approach." Options="NormalPolicyOptions"
                     Disabled="@(!_speech.Value.SterileEnabled)"
                     @bind-Value="NormalPolicyKey" />
        <BoolField Label="Exempt cabin reports" Hint="Cabin reports still come through while sterile."
                   Disabled="@(!_speech.Value.SterileEnabled)"
                   @bind-Value="_speech.Value.SterileExemptCabinReports" />
    </Section>
}
else if (CurrentSection == "crew")
{
    <Section Title="Crew Voices" Hint="Voice names from your provider, for example af_heart (Kokoro), an ElevenLabs voice id, or en-AU-Chirp3-HD-Aoede (Google). Blank uses the FO voice">
        <TextField Label="Purser voice" Hint="Cabin reports on the cabin interphone."
                   @bind-Value="_voices.Value.Purser" />
        <BoolField Label="Purser intercom filter" Hint="Headset sound on the purser."
                   @bind-Value="_voices.Value.PurserIntercomFilter" />
        <TextField Label="Company voice" Hint="Dispatch messages, read out like ACARS."
                   @bind-Value="_voices.Value.Company" />
        <BoolField Label="Company intercom filter" Hint="Off by default. A company message is a printout, not a phone call."
                   @bind-Value="_voices.Value.CompanyIntercomFilter" />
        <TextField Label="Ground crew voice" Hint="Ground crew replies and calls on the interphone."
                   @bind-Value="_voices.Value.Ground" />
        <BoolField Label="Ground intercom filter"
                   @bind-Value="_voices.Value.GroundIntercomFilter" />
    </Section>

    <Section Title="Accent Localization" Hint="The ground crew's accent follows the airport's country">
        <BoolField Label="Enabled" Hint="Ground crew only. Purser and company keep the voices above." More="Needs the Google provider for most accents. Local only mode falls back to US or UK."
                   @bind-Value="_accents.Value.Enabled" />
        <TextField Label="Chirp 3 HD persona" Hint="Google voice persona, for example Charon."
                   Disabled="@(!_accents.Value.Enabled)"
                   @bind-Value="_accents.Value.GooglePersona" />
        <div class="field-hint" style="max-width:640px;">
            Per-airport overrides are file-only: <span class="mono">accents.overrides</span>
            in config/settings.json (airport code prefix to voice locale).
        </div>
    </Section>
}
else if (CurrentSection == "groundCrew")
{
    <Section Title="Ground Crew" Hint="Hail the ground crew and hear their calls">
        <BoolField Label="Enabled" @bind-Value="_groundCrew.Value.Enabled" />
        <BoolField Label="Require INT selected" Hint="Ground speech waits until INT is selected on an audio panel."
                   Disabled="@(!_groundCrew.Value.Enabled)"
                   @bind-Value="_groundCrew.Value.RequireIntChannel" />
        <AdvancedFields>
            <NumberField Label="INT grace" Hint="After this wait the call plays anyway." Suffix="s" Min="0"
                         Disabled="@(!_groundCrew.Value.Enabled || !_groundCrew.Value.RequireIntChannel)"
                         @bind-Value="_groundCrew.Value.IntChannelGraceSeconds"
                         Default="_groundCrew.Defaults.IntChannelGraceSeconds" />
        </AdvancedFields>
        <BoolField Label="MECH call on upcalls" Hint="Flash the MECH light when the ground crew calls you."
                   Disabled="@(!_groundCrew.Value.Enabled)"
                   @bind-Value="_groundCrew.Value.MechCall" />
        <AdvancedFields>
            <NumberField Label="Hail listen window" Hint="How long the crew waits for your request after answering." Suffix="s" Min="3"
                         Disabled="@(!_groundCrew.Value.Enabled)"
                         @bind-Value="_groundCrew.Value.HailListenTimeoutSeconds"
                         Default="_groundCrew.Defaults.HailListenTimeoutSeconds" />
        </AdvancedFields>
    </Section>

    <Section Title="Upcalls" Hint="Each call comes once per turnaround">
        <BoolField Label="Ground power connected" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnGroundPower" />
        <BoolField Label="Chocks in place" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnChocks" />
        <BoolField Label="Refueling complete" Hint="Includes the fuel figure."
                   Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnRefuelComplete" />
        <BoolField Label="Catering complete" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnCateringComplete" />
    </Section>

    <Section Title="Ground Crew Wording" Hint="Spoken word for word. {fuel} becomes the tonnes on board">
        <TextField Label="Hail reply" @bind-Value="_groundCrew.Value.HailReplyText" />
        <TextField Label="Standing by" @bind-Value="_groundCrew.Value.StandingByText" />
        <TextField Label="Ground power" @bind-Value="_groundCrew.Value.GroundPowerText" />
        <TextField Label="Chocks" @bind-Value="_groundCrew.Value.ChocksText" />
        <TextField Label="Refuel complete" @bind-Value="_groundCrew.Value.RefuelCompleteText" />
        <TextField Label="Catering complete" @bind-Value="_groundCrew.Value.CateringCompleteText" />
    </Section>
}
else if (CurrentSection == "cabin")
{
    <Section Title="Cabin Crew" Hint="Purser reports on the cabin interphone">
        <BoolField Label="Enabled" @bind-Value="_cabin.Value.Enabled" />
        <BoolField Label="Cabin secure report" Hint="Before takeoff, once the doors are closed and the beacon is on."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.CabinSecure" />
        <NumberField Label="Cabin secure: minimum wait" Suffix="s" Min="0"
                     Hint="The crew needs this long after doors closed + beacon on before the report. 0 = instant."
                     Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.CabinSecure)"
                     @bind-Value="_cabin.Value.CabinSecureMinDelaySeconds"
                     Default="_cabin.Defaults.CabinSecureMinDelaySeconds" />
        <NumberField Label="Cabin secure: extra per passenger" Suffix="s/pax" Step="0.1" Min="0"
                     Hint="A random share of pax × this is added, drawn once per flight — sometimes ready after pushback, sometimes at the runway."
                     More="Passengers = GSX's boarded count, else the OFP figure. With 45 s and 1 s/pax a full A320 waits between 45 s and about 4 minutes. 0 = the minimum only."
                     Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.CabinSecure)"
                     @bind-Value="_cabin.Value.CabinSecureSecondsPerPax"
                     Default="_cabin.Defaults.CabinSecureSecondsPerPax" />
        <BoolField Label="Cabin ready report" Hint="On approach, below the altitude set here."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.CabinReady" />
        <NumberField Label="Cabin-ready below" Suffix="ft MSL" Min="1000"
                     Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.CabinReady)"
                     @bind-Value="_cabin.Value.CabinReadyBelowAltFt"
                     Default="_cabin.Defaults.CabinReadyBelowAltFt" />
        <BoolField Label="FO acknowledges reports" Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.FoAcknowledge" />
        <BoolField Label="Require CAB selected" Hint="The purser waits until CAB is selected on an audio panel, or the grace time."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.RequireCabChannel" />
        <AdvancedFields>
            <NumberField Label="CAB grace" Suffix="s" Min="0"
                         Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.RequireCabChannel)"
                         @bind-Value="_cabin.Value.CabChannelGraceSeconds"
                         Default="_cabin.Defaults.CabChannelGraceSeconds" />
        </AdvancedFields>
        <BoolField Label="FO answers cabin calls on the ground" Hint="During pushback, engine start and taxi-out the FO selects CAB on the FO's audio panel after the delay, so the report plays without you touching the ACP."
                   More="This is the one place the cabin crew writes to the aircraft: the FO panel's CAB reception latch (S_ASP2_CAB_REC_LATCH; the captain's panel when you fly from the right seat), set on and released after the report. Never while the FO is mid-dialogue with you, never in any other phase. Off by default."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.AutoAnswerGround" />
        <NumberField Label="Ground answer delay" Suffix="ms" Min="0" Step="100"
                     Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.AutoAnswerGround)"
                     @bind-Value="_cabin.Value.AutoAnswerGroundDelayMs"
                     Default="_cabin.Defaults.AutoAnswerGroundDelayMs" />
        <BoolField Label="FO answers cabin calls in the air" Hint="In descent and approach the FO answers the cabin-ready call after the delay."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.AutoAnswerAir" />
        <NumberField Label="Air answer delay" Suffix="ms" Min="0" Step="100"
                     Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.AutoAnswerAir)"
                     @bind-Value="_cabin.Value.AutoAnswerAirDelayMs"
                     Default="_cabin.Defaults.AutoAnswerAirDelayMs" />
        <BoolField Label="Interphone chime before calls" Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.Chime" />
        <BoolField Label="Ding on startup" Hint="Cabin chime when the app starts."
                   @bind-Value="_cabin.Value.DingOnStartup" />
        <BoolField Label="Ding on final loadsheet" Hint="Cabin chime when the final loadsheet is sent."
                   @bind-Value="_cabin.Value.DingOnFinal" />
        <BoolField Label="Ambient events" Hint="Now and then the purser reports a boarding delay."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.AmbientEvents" />
        <NumberField Label="Boarding-delay probability" Hint="0.2 is one flight in five." Step="0.05" Min="0" Max="1"
