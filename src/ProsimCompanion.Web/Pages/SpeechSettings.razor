@code {
    [Parameter]
    public string? Section { get; set; }

    /// <summary>Provider tab for /settings/speech/providers/{tab} — deep links from the manual (2026-10-12).</summary>
    [Parameter]
    public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (CurrentSection == "providers" && !string.IsNullOrWhiteSpace(Tab))
        {
            ProviderTab = Tab.ToLowerInvariant();
        }
    }

    /// <summary>The old "crew" and "elevenlabs" routes (manual, bookmarks) land on the Voices page
    /// and the ElevenLabs provider tab (2026-10-12).</summary>
    private string CurrentSection => Section?.ToLowerInvariant() switch
    {
        "crew" => "voices",
        "elevenlabs" => "providers",
        _ => SettingsNav.ResolveSection(SettingsNav.SpeechSections, Section),
    };

    private void ResetFlapPlacards() => _sop.Value.FlapPlacards = [.. SopOptions.DefaultFlapPlacards];

    // ---- Approach gates (airline SOPs differ: 1000/500, 1000 only, an extra 1500 ft gate) ----

    private static readonly IReadOnlyList<(string, string)> FlapLeverOptions =
        [.. Enumerable.Range(0, 6).Select(handle => (
            handle.ToString(System.Globalization.CultureInfo.InvariantCulture),
            SopOptions.FlapHandleLabel(handle)))];

    private static int ParseFlapLever(string value, int fallback)
        => int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var handle)
            ? handle
            : fallback;

    private void ResetApproachGates() => _sop.Value.ApproachGates = [.. SopOptions.DefaultApproachGates];

    private void RemoveApproachGate(ApproachGate gate) => _sop.Value.ApproachGates.Remove(gate);

    private void AddApproachGate()
    {
        // Above the highest gate in use, so the new one never lands on an existing height.
        var top = _sop.Value.ApproachGates.Count == 0 ? 500 : _sop.Value.ApproachGates.Max(g => g.AglFt);
        _sop.Value.ApproachGates.Add(new ApproachGate { AglFt = top + 500, AnnounceStabilized = false });
        SopOptions.SyncApproachGateNames(_sop.Value.ApproachGates);
    }

    private bool SileroSelected => !string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl)
        && _speech.Value.VadEngine.Equals("silero", StringComparison.OrdinalIgnoreCase);

    private bool KokoroOff => string.IsNullOrWhiteSpace(_speech.Value.KokoroBaseUrl);

    // Voices (owner, 2026-10-12): one live list per provider, read off the DRAFT options so a
    // first-time setup can pick before saving. Nothing is pre-populated — only what each
    // service reports. The Voices page shows every provider's list grouped provider → region;
    // each provider tab shows its own list for the fallback voice.
    private readonly Dictionary<string, IReadOnlyList<VoiceEntry>> _voiceLists = new(StringComparer.OrdinalIgnoreCase);
