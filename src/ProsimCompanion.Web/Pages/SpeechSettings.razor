    private IReadOnlyList<VoiceGroup> GroupsFor(string provider) => BuildGroups([provider]);

    /// <summary>Provider order = chain order; regions with "English" first (the only ones that
    /// make a usable First Officer), then alphabetical; rows as the provider listed them.</summary>
    private IReadOnlyList<VoiceGroup> BuildGroups(IEnumerable<string> providers)
    {
        var groups = new List<VoiceGroup>();
        foreach (var provider in providers)
        {
            if (!_voiceLists.TryGetValue(provider, out var voices) || voices.Count == 0)
            {
                continue;
            }

            var byRegion = voices
                .GroupBy(v => v.Region, StringComparer.OrdinalIgnoreCase)
                .OrderBy(g => g.Key.Contains("English", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
            foreach (var region in byRegion)
            {
                groups.Add(new VoiceGroup($"{VoiceRef.DisplayName(provider)} · {region.Key}", region.ToArray()));
            }
        }

        return groups;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshVoicesAsync(null);
            StateHasChanged();
        }
    }

    /// <summary>Lists one provider ("windows" = both Windows providers) or, with null, every
    /// provider in parallel. Continuations run on the circuit's context, so the dictionaries
    /// are written one at a time.</summary>
    private async Task RefreshVoicesAsync(string? only)
    {
        _refreshingVoices = true;
        try
        {
            IEnumerable<string> targets = only switch
            {
                null => VoiceRef.Providers,
                "windows" => ["winrt", "sapi"],
                _ => [only],
            };
            await Task.WhenAll(targets.Select(ListOneProviderAsync));
            _allVoiceGroups = BuildGroups(VoiceRef.Providers);
        }
        finally
        {
            _refreshingVoices = false;
        }
    }

    private async Task ListOneProviderAsync(string provider)
    {
        if (!IsProviderConfigured(provider))
        {
            _voiceLists.Remove(provider);
            _voiceNotes[provider] = T["speechSettings.voiceNotes.notConfigured"];
            return;
        }

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var list = await VoiceCatalog.ListVoicesAsync(provider, _speech.Value, cts.Token);
            _voiceLists[provider] = list;
            _voiceNotes[provider] = list.Count == 0 ? T["speechSettings.voiceNotes.none"].Value : T["speechSettings.voiceNotes.count", list.Count].Value;
        }
        catch (Exception ex)
        {
            // Status + body snippet from the catalog; keys are never in the message.
            _voiceLists.Remove(provider);
            _voiceNotes[provider] = T["speechSettings.voiceNotes.failed", ex.Message];
        }
    }

