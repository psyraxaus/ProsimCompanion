@page "/settings/speech/{Section?}/{Tab?}"
@page "/speech"
@layout SettingsLayout
@using ProsimCompanion.Core.Speech
@using ProsimCompanion.Web.Settings
@inherits SettingsPageBase
@inject IOptionsMonitor<SpeechOptions> SpeechMonitor
@inject IOptionsMonitor<BriefingOptions> BriefingMonitor
@inject IOptionsMonitor<McduOptions> McduMonitor
@inject IOptionsMonitor<VoicesOptions> VoicesMonitor
@inject IOptionsMonitor<GroundCrewOptions> GroundCrewMonitor
@inject IOptionsMonitor<CabinOptions> CabinMonitor
@inject IOptionsMonitor<AccentOptions> AccentsMonitor
@inject IOptionsMonitor<SayIntentionsOptions> SayIntentionsMonitor
@inject IOptionsMonitor<SopOptions> SopMonitor
@inject IOptionsMonitor<PersonaOptions> PersonaMonitor
@inject IOptionsMonitor<CompanyOptions> CompanyMonitor
@inject IOptionsMonitor<DebriefOptions> DebriefMonitor
@inject IOptionsMonitor<DayOptions> DayMonitor
@inject IOptionsMonitor<TechLogOptions> TechLogMonitor
@inject IOptionsMonitor<LogbookOptions> LogbookMonitor
@inject IOptionsMonitor<AbnormalsOptions> AbnormalsMonitor
@inject IAudioDeviceCatalog DeviceCatalog
@inject IPttInputCapture PttCapture
@inject IVoiceCatalog VoiceCatalog
@inject ITtsUsageReadout TtsUsage
@inject NavigationManager Nav
@inject IStringLocalizer T

<PageTitle>@T["speechSettings.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["speechSettings.heading"]</h1>

@* Sections are URL-driven (settings/speech/{section}, ADR-0010); the rail lives in
   SettingsLayout. The speech master switch moved to Setup with the other pillar switches;
   Kokoro / Google / Windows voices / cache folder merged into one Voice Providers section.
   Since C3 (2026-10-19) every field is <OptionField Draft For />: what a field is — its
   control, texts, bounds, normalisation, parent switch — lives on the option property; this
   page keeps the ordered grouping and the lists only it can build (devices, live voices). *@

<LlmHealthBanner />

@if (CurrentSection == "status")
{
    <SpeechStatusPanel />
}
else if (CurrentSection == "general")
{
    <Section Title="@T["speechSettings.general.title"]" Hint="@T["speechSettings.general.hint"]">
        <OptionField Draft="_speech" For="o => o.LocalOnly" />
        <OptionField Draft="_speech" For="o => o.PilotSeat" />
        <OptionField Draft="_speech" For="o => o.EngineFlapCallouts" />
        <OptionField Draft="_speech" For="o => o.EngineStartCallouts" />
        <OptionField Draft="_speech" For="o => o.ChecklistReadThroughSatisfied" />
    </Section>

    <Section Title="@T["speechSettings.general.pacing.title"]" Hint="@T["speechSettings.general.pacing.hint"]" Advanced="true">
        <OptionField Draft="_speech" For="o => o.Humanize.Enabled" />
        <OptionField Draft="_speech" For="o => o.Humanize.Tempo" />
    </Section>

    <Section Title="@T["speechSettings.general.playback.title"]">
        <OptionField Draft="_speech" For="o => o.OutputDevice" Choices="OutputDeviceOptions()" />
        <OptionField Draft="_speech" For="o => o.Volume" />
        <OptionField Draft="_speech" For="o => o.IntercomFilter" />
    </Section>
}
else if (CurrentSection == "persona")
{
    @* FO persona (Phase 7, 2026-08-08) — settings.json only until the 2026-10-08 audit. *@
    <Section Title="@T["speechSettings.persona.title"]" Hint="@T["speechSettings.persona.hint"]">
        <OptionField Draft="_persona" For="o => o.Enabled" />
        <OptionField Draft="_persona" For="o => o.Name" />
        <OptionField Draft="_persona" For="o => o.Experience" />
        <OptionField Draft="_persona" For="o => o.Formality" />
        <OptionField Draft="_persona" For="o => o.Chattiness" />
    </Section>

    <Section Title="@T["speechSettings.persona.styles.title"]" Hint="@T["speechSettings.persona.styles.hint"]">
        <OptionField Draft="_persona" For="o => o.StyleBriefings" />
        <OptionField Draft="_persona" For="o => o.StyleDebrief" />
        <OptionField Draft="_persona" For="o => o.StyleAdvisories" />
        <OptionField Draft="_persona" For="o => o.VaryAcknowledgements" />
        <AdvancedFields>
            <OptionField Draft="_persona" For="o => o.StyleTimeoutMs" />
        </AdvancedFields>
        <div class="field-hint" style="max-width:640px;">
            @T["speechSettings.persona.styles.poolsBefore"] <code>config\phrases.json</code> @T["speechSettings.persona.styles.poolsMiddle"]
            <code>%LOCALAPPDATA%\ProsimCompanion</code> @T["speechSettings.persona.styles.poolsAfter"]
        </div>
    </Section>
}
else if (CurrentSection == "listening")
{
    <Section Title="@T["speechSettings.listening.title"]" Hint="@T["speechSettings.listening.hint"]">
        <OptionField Draft="_speech" For="o => o.RecognitionMode" />
        <div class="field">
            <label class="field-label">
                @T["speechSettings.listening.foPtt.label"]
                <span class="field-hint">@T["speechSettings.listening.foPtt.hint"]</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.PttBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("fo")'>
                        @(_capturing == "fo" ? T["speechSettings.common.pressNow"].Value : T["speechSettings.common.set"].Value)
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.PttBinding)'>@T["speechSettings.common.clear"]</button>
                    <span title="@T["speechSettings.common.lampTitle"]"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.OwnPttPressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        <div class="field">
            <label class="field-label">
                @T["speechSettings.listening.atcPtt.label"]
                <span class="field-hint">@T["speechSettings.listening.atcPtt.hint"]</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.AtcMuteBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("atc")'>
                        @(_capturing == "atc" ? T["speechSettings.common.pressNow"].Value : T["speechSettings.common.set"].Value)
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.AtcMuteBinding)'>@T["speechSettings.common.clear"]</button>
                    <span title="@T["speechSettings.common.lampTitle"]"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.AtcMutePressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        <OptionField Draft="_speech" For="o => o.AtcMuteSource" />
        @if (_captureMessage is not null)
        {
            <div class="field-hint">@_captureMessage</div>
        }
        <BoolField Label="@T["speechSettings.listening.joystickButtons.label"]" Hint="@T["speechSettings.listening.joystickButtons.hint"]"
                   More="@T["speechSettings.listening.joystickButtons.more"]"
                   @bind-Value="_listenJoysticks" />
        <div class="field">
            <label class="field-label">
                @T["speechSettings.listening.joysticks.label"]
                <span class="field-hint">@(_joysticks.Count == 0 ? T["speechSettings.listening.joysticks.notScanned"].Value : string.Join(", ", _joysticks.Select(j => $"{j.Name} (id {j.Id})")))</span>
            </label>
            <div class="field-control">
                <button type="button" class="btn secondary" disabled="@(_capturing is not null || _scanning)"
                        @onclick="ScanJoysticksAsync">@T["speechSettings.listening.joysticks.scan"]</button>
                @if (_scanMessage is not null)
                {
                    <span class="field-hint">@_scanMessage</span>
                }
            </div>
        </div>
        <div class="field-hint" style="max-width:640px;">
            @T["speechSettings.listening.setHint"]
        </div>
        <OptionField Draft="_speech" For="o => o.InputDevice" Choices="InputDeviceOptions()" />
        <OptionField Draft="_speech" For="o => o.TrackUnmatched" />
        <AdvancedFields>
            <OptionField Draft="_speech" For="o => o.SnappingThreshold" />
            <OptionField Draft="_speech" For="o => o.ConfirmBelowScore" />
            <OptionField Draft="_speech" For="o => o.ClarifierMinAglFt" />
            <OptionField Draft="_speech" For="o => o.RecognitionConfidenceThreshold" />
        </AdvancedFields>
    </Section>

    <Section Title="@T["speechSettings.listening.server.title"]" Hint="@T["speechSettings.listening.server.hint"]">
        <OptionField Draft="_speech" For="o => o.AsrBaseUrl" />
        <OptionField Draft="_speech" For="o => o.AsrApi" />
        <OptionField Draft="_speech" For="o => o.VadEngine" />
        <OptionField Draft="_speech" For="o => o.MuteMicWhileSpeaking" />
        <AdvancedFields>
            <OptionField Draft="_speech" For="o => o.MicTailAfterSpeakingMs" />
            <OptionField Draft="_speech" For="o => o.SelfEchoWindowSeconds" />
            <OptionField Draft="_speech" For="o => o.VadThreshold" />
            <OptionField Draft="_speech" For="o => o.VadEndSilenceMs" />
        </AdvancedFields>
    </Section>

    <Section Title="@T["speechSettings.listening.interphone.title"]" Hint="@T["speechSettings.listening.interphone.hint"]">
        <OptionField Draft="_speech" For="o => o.AcpTransmitGating" />
        <OptionField Draft="_speech" For="o => o.AcpIntKeyRequired" />
    </Section>
}
else if (CurrentSection == "sterile")
{
    <Section Title="@T["speechSettings.sterile.title"]" Hint="@T["speechSettings.sterile.hint"]">
        <OptionField Draft="_speech" For="o => o.SterileEnabled" />
        <OptionField Draft="_speech" For="o => o.SterileCockpitCeilingFt" />
        <OptionField Draft="_speech" For="o => o.SterileSuppressLow" />
        <OptionField Draft="_speech" For="o => o.SterileNormalPolicy" />
        <OptionField Draft="_speech" For="o => o.SterileExemptCabinReports" />
