@page "/settings/speech/{Section?}/{Tab?}"
@page "/speech"
@layout SettingsLayout
@using System.Text.Json
@using ProsimCompanion.Core.Speech
@inherits SettingsPageBase
@inject IOptionsMonitor<SpeechOptions> SpeechMonitor
@inject IOptionsMonitor<BriefingOptions> BriefingMonitor
@inject IOptionsMonitor<McduOptions> McduMonitor
@inject IOptionsMonitor<VoicesOptions> VoicesMonitor
@inject IOptionsMonitor<GroundCrewOptions> GroundCrewMonitor
@inject IOptionsMonitor<CabinOptions> CabinMonitor
@inject IOptionsMonitor<AccentOptions> AccentsMonitor
@inject IOptionsMonitor<SayIntentionsOptions> SayIntentionsMonitor
@inject IOptionsMonitor<SopOptions> SopMonitor
@inject IOptionsMonitor<PersonaOptions> PersonaMonitor
@inject IOptionsMonitor<CompanyOptions> CompanyMonitor
@inject IOptionsMonitor<DebriefOptions> DebriefMonitor
@inject IOptionsMonitor<DayOptions> DayMonitor
@inject IOptionsMonitor<TechLogOptions> TechLogMonitor
@inject IOptionsMonitor<LogbookOptions> LogbookMonitor
@inject IOptionsMonitor<AbnormalsOptions> AbnormalsMonitor
@inject IAudioDeviceCatalog DeviceCatalog
@inject IPttInputCapture PttCapture
@inject IVoiceCatalog VoiceCatalog
@inject ITtsUsageReadout TtsUsage
@inject NavigationManager Nav
@inject IStringLocalizer T

<PageTitle>@T["speechSettings.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["speechSettings.heading"]</h1>

@* Sections are URL-driven (settings/speech/{section}, ADR-0010); the rail lives in
   SettingsLayout. The speech master switch moved to Setup with the other pillar switches;
   Kokoro / Google / Windows voices / cache folder merged into one Voice Providers section. *@

<LlmHealthBanner />

@if (CurrentSection == "status")
{
    <SpeechStatusPanel />
}
else if (CurrentSection == "general")
{
    <Section Title="@T["speechSettings.general.title"]" Hint="@T["speechSettings.general.hint"]">
        <BoolField Label="@T["speechSettings.general.localOnly.label"]" Hint="@T["speechSettings.general.localOnly.hint"]" More="@T["speechSettings.general.localOnly.more"]"
                   @bind-Value="_speech.Value.LocalOnly" />
        <SelectField Label="@T["speechSettings.general.seat.label"]" Hint="@T["speechSettings.general.seat.hint"]" More="@T["speechSettings.general.seat.more"]" Options="PilotSeatOptions"
                     @bind-Value="_speech.Value.PilotSeat" />
        <BoolField Label="@T["speechSettings.general.engineFlap.label"]" Hint="@T["speechSettings.general.engineFlap.hint"]" More="@T["speechSettings.general.engineFlap.more"]"
                   @bind-Value="_speech.Value.EngineFlapCallouts" />
        <BoolField Label="@T["speechSettings.general.engineStart.label"]" Hint="@T["speechSettings.general.engineStart.hint"]" More="@T["speechSettings.general.engineStart.more"]"
                   @bind-Value="_speech.Value.EngineStartCallouts" />
        <BoolField Label="@T["speechSettings.general.readThrough.label"]" Hint="@T["speechSettings.general.readThrough.hint"]" More="@T["speechSettings.general.readThrough.more"]"
                   @bind-Value="_speech.Value.ChecklistReadThroughSatisfied" />
    </Section>

    <Section Title="@T["speechSettings.general.pacing.title"]" Hint="@T["speechSettings.general.pacing.hint"]" Advanced="true">
        <BoolField Label="@T["speechSettings.general.pacing.humanize.label"]" Hint="@T["speechSettings.general.pacing.humanize.hint"]" More="@T["speechSettings.general.pacing.humanize.more"]"
                   @bind-Value="_speech.Value.Humanize.Enabled" />
        <NumberField Label="@T["speechSettings.general.pacing.tempo.label"]" Hint="@T["speechSettings.general.pacing.tempo.hint"]" Step="0.1" Min="0.25" Max="4"
                     Disabled="@(!_speech.Value.Humanize.Enabled)"
                     @bind-Value="_speech.Value.Humanize.Tempo"
                     Default="_speech.Defaults.Humanize.Tempo" />
    </Section>

    <Section Title="@T["speechSettings.general.playback.title"]">
        <SelectField Label="@T["speechSettings.general.playback.outputDevice.label"]" Hint="@T["speechSettings.general.playback.outputDevice.hint"]"
                     Options="OutputDeviceOptions()"
                     @bind-Value="_speech.Value.OutputDevice" />
        <NumberField Label="@T["speechSettings.general.playback.volume"]" Suffix="%" Min="0" Max="100"
                     @bind-Value="_speech.Value.Volume"
                     Default="_speech.Defaults.Volume" />
        <BoolField Label="@T["speechSettings.general.playback.intercomFilter.label"]" Hint="@T["speechSettings.general.playback.intercomFilter.hint"]"
                   @bind-Value="_speech.Value.IntercomFilter" />
    </Section>
}
else if (CurrentSection == "persona")
{
    @* FO persona (Phase 7, 2026-08-08) — settings.json only until the 2026-10-08 audit. *@
    <Section Title="@T["speechSettings.persona.title"]" Hint="@T["speechSettings.persona.hint"]">
        <BoolField Label="@T["speechSettings.common.enabled"]" Hint="@T["speechSettings.persona.enabled.hint"]" More="@T["speechSettings.persona.enabled.more"]"
                   @bind-Value="_persona.Value.Enabled" />
        <TextField Label="@T["speechSettings.persona.name.label"]" Hint="@T["speechSettings.persona.name.hint"]" Placeholder="@T["speechSettings.persona.name.placeholder"]"
                   Disabled="@(!_persona.Value.Enabled)"
                   @bind-Value="_persona.Value.Name" />
        <SelectField Label="@T["speechSettings.persona.experience.label"]" Hint="@T["speechSettings.persona.experience.hint"]" Options="PersonaExperienceOptions"
                     Disabled="@(!_persona.Value.Enabled)"
                     @bind-Value="_persona.Value.Experience" />
        <SelectField Label="@T["speechSettings.persona.formality.label"]" Hint="@T["speechSettings.persona.formality.hint"]" Options="PersonaFormalityOptions"
                     Disabled="@(!_persona.Value.Enabled)"
                     @bind-Value="_persona.Value.Formality" />
        <NumberField Label="@T["speechSettings.persona.chattiness.label"]" Hint="@T["speechSettings.persona.chattiness.hint"]" More="@T["speechSettings.persona.chattiness.more"]" Min="0" Max="3"
                     Disabled="@(!_persona.Value.Enabled)"
                     @bind-Value="_persona.Value.Chattiness"
                     Default="_persona.Defaults.Chattiness" />
    </Section>

    <Section Title="@T["speechSettings.persona.styles.title"]" Hint="@T["speechSettings.persona.styles.hint"]">
        <BoolField Label="@T["speechSettings.persona.styles.briefings"]" Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.StyleBriefings" />
        <BoolField Label="@T["speechSettings.persona.styles.debrief"]" Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.StyleDebrief" />
        <BoolField Label="@T["speechSettings.persona.styles.advisories.label"]" Hint="@T["speechSettings.persona.styles.advisories.hint"]" More="@T["speechSettings.persona.styles.advisories.more"]"
                   Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.StyleAdvisories" />
        <BoolField Label="@T["speechSettings.persona.styles.vary.label"]" Hint="@T["speechSettings.persona.styles.vary.hint"]"
                   Disabled="@(!_persona.Value.Enabled)" @bind-Value="_persona.Value.VaryAcknowledgements" />
        <AdvancedFields>
            <NumberField Label="@T["speechSettings.persona.styles.budget.label"]" Hint="@T["speechSettings.persona.styles.budget.hint"]" Suffix="ms" Min="500" Step="100"
                         Disabled="@(!_persona.Value.Enabled || !_persona.Value.StyleAdvisories)"
                         @bind-Value="_persona.Value.StyleTimeoutMs"
                         Default="_persona.Defaults.StyleTimeoutMs" />
        </AdvancedFields>
        <div class="field-hint" style="max-width:640px;">
            @T["speechSettings.persona.styles.poolsBefore"] <code>config\phrases.json</code> @T["speechSettings.persona.styles.poolsMiddle"]
            <code>%LOCALAPPDATA%\ProsimCompanion</code> @T["speechSettings.persona.styles.poolsAfter"]
        </div>
    </Section>
}
else if (CurrentSection == "listening")
{
    <Section Title="@T["speechSettings.listening.title"]" Hint="@T["speechSettings.listening.hint"]">
        <SelectField Label="@T["speechSettings.listening.mode.label"]" Hint="@T["speechSettings.listening.mode.hint"]" More="@T["speechSettings.listening.mode.more"]" Options="RecognitionModeOptions"
                     @bind-Value="_speech.Value.RecognitionMode" />
        <div class="field">
            <label class="field-label">
                @T["speechSettings.listening.foPtt.label"]
                <span class="field-hint">@T["speechSettings.listening.foPtt.hint"]</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.PttBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("fo")'>
                        @(_capturing == "fo" ? T["speechSettings.common.pressNow"].Value : T["speechSettings.common.set"].Value)
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.PttBinding)'>@T["speechSettings.common.clear"]</button>
                    <span title="@T["speechSettings.common.lampTitle"]"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.OwnPttPressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        <div class="field">
            <label class="field-label">
                @T["speechSettings.listening.atcPtt.label"]
                <span class="field-hint">@T["speechSettings.listening.atcPtt.hint"]</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.AtcMuteBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("atc")'>
                        @(_capturing == "atc" ? T["speechSettings.common.pressNow"].Value : T["speechSettings.common.set"].Value)
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.AtcMuteBinding)'>@T["speechSettings.common.clear"]</button>
                    <span title="@T["speechSettings.common.lampTitle"]"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.AtcMutePressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        <SelectField Label="@T["speechSettings.listening.atcMuteSource.label"]" Hint="@T["speechSettings.listening.atcMuteSource.hint"]"
                     More="@T["speechSettings.listening.atcMuteSource.more"]"
                     Options="PttSwitchOptions"
                     @bind-Value="_speech.Value.AtcMuteSource" />
        @if (_captureMessage is not null)
        {
            <div class="field-hint">@_captureMessage</div>
        }
        <BoolField Label="@T["speechSettings.listening.joystickButtons.label"]" Hint="@T["speechSettings.listening.joystickButtons.hint"]"
                   More="@T["speechSettings.listening.joystickButtons.more"]"
                   @bind-Value="_listenJoysticks" />
        <div class="field">
            <label class="field-label">
                @T["speechSettings.listening.joysticks.label"]
                <span class="field-hint">@(_joysticks.Count == 0 ? T["speechSettings.listening.joysticks.notScanned"].Value : string.Join(", ", _joysticks.Select(j => $"{j.Name} (id {j.Id})")))</span>
            </label>
            <div class="field-control">
                <button type="button" class="btn secondary" disabled="@(_capturing is not null || _scanning)"
                        @onclick="ScanJoysticksAsync">@T["speechSettings.listening.joysticks.scan"]</button>
                @if (_scanMessage is not null)
                {
                    <span class="field-hint">@_scanMessage</span>
                }
            </div>
        </div>
        <div class="field-hint" style="max-width:640px;">
            @T["speechSettings.listening.setHint"]
        </div>
        <SelectField Label="@T["speechSettings.listening.inputDevice.label"]" Hint="@T["speechSettings.listening.inputDevice.hint"]"
                     Options="InputDeviceOptions()"
                     @bind-Value="_speech.Value.InputDevice" />
        <BoolField Label="@T["speechSettings.listening.trackUnmatched.label"]" Hint="@T["speechSettings.listening.trackUnmatched.hint"]" More="@T["speechSettings.listening.trackUnmatched.more"]"
                   @bind-Value="_speech.Value.TrackUnmatched" />
        <AdvancedFields>
            <NumberField Label="@T["speechSettings.listening.matchScore.label"]" Hint="@T["speechSettings.listening.matchScore.hint"]" More="@T["speechSettings.listening.matchScore.more"]" Step="0.05" Min="0.3" Max="1"
                         @bind-Value="_speech.Value.SnappingThreshold"
                         Default="_speech.Defaults.SnappingThreshold" />
            <NumberField Label="@T["speechSettings.listening.confirmBelow.label"]" Hint="@T["speechSettings.listening.confirmBelow.hint"]" More="@T["speechSettings.listening.confirmBelow.more"]" Step="0.05" Min="0.3" Max="1"
                         @bind-Value="_speech.Value.ConfirmBelowScore"
                         Default="_speech.Defaults.ConfirmBelowScore" />
            <NumberField Label="@T["speechSettings.listening.noConfirmBelow.label"]" Hint="@T["speechSettings.listening.noConfirmBelow.hint"]" More="@T["speechSettings.listening.noConfirmBelow.more"]" Suffix="ft" Min="0" Max="5000" Step="100"
                         @bind-Value="_speech.Value.ClarifierMinAglFt"
                         Default="_speech.Defaults.ClarifierMinAglFt" />
            <NumberField Label="@T["speechSettings.listening.offlineConfidence.label"]" Hint="@T["speechSettings.listening.offlineConfidence.hint"]" Step="0.05" Min="0" Max="1"
                         @bind-Value="_speech.Value.RecognitionConfidenceThreshold"
                         Default="_speech.Defaults.RecognitionConfidenceThreshold" />
        </AdvancedFields>
    </Section>

    <Section Title="@T["speechSettings.listening.server.title"]" Hint="@T["speechSettings.listening.server.hint"]">
        <TextField Label="@T["speechSettings.listening.server.asrUrl.label"]" Hint="@T["speechSettings.listening.server.asrUrl.hint"]" Kind="TextFieldKind.Url" Placeholder="http://192.168.1.50:8000"
                   @bind-Value="_speech.Value.AsrBaseUrl" />
        <SelectField Label="@T["speechSettings.listening.server.flavour.label"]" Hint="@T["speechSettings.listening.server.flavour.hint"]" More="@T["speechSettings.listening.server.flavour.more"]" Options="AsrApiOptions"
                     Disabled="@(string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl))"
                     @bind-Value="AsrApiKey" />
        <SelectField Label="@T["speechSettings.listening.server.vad.label"]" Hint="@T["speechSettings.listening.server.vad.hint"]" More="@T["speechSettings.listening.server.vad.more"]" Options="VadEngineOptions"
                     Disabled="@(string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl))"
                     @bind-Value="_speech.Value.VadEngine" />
        <BoolField Label="@T["speechSettings.listening.server.muteMic.label"]" Hint="@T["speechSettings.listening.server.muteMic.hint"]"
                   More="@T["speechSettings.listening.server.muteMic.more"]"
                   @bind-Value="_speech.Value.MuteMicWhileSpeaking" />
        <AdvancedFields>
            <NumberField Label="@T["speechSettings.listening.server.micTail.label"]" Hint="@T["speechSettings.listening.server.micTail.hint"]" Suffix="ms" Min="0" Max="3000" Step="50"
                         Disabled="@(!_speech.Value.MuteMicWhileSpeaking)"
                         @bind-Value="_speech.Value.MicTailAfterSpeakingMs"
                         Default="_speech.Defaults.MicTailAfterSpeakingMs" />
            <NumberField Label="@T["speechSettings.listening.server.ownWords.label"]" Hint="@T["speechSettings.listening.server.ownWords.hint"]" More="@T["speechSettings.listening.server.ownWords.more"]" Suffix="s" Min="0" Max="120" Step="1"
                         Disabled="@(!_speech.Value.MuteMicWhileSpeaking)"
                         @bind-Value="_speech.Value.SelfEchoWindowSeconds"
                         Default="_speech.Defaults.SelfEchoWindowSeconds" />
            <NumberField Label="@T["speechSettings.listening.server.vadThreshold.label"]" Hint="@T["speechSettings.listening.server.vadThreshold.hint"]" Step="0.05" Min="0.1" Max="0.95"
                         Disabled="@(!SileroSelected)"
                         @bind-Value="_speech.Value.VadThreshold"
                         Default="_speech.Defaults.VadThreshold" />
            <NumberField Label="@T["speechSettings.listening.server.endSilence.label"]" Hint="@T["speechSettings.listening.server.endSilence.hint"]" Suffix="ms" Min="200" Step="50"
                         Disabled="@(!SileroSelected)"
                         @bind-Value="_speech.Value.VadEndSilenceMs"
                         Default="_speech.Defaults.VadEndSilenceMs" />
        </AdvancedFields>
    </Section>

    <Section Title="@T["speechSettings.listening.interphone.title"]" Hint="@T["speechSettings.listening.interphone.hint"]">
        <BoolField Label="@T["speechSettings.listening.interphone.acpGating.label"]" Hint="@T["speechSettings.listening.interphone.acpGating.hint"]" More="@T["speechSettings.listening.interphone.acpGating.more"]"
                   @bind-Value="_speech.Value.AcpTransmitGating" />
        <BoolField Label="@T["speechSettings.listening.interphone.intRequired.label"]" Hint="@T["speechSettings.listening.interphone.intRequired.hint"]" More="@T["speechSettings.listening.interphone.intRequired.more"]"
                   Disabled="@(!_speech.Value.AcpTransmitGating)"
                   @bind-Value="_speech.Value.AcpIntKeyRequired" />
    </Section>
}
else if (CurrentSection == "sterile")
{
    <Section Title="@T["speechSettings.sterile.title"]" Hint="@T["speechSettings.sterile.hint"]">
        <BoolField Label="@T["speechSettings.common.enabled"]" Hint="@T["speechSettings.sterile.enabledHint"]" @bind-Value="_speech.Value.SterileEnabled" />
        <NumberField Label="@T["speechSettings.sterile.ceiling.label"]" Hint="@T["speechSettings.sterile.ceiling.hint"]" More="@T["speechSettings.sterile.ceiling.more"]" Suffix="ft MSL" Min="1000"
                     Disabled="@(!_speech.Value.SterileEnabled)"
                     @bind-Value="_speech.Value.SterileCockpitCeilingFt"
                     Default="_speech.Defaults.SterileCockpitCeilingFt" />
        <BoolField Label="@T["speechSettings.sterile.dropLow.label"]" Hint="@T["speechSettings.sterile.dropLow.hint"]"
                   Disabled="@(!_speech.Value.SterileEnabled)"
                   @bind-Value="_speech.Value.SterileSuppressLow" />
        <SelectField Label="@T["speechSettings.sterile.normalPolicy.label"]" Hint="@T["speechSettings.sterile.normalPolicy.hint"]" More="@T["speechSettings.sterile.normalPolicy.more"]" Options="NormalPolicyOptions"
                     Disabled="@(!_speech.Value.SterileEnabled)"
                     @bind-Value="NormalPolicyKey" />
        <BoolField Label="@T["speechSettings.sterile.exemptCabin.label"]" Hint="@T["speechSettings.sterile.exemptCabin.hint"]"
                   Disabled="@(!_speech.Value.SterileEnabled)"
                   @bind-Value="_speech.Value.SterileExemptCabinReports" />
    </Section>
}
else if (CurrentSection == "voices")
{
    <Section Title="@T["speechSettings.voices.fo.title"]" Hint="@T["speechSettings.voices.fo.hint"]">
        <VoicePickerField Label="@T["speechSettings.voices.fo.picker.label"]" Hint="@T["speechSettings.voices.fo.picker.hint"]" More="@T["speechSettings.voices.fo.picker.more"]" Groups="_allVoiceGroups" EmptyListHint="@VoicesEmptyHint"
                          @bind-Value="_speech.Value.FoVoice" />
        <div class="field">
            <label class="field-label">
                @T["speechSettings.voices.fo.lists.label"]
                <span class="field-hint">@T["speechSettings.voices.fo.lists.hint"]</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <button type="button" class="btn secondary" disabled="@_refreshingVoices" @onclick="() => RefreshVoicesAsync(null)">
                        @(_refreshingVoices ? T["speechSettings.common.refreshing"].Value : T["speechSettings.voices.fo.refreshAll"].Value)
                    </button>
                </div>
                <div class="field-hint" style="margin-top:6px;">
                    @foreach (var provider in VoiceRef.Providers)
                    {
                        <div><span class="mono">@VoiceRef.DisplayName(provider)</span>: @VoiceNote(provider)</div>
                    }
                </div>
            </div>
        </div>
    </Section>

    <Section Title="@T["speechSettings.voices.crew.title"]" Hint="@T["speechSettings.voices.crew.hint"]">
        <VoicePickerField Label="@T["speechSettings.voices.crew.purser.label"]" Hint="@T["speechSettings.voices.crew.purser.hint"]" Groups="_allVoiceGroups" BlankLabel="@T["speechSettings.common.sameAsFo"]" EmptyListHint="@VoicesEmptyHint"
                   @bind-Value="_voices.Value.Purser" />
        <BoolField Label="@T["speechSettings.voices.crew.purserFilter.label"]" Hint="@T["speechSettings.voices.crew.purserFilter.hint"]"
                   @bind-Value="_voices.Value.PurserIntercomFilter" />
        <VoicePickerField Label="@T["speechSettings.voices.crew.company.label"]" Hint="@T["speechSettings.voices.crew.company.hint"]" Groups="_allVoiceGroups" BlankLabel="@T["speechSettings.common.sameAsFo"]" EmptyListHint="@VoicesEmptyHint"
                   @bind-Value="_voices.Value.Company" />
        <BoolField Label="@T["speechSettings.voices.crew.companyFilter.label"]" Hint="@T["speechSettings.voices.crew.companyFilter.hint"]"
                   @bind-Value="_voices.Value.CompanyIntercomFilter" />
        <VoicePickerField Label="@T["speechSettings.voices.crew.ground.label"]" Hint="@T["speechSettings.voices.crew.ground.hint"]" Groups="_allVoiceGroups" BlankLabel="@T["speechSettings.common.sameAsFo"]" EmptyListHint="@VoicesEmptyHint"
                   @bind-Value="_voices.Value.Ground" />
        <BoolField Label="@T["speechSettings.voices.crew.groundFilter"]"
                   @bind-Value="_voices.Value.GroundIntercomFilter" />
    </Section>

    <Section Title="@T["speechSettings.voices.accents.title"]" Hint="@T["speechSettings.voices.accents.hint"]">
        <BoolField Label="@T["speechSettings.common.enabled"]" Hint="@T["speechSettings.voices.accents.enabled.hint"]" More="@T["speechSettings.voices.accents.enabled.more"]"
                   @bind-Value="_accents.Value.Enabled" />
        <TextField Label="@T["speechSettings.voices.accents.persona.label"]" Hint="@T["speechSettings.voices.accents.persona.hint"]"
                   Disabled="@(!_accents.Value.Enabled)"
                   @bind-Value="_accents.Value.GooglePersona" />
        <div class="field-hint" style="max-width:640px;">
            @T["speechSettings.voices.accents.overridesBefore"] <span class="mono">accents.overrides</span>
            @T["speechSettings.voices.accents.overridesAfter"]
        </div>
    </Section>
}
else if (CurrentSection == "groundCrew")
{
    <Section Title="@T["speechSettings.groundCrew.title"]" Hint="@T["speechSettings.groundCrew.hint"]">
        <BoolField Label="@T["speechSettings.common.enabled"]" @bind-Value="_groundCrew.Value.Enabled" />
        <BoolField Label="@T["speechSettings.groundCrew.requireInt.label"]" Hint="@T["speechSettings.groundCrew.requireInt.hint"]"
                   Disabled="@(!_groundCrew.Value.Enabled)"
                   @bind-Value="_groundCrew.Value.RequireIntChannel" />
        <AdvancedFields>
            <NumberField Label="@T["speechSettings.groundCrew.intGrace.label"]" Hint="@T["speechSettings.groundCrew.intGrace.hint"]" Suffix="s" Min="0"
                         Disabled="@(!_groundCrew.Value.Enabled || !_groundCrew.Value.RequireIntChannel)"
                         @bind-Value="_groundCrew.Value.IntChannelGraceSeconds"
                         Default="_groundCrew.Defaults.IntChannelGraceSeconds" />
        </AdvancedFields>
        <BoolField Label="@T["speechSettings.groundCrew.mechCall.label"]" Hint="@T["speechSettings.groundCrew.mechCall.hint"]"
                   Disabled="@(!_groundCrew.Value.Enabled)"
                   @bind-Value="_groundCrew.Value.MechCall" />
        <AdvancedFields>
            <NumberField Label="@T["speechSettings.groundCrew.hailWindow.label"]" Hint="@T["speechSettings.groundCrew.hailWindow.hint"]" Suffix="s" Min="3"
                         Disabled="@(!_groundCrew.Value.Enabled)"
                         @bind-Value="_groundCrew.Value.HailListenTimeoutSeconds"
                         Default="_groundCrew.Defaults.HailListenTimeoutSeconds" />
        </AdvancedFields>
    </Section>

    <Section Title="@T["speechSettings.groundCrew.upcalls.title"]" Hint="@T["speechSettings.groundCrew.upcalls.hint"]">
        <BoolField Label="@T["speechSettings.groundCrew.upcalls.groundPower"]" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnGroundPower" />
        <BoolField Label="@T["speechSettings.groundCrew.upcalls.chocks"]" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnChocks" />
        <BoolField Label="@T["speechSettings.groundCrew.upcalls.refuel.label"]" Hint="@T["speechSettings.groundCrew.upcalls.refuel.hint"]"
                   Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnRefuelComplete" />
        <BoolField Label="@T["speechSettings.common.cateringComplete"]" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnCateringComplete" />
    </Section>

    <Section Title="@T["speechSettings.groundCrew.wording.title"]" Hint="@T["speechSettings.groundCrew.wording.hint"]">
        <TextField Label="@T["speechSettings.common.hailReply"]" @bind-Value="_groundCrew.Value.HailReplyText" />
        <TextField Label="@T["speechSettings.groundCrew.wording.standingBy"]" @bind-Value="_groundCrew.Value.StandingByText" />
        <TextField Label="@T["speechSettings.groundCrew.wording.groundPower"]" @bind-Value="_groundCrew.Value.GroundPowerText" />
        <TextField Label="@T["speechSettings.groundCrew.wording.chocks"]" @bind-Value="_groundCrew.Value.ChocksText" />
