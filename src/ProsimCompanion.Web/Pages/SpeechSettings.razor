    </Section>

    <Section Title="Manual Procedure Overrides" Hint="Used when the FMS or SayIntentions cannot fill a field, or always in Manual mode">
        <TextField Label="Departure airport" Hint="ICAO, e.g. YSSY" @bind-Value="_briefing.Value.DepartureAirport" />
        <TextField Label="Departure runway" Hint="e.g. 16R" @bind-Value="_briefing.Value.DepartureRunway" />
        <TextField Label="SID" Hint="Identifier, e.g. FISHA1" @bind-Value="_briefing.Value.DepartureSid" />
        <TextField Label="Arrival airport" Hint="ICAO, e.g. YMML" @bind-Value="_briefing.Value.ArrivalAirport" />
        <TextField Label="Arrival runway" Hint="e.g. 34" @bind-Value="_briefing.Value.ArrivalRunway" />
        <TextField Label="STAR" Hint="Identifier, e.g. RAZZI4" @bind-Value="_briefing.Value.ArrivalStar" />
        <TextField Label="Approach" Hint="For example I16R. Empty picks the best published approach, ILS first." More="Ask the FO &quot;which approach&quot; to hear the candidates."
                   @bind-Value="_briefing.Value.ArrivalApproach" />
    </Section>

    <Section Title="Minima Capture" Hint="The FO asks for the minimums during the arrival brief">
        <BoolField Label="Interactive capture" Hint="The FO asks, reads back, and arms the minimums callouts." More="A value already set on the Status section skips the question. Works best with a transcription server."
                   @bind-Value="_briefing.Value.MinimaCaptureEnabled" />
        <AdvancedFields>
            <NumberField Label="Listen timeout" Hint="How long the FO waits for your answer." Suffix="s" Min="5"
                         Disabled="@(!_briefing.Value.MinimaCaptureEnabled)"
                         @bind-Value="_briefing.Value.MinimaListenTimeoutSeconds"
                         Default="_briefing.Defaults.MinimaListenTimeoutSeconds" />
            <NumberField Label="Max retries" Hint="Failed tries before the brief goes on as not briefed." Min="0"
                         Disabled="@(!_briefing.Value.MinimaCaptureEnabled)"
                         @bind-Value="_briefing.Value.MinimaMaxRetries"
                         Default="_briefing.Defaults.MinimaMaxRetries" />
        </AdvancedFields>
    </Section>

    <Section Title="Missed-Approach Re-brief" Hint="After a go-around the FO reads the missed approach">
        <BoolField Label="Enabled" Hint="Waits for the delay and gear up, so you fly first." More="Without published legs the FO gives a prompt instead."
                   @bind-Value="_briefing.Value.MissedApproachRebriefEnabled" />
        <AdvancedFields>
            <NumberField Label="Delay" Suffix="s" Min="0"
                         Disabled="@(!_briefing.Value.MissedApproachRebriefEnabled)"
                         @bind-Value="_briefing.Value.MissedApproachDelaySeconds"
                         Default="_briefing.Defaults.MissedApproachDelaySeconds" />
            <NumberField Label="Hard ceiling" Hint="Speaks by this time even if the gear never comes up." Suffix="s" Min="0"
                         Disabled="@(!_briefing.Value.MissedApproachRebriefEnabled)"
                         @bind-Value="_briefing.Value.MissedApproachHardCeilingSeconds"
                         Default="_briefing.Defaults.MissedApproachHardCeilingSeconds" />
        </AdvancedFields>
    </Section>

    <Section Title="LLM Styling" Hint="One language model for the briefing and debrief prose">
        <BoolField Label="Enabled" Hint="Off: plain templates only. Nothing leaves this PC."
                   @bind-Value="_briefing.Value.LlmEnabled" />
        <BoolField Label="Speak while the model writes"
                   Hint="The FO starts speaking after the first sentence, not after the whole reply. Each sentence is checked before it is spoken."
                   More="If a sentence has a wrong number, or the model stops, the plain template finishes the briefing. Nothing starts again from the top. Off: the FO waits for the whole reply (the old behaviour)."
                   Disabled="@(!_briefing.Value.LlmEnabled)"
                   @bind-Value="_briefing.Value.StreamLlm" />
        <SelectField Label="API flavour" Hint="Pick Ollama when the address is an Ollama server." More="Only the Ollama type can switch model thinking off." Options="LlmApiOptions"
                     Disabled="@(!_briefing.Value.LlmEnabled)"
                     @bind-Value="LlmApiKey" />
        <TextField Label="Base URL" Hint="OpenAI style: the API root, e.g. https://api.openai.com/v1. Ollama: the server root, e.g. http://localhost:11434."
                   Disabled="@(!_briefing.Value.LlmEnabled)"
                   @bind-Value="_briefing.Value.LlmBaseUrl" />
        <TextField Label="API key" Hint="Never logged. Empty for local servers without a key."
                   Disabled="@(!_briefing.Value.LlmEnabled)"
                   @bind-Value="_briefing.Value.LlmApiKey" />
        <SecretUnreadableHint Path="briefing:llmApiKey" />
        <TextField Label="Model" Hint="Model name, e.g. gpt-4o-mini or qwen3.6:27b. Empty turns styling off."
                   Disabled="@(!_briefing.Value.LlmEnabled)"
                   @bind-Value="_briefing.Value.LlmModel" />
        <BoolField Label="Enable model thinking (slower, deeper reasoning)" Hint="Lets a thinking model reason first. Slow: often 10 s or more." More="Ollama only. Leave off for briefings."
                   Disabled="@(!_briefing.Value.LlmEnabled || _briefing.Value.LlmApi != LlmApiKind.Ollama)"
                   @bind-Value="_briefing.Value.LlmEnableThinking" />
        <AdvancedFields>
            <NumberField Label="Max tokens" Min="64"
                         Disabled="@(!_briefing.Value.LlmEnabled)"
                         @bind-Value="_briefing.Value.LlmMaxTokens"
                         Default="_briefing.Defaults.LlmMaxTokens" />
            <NumberField Label="Timeout" Hint="Per call. A styled briefing may make two calls." Suffix="s" Min="5"
                         Disabled="@(!_briefing.Value.LlmEnabled)"
                         @bind-Value="_briefing.Value.LlmTimeoutSeconds"
                         Default="_briefing.Defaults.LlmTimeoutSeconds" />
        </AdvancedFields>
        <div class="field-hint" style="max-width:640px;">
            Save, then press "Test LLM connection" on the <a href="settings/speech/status">Status section</a>.
        </div>
    </Section>

    <Section Title="Ask the First Officer" Hint="Free-form questions, answered by the language model from live facts. Spoken only — never acted on">
        <BoolField Label="Enabled"
                   Hint="Ask in plain words: 'what is our fuel on board', 'how long to top of descent', 'tell me the destination weather'. The FO answers from what the app knows right now."
                   More="Needs the LLM above and the LAN speech recognition server (the offline Windows engine only hears exact phrases). Every number in the answer is checked against the live facts; an unverifiable answer becomes 'I don't have a verified answer for that'. A question is tried only after every exact phrase has been ruled out, so nothing you could say before changes. In the sterile cockpit (below the sterile ceiling in climb, descent and approach) a question is heard but not answered."
                   @bind-Value="_speech.Value.FoQuestions.Enabled" />
        <BoolField Label="Small talk and fun facts"
                   Hint="Ask anything: 'who is better, Chelsea or Arsenal', 'tell me a fun fact', 'what is the capital of Peru'. The FO answers from general knowledge, in character, one or two light sentences."
                   More="A question that mentions the flight (fuel, weights, speeds, altitude, runway, weather, times, passengers…) still takes the strict path: fact sheet only, every number verified. On the small-talk path numbers are not verified — they are trivia — but a sentence about this flight with a figure in it is refused and the FO says 'I don't have a verified answer for that'. With this on, no lead-in word is needed: any sentence of four words or more that matched nothing else goes to the FO. Still speech only, still silent in the sterile cockpit."
                   Disabled="@(!_speech.Value.FoQuestions.Enabled)"
                   @bind-Value="_speech.Value.FoQuestions.SmallTalk" />
        <BoolField Label="'What are we flying over?'"
                   Hint="Ask 'what are we flying over', 'where are we', 'what is that city on the left'. The FO names the country, the mountains or sea, and the nearest towns with distance and side — at once, from an atlas in the app — then adds a fact or two about them."
                   More="The position line comes from a built-in offline atlas (Natural Earth outlines, GeoNames towns — see the manual for the attribution), never from the language model, so it needs no internet and is always the same for the same spot. The facts after it come from the LLM: with 'Wikipedia facts' off, from its own knowledge, like small talk (numbers unverified, nothing about this flight). No lead-in word or minimum length is needed for these phrases. Works with small talk off."
                   Disabled="@(!_speech.Value.FoQuestions.Enabled)"
                   @bind-Value="_speech.Value.FoQuestions.WhereAreWe" />
        <BoolField Label="Wikipedia facts"
                   Hint="With the switch above: fetch a short Wikipedia summary of the nearest town and have the FO take its facts from that instead of the model's memory."
                   More="One small request to en.wikipedia.org per place, three-second limit, answered from a cache after the first time. If it fails or finds nothing, the FO still gives the position and falls back to the model's own knowledge. Nothing about you or the flight is sent — only the place name."
                   Disabled="@(!_speech.Value.FoQuestions.Enabled || !_speech.Value.FoQuestions.WhereAreWe)"
                   @bind-Value="_speech.Value.FoQuestions.WikipediaFacts" />
        <TextField Label="Question lead-ins" Hint="Comma-separated. An utterance must start with one of these to count as a question (not needed with small talk on)."
                   Disabled="@(!_speech.Value.FoQuestions.Enabled)"
                   @bind-Value="_speech.Value.FoQuestions.LeadIns" />
        <NumberField Label="Minimum words" Hint="Shorter utterances are never questions — they are exact phrases, misheard." Min="1" Max="10"
                     Disabled="@(!_speech.Value.FoQuestions.Enabled)"
                     @bind-Value="_speech.Value.FoQuestions.MinimumWords"
                     Default="_speech.Defaults.FoQuestions.MinimumWords" />
        <NumberField Label="Time budget" Hint="From the question to the first spoken word. After this the FO gives up with the fixed line." Suffix="s" Min="1" Max="60"
                     Disabled="@(!_speech.Value.FoQuestions.Enabled)"
                     @bind-Value="_speech.Value.FoQuestions.TimeBudgetSeconds"
                     Default="_speech.Defaults.FoQuestions.TimeBudgetSeconds" />
        <NumberField Label="'Stand by' after" Hint="Silence before the FO says 'Stand by'. 0 = never." Suffix="s" Min="0" Max="30"
                     Disabled="@(!_speech.Value.FoQuestions.Enabled)"
                     @bind-Value="_speech.Value.FoQuestions.StandBySeconds"
                     Default="_speech.Defaults.FoQuestions.StandBySeconds" />
    </Section>

    <Section Title="Region Facts" Hint="In the cruise the FO now and then offers a short fact about the country or sea below. Unprompted, spoken only">
        <BoolField Label="Enabled"
                   Hint="Every fifteen to thirty minutes in the cruise (your interval), the FO mentions something about the region you are over: 'We're over the Netherlands — a quarter of what you see down there sits below sea level.' Never the same region twice in a flight."
                   More="The region comes from the same built-in atlas as 'what are we flying over?' (no internet needed). The fact comes from the language model when it is on and healthy (two sentences, the same guard as the place facts — nothing about this flight), otherwise from the curated file region-facts.json in %LOCALAPPDATA%\ProsimCompanion\config — edit it to add your own, keyed by country code (FR, GB) or 'sea:North Sea'. Silent outside the cruise, while the flight is not live, while the FO's ear is paused, in the sterile cockpit, after 'quiet please', and over places the atlas does not name. With the FO persona on, a curated fact is spoken in the persona's voice with every figure locked."
                   @bind-Value="_speech.Value.RegionFacts.Enabled" />
        <NumberField Label="Shortest gap" Hint="Minutes between facts, at least. The first fact comes this long (plus the random share) after the cruise begins." Suffix="min" Min="1" Max="240"
                     Disabled="@(!_speech.Value.RegionFacts.Enabled)"
                     @bind-Value="_speech.Value.RegionFacts.MinIntervalMinutes"
                     Default="_speech.Defaults.RegionFacts.MinIntervalMinutes" />
        <NumberField Label="Longest gap" Hint="Each gap is drawn at random between the two, so it never feels like a timer." Suffix="min" Min="1" Max="480"
                     Disabled="@(!_speech.Value.RegionFacts.Enabled)"
                     @bind-Value="_speech.Value.RegionFacts.MaxIntervalMinutes"
                     Default="_speech.Defaults.RegionFacts.MaxIntervalMinutes" />
        <NumberField Label="Facts per flight" Hint="At most. Resets with the cabin's once-per-flight reports (cold and dark, or a new preflight after shutdown)." Min="1" Max="20"
                     Disabled="@(!_speech.Value.RegionFacts.Enabled)"
                     @bind-Value="_speech.Value.RegionFacts.MaxPerFlight"
                     Default="_speech.Defaults.RegionFacts.MaxPerFlight" />
        <BoolField Label="Facts from the language model"
                   Hint="Ask the LLM above for the fact when it is configured and healthy; off, or with the model down, only the curated file speaks."
                   More="Model facts stream sentence by sentence like the place facts; a sentence about this flight with a figure in it is refused, and if the model says nothing within twenty seconds the curated file speaks instead. Numbers in a model fact are trivia and are not verified."
                   Disabled="@(!_speech.Value.RegionFacts.Enabled)"
                   @bind-Value="_speech.Value.RegionFacts.LlmFacts" />
    </Section>

    <Section Title="Wake-on-LAN" Hint="Moved to Setup" Advanced="true">
        <div class="field-hint" style="max-width:640px;">
            The PCs the app wakes at startup — the language-model box, the speech server, any other — are one list on
            <a href="settings">Settings → Setup → Wake-on-LAN</a>. An old single-PC setting from this page is moved there the first time Setup opens.
        </div>
    </Section>
}
else if (CurrentSection == "callouts")
{
    <Section Title="Standard Callouts" Hint="The FO's speed, altitude and rollout calls.">
        <BoolField Label="Callouts enabled" Hint="Master switch for every standard callout." More="Applies live. The individual callout texts, altitude callouts, the other flow-monitor reminders and the weather advisories are edited in the sop section of settings.json for now."
                   @bind-Value="_sop.Value.CalloutsEnabled" />
    </Section>

    <Section Title="Flap Placards" Hint="Maximum speed per flap lever position (VFE). The FO warns when you approach or exceed it, and checks your flap calls against it.">
        <div class="field-hint" style="margin-bottom:8px; max-width:640px;">
            ProSim reports the lever in six steps: UP, 1, 1+F, 2, 3, FULL. Lever 1 gives 1+F on the
            ground and on take-off; the FO reads the step ProSim reports.
        </div>
        <div class="services-header">
            <span>Lever</span><span>Limit (kt)</span><span></span><span></span><span></span>
        </div>
        @for (var i = 0; i < _sop.Value.FlapPlacards.Count; i++)
        {
            var row = _sop.Value.FlapPlacards[i];
            <div class="service-row">
                <span class="row-value-mono">@SopOptions.FlapHandleLabel(row.FlapHandle)</span>
                <input class="number-input" type="number" min="0" max="400" step="1" @bind="row.MaxKt" />
                <span></span><span></span><span></span>
            </div>
        }
        <div class="preset-row" style="margin-top:8px;">
            <button type="button" class="btn secondary" title="A322 figures: 230 / 215 / 200 / 185 / 177"
                    @onclick="ResetFlapPlacards">Reset to A320 defaults</button>
        </div>
    </Section>

    <Section Title="Gear Limits" Hint="VLE is the limit with the gear down. VLO is the limit while the gear moves; the FO refuses a gear call above it.">
        <NumberField Label="Gear extended (VLE)" Suffix="kt" Min="0" Max="400"
                     Hint="The FO warns when you fly faster than this with the gear down. 0 turns the warning off."
                     @bind-Value="_sop.Value.GearMaxKt"
                     Default="_sop.Defaults.GearMaxKt" />
        <NumberField Label="Gear extension (VLO down)" Suffix="kt" Min="0" Max="400"
                     Hint='"Gear down" is refused above this speed. 0 turns the check off.'
                     @bind-Value="_sop.Value.GearExtendMaxKt"
                     Default="_sop.Defaults.GearExtendMaxKt" />
        <NumberField Label="Gear retraction (VLO up)" Suffix="kt" Min="0" Max="400"
                     Hint='"Gear up" is refused above this speed. 0 turns the check off.'
                     @bind-Value="_sop.Value.GearRetractMaxKt"
                     Default="_sop.Defaults.GearRetractMaxKt" />
        <BoolField Label="Gear still down reminder"
                   Hint='The FO says "gear still down" when you climb with the gear down.'
                   @bind-Value="_sop.Value.FlowMonitor.GearStillDown.Enabled" />
        <NumberField Label="Gear up by" Suffix="ft AGL" Min="0" Max="10000" Step="50"
                     Hint="The reminder comes when you climb above this height with the gear down."
                     Disabled="@(!_sop.Value.FlowMonitor.GearStillDown.Enabled)"
                     @bind-Value="_sop.Value.FlowMonitor.GearUpAboveAglFt"
                     Default="_sop.Defaults.FlowMonitor.GearUpAboveAglFt" />
    </Section>

    <Section Title="Approach Gates" Hint="The heights where the FO checks that the approach is stable. Airlines differ — set your own SOP.">
        <BoolField Label="Stable approach check"
                   Hint="At each gate the FO checks speed, sink rate, gear and flaps, and calls an unstable approach."
                   More="A gate is checked once, when you descend through its height on the radio altimeter. The highest gate is checked first. The speed band is measured from VLS."
                   @bind-Value="_sop.Value.Stabilized.Enabled" />
        @for (var i = 0; i < _sop.Value.ApproachGates.Count; i++)
        {
            var gate = _sop.Value.ApproachGates[i];
            var gateOff = !_sop.Value.Stabilized.Enabled || !gate.Enabled;
            <div class="gate-block">
                <div class="gate-title">
                    <span>Gate @(i + 1) — @gate.AglFt ft</span>
                    <button type="button" class="btn secondary" title="Remove this gate"
                            @onclick="() => RemoveApproachGate(gate)">Remove</button>
                </div>
                <BoolField Label="Gate in use" @bind-Value="gate.Enabled" Disabled="@(!_sop.Value.Stabilized.Enabled)" />
                <NumberField Label="Height" Suffix="ft AGL" Min="0" Max="5000" Step="50"
                             Hint="Radio altitude of the gate. 0 switches the gate off."
                             Disabled="@gateOff" @bind-Value="gate.AglFt" />
                <BoolField Label="Gear down required" Disabled="@gateOff" @bind-Value="gate.RequireGearDown" />
                <SelectField Label="Minimum flap lever" Options="FlapLeverOptions" Disabled="@gateOff"
                             Hint="The flap lever must be at this position or further."
                             Value="@gate.RequireFlapHandleAtLeast.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             ValueChanged="@(value => gate.RequireFlapHandleAtLeast = ParseFlapLever(value, gate.RequireFlapHandleAtLeast))" />
                <NumberField Label="Speed below VLS allowed" Suffix="kt" Min="0" Max="50" Step="1"
                             Disabled="@gateOff" @bind-Value="gate.SpeedBandBelowVls" />
                <NumberField Label="Speed above VLS allowed" Suffix="kt" Min="0" Max="50" Step="1"
                             Disabled="@gateOff" @bind-Value="gate.SpeedBandAboveVls" />
                <NumberField Label="Maximum sink rate" Suffix="fpm" Min="0" Max="3000" Step="50"
                             Disabled="@gateOff" @bind-Value="gate.MaxSinkRateFpm" />
                <BoolField Label='Say "stabilized" when the gate passes'
                           Hint="Off: the FO speaks at this gate only when the approach is unstable."
                           Disabled="@gateOff" @bind-Value="gate.AnnounceStabilized" />
            </div>
        }
        <div class="preset-row" style="margin-top:12px;">
            <button type="button" class="btn secondary" title="Add a gate, for example a 1500 ft gate"
                    @onclick="AddApproachGate">Add gate</button>
            <button type="button" class="btn secondary" title="Two gates: 1000 ft (flap 2 or more) and 500 ft (flap 3 or more), gear down at both"
                    @onclick="ResetApproachGates">Reset to defaults</button>
        </div>
        <AdvancedFields Label="Wording and thrust check hidden">
            <div class="gate-block">
                <TextField Label="Stable call" Disabled="@(!_sop.Value.Stabilized.Enabled)"
                           @bind-Value="_sop.Value.Stabilized.StableText" />
                <TextField Label="Unstable call" Disabled="@(!_sop.Value.Stabilized.Enabled)"
                           @bind-Value="_sop.Value.Stabilized.UnstableText" />
                <BoolField Label="Thrust must be spooled up"
                           Hint="Adds a thrust check to every gate: the average N1 must be at or above the figure below."
                           Disabled="@(!_sop.Value.Stabilized.Enabled)"
                           @bind-Value="_sop.Value.Stabilized.RequireThrustStabilized" />
                <NumberField Label="Minimum N1" Suffix="%" Min="0" Max="100" Step="1"
                             Disabled="@(!_sop.Value.Stabilized.Enabled || !_sop.Value.Stabilized.RequireThrustStabilized)"
                             @bind-Value="_sop.Value.Stabilized.MinStabilizedN1"
                             Default="_sop.Defaults.Stabilized.MinStabilizedN1" />
            </div>
        </AdvancedFields>
    </Section>

    <Section Title="Placard Advisories" Hint="What the FO says when a limit is close or exceeded" Advanced="true">
        <BoolField Label="Enabled" @bind-Value="_sop.Value.PlacardAdvisory.Enabled" />
        <NumberField Label="Warn within" Suffix="kt" Min="0" Max="50"
                     Hint="Speak the approaching call this close below the limit, while accelerating."
                     Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                     @bind-Value="_sop.Value.PlacardAdvisory.WarnWithinKt"
                     Default="_sop.Defaults.PlacardAdvisory.WarnWithinKt" />
        <NumberField Label="Cooldown" Suffix="s" Min="0" Max="600"
                     Hint="Minimum time between two advisories of the same kind."
                     Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                     @bind-Value="_sop.Value.PlacardAdvisory.CooldownSeconds"
                     Default="_sop.Defaults.PlacardAdvisory.CooldownSeconds" />
        <TextField Label="Approaching flap limit" Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                   @bind-Value="_sop.Value.PlacardAdvisory.ApproachingText" />
        <TextField Label="Flap limit exceeded" Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                   @bind-Value="_sop.Value.PlacardAdvisory.ExceededText" />
        <TextField Label="Gear limit exceeded" Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                   @bind-Value="_sop.Value.PlacardAdvisory.GearExceededText" />
    </Section>

    <Section Title="In-flight monitoring" Hint="Four FO duties that are off until you turn them on. Each needs a live flight and only ever speaks.">
        <BoolField Label="Fuel check"
                   Hint="In the cruise the FO compares fuel on board with the SimBrief plan at your position and gives the estimated landing fuel. Also on 'fuel check'."
                   More="Needs a SimBrief OFP with a navlog and the aircraft position. Without them: fuel on board minus fuel flow times the time to the ETA. A shortfall beyond the margin is spoken at High. Silent in sterile phases."
                   @bind-Value="_sop.Value.Monitoring.FuelCheck.Enabled" />
        <NumberField Label="Fuel check every" Suffix="min" Min="0" Max="120"
                     Hint="Minutes between automatic checks in the cruise; 0 = on request only"
                     Disabled="@(!_sop.Value.Monitoring.FuelCheck.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.FuelCheck.IntervalMinutes"
                     Default="_sop.Defaults.Monitoring.FuelCheck.IntervalMinutes" />
        <NumberField Label="Shortfall margin" Suffix="kg" Min="0" Max="5000"
                     Hint="This far below plan (or more) the check is spoken as a warning"
                     Disabled="@(!_sop.Value.Monitoring.FuelCheck.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.FuelCheck.ShortfallMarginKg"
                     Default="_sop.Defaults.Monitoring.FuelCheck.ShortfallMarginKg" />
        <NumberField Label="Counts as on plan within" Suffix="kg" Min="0" Max="2000"
                     Hint="Smaller differences are 'on plan' instead of a figure"
                     Disabled="@(!_sop.Value.Monitoring.FuelCheck.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.FuelCheck.OnPlanWithinKg"
                     Default="_sop.Defaults.Monitoring.FuelCheck.OnPlanWithinKg" />

        <BoolField Label="Takeoff gross error check"
                   Hint="One line before takeoff: the aircraft's weights against the final loadsheet, and the FMS flaps, flex and V-speeds against the last takeoff performance calculation. Also on 'gross error check'."
                   More="Runs once per departure when the final loadsheet is out and the V-speeds are in the FMS. The FMS INIT weights cannot be read from ProSim, so the aircraft's own zero fuel weight and fuel on board stand in for them. The performance figures come from the Performance page's last calculation."
                   @bind-Value="_sop.Value.Monitoring.GrossErrorCheck.Enabled" />
        <BoolField Label="Automatic" Hint="Off = only when you ask for it"
                   Disabled="@(!_sop.Value.Monitoring.GrossErrorCheck.Enabled)"
                   @bind-Value="_sop.Value.Monitoring.GrossErrorCheck.Automatic" />
        <NumberField Label="Zero fuel weight tolerance" Suffix="kg" Min="0" Max="5000"
                     Disabled="@(!_sop.Value.Monitoring.GrossErrorCheck.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.GrossErrorCheck.ZfwToleranceKg"
                     Default="_sop.Defaults.Monitoring.GrossErrorCheck.ZfwToleranceKg" />
        <NumberField Label="Block fuel tolerance" Suffix="kg" Min="0" Max="5000"
                     Disabled="@(!_sop.Value.Monitoring.GrossErrorCheck.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.GrossErrorCheck.BlockFuelToleranceKg"
                     Default="_sop.Defaults.Monitoring.GrossErrorCheck.BlockFuelToleranceKg" />
        <NumberField Label="V-speed tolerance" Suffix="kt" Min="0" Max="20"
                     Disabled="@(!_sop.Value.Monitoring.GrossErrorCheck.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.GrossErrorCheck.VSpeedToleranceKt"
                     Default="_sop.Defaults.Monitoring.GrossErrorCheck.VSpeedToleranceKt" />
        <NumberField Label="Flex tolerance" Suffix="°C" Min="0" Max="20"
                     Disabled="@(!_sop.Value.Monitoring.GrossErrorCheck.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.GrossErrorCheck.FlexToleranceC"
                     Default="_sop.Defaults.Monitoring.GrossErrorCheck.FlexToleranceC" />

        <BoolField Label="Destination weather watch"
                   Hint="From the cruise on, the FO tells you when the destination's visibility or ceiling crosses your limit, when the ATIS letter changes, or when the wind turns into a tailwind on the planned landing runway."
                   More="Uses the weather cards' own refresh, no extra polling. The alternate's weather is added once the destination is below a limit. Each kind of change is spoken at most once in the quiet period."
                   @bind-Value="_sop.Value.Monitoring.DestinationWeather.Enabled" />
        <NumberField Label="Visibility limit" Suffix="m" Min="0" Max="10000"
                     Disabled="@(!_sop.Value.Monitoring.DestinationWeather.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.DestinationWeather.VisibilityThresholdM"
                     Default="_sop.Defaults.Monitoring.DestinationWeather.VisibilityThresholdM" />
        <NumberField Label="Ceiling limit" Suffix="ft" Min="0" Max="5000"
                     Disabled="@(!_sop.Value.Monitoring.DestinationWeather.Enabled)"
                     @bind-Value="_sop.Value.Monitoring.DestinationWeather.CeilingThresholdFt"
                     Default="_sop.Defaults.Monitoring.DestinationWeather.CeilingThresholdFt" />
        <NumberField Label="Tailwind limit" Suffix="kt" Min="0" Max="30"
