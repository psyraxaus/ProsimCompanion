@code {
    [Parameter]
    public string? Section { get; set; }

    /// <summary>Provider tab for /settings/speech/providers/{tab} — deep links from the manual (2026-10-12).</summary>
    [Parameter]
    public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (CurrentSection == "providers" && !string.IsNullOrWhiteSpace(Tab))
        {
            ProviderTab = Tab.ToLowerInvariant();
        }
    }

    /// <summary>The old "crew" and "elevenlabs" routes (manual, bookmarks) land on the Voices page
    /// and the ElevenLabs provider tab (2026-10-12).</summary>
    private string CurrentSection => Section?.ToLowerInvariant() switch
    {
        "crew" => "voices",
        "elevenlabs" => "providers",
        _ => SettingsNav.ResolveSection(SettingsNav.SpeechSections, Section),
    };

    private void ResetFlapPlacards() => _sop.Value.FlapPlacards = [.. SopOptions.DefaultFlapPlacards];

    // ---- Approach gates (airline SOPs differ: 1000/500, 1000 only, an extra 1500 ft gate) ----

    private void ResetApproachGates() => _sop.Value.ApproachGates = [.. SopOptions.DefaultApproachGates];

    private void RemoveApproachGate(ApproachGate gate) => _sop.Value.ApproachGates.Remove(gate);

    private void AddApproachGate()
    {
        // Above the highest gate in use, so the new one never lands on an existing height.
        var top = _sop.Value.ApproachGates.Count == 0 ? 500 : _sop.Value.ApproachGates.Max(g => g.AglFt);
        _sop.Value.ApproachGates.Add(new ApproachGate { AglFt = top + 500, AnnounceStabilized = false });
        SopOptions.SyncApproachGateNames(_sop.Value.ApproachGates);
    }

    private bool KokoroOff => string.IsNullOrWhiteSpace(_speech.Value.KokoroBaseUrl);

    // Voices (owner, 2026-10-12): one live list per provider, read off the DRAFT options so a
    // first-time setup can pick before saving. Nothing is pre-populated — only what each
    // service reports. The Voices page shows every provider's list grouped provider → region;
    // each provider tab shows its own list for the fallback voice.
    private readonly Dictionary<string, IReadOnlyList<VoiceEntry>> _voiceLists = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _voiceNotes = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<VoiceGroup> _allVoiceGroups = [];
    private bool _refreshingVoices;

    private static readonly (string Id, string Label)[] ProviderTabs =
    [
        ("kokoro", "Kokoro"),
        ("elevenlabs", "ElevenLabs"),
        ("google", "Google"),
        ("windows", "Windows"),
    ];

    private string _providerTab = "kokoro";

    /// <summary>The open provider tab; the old /settings/speech/elevenlabs route (manual,
    /// bookmarks) opens the ElevenLabs tab.</summary>
    private string ProviderTab
    {
        get => _providerTab;
        set => _providerTab = ProviderTabs.Any(t => t.Id == value) ? value : "kokoro";
    }

    /// <summary>Switches the tab and puts it in the URL, so a refresh and the Back button keep it.</summary>
    private void OpenProviderTab(string id)
    {
        ProviderTab = id;
        Nav.NavigateTo($"settings/speech/providers/{id}", replace: true);
    }

    private bool IsProviderConfigured(string provider) => provider switch
    {
        "kokoro" => !KokoroOff,
        "elevenlabs" => !ElevenLabsOff,
        "google" => !GoogleOff,
        _ => true,
    };

    private string VoiceNote(string provider)
        => _voiceNotes.TryGetValue(provider, out var note) ? note
            : IsProviderConfigured(provider) ? T["speechSettings.voiceNotes.notListed"].Value : T["speechSettings.voiceNotes.notConfigured"].Value;

    private IReadOnlyList<VoiceGroup> GroupsFor(string provider) => SpeechPageRules.BuildVoiceGroups([provider], _voiceLists);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshVoicesAsync(null);
            StateHasChanged();
        }
    }

    /// <summary>Lists one provider ("windows" = both Windows providers) or, with null, every
    /// provider in parallel. Continuations run on the circuit's context, so the dictionaries
    /// are written one at a time.</summary>
    private async Task RefreshVoicesAsync(string? only)
    {
        _refreshingVoices = true;
        try
        {
            IEnumerable<string> targets = only switch
            {
                null => VoiceRef.Providers,
                "windows" => ["winrt", "sapi"],
                _ => [only],
            };
            await Task.WhenAll(targets.Select(ListOneProviderAsync));
            _allVoiceGroups = SpeechPageRules.BuildVoiceGroups(VoiceRef.Providers, _voiceLists);
        }
        finally
        {
            _refreshingVoices = false;
        }
    }

    private async Task ListOneProviderAsync(string provider)
    {
        if (!IsProviderConfigured(provider))
        {
            _voiceLists.Remove(provider);
            _voiceNotes[provider] = T["speechSettings.voiceNotes.notConfigured"];
            return;
        }

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var list = await VoiceCatalog.ListVoicesAsync(provider, _speech.Value, cts.Token);
            _voiceLists[provider] = list;
            _voiceNotes[provider] = list.Count == 0 ? T["speechSettings.voiceNotes.none"].Value : T["speechSettings.voiceNotes.count", list.Count].Value;
        }
        catch (Exception ex)
        {
            // Status + body snippet from the catalog; keys are never in the message.
            _voiceLists.Remove(provider);
            _voiceNotes[provider] = T["speechSettings.voiceNotes.failed", ex.Message];
        }
    }

    private bool GoogleOff => string.IsNullOrWhiteSpace(_speech.Value.GoogleKeyFilePath);

    private bool ElevenLabsOff => string.IsNullOrWhiteSpace(_speech.Value.ElevenLabsApiKey);

    /// <summary>Picking a SayIntentions PTT switch also sets the ATC mute to the same switch
    /// while that is still Off (2026-10-10) — the one coupling between two fields on this page.</summary>
    private void CoupleAtcMute() => SpeechPageRules.CoupleAtcMuteToSiPtt(_sayIntentions.Value, _speech.Value);

