}
else if (CurrentSection == "voices")
{
    <Section Title="@T["speechSettings.voices.fo.title"]" Hint="@T["speechSettings.voices.fo.hint"]">
        <OptionField Draft="_speech" For="o => o.FoVoice" VoiceGroups="_allVoiceGroups" />
        <div class="field">
            <label class="field-label">
                @T["speechSettings.voices.fo.lists.label"]
                <span class="field-hint">@T["speechSettings.voices.fo.lists.hint"]</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <button type="button" class="btn secondary" disabled="@_refreshingVoices" @onclick="() => RefreshVoicesAsync(null)">
                        @(_refreshingVoices ? T["speechSettings.common.refreshing"].Value : T["speechSettings.voices.fo.refreshAll"].Value)
                    </button>
                </div>
                <div class="field-hint" style="margin-top:6px;">
                    @foreach (var provider in VoiceRef.Providers)
                    {
                        <div><span class="mono">@VoiceRef.DisplayName(provider)</span>: @VoiceNote(provider)</div>
                    }
                </div>
            </div>
        </div>
    </Section>

    <Section Title="@T["speechSettings.voices.crew.title"]" Hint="@T["speechSettings.voices.crew.hint"]">
        <OptionField Draft="_voices" For="o => o.Purser" VoiceGroups="_allVoiceGroups" />
        <OptionField Draft="_voices" For="o => o.PurserIntercomFilter" />
