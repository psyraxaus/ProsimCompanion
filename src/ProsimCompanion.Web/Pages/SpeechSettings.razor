@page "/settings/speech/{Section?}"
@page "/speech"
@layout SettingsLayout
@using System.Text.Json
@inherits SettingsPageBase
@inject IOptionsMonitor<SpeechOptions> SpeechMonitor
@inject IOptionsMonitor<BriefingOptions> BriefingMonitor
@inject IOptionsMonitor<McduOptions> McduMonitor
@inject IOptionsMonitor<VoicesOptions> VoicesMonitor
@inject IOptionsMonitor<GroundCrewOptions> GroundCrewMonitor
@inject IOptionsMonitor<CabinOptions> CabinMonitor
@inject IOptionsMonitor<AccentOptions> AccentsMonitor
@inject IOptionsMonitor<SayIntentionsOptions> SayIntentionsMonitor
@inject IOptionsMonitor<SopOptions> SopMonitor
@inject IAudioDeviceCatalog DeviceCatalog
@inject IPttInputCapture PttCapture

<PageTitle>Voice First Officer — ProsimCompanion</PageTitle>
<h1 class="sr-only">Voice First Officer</h1>

@* Sections are URL-driven (settings/speech/{section}, ADR-0010); the rail lives in
   SettingsLayout. The speech master switch moved to Setup with the other pillar switches;
   Kokoro / Google / Windows voices / cache folder merged into one Voice Providers section. *@

<LlmHealthBanner />

@if (CurrentSection == "status")
{
    <SpeechStatusPanel />
}
else if (CurrentSection == "general")
{
    <Section Title="Voice First Officer" Hint="Voices are tried in order: Kokoro, Google, then Windows">
        <BoolField Label="Local only" Hint="Never use network voices. Speech never leaves this PC." More="Kokoro and Google are skipped on every path."
                   @bind-Value="_speech.Value.LocalOnly" />
        <SelectField Label="Your seat" Hint="The seat you fly from. The First Officer works the other side." More="Left: the FO uses the right MCDU, EFIS and controls. Right: the FO uses the captain's side. The MCDU side changes after an app restart." Options="PilotSeatOptions"
                     @bind-Value="_speech.Value.PilotSeat" />
        <BoolField Label="Engine &amp; flap call responses" Hint="The FO answers your engine start and flap calls." More="Flap calls are checked against the placard speeds. Verbal only: the FO never moves the levers."
                   @bind-Value="_speech.Value.EngineFlapCallouts" />
        <BoolField Label="Engine start monitoring" Hint="The FO calls each engine start: starting, available, both stabilized." More="Read from the engine data on the ground, once per start. No pilot call needed."
                   @bind-Value="_speech.Value.EngineStartCallouts" />
    </Section>

    <Section Title="Human Pacing" Hint="Button presses at a human tempo" Advanced="true">
        <BoolField Label="Humanize button timing" Hint="Add small human pauses between button presses." More="Off: the minimum delays only."
                   @bind-Value="_speech.Value.Humanize.Enabled" />
        <NumberField Label="Tempo" Hint="1.0 is normal, 2.0 is twice as slow." Step="0.1" Min="0.25" Max="4"
                     Disabled="@(!_speech.Value.Humanize.Enabled)"
                     @bind-Value="_speech.Value.Humanize.Tempo"
                     Default="_speech.Defaults.Humanize.Tempo" />
    </Section>

    <Section Title="Playback">
        <SelectField Label="Output device" Hint="Where the First Officer's voice plays."
                     Options="OutputDeviceOptions()"
                     @bind-Value="_speech.Value.OutputDevice" />
        <NumberField Label="Volume" Suffix="%" Min="0" Max="100"
                     @bind-Value="_speech.Value.Volume"
                     Default="_speech.Defaults.Volume" />
        <BoolField Label="Intercom filter" Hint="Make the FO sound like a headset, not a narrator."
                   @bind-Value="_speech.Value.IntercomFilter" />
    </Section>
}
else if (CurrentSection == "listening")
{
    <Section Title="Recognition & Push-to-Talk" Hint="How the First Officer hears you">
        <SelectField Label="Listening mode" Hint="Push-to-talk: the FO listens only while your FO key is held." More="Continuous: the FO listens whenever it expects a reply, except while the ATC key is held. On a network (VATSIM, IVAO, SayIntentions) always bind your ATC transmit key below, so the FO never hears what you say to ATC." Options="RecognitionModeOptions"
                     @bind-Value="_speech.Value.RecognitionMode" />
        <div class="field">
            <label class="field-label">
                FO push-to-talk
                <span class="field-hint">The key or button that talks to the First Officer. Never your ATC key.</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.PttBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("fo")'>
                        @(_capturing == "fo" ? "Press the key or button now…" : "Set")
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.PttBinding)'>Clear</button>
                    <span title="Lights while the bound input is held"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.OwnPttPressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        <div class="field">
            <label class="field-label">
                ATC push-to-talk (mute)
                <span class="field-hint">The key or button you use to talk to ATC. While it is held, the FO does not listen.</span>
            </label>
            <div class="field-control">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="mono" style="min-width:220px;">@BindingText(_speech.Value.AtcMuteBinding)</span>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => SetBindingAsync("atc")'>
                        @(_capturing == "atc" ? "Press the key or button now…" : "Set")
                    </button>
                    <button type="button" class="btn secondary" disabled="@(_capturing is not null)"
                            @onclick='() => ClearBinding(_speech.Value.AtcMuteBinding)'>Clear</button>
                    <span title="Lights while the bound input is held"
                          style="display:inline-block; width:13px; height:13px; border-radius:50%; background:@(PttCapture.AtcMutePressed ? "var(--ok, #3fb950)" : "var(--border, #444)");"></span>
                </div>
            </div>
        </div>
        @if (_captureMessage is not null)
        {
            <div class="field-hint">@_captureMessage</div>
        }
        <div class="field-hint" style="max-width:640px;">
            Set waits ten seconds for a key or a joystick button. Save afterwards; the lamps
            light for the saved bindings only.
        </div>
        <SelectField Label="Input device" Hint="The microphone the FO listens on."
                     Options="InputDeviceOptions()"
                     @bind-Value="_speech.Value.InputDevice" />
    </Section>

    <Section Title="Speech Recognition Server" Hint="A transcription server on your network. Empty uses the offline Windows engine">
        <TextField Label="LAN ASR URL" Hint="Server address, for example http://192.168.1.50:8000."
                   @bind-Value="_speech.Value.AsrBaseUrl" />
        <SelectField Label="LAN ASR server flavour" Hint="Must match the server type running at that address." More="The wrong type answers 404 to everything while the health check stays green. A warning is logged when that happens." Options="AsrApiOptions"
                     Disabled="@(string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl))"
                     @bind-Value="AsrApiKey" />
        <SelectField Label="Voice activity detection" Hint="How the FO decides you are speaking." More="Silero ignores engine noise and the FO's own voice and hears quiet commands. RMS is the older energy gate and the fallback if the Silero model cannot load. Applies from the next listening start. Further knobs (vadMinSpeechMs, vadPreRollMs, vadMaxUtteranceMs) are file-only in settings.json." Options="VadEngineOptions"
                     Disabled="@(string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl))"
                     @bind-Value="_speech.Value.VadEngine" />
        <AdvancedFields>
            <NumberField Label="VAD threshold" Hint="Raise it if noise triggers the FO. Lower it if quiet commands are missed." Step="0.05" Min="0.1" Max="0.95"
                         Disabled="@(!SileroSelected)"
                         @bind-Value="_speech.Value.VadThreshold"
                         Default="_speech.Defaults.VadThreshold" />
            <NumberField Label="End-of-utterance silence" Hint="Silence that ends your sentence. Raise it if pauses split your sentences." Suffix="ms" Min="200" Step="50"
                         Disabled="@(!SileroSelected)"
                         @bind-Value="_speech.Value.VadEndSilenceMs"
                         Default="_speech.Defaults.VadEndSilenceMs" />
        </AdvancedFields>
    </Section>

    <Section Title="Interphone Transmit" Hint="Crew calls follow the captain's audio panel">
        <BoolField Label="ACP transmit gating" Hint="Calls to ground or cabin need INT or CAB selected on the audio panel." More="Moving the selector away mid-call hangs up. Off, or an older ProSim: calls are always accepted."
                   @bind-Value="_speech.Value.AcpTransmitGating" />
        <BoolField Label="Require the INT key pressed" Hint="Ground calls also need the INT key held while you speak." More="Leave off unless your panel has the key."
                   Disabled="@(!_speech.Value.AcpTransmitGating)"
                   @bind-Value="_speech.Value.AcpIntKeyRequired" />
    </Section>
}
else if (CurrentSection == "sterile")
{
    <Section Title="Sterile Cockpit" Hint="A quiet cockpit during the busy phases">
        <BoolField Label="Enabled" Hint="The FO holds non-essential speech below the ceiling." @bind-Value="_speech.Value.SterileEnabled" />
        <NumberField Label="Ceiling" Hint="Sterile below this altitude in climb, descent and approach." More="Cruise and ground are never sterile." Suffix="ft MSL" Min="1000"
                     Disabled="@(!_speech.Value.SterileEnabled)"
                     @bind-Value="_speech.Value.SterileCockpitCeilingFt"
                     Default="_speech.Defaults.SterileCockpitCeilingFt" />
        <BoolField Label="Drop Low-priority speech" Hint="Advisories are dropped while sterile, never replayed."
                   Disabled="@(!_speech.Value.SterileEnabled)"
                   @bind-Value="_speech.Value.SterileSuppressLow" />
        <SelectField Label="Normal-priority policy" Hint="What happens to normal speech while sterile." More="Allow is the safe default. Checklists and briefings are normal priority and are needed on a low approach." Options="NormalPolicyOptions"
                     Disabled="@(!_speech.Value.SterileEnabled)"
                     @bind-Value="NormalPolicyKey" />
        <BoolField Label="Exempt cabin reports" Hint="Cabin reports still come through while sterile."
                   Disabled="@(!_speech.Value.SterileEnabled)"
                   @bind-Value="_speech.Value.SterileExemptCabinReports" />
    </Section>
}
else if (CurrentSection == "crew")
{
    <Section Title="Crew Voices" Hint="Voice names from your provider, for example af_heart (Kokoro) or en-AU-Chirp3-HD-Aoede (Google). Blank uses the FO voice">
        <TextField Label="Purser voice" Hint="Cabin reports on the cabin interphone."
                   @bind-Value="_voices.Value.Purser" />
        <BoolField Label="Purser intercom filter" Hint="Headset sound on the purser."
                   @bind-Value="_voices.Value.PurserIntercomFilter" />
        <TextField Label="Company voice" Hint="Dispatch messages, read out like ACARS."
                   @bind-Value="_voices.Value.Company" />
        <BoolField Label="Company intercom filter" Hint="Off by default. A company message is a printout, not a phone call."
                   @bind-Value="_voices.Value.CompanyIntercomFilter" />
        <TextField Label="Ground crew voice" Hint="Ground crew replies and calls on the interphone."
                   @bind-Value="_voices.Value.Ground" />
        <BoolField Label="Ground intercom filter"
                   @bind-Value="_voices.Value.GroundIntercomFilter" />
    </Section>

    <Section Title="Accent Localization" Hint="The ground crew's accent follows the airport's country">
        <BoolField Label="Enabled" Hint="Ground crew only. Purser and company keep the voices above." More="Needs the Google provider for most accents. Local only mode falls back to US or UK."
                   @bind-Value="_accents.Value.Enabled" />
        <TextField Label="Chirp 3 HD persona" Hint="Google voice persona, for example Charon."
                   Disabled="@(!_accents.Value.Enabled)"
                   @bind-Value="_accents.Value.GooglePersona" />
        <div class="field-hint" style="max-width:640px;">
            Per-airport overrides are file-only: <span class="mono">accents.overrides</span>
            in config/settings.json (airport code prefix to voice locale).
        </div>
    </Section>
}
else if (CurrentSection == "groundCrew")
{
    <Section Title="Ground Crew" Hint="Hail the ground crew and hear their calls">
        <BoolField Label="Enabled" @bind-Value="_groundCrew.Value.Enabled" />
        <BoolField Label="Require INT selected" Hint="Ground speech waits until INT is selected on an audio panel."
                   Disabled="@(!_groundCrew.Value.Enabled)"
                   @bind-Value="_groundCrew.Value.RequireIntChannel" />
        <AdvancedFields>
            <NumberField Label="INT grace" Hint="After this wait the call plays anyway." Suffix="s" Min="0"
                         Disabled="@(!_groundCrew.Value.Enabled || !_groundCrew.Value.RequireIntChannel)"
                         @bind-Value="_groundCrew.Value.IntChannelGraceSeconds"
                         Default="_groundCrew.Defaults.IntChannelGraceSeconds" />
        </AdvancedFields>
        <BoolField Label="MECH call on upcalls" Hint="Flash the MECH light when the ground crew calls you."
                   Disabled="@(!_groundCrew.Value.Enabled)"
                   @bind-Value="_groundCrew.Value.MechCall" />
        <AdvancedFields>
            <NumberField Label="Hail listen window" Hint="How long the crew waits for your request after answering." Suffix="s" Min="3"
                         Disabled="@(!_groundCrew.Value.Enabled)"
                         @bind-Value="_groundCrew.Value.HailListenTimeoutSeconds"
                         Default="_groundCrew.Defaults.HailListenTimeoutSeconds" />
        </AdvancedFields>
    </Section>

    <Section Title="Upcalls" Hint="Each call comes once per turnaround">
        <BoolField Label="Ground power connected" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnGroundPower" />
        <BoolField Label="Chocks in place" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnChocks" />
        <BoolField Label="Refueling complete" Hint="Includes the fuel figure."
                   Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnRefuelComplete" />
        <BoolField Label="Catering complete" Disabled="@(!_groundCrew.Value.Enabled)" @bind-Value="_groundCrew.Value.CallOnCateringComplete" />
    </Section>

    <Section Title="Ground Crew Wording" Hint="Spoken word for word. {fuel} becomes the tonnes on board">
        <TextField Label="Hail reply" @bind-Value="_groundCrew.Value.HailReplyText" />
        <TextField Label="Standing by" @bind-Value="_groundCrew.Value.StandingByText" />
        <TextField Label="Ground power" @bind-Value="_groundCrew.Value.GroundPowerText" />
        <TextField Label="Chocks" @bind-Value="_groundCrew.Value.ChocksText" />
        <TextField Label="Refuel complete" @bind-Value="_groundCrew.Value.RefuelCompleteText" />
        <TextField Label="Catering complete" @bind-Value="_groundCrew.Value.CateringCompleteText" />
    </Section>
}
else if (CurrentSection == "cabin")
{
    <Section Title="Cabin Crew" Hint="Purser reports on the cabin interphone">
        <BoolField Label="Enabled" @bind-Value="_cabin.Value.Enabled" />
        <BoolField Label="Cabin secure report" Hint="Before takeoff, once the doors are closed and the beacon is on."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.CabinSecure" />
        <BoolField Label="Cabin ready report" Hint="On approach, below the altitude set here."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.CabinReady" />
        <NumberField Label="Cabin-ready below" Suffix="ft MSL" Min="1000"
                     Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.CabinReady)"
                     @bind-Value="_cabin.Value.CabinReadyBelowAltFt"
                     Default="_cabin.Defaults.CabinReadyBelowAltFt" />
        <BoolField Label="FO acknowledges reports" Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.FoAcknowledge" />
        <BoolField Label="Require CAB selected" Hint="The purser waits until CAB is selected on an audio panel, or the grace time."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.RequireCabChannel" />
        <AdvancedFields>
            <NumberField Label="CAB grace" Suffix="s" Min="0"
                         Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.RequireCabChannel)"
                         @bind-Value="_cabin.Value.CabChannelGraceSeconds"
                         Default="_cabin.Defaults.CabChannelGraceSeconds" />
        </AdvancedFields>
        <BoolField Label="Interphone chime before calls" Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.Chime" />
        <BoolField Label="Ding on startup" Hint="Cabin chime when the app starts."
                   @bind-Value="_cabin.Value.DingOnStartup" />
        <BoolField Label="Ding on final loadsheet" Hint="Cabin chime when the final loadsheet is sent."
                   @bind-Value="_cabin.Value.DingOnFinal" />
        <BoolField Label="Ambient events" Hint="Now and then the purser reports a boarding delay."
                   Disabled="@(!_cabin.Value.Enabled)" @bind-Value="_cabin.Value.AmbientEvents" />
        <NumberField Label="Boarding-delay probability" Hint="0.2 is one flight in five." Step="0.05" Min="0" Max="1"
                     Disabled="@(!_cabin.Value.Enabled || !_cabin.Value.AmbientEvents)"
                     @bind-Value="_cabin.Value.BoardingDelayProbability"
                     Default="_cabin.Defaults.BoardingDelayProbability" />
    </Section>

    <Section Title="Cabin Wording" Hint="Spoken word for word">
        <TextField Label="Hail reply" Hint="Answer to &quot;cockpit to cabin&quot;."
                   @bind-Value="_cabin.Value.HailReplyText" />
        <TextField Label="Cabin secure" @bind-Value="_cabin.Value.CabinSecureText" />
        <TextField Label="Cabin secure — FO ack" @bind-Value="_cabin.Value.CabinSecureAckText" />
        <TextField Label="Cabin ready" @bind-Value="_cabin.Value.CabinReadyText" />
        <TextField Label="Cabin ready — FO ack" @bind-Value="_cabin.Value.CabinReadyAckText" />
        <TextField Label="Boarding delay" @bind-Value="_cabin.Value.BoardingDelayText" />
    </Section>
}
else if (CurrentSection == "sayIntentions")
{
    <Section Title="SayIntentions" Hint="Online ATC: radio requests, weather, CPDLC and the arrival gate">
        <BoolField Label="Use SayIntentions" Hint="Turns on every SayIntentions feature." More="Voice requests need SayIntentions running with an active flight. Weather only needs the API key."
                   @bind-Value="_sayIntentions.Value.Enabled" />
        <SelectField Label="API key" Hint="Auto reads the key from SayIntentions' flight.json." Options="ApiKeySourceOptions"
                     Disabled="@(!_sayIntentions.Value.Enabled)"
                     @bind-Value="_sayIntentions.Value.ApiKeySource" />
        <TextField Label="Manual API key" Hint="Used only with Manual. Never logged."
                   Disabled="@(!_sayIntentions.Value.Enabled || _sayIntentions.Value.ApiKeySource != "manual")"
                   @bind-Value="_sayIntentions.Value.ManualApiKey" />
        <SecretUnreadableHint Path="sayIntentions:manualApiKey" />
        <SelectField Label="Phraseology" Options="PhraseologyOptions"
                     Disabled="@(!_sayIntentions.Value.Enabled)"
                     @bind-Value="_sayIntentions.Value.Phraseology" />
        <BoolField Label="FO speaks the transmission" Hint="The FO says the radio call out loud before it is sent." More="Turn off if SayIntentions plays it as well (double audio)."
                   Disabled="@(!_sayIntentions.Value.Enabled)"
                   @bind-Value="_sayIntentions.Value.FoSpeaksTransmission" />
        <BoolField Label="Auto-tune frequency" Hint="Tune the matched station before transmitting."
                   Disabled="@(!_sayIntentions.Value.Enabled)"
                   @bind-Value="_sayIntentions.Value.AutoTuneFrequency" />
        <BoolField Label="Departure comms gate" Hint="You make the takeoff request, not the SayIntentions copilot." More="Comms come back to you when you get close to the runway."
                   Disabled="@(!_sayIntentions.Value.Enabled)"
                   @bind-Value="_sayIntentions.Value.DepartureGatingEnabled" />
        <NumberField Label="Gate distance" Hint="Distance from the runway where comms come back to you." Suffix="nm" Step="0.1" Min="0"
                     Disabled="@(!_sayIntentions.Value.Enabled || !_sayIntentions.Value.DepartureGatingEnabled)"
                     @bind-Value="_sayIntentions.Value.DepartureGateDistanceNm"
                     Default="_sayIntentions.Defaults.DepartureGateDistanceNm" />
    </Section>

    <Section Title="SayIntentions Weather" Hint="ATIS, METAR, TAF and CPDLC. Needs only the API key">
        <BoolField Label="Enabled"
                   Disabled="@(!_sayIntentions.Value.Enabled)"
                   @bind-Value="_sayIntentions.Value.WeatherEnabled" />
        <AdvancedFields>
            <NumberField Label="Cache TTL" Hint="How long a weather report is kept." Suffix="min" Min="1"
                         Disabled="@(!_sayIntentions.Value.Enabled || !_sayIntentions.Value.WeatherEnabled)"
                         @bind-Value="_sayIntentions.Value.WeatherCacheMinutes"
                         Default="_sayIntentions.Defaults.WeatherCacheMinutes" />
            <NumberField Label="Refresh debounce" Hint="Shortest gap between refreshes." Suffix="s" Min="0"
                         Disabled="@(!_sayIntentions.Value.Enabled || !_sayIntentions.Value.WeatherEnabled)"
                         @bind-Value="_sayIntentions.Value.WeatherRefreshDebounceSeconds"
                         Default="_sayIntentions.Defaults.WeatherRefreshDebounceSeconds" />
        </AdvancedFields>
    </Section>
}
else if (CurrentSection == "providers")
{
    <Section Title="Kokoro (local neural TTS)" Hint="Free neural voices from a Kokoro server on this PC or your network">
        <TextField Label="Base URL" Hint="Server address, for example http://192.168.1.50:8880. Empty turns Kokoro off."
                   @bind-Value="_speech.Value.KokoroBaseUrl" />
        <TextField Label="Model" Disabled="@KokoroOff" @bind-Value="_speech.Value.KokoroModel" />
        <TextField Label="Voice" Hint="For example bm_george." Disabled="@KokoroOff" @bind-Value="_speech.Value.KokoroVoice" />
        <AdvancedFields>
            <NumberField Label="Connect timeout" Hint="Wait for the server to answer." More="Kept short on purpose. A sleeping server falls through to the next voice instead of stalling a callout." Suffix="ms" Min="200"
                         Disabled="@KokoroOff"
                         @bind-Value="_speech.Value.KokoroTimeoutMs"
                         Default="_speech.Defaults.KokoroTimeoutMs" />
            <NumberField Label="Body timeout" Hint="Time allowed for the audio to arrive." More="Plus 100 ms per character, so a long briefing never trips the 60 s cooldown." Suffix="ms" Min="1000"
                         Disabled="@KokoroOff"
                         @bind-Value="_speech.Value.KokoroBodyTimeoutMs"
                         Default="_speech.Defaults.KokoroBodyTimeoutMs" />
            <NumberField Label="Cache cap per voice" Hint="0 is no limit." Suffix="MB" Min="0"
                         Disabled="@KokoroOff"
                         @bind-Value="_speech.Value.KokoroMaxCacheMbPerVoice"
                         Default="_speech.Defaults.KokoroMaxCacheMbPerVoice" />
        </AdvancedFields>
    </Section>

    <Section Title="Google Cloud TTS (Chirp 3 HD)" Hint="Paid neural voices. Cached, with a monthly budget">
        <TextField Label="Service-account key file" Hint="Path to the service-account JSON key. Empty turns Google off. Never logged."
                   @bind-Value="_speech.Value.GoogleKeyFilePath" />
        <TextField Label="Voice" Hint="For example en-AU-Chirp3-HD-Charon." Disabled="@GoogleOff" @bind-Value="_speech.Value.GoogleVoice" />
        <NumberField Label="Monthly character budget" Hint="Google stops for the month at this many characters. 0 is no limit." More="The free tier is 1,000,000 characters. The offline voices take over." Min="0"
                     Disabled="@GoogleOff"
                     @bind-Value="_speech.Value.GoogleMonthlyCharBudget"
                     Default="_speech.Defaults.GoogleMonthlyCharBudget" />
    </Section>

    <Section Title="Windows Voices" Hint="Offline voices, always available">
        <TextField Label="WinRT voice" Hint="Voice name. Empty uses the Windows default." More="This reaches the Windows 11 &quot;Natural&quot; voices."
                   @bind-Value="_speech.Value.WinRtVoice" />
        <TextField Label="SAPI5 voice" Hint="Last-resort voice. Empty uses the Windows default."
                   @bind-Value="_speech.Value.SapiVoice" />
    </Section>

    <Section Title="Cache" Advanced="true">
        <TextField Label="TTS cache folder" Hint="Empty uses the app's cache folder." More="%LOCALAPPDATA%\ProsimCompanion\cache\tts, one folder per provider and voice. The usage counter lives there too."
                   @bind-Value="_speech.Value.CacheFolder" />
    </Section>
}
else if (CurrentSection == "mcdu")
{
    <Section Title="MCDU" Hint="Voice MCDU: reading always works, key presses need arming">
        <BoolField Label="Enabled" Hint="Read the MCDU, tune the ILS and change the arrival runway by voice."
                   @bind-Value="_mcdu.Value.Enabled" />
        <BoolField Label="Allow actuation" Hint="Let the FO press MCDU keys." More="Off: read only. Commands answer that key presses are off."
                   Disabled="@(!_mcdu.Value.Enabled)"
                   @bind-Value="_mcdu.Value.AllowActuation" />
        <NumberField Label="Verify pause" Hint="The FO announces the change, then waits this long so you can cancel." Suffix="s" Min="0"
                     Disabled="@(!_mcdu.Value.Enabled || !_mcdu.Value.AllowActuation)"
                     @bind-Value="_mcdu.Value.VerifyPauseSeconds"
                     Default="_mcdu.Defaults.VerifyPauseSeconds" />
    </Section>
}
else if (CurrentSection == "briefing")
{
    <Section Title="Briefings" Hint="Departure and arrival briefings from nav data and weather">
        <SelectField Label="Procedure source" Hint="Where the runway, SID, STAR and approach come from." More="Auto tries the FMS plan, then SayIntentions, then the manual entries below, field by field." Options="ProcedureSourceOptions"
                     @bind-Value="ProcedureSourceKey" />
        <BoolField Label="Verify numbers in LLM output" Hint="Every figure the LLM writes is checked against the facts." More="A failed check falls back to the plain template."
                   @bind-Value="_briefing.Value.VerifyNumbers" />
        <div class="field-hint" style="max-width:640px;">
            The Navigraph DFD database path lives under <a href="settings">Setup → Nav Data</a>.
        </div>
    </Section>

    <Section Title="Manual Procedure Overrides" Hint="Used when the FMS or SayIntentions cannot fill a field, or always in Manual mode">
        <TextField Label="Departure airport" Hint="ICAO, e.g. YSSY" @bind-Value="_briefing.Value.DepartureAirport" />
        <TextField Label="Departure runway" Hint="e.g. 16R" @bind-Value="_briefing.Value.DepartureRunway" />
        <TextField Label="SID" Hint="Identifier, e.g. FISHA1" @bind-Value="_briefing.Value.DepartureSid" />
        <TextField Label="Arrival airport" Hint="ICAO, e.g. YMML" @bind-Value="_briefing.Value.ArrivalAirport" />
        <TextField Label="Arrival runway" Hint="e.g. 34" @bind-Value="_briefing.Value.ArrivalRunway" />
        <TextField Label="STAR" Hint="Identifier, e.g. RAZZI4" @bind-Value="_briefing.Value.ArrivalStar" />
        <TextField Label="Approach" Hint="For example I16R. Empty picks the best published approach, ILS first." More="Ask the FO &quot;which approach&quot; to hear the candidates."
                   @bind-Value="_briefing.Value.ArrivalApproach" />
    </Section>

    <Section Title="Minima Capture" Hint="The FO asks for the minimums during the arrival brief">
        <BoolField Label="Interactive capture" Hint="The FO asks, reads back, and arms the minimums callouts." More="A value already set on the Status section skips the question. Works best with a transcription server."
                   @bind-Value="_briefing.Value.MinimaCaptureEnabled" />
        <AdvancedFields>
            <NumberField Label="Listen timeout" Hint="How long the FO waits for your answer." Suffix="s" Min="5"
                         Disabled="@(!_briefing.Value.MinimaCaptureEnabled)"
                         @bind-Value="_briefing.Value.MinimaListenTimeoutSeconds"
                         Default="_briefing.Defaults.MinimaListenTimeoutSeconds" />
            <NumberField Label="Max retries" Hint="Failed tries before the brief goes on as not briefed." Min="0"
                         Disabled="@(!_briefing.Value.MinimaCaptureEnabled)"
                         @bind-Value="_briefing.Value.MinimaMaxRetries"
                         Default="_briefing.Defaults.MinimaMaxRetries" />
        </AdvancedFields>
    </Section>

    <Section Title="Missed-Approach Re-brief" Hint="After a go-around the FO reads the missed approach">
        <BoolField Label="Enabled" Hint="Waits for the delay and gear up, so you fly first." More="Without published legs the FO gives a prompt instead."
                   @bind-Value="_briefing.Value.MissedApproachRebriefEnabled" />
        <AdvancedFields>
            <NumberField Label="Delay" Suffix="s" Min="0"
                         Disabled="@(!_briefing.Value.MissedApproachRebriefEnabled)"
                         @bind-Value="_briefing.Value.MissedApproachDelaySeconds"
                         Default="_briefing.Defaults.MissedApproachDelaySeconds" />
            <NumberField Label="Hard ceiling" Hint="Speaks by this time even if the gear never comes up." Suffix="s" Min="0"
                         Disabled="@(!_briefing.Value.MissedApproachRebriefEnabled)"
                         @bind-Value="_briefing.Value.MissedApproachHardCeilingSeconds"
                         Default="_briefing.Defaults.MissedApproachHardCeilingSeconds" />
        </AdvancedFields>
    </Section>

    <Section Title="LLM Styling" Hint="One language model for the briefing and debrief prose">
        <BoolField Label="Enabled" Hint="Off: plain templates only. Nothing leaves this PC."
                   @bind-Value="_briefing.Value.LlmEnabled" />
        <SelectField Label="API flavour" Hint="Pick Ollama when the address is an Ollama server." More="Only the Ollama type can switch model thinking off." Options="LlmApiOptions"
                     Disabled="@(!_briefing.Value.LlmEnabled)"
                     @bind-Value="LlmApiKey" />
        <TextField Label="Base URL" Hint="OpenAI style: the API root, e.g. https://api.openai.com/v1. Ollama: the server root, e.g. http://localhost:11434."
                   Disabled="@(!_briefing.Value.LlmEnabled)"
                   @bind-Value="_briefing.Value.LlmBaseUrl" />
        <TextField Label="API key" Hint="Never logged. Empty for local servers without a key."
                   Disabled="@(!_briefing.Value.LlmEnabled)"
                   @bind-Value="_briefing.Value.LlmApiKey" />
        <SecretUnreadableHint Path="briefing:llmApiKey" />
        <TextField Label="Model" Hint="Model name, e.g. gpt-4o-mini or qwen3.6:27b. Empty turns styling off."
                   Disabled="@(!_briefing.Value.LlmEnabled)"
                   @bind-Value="_briefing.Value.LlmModel" />
        <BoolField Label="Enable model thinking (slower, deeper reasoning)" Hint="Lets a thinking model reason first. Slow: often 10 s or more." More="Ollama only. Leave off for briefings."
                   Disabled="@(!_briefing.Value.LlmEnabled || _briefing.Value.LlmApi != LlmApiKind.Ollama)"
                   @bind-Value="_briefing.Value.LlmEnableThinking" />
        <AdvancedFields>
            <NumberField Label="Max tokens" Min="64"
                         Disabled="@(!_briefing.Value.LlmEnabled)"
                         @bind-Value="_briefing.Value.LlmMaxTokens"
                         Default="_briefing.Defaults.LlmMaxTokens" />
            <NumberField Label="Timeout" Hint="Per call. A styled briefing may make two calls." Suffix="s" Min="5"
                         Disabled="@(!_briefing.Value.LlmEnabled)"
                         @bind-Value="_briefing.Value.LlmTimeoutSeconds"
                         Default="_briefing.Defaults.LlmTimeoutSeconds" />
        </AdvancedFields>
        <div class="field-hint" style="max-width:640px;">
            Save, then press "Test LLM connection" on the <a href="settings/speech/status">Status section</a>.
        </div>
    </Section>

    <Section Title="LLM Wake-on-LAN" Hint="Wake the LLM PC when the app starts" Advanced="true">
        <BoolField Label="Enabled" Hint="Sends a wake-up packet when the app starts." More="The LLM PC needs Wake-on-LAN enabled in its BIOS and network driver, a wired connection, and the same network."
                   @bind-Value="_briefing.Value.LlmWakeOnLan.Enabled" />
        <TextField Label="MAC address" Hint="For example AA:BB:CC:DD:EE:FF."
                   Disabled="@(!_briefing.Value.LlmWakeOnLan.Enabled)"
                   @bind-Value="_briefing.Value.LlmWakeOnLan.MacAddress" />
        <TextField Label="Broadcast address" Hint="255.255.255.255, or your subnet's broadcast such as 192.168.1.255."
                   Disabled="@(!_briefing.Value.LlmWakeOnLan.Enabled)"
                   @bind-Value="_briefing.Value.LlmWakeOnLan.BroadcastAddress" />
        <NumberField Label="Port" Hint="Usually 9." Min="1" Max="65535"
                     Disabled="@(!_briefing.Value.LlmWakeOnLan.Enabled)"
                     @bind-Value="_briefing.Value.LlmWakeOnLan.Port"
                     Default="_briefing.Defaults.LlmWakeOnLan.Port" />
        <div class="field-hint" style="max-width:640px;">
            Press "Wake LLM server", then "Test LLM connection" on the <a href="settings/speech/status">Status section</a> to check the PC came up.
        </div>
    </Section>
}
else if (CurrentSection == "callouts")
{
    <Section Title="Standard Callouts" Hint="The FO's speed, altitude and rollout calls.">
        <BoolField Label="Callouts enabled" Hint="Master switch for every standard callout." More="Applies live. The individual callout texts, altitude callouts, approach gates, flow monitor and weather advisories are edited in the sop section of settings.json for now."
                   @bind-Value="_sop.Value.CalloutsEnabled" />
    </Section>

    <Section Title="Flap Placards" Hint="Maximum speed per flap lever position (VFE). The FO warns when you approach or exceed it, and checks your flap calls against it.">
        <div class="field-hint" style="margin-bottom:8px; max-width:640px;">
            ProSim reports the lever in six steps: UP, 1, 1+F, 2, 3, FULL. Lever 1 gives 1+F on the
            ground and on take-off; the FO reads the step ProSim reports.
        </div>
        <div class="services-header">
            <span>Lever</span><span>Limit (kt)</span><span></span><span></span><span></span>
        </div>
        @for (var i = 0; i < _sop.Value.FlapPlacards.Count; i++)
        {
            var row = _sop.Value.FlapPlacards[i];
            <div class="service-row">
                <span class="row-value-mono">@SopOptions.FlapHandleLabel(row.FlapHandle)</span>
                <input class="number-input" type="number" min="0" max="400" step="1" @bind="row.MaxKt" />
                <span></span><span></span><span></span>
            </div>
        }
        <div class="preset-row" style="margin-top:8px;">
            <button type="button" class="btn secondary" title="A322 figures: 230 / 215 / 200 / 185 / 177"
                    @onclick="ResetFlapPlacards">Reset to A320 defaults</button>
        </div>
    </Section>

    <Section Title="Gear Limits" Hint="VLE is the limit with the gear down. VLO is the limit while the gear moves; the FO refuses a gear call above it.">
        <NumberField Label="Gear extended (VLE)" Suffix="kt" Min="0" Max="400"
                     Hint="The FO warns when you fly faster than this with the gear down. 0 turns the warning off."
                     @bind-Value="_sop.Value.GearMaxKt"
                     Default="_sop.Defaults.GearMaxKt" />
        <NumberField Label="Gear extension (VLO down)" Suffix="kt" Min="0" Max="400"
                     Hint="\"Gear down\" is refused above this speed. 0 turns the check off."
                     @bind-Value="_sop.Value.GearExtendMaxKt"
                     Default="_sop.Defaults.GearExtendMaxKt" />
        <NumberField Label="Gear retraction (VLO up)" Suffix="kt" Min="0" Max="400"
                     Hint="\"Gear up\" is refused above this speed. 0 turns the check off."
                     @bind-Value="_sop.Value.GearRetractMaxKt"
                     Default="_sop.Defaults.GearRetractMaxKt" />
    </Section>

    <Section Title="Placard Advisories" Hint="What the FO says when a limit is close or exceeded" Advanced="true">
        <BoolField Label="Enabled" @bind-Value="_sop.Value.PlacardAdvisory.Enabled" />
        <NumberField Label="Warn within" Suffix="kt" Min="0" Max="50"
                     Hint="Speak the approaching call this close below the limit, while accelerating."
                     Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                     @bind-Value="_sop.Value.PlacardAdvisory.WarnWithinKt"
                     Default="_sop.Defaults.PlacardAdvisory.WarnWithinKt" />
        <NumberField Label="Cooldown" Suffix="s" Min="0" Max="600"
                     Hint="Minimum time between two advisories of the same kind."
                     Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                     @bind-Value="_sop.Value.PlacardAdvisory.CooldownSeconds"
                     Default="_sop.Defaults.PlacardAdvisory.CooldownSeconds" />
        <TextField Label="Approaching flap limit" Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                   @bind-Value="_sop.Value.PlacardAdvisory.ApproachingText" />
        <TextField Label="Flap limit exceeded" Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                   @bind-Value="_sop.Value.PlacardAdvisory.ExceededText" />
        <TextField Label="Gear limit exceeded" Disabled="@(!_sop.Value.PlacardAdvisory.Enabled)"
                   @bind-Value="_sop.Value.PlacardAdvisory.GearExceededText" />
    </Section>
}

<DirtyBar Visible="@BarVisible"
          Message="@(BarMessage ?? "You have unsaved changes")"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    [Parameter]
    public string? Section { get; set; }

    private string CurrentSection => SettingsNav.ResolveSection(SettingsNav.SpeechSections, Section);

    private void ResetFlapPlacards() => _sop.Value.FlapPlacards = [.. SopOptions.DefaultFlapPlacards];

    private bool SileroSelected => !string.IsNullOrWhiteSpace(_speech.Value.AsrBaseUrl)
        && _speech.Value.VadEngine.Equals("silero", StringComparison.OrdinalIgnoreCase);

    private bool KokoroOff => string.IsNullOrWhiteSpace(_speech.Value.KokoroBaseUrl);

    private bool GoogleOff => string.IsNullOrWhiteSpace(_speech.Value.GoogleKeyFilePath);

    private static readonly IReadOnlyList<(string, string)> RecognitionModeOptions =
    [
        ("pushToTalk", "Push-to-talk (dedicated FO key)"),
        ("continuous", "Continuous (ATC-mute while transmitting)"),
    ];

    private static readonly IReadOnlyList<(string, string)> PilotSeatOptions =
    [
        ("left", "Left seat (FO operates the right side)"),
        ("right", "Right seat (virtual pilot operates the left side)"),
    ];

    private static readonly IReadOnlyList<(string, string)> LlmApiOptions =
    [
        ("openAi", "OpenAI-compatible (/chat/completions)"),
        ("ollama", "Ollama native (/api/chat — thinking control)"),
    ];

    private static readonly IReadOnlyList<(string, string)> AsrApiOptions =
    [
        ("fasterWhisper", "faster-whisper wrapper (/transcribe)"),
        ("whisperCpp", "whisper.cpp server (/v1/audio/transcriptions)"),
    ];

    private static readonly IReadOnlyList<(string, string)> VadEngineOptions =
    [
        ("silero", "Silero VAD (neural, recommended)"),
        ("rms", "RMS energy gate (legacy)"),
    ];

    private static readonly IReadOnlyList<(string, string)> ProcedureSourceOptions =
    [
        ("auto", "Auto (FMS → flight.json → manual)"),
        ("manual", "Manual entries only"),
        ("flightJson", "SayIntentions flight.json only"),
    ];

    private static readonly IReadOnlyList<(string, string)> NormalPolicyOptions =
    [
        ("allow", "Allow (speak normally)"),
        ("defer", "Defer (replay when sterile ends)"),
        ("suppress", "Suppress (drop)"),
    ];

    private static readonly IReadOnlyList<(string, string)> ApiKeySourceOptions =
        [("auto", "Auto (from flight.json)"), ("manual", "Manual (entered below)")];

    private static readonly IReadOnlyList<(string, string)> PhraseologyOptions =
        [("icao", "ICAO"), ("faa", "FAA")];

    private OptionsDraft<SpeechOptions> _speech = default!;
    private OptionsDraft<BriefingOptions> _briefing = default!;
    private OptionsDraft<McduOptions> _mcdu = default!;
    private OptionsDraft<VoicesOptions> _voices = default!;
    private OptionsDraft<GroundCrewOptions> _groundCrew = default!;
    private OptionsDraft<CabinOptions> _cabin = default!;
    private OptionsDraft<AccentOptions> _accents = default!;
    private OptionsDraft<SayIntentionsOptions> _sayIntentions = default!;
    private OptionsDraft<SopOptions> _sop = default!;

    private IReadOnlyList<string> _captureDevices = [];
    private IReadOnlyList<string> _renderDevices = [];

    private IReadOnlyList<(string, string)> InputDeviceOptions() =>
        DeviceOptions("Default capture device", _captureDevices, _speech.Value.InputDevice);

    private IReadOnlyList<(string, string)> OutputDeviceOptions() =>
        DeviceOptions("System default", _renderDevices, _speech.Value.OutputDevice);

    /// <summary>Empty-value default first, then every detected device; a saved device that is
    /// not currently detected (unplugged, renamed) stays selectable so opening the page never
    /// silently rewrites the setting.</summary>
    private static IReadOnlyList<(string, string)> DeviceOptions(
        string defaultLabel, IReadOnlyList<string> devices, string current)
    {
        var options = new List<(string, string)> { ("", defaultLabel) };
        foreach (var name in devices)
        {
            options.Add((name, name));
        }

        if (!string.IsNullOrWhiteSpace(current)
            && !devices.Contains(current, StringComparer.OrdinalIgnoreCase))
        {
            options.Add((current, $"{current} (not currently detected)"));
        }

        return options;
    }

    private IReadOnlyList<JoystickDeviceView> _joysticks = [];
    private string? _capturing;
    private string? _captureMessage;

    /// <summary>"Key: capslock" / "VIRPIL Constellation — button 3" / "(unset)".</summary>
    private static string BindingText(PttBindingOptions binding)
    {
        if (!binding.IsSet)
        {
            return "(unset)";
        }

        if (binding.Kind.Equals("keyboard", StringComparison.OrdinalIgnoreCase))
        {
            return $"Key: {binding.Key}";
        }

        var device = string.IsNullOrWhiteSpace(binding.JoystickDeviceName)
            ? $"Joystick {binding.JoystickDevice}"
            : binding.JoystickDeviceName;
        return $"{device} — button {binding.Button}";
    }

    /// <summary>Prosim2FO's Set process: capture the next key OR button and assign the whole
    /// binding, whichever the user presses first. Mutates the draft's typed binding, so the
    /// dirty bar reflects the capture automatically.</summary>
    private async Task SetBindingAsync(string target)
    {
        _capturing = target;
        _captureMessage = null;
        try
        {
            var result = await PttCapture.CaptureAsync(
                includeJoysticks: true, TimeSpan.FromSeconds(10), CancellationToken.None);
            if (result is null)
            {
                _captureMessage = "Nothing pressed within ten seconds.";
                return;
            }

            var binding = target == "atc" ? _speech.Value.AtcMuteBinding : _speech.Value.PttBinding;
            if (result.IsJoystick)
            {
                _joysticks = PttCapture.GetJoysticks(); // the pressed device is connected — relist
                binding.Kind = "joystickButton";
                binding.Key = "";
                binding.JoystickDevice = result.JoystickId;
                binding.JoystickDeviceName = _joysticks.FirstOrDefault(j => j.Id == result.JoystickId)?.Name ?? "";
                binding.Button = result.JoystickButton;
            }
            else
            {
                binding.Kind = "keyboard";
                binding.Key = result.KeyName ?? "";
                binding.JoystickDevice = null;
                binding.JoystickDeviceName = "";
                binding.Button = null;
            }

            _captureMessage = $"{(target == "atc" ? "ATC PTT" : "FO PTT")} bound to {BindingText(binding)}.";
        }
        catch (Exception)
        {
            _captureMessage = "Capture failed — see the Logs page.";
        }
        finally
        {
            _capturing = null;
        }
    }

    private void ClearBinding(PttBindingOptions binding)
    {
        binding.Kind = "";
        binding.Key = "";
        binding.JoystickDevice = null;
        binding.JoystickDeviceName = "";
        binding.Button = null;
        _captureMessage = null;
    }

    /// <summary>One-way migration: pre-binding configs carried flat key/joystick fields; the
    /// first page load synthesizes bindings from them (joystick wins when both were set —
    /// hardware buttons were the deliberate choice). The synthesized binding dirties the
    /// draft, so the bar prompts for the save that persists it; the legacy keys are blanked
    /// at save time in <see cref="OnBeforeSave"/>.</summary>
    private static void MigrateLegacyBindings(SpeechOptions draft)
    {
        if (!draft.PttBinding.IsSet)
        {
            if (draft.PttJoystickButton is not null)
            {
                draft.PttBinding = new PttBindingOptions
                {
                    Kind = "joystickButton",
                    JoystickDevice = draft.PttJoystickDevice,
                    JoystickDeviceName = draft.PttJoystickDeviceName,
                    Button = draft.PttJoystickButton,
                };
            }
            else if (!string.IsNullOrWhiteSpace(draft.PttKey))
            {
                draft.PttBinding = new PttBindingOptions { Kind = "keyboard", Key = draft.PttKey.Trim() };
            }
        }

        if (!draft.AtcMuteBinding.IsSet)
        {
            if (draft.AtcMuteJoystickButton is not null)
            {
                draft.AtcMuteBinding = new PttBindingOptions
                {
                    Kind = "joystickButton",
                    JoystickDevice = draft.AtcMuteJoystickDevice,
                    JoystickDeviceName = draft.AtcMuteJoystickDeviceName,
                    Button = draft.AtcMuteJoystickButton,
                };
            }
            else if (!string.IsNullOrWhiteSpace(draft.AtcMuteKey))
            {
                draft.AtcMuteBinding = new PttBindingOptions { Kind = "keyboard", Key = draft.AtcMuteKey.Trim() };
            }
        }
    }

    private void OnPressedChanged(object? sender, EventArgs e)
        // Service events fire on its worker thread; marshal into the circuit for the lamps.
        => _ = InvokeAsync(StateHasChanged);

    private string LlmApiKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_briefing.Value.LlmApi.ToString());
        set => _briefing.Value.LlmApi = Enum.TryParse<LlmApiKind>(value, ignoreCase: true, out var parsed)
            ? parsed : LlmApiKind.OpenAi;
    }

    private string AsrApiKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_speech.Value.AsrApi.ToString());
        set => _speech.Value.AsrApi = Enum.TryParse<AsrApiKind>(value, ignoreCase: true, out var parsed)
            ? parsed : AsrApiKind.FasterWhisper;
    }

    private string ProcedureSourceKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_briefing.Value.ProcedureSource.ToString());
        set => _briefing.Value.ProcedureSource = Enum.TryParse<ProcedureSourceMode>(value, ignoreCase: true, out var parsed)
            ? parsed : ProcedureSourceMode.Auto;
    }

    private string NormalPolicyKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_speech.Value.SterileNormalPolicy.ToString());
        set => _speech.Value.SterileNormalPolicy = Enum.TryParse<SterileNormalPolicy>(value, ignoreCase: true, out var parsed)
            ? parsed : SterileNormalPolicy.Allow;
    }

    protected override void OnInitialized()
    {
        _speech = Draft(SpeechMonitor);
        _briefing = Draft(BriefingMonitor);
        _mcdu = Draft(McduMonitor);
        _voices = Draft(VoicesMonitor);
        _groundCrew = Draft(GroundCrewMonitor);
        _cabin = Draft(CabinMonitor);
        _accents = Draft(AccentsMonitor);
        _sayIntentions = Draft(SayIntentionsMonitor);
        _sop = Draft(SopMonitor);
        MigrateLegacyBindings(_speech.Value);
        _captureDevices = DeviceCatalog.GetCaptureDeviceNames();
        _renderDevices = DeviceCatalog.GetRenderDeviceNames();
        _joysticks = PttCapture.GetJoysticks();
        PttCapture.PressedChanged += OnPressedChanged;
    }

    protected override void OnBeforeSave()
    {
        var speech = _speech.Value;
        speech.PilotSeat = speech.PilotSeat.Trim().ToLowerInvariant();
        speech.RecognitionMode = speech.RecognitionMode.Trim();
        speech.AsrBaseUrl = speech.AsrBaseUrl.Trim();
        speech.VadEngine = speech.VadEngine.Trim();
        speech.InputDevice = speech.InputDevice.Trim();
        speech.KokoroBaseUrl = speech.KokoroBaseUrl.Trim();
        speech.KokoroModel = speech.KokoroModel.Trim();
        speech.KokoroVoice = speech.KokoroVoice.Trim();
        speech.GoogleKeyFilePath = speech.GoogleKeyFilePath.Trim();
        speech.GoogleVoice = speech.GoogleVoice.Trim();
        speech.WinRtVoice = speech.WinRtVoice.Trim();
        speech.SapiVoice = speech.SapiVoice.Trim();
        speech.OutputDevice = speech.OutputDevice.Trim();
        speech.CacheFolder = speech.CacheFolder.Trim();
        // Legacy flat PTT fields blanked: the typed bindings are authoritative from the first
        // save on (they were migrated into the draft at load). The diff only writes these when
        // the file still carries values.
        speech.PttKey = "";
        speech.AtcMuteKey = "";
        speech.PttJoystickDevice = null;
        speech.PttJoystickButton = null;
        speech.PttJoystickDeviceName = "";
        speech.AtcMuteJoystickDevice = null;
        speech.AtcMuteJoystickButton = null;
        speech.AtcMuteJoystickDeviceName = "";

        var briefing = _briefing.Value;
        // dfdPath deliberately untouched — Setup → Nav Data owns it, and an unchanged
        // key is never written, so a save made there can't be clobbered from this page.
        briefing.DepartureAirport = briefing.DepartureAirport.Trim().ToUpperInvariant();
        briefing.DepartureRunway = briefing.DepartureRunway.Trim().ToUpperInvariant();
        briefing.DepartureSid = briefing.DepartureSid.Trim().ToUpperInvariant();
        briefing.ArrivalAirport = briefing.ArrivalAirport.Trim().ToUpperInvariant();
        briefing.ArrivalRunway = briefing.ArrivalRunway.Trim().ToUpperInvariant();
        briefing.ArrivalStar = briefing.ArrivalStar.Trim().ToUpperInvariant();
        briefing.ArrivalApproach = briefing.ArrivalApproach.Trim().ToUpperInvariant();
        briefing.LlmWakeOnLan.MacAddress = briefing.LlmWakeOnLan.MacAddress.Trim();
        briefing.LlmWakeOnLan.BroadcastAddress = briefing.LlmWakeOnLan.BroadcastAddress.Trim();
        briefing.LlmBaseUrl = briefing.LlmBaseUrl.Trim();
        briefing.LlmApiKey = briefing.LlmApiKey.Trim();
        briefing.LlmModel = briefing.LlmModel.Trim();

        var voices = _voices.Value;
        voices.Purser = voices.Purser.Trim();
        voices.Company = voices.Company.Trim();
        voices.Ground = voices.Ground.Trim();

        // accents.overrides never mutated here — the JSON-edited dictionary stays unchanged,
        // so the diff never writes it.
        _accents.Value.GooglePersona = _accents.Value.GooglePersona.Trim();

        var sayIntentions = _sayIntentions.Value;
        sayIntentions.ApiKeySource = sayIntentions.ApiKeySource.Trim().ToLowerInvariant();
        sayIntentions.ManualApiKey = sayIntentions.ManualApiKey.Trim();
        sayIntentions.Phraseology = sayIntentions.Phraseology.Trim().ToLowerInvariant();
    }

    protected override void OnDiscarded()
        // Reload re-clones from the live options, which may still carry only the legacy flat
        // PTT fields — re-synthesize so the bindings keep displaying after a discard.
        => MigrateLegacyBindings(_speech.Value);

    public override void Dispose()
    {
        PttCapture.PressedChanged -= OnPressedChanged;
        base.Dispose();
    }
}
