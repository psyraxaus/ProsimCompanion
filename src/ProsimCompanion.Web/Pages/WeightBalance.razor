@page "/wnb"
@using System.Globalization
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Core.Aircraft.Ofp
@implements IDisposable
@inject IProsimDataRefs DataRefs
@inject LoadsheetStore Loadsheets
@inject PassengerManifestService ManifestService
@inject OfpStore Ofp
@inject IFmsInitSync FmsSync

<PageTitle>Weight &amp; Balance — ProsimCompanion</PageTitle>
<h1 class="sr-only">Weight and Balance</h1>

<div class="status-panel">

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">CG Envelope</h3>
        <div class="section-body">
            <CgEnvelope GrossWeightKg="@_gross.GetValue(0.0)"
                        GrossCgMac="@_cg.GetValue(0.0)"
                        ZfwKg="@_zfw.GetValue(0.0)"
                        ZfwCgMac="@_zfwcg.GetValue(0.0)" />
            @{
                var sheets = Loadsheets.Snapshot();
                var best = sheets.Final.Status == LoadsheetSlotStatus.Sent ? sheets.Final
                    : sheets.Prelim.Status == LoadsheetSlotStatus.Sent ? sheets.Prelim
                    : null;
                var bestTag = sheets.Final.Status == LoadsheetSlotStatus.Sent ? "FIN"
                    : sheets.Prelim.Status == LoadsheetSlotStatus.Sent ? "PRE" : null;
            }
            <div class="manifest-grid" style="margin-top:10px; grid-template-columns:auto repeat(4, 1fr);">
                <span class="manifest-head"></span>
                <span class="manifest-head">ZFW (KG)</span><span class="manifest-head">MACZFW (%)</span>
                <span class="manifest-head">GW (KG)</span><span class="manifest-head">MACGW (%)</span>
                <span class="manifest-head">LIVE</span>
                <span class="row-value-mono">@($"{_zfw.GetValue(0.0):F0}")</span>
                <span class="row-value-mono">@($"{_zfwcg.GetValue(0.0):F1}")</span>
                <span class="row-value-mono">@($"{_gross.GetValue(0.0):F0}")</span>
                <span class="row-value-mono">@($"{_cg.GetValue(0.0):F1}")</span>
                <span class="manifest-head">L/S @(bestTag is null ? "" : $"({bestTag})")</span>
                <span class="row-value-mono">@(best is null ? "—" : $"{best.ZfwKg:F0}")</span>
                <span class="row-value-mono">@(best is null ? "—" : $"{best.MacZfw:F1}")</span>
                <span class="row-value-mono">@(best is null ? "—" : $"{best.TowKg:F0}")</span>
                <span class="row-value-mono">@(best is null ? "—" : $"{best.MacTow:F1}")</span>
            </div>
            <div class="row" style="margin-top:6px;">
                <span class="row-label"></span>
                <span class="row-value">LIVE reads aircraft datarefs each tick. L/S mirrors the latest loadsheet (final preferred, prelim fallback).</span>
            </div>
            <div class="row">
                <button type="button" class="btn primary" disabled="@_syncing" @onclick="SyncFms">
                    @(_syncing ? "Syncing…" : $"Sync to FMS ({bestTag ?? "COMPUTED"})")
                </button>
                @if (_syncResult is not null)
                {
                    <span class="row-value">@_syncResult</span>
                }
            </div>
        </div>
    </section>

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">Passengers &amp; Cargo</h3>
        <div class="section-body">
            @{
                var paxCapacity = _zone1Cap.GetValue(0) + _zone2Cap.GetValue(0) + _zone3Cap.GetValue(0) + _zone4Cap.GetValue(0);
                var paxBoarded = _zone1.GetValue(0) + _zone2.GetValue(0) + _zone3.GetValue(0) + _zone4.GetValue(0);
                var cargoLoaded = _cargoFwd.GetValue(0.0) + _cargoAft.GetValue(0.0);
                var ofp = Ofp.Current;
            }
            <div class="row"><span class="row-label">Pax capacity</span><span class="row-value-mono">@paxCapacity ECONOMY</span></div>
            <div class="row">
                <span class="row-label">Pax</span>
                <span class="row-value-mono">PLANNED @(ofp?.PaxCount.ToString() ?? "—") · BOARDED @paxBoarded</span>
            </div>
            <div class="row"><span class="row-label">Pax zones 1–4</span><span class="row-value-mono">@_zone1.GetValue(0) / @_zone2.GetValue(0) / @_zone3.GetValue(0) / @_zone4.GetValue(0)</span></div>
            <div class="row">
                <span class="row-label">Cargo capacity</span>
                <span class="row-value-mono">@($"{_cargoFwdCap.GetValue(0.0):F0}") KG FWD, @($"{_cargoAftCap.GetValue(0.0):F0}") KG AFT@(_cargoBulkCap.GetValue(0.0) > 0 ? $", {_cargoBulkCap.GetValue(0.0):F0} KG BULK" : "")</span>
            </div>
            <div class="row">
                <span class="row-label">Cargo</span>
                <span class="row-value-mono">PLANNED @(ofp is null ? "—" : $"{ofp.CargoKg:F0}") · LOADED @($"{cargoLoaded:F0}") KG</span>
            </div>
            <div class="row"><span class="row-label">FWD / AFT</span><span class="row-value-mono">@($"{_cargoFwd.GetValue(0.0):F0}") / @($"{_cargoAft.GetValue(0.0):F0}") KG</span></div>
            <div class="row"><span class="row-label">Fuel</span><span class="row-value-mono">PLANNED @(ofp is null ? "—" : $"{ofp.FuelPlanRampKg:F0}") · IN TANKS @($"{_fuelTotal.GetValue(0.0):F0}") KG</span></div>
            <div class="row"><span class="row-label">ZFW</span><span class="row-value-mono">@Kg(_zfw) / max @Kg(_zfwMax)</span></div>
            <div class="row"><span class="row-label">Gross weight</span><span class="row-value-mono">@Kg(_gross) / max @Kg(_grossMax)</span></div>
        </div>
    </section>

    <section class="status-section status-span">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">Aircraft Status</h3>
        <div class="section-body">
            <A320Silhouette SeatOccupation="@ParseSeatOccupation(_seatOccupation.GetValue(""))"
                            Door1L="@DoorOpen(_door1L)" Door2L="@DoorOpen(_door2L)"
                            Door3L="@DoorOpen(_door3L)" Door4L="@DoorOpen(_door4L)"
                            Door1R="@DoorOpen(_door1R)" Door2R="@DoorOpen(_door2R)"
                            Door3R="@DoorOpen(_door3R)" Door4R="@DoorOpen(_door4R)"
                            FwdCargoOpen="@DoorOpen(_doorCargoFwd)"
                            AftCargoOpen="@DoorOpen(_doorCargoAft)"
                            BulkCargoOpen="@DoorOpen(_doorCargoBulk)"
                            BulkFitted="@(_cargoBulkCap.GetValue(0.0) > 0)" />
            @{
                var anyDoorOpen = new[] { _door1L, _door2L, _door3L, _door4L, _door1R, _door2R, _door3R, _door4R, _doorCargoFwd, _doorCargoAft, _doorCargoBulk }
                    .Any(DoorOpen);
            }
            <div class="row" style="justify-content:center; gap:24px;">
                @foreach (var (label, sub) in new[] { ("FWD", _doorCargoFwd), ("AFT", _doorCargoAft), ("BULK", _doorCargoBulk) })
                {
                    var fitted = label != "BULK" || _cargoBulkCap.GetValue(0.0) > 0;
                    <span class="row-value-mono" style="color:@(!fitted ? "#555555" : DoorOpen(sub) ? "var(--warning)" : "var(--success)")">
                        @label: @(!fitted ? "N/A" : DoorOpen(sub) ? "OPEN" : "CLOSED")
                    </span>
                }
            </div>
            <div class="row" style="justify-content:center;">
                <span class="pill @(anyDoorOpen ? "tone-active" : "tone-ok")" style="font-weight:600;">
                    @(anyDoorOpen ? "DOORS OPEN" : "ALL DOORS CLOSED")
                </span>
            </div>
            <div class="row">
                <button type="button" class="btn secondary" @onclick="() => _showManifest = !_showManifest">
                    @(_showManifest ? "▾ Hide manifest" : $"▸ Manifest ({ManifestService.Manifest().Count})")
                </button>
                <span class="row-value">Generated from the booked seat map; the same flight keeps the same names.</span>
            </div>
            @if (_showManifest)
            {
                var manifest = ManifestService.Manifest();
                @if (manifest.Count == 0)
                {
                    <div class="empty">No booked passengers yet — import an OFP first.</div>
                }
                else
                {
                    <div class="manifest-grid">
                        <span class="manifest-head">SEAT</span><span class="manifest-head">NAME</span><span class="manifest-head">ZONE</span>
                        @foreach (var pax in manifest)
                        {
                            <span class="row-value-mono">@pax.SeatNumber</span>
                            <span class="row-value-mono">@pax.FirstName @pax.LastName</span>
                            <span class="row-value-mono">Z@(pax.Zone)</span>
                        }
                    </div>
                }
            }
        </div>
    </section>

</div>

@code {
    private IDataRefSubscription _zfw = default!;
    private IDataRefSubscription _zfwMax = default!;
    private IDataRefSubscription _gross = default!;
    private IDataRefSubscription _grossMax = default!;
    private IDataRefSubscription _cg = default!;
    private IDataRefSubscription _zfwcg = default!;
    private IDataRefSubscription _fuelTotal = default!;
    private IDataRefSubscription _zone1 = default!;
    private IDataRefSubscription _zone2 = default!;
    private IDataRefSubscription _zone3 = default!;
    private IDataRefSubscription _zone4 = default!;
    private IDataRefSubscription _zone1Cap = default!;
    private IDataRefSubscription _zone2Cap = default!;
    private IDataRefSubscription _zone3Cap = default!;
    private IDataRefSubscription _zone4Cap = default!;
    private IDataRefSubscription _cargoFwd = default!;
    private IDataRefSubscription _cargoAft = default!;
    private IDataRefSubscription _cargoFwdCap = default!;
    private IDataRefSubscription _cargoAftCap = default!;
    private IDataRefSubscription _cargoBulkCap = default!;
    private IDataRefSubscription _seatOccupation = default!;
    private IDataRefSubscription _door1L = default!;
    private IDataRefSubscription _door2L = default!;
    private IDataRefSubscription _door3L = default!;
    private IDataRefSubscription _door4L = default!;
    private IDataRefSubscription _door1R = default!;
    private IDataRefSubscription _door2R = default!;
    private IDataRefSubscription _door3R = default!;
    private IDataRefSubscription _door4R = default!;
    private IDataRefSubscription _doorCargoFwd = default!;
    private IDataRefSubscription _doorCargoAft = default!;
    private IDataRefSubscription _doorCargoBulk = default!;
    private Timer? _refresh;
    private bool _showManifest;
    private bool _syncing;
    private string? _syncResult;

    protected override void OnInitialized()
    {
        _zfw = DataRefs.Subscribe(ProsimDataRefNames.WeightZfw, DataRefTier.Normal);
        _zfwMax = DataRefs.Subscribe(ProsimDataRefNames.WeightZfwMax, DataRefTier.Infrequent);
        _gross = DataRefs.Subscribe(ProsimDataRefNames.WeightGross, DataRefTier.Normal);
        _grossMax = DataRefs.Subscribe(ProsimDataRefNames.WeightGrossMax, DataRefTier.Infrequent);
        _cg = DataRefs.Subscribe(ProsimDataRefNames.CenterOfGravity, DataRefTier.Normal);
        _zfwcg = DataRefs.Subscribe(ProsimDataRefNames.Zfwcg, DataRefTier.Normal);
        _fuelTotal = DataRefs.Subscribe(ProsimDataRefNames.FuelTotal, DataRefTier.Normal);
        _zone1 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone1Amount, DataRefTier.Normal);
        _zone2 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone2Amount, DataRefTier.Normal);
        _zone3 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone3Amount, DataRefTier.Normal);
        _zone4 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone4Amount, DataRefTier.Normal);
        _zone1Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone1Capacity, DataRefTier.Infrequent);
        _zone2Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone2Capacity, DataRefTier.Infrequent);
        _zone3Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone3Capacity, DataRefTier.Infrequent);
        _zone4Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone4Capacity, DataRefTier.Infrequent);
        _cargoFwd = DataRefs.Subscribe(ProsimDataRefNames.CargoForwardAmount, DataRefTier.Normal);
        _cargoAft = DataRefs.Subscribe(ProsimDataRefNames.CargoAftAmount, DataRefTier.Normal);
        _cargoFwdCap = DataRefs.Subscribe(ProsimDataRefNames.CargoForwardCapacity, DataRefTier.Infrequent);
        _cargoAftCap = DataRefs.Subscribe(ProsimDataRefNames.CargoAftCapacity, DataRefTier.Infrequent);
        _cargoBulkCap = DataRefs.Subscribe(ProsimDataRefNames.CargoBulkCapacity, DataRefTier.Infrequent);
        _seatOccupation = DataRefs.Subscribe(ProsimDataRefNames.PaxSeatOccupationString, DataRefTier.Normal);
        _door1L = DataRefs.Subscribe(ProsimDataRefNames.Door1L, DataRefTier.Normal);
        _door2L = DataRefs.Subscribe(ProsimDataRefNames.Door2L, DataRefTier.Normal);
        _door3L = DataRefs.Subscribe(ProsimDataRefNames.Door3L, DataRefTier.Normal);
        _door4L = DataRefs.Subscribe(ProsimDataRefNames.Door4L, DataRefTier.Normal);
        _door1R = DataRefs.Subscribe(ProsimDataRefNames.Door1R, DataRefTier.Normal);
        _door2R = DataRefs.Subscribe(ProsimDataRefNames.Door2R, DataRefTier.Normal);
        _door3R = DataRefs.Subscribe(ProsimDataRefNames.Door3R, DataRefTier.Normal);
        _door4R = DataRefs.Subscribe(ProsimDataRefNames.Door4R, DataRefTier.Normal);
        _doorCargoFwd = DataRefs.Subscribe(ProsimDataRefNames.DoorCargoForward, DataRefTier.Normal);
        _doorCargoAft = DataRefs.Subscribe(ProsimDataRefNames.DoorCargoAft, DataRefTier.Normal);
        _doorCargoBulk = DataRefs.Subscribe(ProsimDataRefNames.DoorCargoBulk, DataRefTier.Normal);

        // Live instrument view — a 1 s repaint is simpler and cheaper than wiring 30+
        // ValueChanged handlers, and matches the datarefs' Normal cadence.
        _refresh = new Timer(_ => _ = InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        _refresh?.Dispose();
        foreach (var sub in new[]
        {
            _zfw, _zfwMax, _gross, _grossMax, _cg, _zfwcg, _fuelTotal,
            _zone1, _zone2, _zone3, _zone4, _zone1Cap, _zone2Cap, _zone3Cap, _zone4Cap,
            _cargoFwd, _cargoAft, _cargoFwdCap, _cargoAftCap, _cargoBulkCap, _seatOccupation,
            _door1L, _door2L, _door3L, _door4L, _door1R, _door2R, _door3R, _door4R,
            _doorCargoFwd, _doorCargoAft, _doorCargoBulk,
        })
        {
            sub.Dispose();
        }
    }

    private static bool DoorOpen(IDataRefSubscription sub) => sub.GetValue(0.0) > 0.5;

    /// <summary>ProSim's seatOccupation string is comma-separated "true,false,…" (legacy
    /// producers used "1"/"0"); anything unparseable reads as an empty cabin.</summary>
    private static IReadOnlyList<bool> ParseSeatOccupation(string raw)
        => string.IsNullOrEmpty(raw)
            ? []
            : raw.Split(',').Select(token =>
            {
                var value = token.Trim();
                return value.Equals("true", StringComparison.OrdinalIgnoreCase) || value == "1";
            }).ToArray();

    private static string Kg(IDataRefSubscription sub)
        => $"{sub.GetValue(0.0):F0} kg";

    private async Task SyncFms()
    {
        _syncing = true;
        try
        {
            var result = await FmsSync.SyncAsync();
            _syncResult = result is null
                ? "Sync failed — see logs."
                : $"FMS UPDATED — ZFW {result.ZfwTonnes:F1} t · ZFWCG {result.ZfwCgPercent:F1}% · block {result.BlockTonnes:F1} t ({result.Source})";
        }
        finally
        {
            _syncing = false;
        }
    }
}
