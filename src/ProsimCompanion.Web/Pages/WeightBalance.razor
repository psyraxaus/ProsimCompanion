@page "/wnb"
@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Core.Aircraft.Ofp
@using ProsimCompanion.Core.Aircraft.WeightAndBalance
@inherits StoreObserverComponent
@inject IProsimDataRefs DataRefs
@inject LoadsheetStore Loadsheets
@inject PassengerManifestService ManifestService
@inject OfpStore Ofp
@inject IFmsInitSync FmsSync
@inject IServiceProvider Services
@inject DisplayUnitService Units
@inject IStringLocalizer T

<PageTitle>@T["wnb.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["wnb.heading"]</h1>

@{
    var sheets = Loadsheets.Snapshot();
    var best = sheets.Final.Status == LoadsheetSlotStatus.Sent ? sheets.Final
        : sheets.Prelim.Status == LoadsheetSlotStatus.Sent ? sheets.Prelim
        : null;
    var bestTag = sheets.Final.Status == LoadsheetSlotStatus.Sent ? "FIN"
        : sheets.Prelim.Status == LoadsheetSlotStatus.Sent ? "PRE" : null;

    var paxCapacity = _zone1Cap.Value + _zone2Cap.Value + _zone3Cap.Value + _zone4Cap.Value;
    var paxBoarded = _zone1.Value + _zone2.Value + _zone3.Value + _zone4.Value;
    var cargoLoaded = _cargoFwd.Value + _cargoAft.Value;
    var cargoCapacity = _cargoFwdCap.Value + _cargoAftCap.Value + _cargoBulkCap.Value;
    var ofp = Ofp.Current;

    // Weight-dependent envelope limits (A320TrimEnvelope, digitized from this chart's own
    // artwork) — the Prosim2GSX "VALID RANGE" line, per live weight.
    var (zfwMin, zfwMax) = A320TrimEnvelope.ZeroFuelLimits(_zfw.Value);
    var (gwMin, gwMax) = A320TrimEnvelope.GrossWeightLimits(_gross.Value);
    var zfwCgBad = _zfwcg.Value is var liveZfwCg and > 0 && (liveZfwCg < zfwMin || liveZfwCg > zfwMax);
    var gwCgBad = _cg.Value is var liveGwCg and > 0 && (liveGwCg < gwMin || liveGwCg > gwMax);

    var anyDoorOpen = new[] { _door1L, _door2L, _door3L, _door4L, _door1R, _door2R, _door3R, _door4R, _doorCargoFwd, _doorCargoAft, _doorCargoBulk }
        .Any(DoorOpen);
}

@* Layout (ADR-0011, canvas "W&B" page): aircraft loading + weight summary on the first row,
   the CG envelope (kept as-is — owner decision) + loading breakdown on the second. *@
<div class="wnb-page">

    <section class="section wnb-loading">
        <div class="section-header">
            <h3 class="section-title">@T["wnb.loading.title"]</h3>
            <span class="section-hint wnb-legend">
                <span class="wnb-legend-item"><span class="dot dot-ok"></span>@T["wnb.loading.closed"]</span>
                <span class="wnb-legend-item"><span class="dot dot-warn"></span>@T["wnb.loading.open"]</span>
            </span>
        </div>
        <div class="section-body wnb-loading-body">
            <div class="wnb-silhouette inset">
                <A320Silhouette SeatOccupation="@ParseSeatOccupation(_seatOccupation.Value)"
                                Door1L="@DoorOpen(_door1L)" Door2L="@DoorOpen(_door2L)"
                                Door3L="@DoorOpen(_door3L)" Door4L="@DoorOpen(_door4L)"
                                Door1R="@DoorOpen(_door1R)" Door2R="@DoorOpen(_door2R)"
                                Door3R="@DoorOpen(_door3R)" Door4R="@DoorOpen(_door4R)"
                                FwdCargoOpen="@DoorOpen(_doorCargoFwd)"
                                AftCargoOpen="@DoorOpen(_doorCargoAft)"
                                BulkCargoOpen="@DoorOpen(_doorCargoBulk)"
                                BulkFitted="@(_cargoBulkCap.Value > 0)" />
                <div class="wnb-doors">
                    @foreach (var (label, sub) in new[] { ("FWD", _doorCargoFwd), ("AFT", _doorCargoAft), ("BULK", _doorCargoBulk) })
                    {
                        var fitted = label != "BULK" || _cargoBulkCap.Value > 0;
                        <span class="wnb-door @(!fitted ? "na" : DoorOpen(sub) ? "open" : "closed")">
                            @label: @(!fitted ? T["wnb.loading.door.notFitted"].Value : DoorOpen(sub) ? T["wnb.loading.door.open"].Value : T["wnb.loading.door.closed"].Value)
                        </span>
                    }
                    <span class="pill @(anyDoorOpen ? "tone-warn" : "tone-ok")">
                        @(anyDoorOpen ? T["wnb.loading.doorsOpen"].Value : T["wnb.loading.allDoorsClosed"].Value)
                    </span>
                </div>
            </div>

            <div class="wnb-totals">
                <div class="wnb-total">
                    <span class="label-caps">@T["wnb.totals.totalPax"]</span>
                    <span class="figure figure-lg">@paxBoarded<span class="figure-unit">/ @paxCapacity</span></span>
                    <span class="wnb-total-sub">@T["wnb.totals.zones", _zone1.Value, _zone2.Value, _zone3.Value, _zone4.Value, ofp?.PaxCount.ToString() ?? "—"]</span>
                </div>
                <div class="wnb-total">
                    <span class="label-caps">@T["wnb.totals.cargoFwd"]</span>
                    <span class="figure figure-lg">@W0(_cargoFwd.Value)<span class="figure-unit">@UnitU</span></span>
                    <span class="wnb-total-sub">@T["wnb.max", W0(_cargoFwdCap.Value)]</span>
                </div>
                <div class="wnb-total">
                    <span class="label-caps">@T["wnb.totals.cargoAft"]</span>
                    <span class="figure figure-lg">@W0(_cargoAft.Value)<span class="figure-unit">@UnitU</span></span>
                    <span class="wnb-total-sub">@T["wnb.max", W0(_cargoAftCap.Value)]@(_cargoBulkCap.Value > 0 ? T["wnb.totals.bulk", W0(_cargoBulkCap.Value)].Value : "")</span>
                </div>
                <div class="wnb-total">
                    <span class="label-caps">@T["wnb.totals.fuelInTanks"]</span>
                    <span class="figure figure-lg glow">@W0(_fuelTotal.Value)<span class="figure-unit">@UnitU</span></span>
                    <span class="wnb-total-sub">@T["wnb.totals.planned", ofp is null ? "—" : W0(ofp.FuelPlanRampKg)]</span>
                </div>
            </div>

            <div class="wnb-tools">
                @if (_paxSim is not null)
                {
                    @* Predecessor's SIMULATE affordance: the button expands inline to COUNT +
                       GENERATE/CLEAR. Empty COUNT means a full cabin. The silhouette above picks
                       up the written occupation string on the next 1 s repaint. *@
                    @if (!_simOpen)
                    {
                        <button type="button" class="btn secondary" @onclick="() => _simOpen = true">@T["wnb.simulate.open"]</button>
                    }
                    else
                    {
                        <span class="label-caps">@T["wnb.simulate.count"]</span>
                        <input type="number" class="number-input" min="0" max="@paxCapacity"
                               placeholder="@(paxCapacity > 0 ? paxCapacity.ToString() : "132")"
                               disabled="@_simBusy" @bind="_simCount" />
                        <button type="button" class="btn secondary" disabled="@_simBusy" @onclick="GeneratePax">
                            @(_simBusy ? "…" : T["wnb.simulate.generate"].Value)
                        </button>
                        <button type="button" class="btn secondary" disabled="@_simBusy" @onclick="ClearPax">@T["wnb.simulate.clear"]</button>
                        <button type="button" class="btn secondary" title="@T["wnb.simulate.hide"]" @onclick="CloseSimulate">×</button>
                        <span class="field-hint">@T["wnb.simulate.hint"]</span>
                    }
                    @if (_simResult is not null)
                    {
                        <span class="field-hint">@_simResult</span>
                    }
                }
                <button type="button" class="btn secondary" @onclick="() => _showManifest = !_showManifest">
                    @(_showManifest ? T["wnb.manifest.hide"].Value : T["wnb.manifest.show", ManifestService.Manifest().Count].Value)
                </button>
                <span class="field-hint">@T["wnb.manifest.hint"]</span>
            </div>

            @if (_showManifest)
            {
                var manifest = ManifestService.Manifest();
                @if (manifest.Count == 0)
                {
                    <div class="empty">@T["wnb.manifest.empty"]</div>
                }
                else
                {
                    <div class="manifest-grid inset wnb-manifest">
                        <span class="manifest-head">@T["wnb.manifest.seat"]</span><span class="manifest-head">@T["wnb.manifest.name"]</span><span class="manifest-head">@T["wnb.manifest.zone"]</span>
                        @foreach (var pax in manifest)
                        {
                            <span class="row-value-mono">@pax.SeatNumber</span>
                            <span class="row-value-mono">@pax.FirstName @pax.LastName</span>
                            <span class="row-value-mono">Z@(pax.Zone)</span>
                        }
                    </div>
                }
            }
        </div>
    </section>

    <section class="section wnb-summary">
        <div class="section-header"><h3 class="section-title">@T["wnb.summary.title"]</h3></div>
        <div class="section-body wnb-summary-body">
            @WeightBar(T["wnb.summary.zfw"], _zfw.Value, _zfwMax.Value, false)
            @WeightBar(T["wnb.summary.gw"], _gross.Value, _grossMax.Value, true)
            <div class="wnb-mac inset">
                @* Owner question 2026-10-04 ("the W&B page says 26.8, the loadsheet 27.6"): the big
                   figure is ProSim's LIVE zfwcg dataref; the loadsheet's MACZFW comes from ProSim's
                   own loadsheet-generator relation (gross CG minus the fuel-shift table) and is what
                   ProSim's EFB prints and what goes to the MCDU. Both are shown and named. *@
                <div class="wnb-mac-cell">
                    <span class="label-caps">MACZFW <span class="muted">· @T["wnb.summary.live"]</span></span>
                    <span class="figure @(zfwCgBad ? "wnb-bad" : null)">@($"{_zfwcg.Value:F1}")<span class="figure-unit">%</span></span>
                    <span class="wnb-total-sub @(zfwCgBad ? "wnb-bad" : null)">@T["wnb.summary.valid", $"{zfwMin:F1}–{zfwMax:F1}"]@(best is { MacZfw: > 0 } ? T["wnb.summary.loadsheet", bestTag ?? "", $"{best.MacZfw:F1}"].Value : "")</span>
                </div>
                <div class="wnb-mac-cell">
                    <span class="label-caps">MACGW <span class="muted">· @T["wnb.summary.live"]</span></span>
                    <span class="figure glow @(gwCgBad ? "wnb-bad" : null)">@($"{_cg.Value:F1}")<span class="figure-unit">%</span></span>
                    <span class="wnb-total-sub @(gwCgBad ? "wnb-bad" : null)">@T["wnb.summary.valid", $"{gwMin:F1}–{gwMax:F1}"]@(best is { MacTow: > 0 } ? T["wnb.summary.loadsheet", bestTag ?? "", $"{best.MacTow:F1}"].Value : "")</span>
                </div>
            </div>
            <button type="button" class="btn primary" disabled="@_syncing" @onclick="SyncFms">
                @(_syncing ? T["wnb.summary.syncing"].Value : T["wnb.summary.sync", bestTag ?? T["wnb.summary.computed"].Value].Value)
            </button>
            @if (_syncResult is not null)
            {
                <span class="field-hint">@_syncResult</span>
            }
        </div>
    </section>

    <section class="section wnb-envelope">
        <div class="section-header">
            <h3 class="section-title">@T["wnb.envelope.title"]</h3>
            <span class="section-hint">@T["wnb.envelope.hint"]</span>
        </div>
        <div class="section-body wnb-envelope-body">
            <div class="wnb-chart">
                <CgEnvelope GrossWeightKg="@_gross.Value"
                            GrossCgMac="@_cg.Value"
                            ZfwKg="@_zfw.Value"
                            ZfwCgMac="@_zfwcg.Value" />
            </div>
            <table class="data-table wnb-table">
                <thead>
                    <tr>
                        <th></th>
                        <th class="num">ZFW (@UnitU)</th>
                        <th class="num">MACZFW (%)</th>
                        <th class="num">GW (@UnitU)</th>
                        <th class="num">MACGW (%)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="wnb-rowhead">@T["wnb.envelope.live"]</td>
                        <td class="mono num">@W0(_zfw.Value)</td>
                        <td class="mono num @(zfwCgBad ? "wnb-bad" : null)">@($"{_zfwcg.Value:F1}")</td>
                        <td class="mono num">@W0(_gross.Value)</td>
                        <td class="mono num @(gwCgBad ? "wnb-bad" : null)">@($"{_cg.Value:F1}")</td>
                    </tr>
                    <tr>
                        <td class="wnb-rowhead">@T["wnb.envelope.loadsheet"] @(bestTag is null ? "" : $"({bestTag})")</td>
                        <td class="mono num">@(best is null ? "—" : W0(best.ZfwKg))</td>
                        <td class="mono num">@(best is null ? "—" : $"{best.MacZfw:F1}")</td>
                        <td class="mono num">@(best is null ? "—" : W0(best.TowKg))</td>
                        <td class="mono num">@(best is null ? "—" : $"{best.MacTow:F1}")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="section wnb-breakdown">
        <div class="section-header"><h3 class="section-title">@T["wnb.breakdown.title"]</h3></div>
        <div class="section-body">
            <table class="data-table wnb-table">
                <thead>
                    <tr>
                        <th>@T["wnb.breakdown.category"]</th>
                        <th class="num">@T["wnb.breakdown.actual"]</th>
                        <th class="num">@T["wnb.breakdown.max"]</th>
                        <th class="num">@T["wnb.breakdown.status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @BreakdownRow(T["wnb.breakdown.passengers"], paxBoarded, paxCapacity, "", ofp?.PaxCount)
                    @BreakdownRow(T["wnb.breakdown.cargoFwd"], _cargoFwd.Value, _cargoFwdCap.Value, UnitU, null)
                    @BreakdownRow(T["wnb.breakdown.cargoAft"], _cargoAft.Value, _cargoAftCap.Value, UnitU, null)
                    @if (_cargoBulkCap.Value > 0)
                    {
                        @BreakdownRow(T["wnb.breakdown.cargoTotal"], cargoLoaded, cargoCapacity, UnitU, ofp?.CargoKg)
                    }
                    else
                    {
                        @BreakdownRow(T["wnb.breakdown.cargoTotal"], cargoLoaded, cargoCapacity, UnitU, ofp?.CargoKg)
                    }
                    @BreakdownRow(T["wnb.breakdown.fuel"], _fuelTotal.Value, 0, UnitU, ofp?.FuelPlanRampKg)
                    @BreakdownRow("ZFW", _zfw.Value, _zfwMax.Value, UnitU, ofp?.EstZfwKg)
                    @BreakdownRow(T["wnb.breakdown.grossWeight"], _gross.Value, _grossMax.Value, UnitU, ofp?.EstTowKg)
                </tbody>
            </table>
        </div>
    </section>

</div>

@code {
    private IDataRefSubscription<double> _zfw = default!;
    private IDataRefSubscription<double> _zfwMax = default!;
    private IDataRefSubscription<double> _gross = default!;
    private IDataRefSubscription<double> _grossMax = default!;
    private IDataRefSubscription<double> _cg = default!;
    private IDataRefSubscription<double> _zfwcg = default!;
    private IDataRefSubscription<double> _fuelTotal = default!;
    private IDataRefSubscription<int> _zone1 = default!;
    private IDataRefSubscription<int> _zone2 = default!;
    private IDataRefSubscription<int> _zone3 = default!;
    private IDataRefSubscription<int> _zone4 = default!;
    private IDataRefSubscription<int> _zone1Cap = default!;
    private IDataRefSubscription<int> _zone2Cap = default!;
    private IDataRefSubscription<int> _zone3Cap = default!;
    private IDataRefSubscription<int> _zone4Cap = default!;
    private IDataRefSubscription<double> _cargoFwd = default!;
    private IDataRefSubscription<double> _cargoAft = default!;
    private IDataRefSubscription<double> _cargoFwdCap = default!;
    private IDataRefSubscription<double> _cargoAftCap = default!;
    private IDataRefSubscription<double> _cargoBulkCap = default!;
    private IDataRefSubscription<string?> _seatOccupation = default!;
    private IDataRefSubscription<bool> _door1L = default!;
    private IDataRefSubscription<bool> _door2L = default!;
    private IDataRefSubscription<bool> _door3L = default!;
    private IDataRefSubscription<bool> _door4L = default!;
    private IDataRefSubscription<bool> _door1R = default!;
    private IDataRefSubscription<bool> _door2R = default!;
    private IDataRefSubscription<bool> _door3R = default!;
    private IDataRefSubscription<bool> _door4R = default!;
    private IDataRefSubscription<bool> _doorCargoFwd = default!;
    private IDataRefSubscription<bool> _doorCargoAft = default!;
    private IDataRefSubscription<bool> _doorCargoBulk = default!;
    private Timer? _refresh;
    private bool _showManifest;
    private bool _syncing;
    private string? _syncResult;
    private IPassengerSimulation? _paxSim;
    private bool _simOpen;
    private bool _simBusy;
    private int? _simCount;
    private string? _simResult;

    protected override void OnInitialized()
    {
        // Optional resolution: the SIMULATE tool simply disappears in builds where the ProSim
        // pillar (its owner) is not wired — degrade, not fail.
        _paxSim = Services.GetService<IPassengerSimulation>();

        // Markup reads Units directly, so the watch only needs the base's re-render.
        WatchChanged(h => Units.Changed += h, h => Units.Changed -= h, () => { });

        _zfw = DataRefs.Subscribe(ProsimDataRefNames.WeightZfw);
        _zfwMax = DataRefs.Subscribe(ProsimDataRefNames.WeightZfwMax);
        _gross = DataRefs.Subscribe(ProsimDataRefNames.WeightGross);
        _grossMax = DataRefs.Subscribe(ProsimDataRefNames.WeightGrossMax);
        _cg = DataRefs.Subscribe(ProsimDataRefNames.CenterOfGravity);
        _zfwcg = DataRefs.Subscribe(ProsimDataRefNames.Zfwcg);
        _fuelTotal = DataRefs.Subscribe(ProsimDataRefNames.FuelTotal);
        _zone1 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone1Amount);
        _zone2 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone2Amount);
        _zone3 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone3Amount);
        _zone4 = DataRefs.Subscribe(ProsimDataRefNames.PaxZone4Amount);
        _zone1Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone1Capacity);
        _zone2Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone2Capacity);
        _zone3Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone3Capacity);
        _zone4Cap = DataRefs.Subscribe(ProsimDataRefNames.PaxZone4Capacity);
        _cargoFwd = DataRefs.Subscribe(ProsimDataRefNames.CargoForwardAmount);
        _cargoAft = DataRefs.Subscribe(ProsimDataRefNames.CargoAftAmount);
        _cargoFwdCap = DataRefs.Subscribe(ProsimDataRefNames.CargoForwardCapacity);
        _cargoAftCap = DataRefs.Subscribe(ProsimDataRefNames.CargoAftCapacity);
        _cargoBulkCap = DataRefs.Subscribe(ProsimDataRefNames.CargoBulkCapacity);
        _seatOccupation = DataRefs.Subscribe(ProsimDataRefNames.PaxSeatOccupationString);
        _door1L = DataRefs.Subscribe(ProsimDataRefNames.Door1L);
        _door2L = DataRefs.Subscribe(ProsimDataRefNames.Door2L);
        _door3L = DataRefs.Subscribe(ProsimDataRefNames.Door3L);
        _door4L = DataRefs.Subscribe(ProsimDataRefNames.Door4L);
        _door1R = DataRefs.Subscribe(ProsimDataRefNames.Door1R);
        _door2R = DataRefs.Subscribe(ProsimDataRefNames.Door2R);
        _door3R = DataRefs.Subscribe(ProsimDataRefNames.Door3R);
        _door4R = DataRefs.Subscribe(ProsimDataRefNames.Door4R);
        _doorCargoFwd = DataRefs.Subscribe(ProsimDataRefNames.DoorCargoForward);
        _doorCargoAft = DataRefs.Subscribe(ProsimDataRefNames.DoorCargoAft);
        _doorCargoBulk = DataRefs.Subscribe(ProsimDataRefNames.DoorCargoBulk);

        // Live instrument view — a 1 s repaint is simpler and cheaper than wiring 30+
        // ValueChanged handlers, and matches the datarefs' Normal cadence.
        _refresh = new Timer(_ => _ = InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public override void Dispose()
    {
        _refresh?.Dispose();
        foreach (var sub in new IDataRefSubscription[]
        {
            _zfw, _zfwMax, _gross, _grossMax, _cg, _zfwcg, _fuelTotal,
            _zone1, _zone2, _zone3, _zone4, _zone1Cap, _zone2Cap, _zone3Cap, _zone4Cap,
            _cargoFwd, _cargoAft, _cargoFwdCap, _cargoAftCap, _cargoBulkCap, _seatOccupation,
            _door1L, _door2L, _door3L, _door4L, _door1R, _door2R, _door3R, _door4R,
            _doorCargoFwd, _doorCargoAft, _doorCargoBulk,
        })
        {
            sub.Dispose();
        }
        base.Dispose();
    }

    // ── Row renderers (ADR-0011) ─────────────────────────────────────────────────────

    /// <summary>Weight summary bar: figure vs limit, red when over.</summary>
    private RenderFragment WeightBar(string label, double kg, double maxKg, bool hot)
    {
        var pct = maxKg > 0 ? Math.Clamp(kg / maxKg * 100, 0, 100) : 0;
        var over = maxKg > 0 && kg > maxKg;
        return @<div class="wnb-bar @(hot ? "hot" : null)">
            <div class="wnb-bar-head">
                <span class="label-caps">@label</span>
                <span class="wnb-bar-value @(over ? "wnb-bad" : null)">@W0(kg) @UnitU</span>
            </div>
            <div class="wnb-bar-track"><div class="wnb-bar-fill @(over ? "over" : null)" style="width:@(pct.ToString("F1", CultureInfo.InvariantCulture))%"></div></div>
            <span class="wnb-bar-max">@T["wnb.max", maxKg > 0 ? $"{W0(maxKg)} {UnitU}" : "—"]</span>
        </div>;
    }

    /// <summary>Loading-breakdown row: actual vs max (0 = no limit) with a status pill;
    /// pax rows carry no unit, weight rows convert through the display unit.</summary>
    private RenderFragment BreakdownRow(string category, double actual, double max, string unit, double? planned)
    {
        var isWeight = unit.Length > 0;
        string Fmt(double v) => isWeight ? W0(v) : v.ToString("F0", CultureInfo.InvariantCulture);
        var over = max > 0 && actual > max;
        var (tone, text) = over ? ("tone-bad", T["wnb.breakdown.over"].Value)
            : actual <= 0 ? ("tone-neutral", T["wnb.breakdown.empty"].Value)
            : planned is { } p && p > 0 && Math.Abs(actual - p) / p > 0.05 ? ("tone-warn", T["wnb.breakdown.vsPlan"].Value)
            : ("tone-ok", T["wnb.breakdown.ok"].Value);
        return @<tr>
            <td class="wnb-rowhead">@category</td>
            <td class="mono num @(over ? "wnb-bad" : null)">@Fmt(actual) @unit</td>
            <td class="mono num" style="color:var(--text-muted)">@(max > 0 ? $"{Fmt(max)} {unit}" : planned is { } pl ? T["wnb.breakdown.plan", Fmt(pl), unit].Value : "—")</td>
            <td class="num"><span class="pill @tone">@text</span></td>
        </tr>;
    }

    private static bool DoorOpen(IDataRefSubscription<bool> sub) => sub.Value;

    // Uppercase unit label for the panel's all-caps typography ("KG" / "LB").
    private string UnitU => Units.UnitLabel.ToUpperInvariant();

    /// <summary>Bare converted figure, no unit label (grid cells carry the unit in the header).</summary>
    private string W0(double kg) => Units.FromKg(kg).ToString("F0", CultureInfo.InvariantCulture);

    /// <summary>ProSim's seatOccupation string is comma-separated "true,false,…" (legacy
    /// producers used "1"/"0"); anything unparseable — including the descriptor's null
    /// "no seat map yet" fallback — reads as an empty cabin.</summary>
    private static IReadOnlyList<bool> ParseSeatOccupation(string? raw)
        => string.IsNullOrEmpty(raw)
            ? []
            : raw.Split(',').Select(token =>
            {
                var value = token.Trim();
                return value.Equals("true", StringComparison.OrdinalIgnoreCase) || value == "1";
            }).ToArray();

    private string Wt(IDataRefSubscription<double> sub)
        => $"{W0(sub.Value)} {Units.UnitLabel}";

    private void CloseSimulate()
    {
        _simOpen = false;
        _simResult = null;
    }

    /// <summary>An empty COUNT simulates a full cabin (the predecessor's semantics); the
    /// service clamps to live capacity either way, so the page only clamps for the message.</summary>
    private async Task GeneratePax()
    {
        if (_paxSim is null || _simBusy)
        {
            return;
        }

        _simBusy = true;
        _simResult = null;
        try
        {
            var capacity = _zone1Cap.Value + _zone2Cap.Value + _zone3Cap.Value + _zone4Cap.Value;
            if (capacity <= 0)
            {
                capacity = 132;
            }
            var target = Math.Clamp(_simCount ?? capacity, 0, capacity);
            var ok = await _paxSim.GenerateAsync(target);
            _simResult = ok ? T["wnb.simulate.generated", target].Value : T["wnb.simulate.generationFailed"].Value;
        }
        finally
        {
            _simBusy = false;
        }
    }

    private async Task ClearPax()
    {
        if (_paxSim is null || _simBusy)
        {
            return;
        }

        _simBusy = true;
        _simResult = null;
        try
        {
            var ok = await _paxSim.ClearAsync();
            _simResult = ok ? T["wnb.simulate.cleared"].Value : T["wnb.simulate.clearFailed"].Value;
        }
        finally
        {
            _simBusy = false;
        }
    }

    private async Task SyncFms()
    {
        _syncing = true;
        try
        {
            var result = await FmsSync.SyncAsync();
            _syncResult = result is null
                ? T["wnb.summary.syncFailed"].Value
                : T["wnb.summary.fmsUpdated", $"{result.ZfwTonnes:F1}", $"{result.ZfwCgPercent:F1}", $"{result.BlockTonnes:F1}", result.Source].Value;
        }
        finally
        {
            _syncing = false;
        }
    }
}
