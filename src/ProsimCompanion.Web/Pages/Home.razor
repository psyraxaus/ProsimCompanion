@page "/"
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Core.Flight
@using ProsimCompanion.Core.Profiles
@implements IDisposable
@inject ConnectionStatusStore Status
@inject IProsimDataRefs DataRefs
@inject FlightStateEngine FlightState
@inject AircraftProfileService Profiles
@inject ProsimCompanion.Core.Logging.LogBufferStore LogBuffer
@inject ProsimCompanion.Core.State.GsxDiagnosticsStore GsxDiagnosticsStore

<h1>Status</h1>

<p>Flight phase: <strong>@FlightState.CurrentPhase</strong></p>
<p>
    Aircraft: <strong>@(Profiles.AircraftTitle ?? "—")</strong>
    &nbsp;·&nbsp; Profile: <strong>@(Profiles.ActiveProfile?.Name ?? "none")</strong>
</p>
<p class="hint">
    This session: @LogBuffer.WarningCount warnings, @LogBuffer.ErrorCount errors —
    <a href="logs">view logs</a>
</p>

@if (_snapshot.Count == 0)
{
    <p class="hint">No subsystems have reported yet.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Subsystem</th><th>State</th></tr>
        </thead>
        <tbody>
            @foreach (var (subsystem, state) in _snapshot)
            {
                <tr>
                    <td>@subsystem</td>
                    <td><span class="badge @state.ToString().ToLowerInvariant()">@state</span></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_serviceBoard.Count > 0)
{
    <h2>Departure services</h2>
    <table>
        <tbody>
            @foreach (var row in _serviceBoard)
            {
                <tr>
                    <td>@row.ServiceId</td>
                    <td><span class="badge @GsxDiagnostics.StageClass(row.Stage)">@GsxDiagnostics.StageLabel(row.Stage)</span></td>
                    <td class="hint">@(row.Detail ?? "")</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="hint">Live turnaround status — full detail on the <a href="gsx">GSX page</a>.</p>
}

<h2>Live aircraft data</h2>
<table>
    <thead>
        <tr><th>Dataref</th><th>Value</th></tr>
    </thead>
    <tbody>
        @foreach (var sample in _samples)
        {
            <tr>
                <td>@sample.Label</td>
                <td>@sample.Display()@(sample.Subscription.IsStale ? " (stale)" : "")</td>
            </tr>
        }
    </tbody>
</table>
<p class="hint">
    Pushed live from ProSim through the register-once cached read model — the same seam every
    feature pillar consumes. Shows “—” until ProSim connects and pushes a value.
</p>

<details style="margin-top:1rem;">
    <summary style="cursor:pointer; font-weight:600;">Flight data diagnostics (raw snapshot)</summary>
    @if (FlightState.LastSnapshot is not { } snap)
    {
        <p class="hint">No snapshot sampled yet.</p>
    }
    else
    {
        <table style="font-family:Consolas, monospace; font-size:0.85rem; margin-top:0.5rem;">
            <tbody>
                <tr><td>IsValid</td><td>@snap.IsValid</td><td>OnGround</td><td>@snap.OnGround</td></tr>
                <tr><td>IAS kt</td><td>@snap.IndicatedAirspeedKt.ToString("F1")</td><td>GS kt</td><td>@snap.GroundSpeedKt.ToString("F1")</td></tr>
                <tr><td>Alt ft</td><td>@snap.AltitudeFt.ToString("F0")</td><td>RA ft</td><td>@snap.RadioAltitudeFt.ToString("F0")</td></tr>
                <tr><td>VS fpm</td><td>@snap.VerticalSpeedFpm.ToString("F0")</td><td>Powered</td><td>@snap.AircraftPowered</td></tr>
                <tr><td>AnyEngineRunning</td><td>@snap.AnyEngineRunning</td><td>EngineStarting</td><td>@snap.EngineStarting</td></tr>
                <tr><td>Engine1 state</td><td>@(snap.RawEngine1State ?? "—")</td><td>Engine2 state</td><td>@(snap.RawEngine2State ?? "—")</td></tr>
                <tr><td>Max N1 %</td><td>@snap.MaxN1Percent.ToString("F1")</td><td>TakeoffThrustSet</td><td>@snap.TakeoffThrustSet</td></tr>
                <tr><td>PushbackActive</td><td>@snap.PushbackActive</td><td>Raw pushback</td><td>@snap.RawPushbackState</td></tr>
                <tr><td>ParkBrakeSet</td><td>@snap.ParkBrakeSet</td><td>GearDown</td><td>@snap.GearDown</td></tr>
            </tbody>
        </table>
        <p class="hint">Raw values feeding the phase engine — for diagnosing phase misbehaviour.</p>
    }
</details>

@code {
    private IReadOnlyList<KeyValuePair<string, ConnectionState>> _snapshot = [];
    private IReadOnlyList<ProsimCompanion.Core.State.GsxServiceBoardRow> _serviceBoard = [];
    private readonly List<Sample> _samples = [];
    private Timer? _boardTimer;

    protected override void OnInitialized()
    {
        _snapshot = Status.Snapshot();
        Status.Changed += OnStatusChanged;
        FlightState.PhaseChanged += OnPhaseChanged;
        Profiles.Changed += OnDataChanged;

        _serviceBoard = GsxDiagnosticsStore.Snapshot().ServiceBoard;
        _boardTimer = new Timer(_ => _ = InvokeAsync(() =>
        {
            var board = GsxDiagnosticsStore.Snapshot().ServiceBoard;
            if (!ReferenceEquals(board, _serviceBoard))
            {
                _serviceBoard = board;
                StateHasChanged();
            }
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        AddSample("Indicated airspeed (kt)", "aircraft.speed.ias", DataRefTier.Frequent,
            subscription => subscription.GetValue(double.NaN) is var v && double.IsNaN(v) ? "—" : v.ToString("F0"));
        AddSample("Fuel on board (kg)", "aircraft.fuel.total.amount.kg", DataRefTier.Normal,
            subscription => subscription.GetValue(double.NaN) is var v && double.IsNaN(v) ? "—" : v.ToString("F0"));
        AddSample("Gear down", "aircraft.gearDown", DataRefTier.Normal,
            subscription => subscription.RawValue is null ? "—" : subscription.GetValue(false) ? "yes" : "no");
    }

    private void AddSample(string label, string name, DataRefTier tier, Func<IDataRefSubscription, string> display)
    {
        var subscription = DataRefs.Subscribe(name, tier);
        subscription.ValueChanged += OnDataChanged;
        _samples.Add(new Sample(label, subscription, display));
    }

    private void OnStatusChanged(object? sender, EventArgs e)
    {
        // Store events fire on the writer's thread; marshal into the circuit.
        _ = InvokeAsync(() =>
        {
            _snapshot = Status.Snapshot();
            StateHasChanged();
        });
    }

    private void OnDataChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private void OnPhaseChanged(object? sender, FlightPhaseChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _boardTimer?.Dispose();
        Status.Changed -= OnStatusChanged;
        FlightState.PhaseChanged -= OnPhaseChanged;
        Profiles.Changed -= OnDataChanged;
        foreach (var sample in _samples)
        {
            sample.Subscription.ValueChanged -= OnDataChanged;
            sample.Subscription.Dispose();
        }
    }

    private sealed record Sample(string Label, IDataRefSubscription Subscription, Func<IDataRefSubscription, string> Format)
    {
        public string Display() => Format(Subscription);
    }
}
