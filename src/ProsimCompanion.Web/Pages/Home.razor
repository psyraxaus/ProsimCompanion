@page "/"
@using ProsimCompanion.Core.Configuration
@using ProsimCompanion.Core.Flight
@using ProsimCompanion.Core.Profiles
@implements IDisposable
@inject ConnectionStatusStore Status
@inject FlightStateEngine FlightState
@inject AircraftProfileService Profiles
@inject GsxDiagnosticsStore Diagnostics
@inject IGsxDepartureControl DepartureControl
@inject AudioStatusStore Audio
@inject IOptionsMonitor<GsxOptions> GsxOptionsMonitor

@* Prosim2GSX FlightStatusPanel clone: Flight Phase span card, then Sim / App / GSX /
   Services cards with the same rows in the same order. The log tail card is deliberately
   omitted (decision: the Logs tab owns log viewing); the departure-services board lives on
   the GSX Status page. Signals our architecture does not track yet render as neutral "—"
   rather than being dropped, so the layout stays identical. *@

<PageTitle>Flight Status — ProsimCompanion</PageTitle>
<h1 class="sr-only">Flight Status</h1>

<div class="status-panel">

    <section class="status-section status-span">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">Flight Phase</h3>
        <div class="phase-body">
            <div class="phase-label">@PhaseDisplay</div>
            <div class="phase-grid">
                @for (var i = 0; i < BlockLabels.Length; i++)
                {
                    <div class="phase-block @(i == ActiveBlock ? "active" : null)"></div>
                }
                @foreach (var label in BlockLabels)
                {
                    <div class="phase-block-label">@label</div>
                }
            </div>
        </div>
    </section>

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">Sim</h3>
        <div class="section-body">
            @Indicator("Sim Running", SimConnected)
            @Indicator("Sim Connected", SimConnected)
            @Indicator("Sim Session", FlightState.LastSnapshot?.IsValid == true)
            @UntrackedIndicator("Sim Paused")
            @UntrackedIndicator("Walkaround")
            @Kv("Camera State", "—")
            @Kv("Sim Version", "—")
            @Kv("Aircraft", Profiles.AircraftTitle ?? "—")
        </div>
    </section>

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">App</h3>
        <div class="section-body">
            @Indicator("GSX Controller", GsxConnected)
            @Indicator("ProSim Binary", ProsimConnected)
            @Indicator("Aircraft Interface", ProsimConnected)
            @Indicator("ProSim SDK Connected", ProsimConnected)
            @Indicator("Automation Controller", GsxOptionsMonitor.CurrentValue.AutomationEnabled)
            @Indicator("Audio Controller", Audio.Snapshot().Enabled)
            @Kv("Profile", Profiles.ActiveProfile?.Name ?? "—")
            @Kv("Aircraft", Profiles.AircraftTitle ?? "—")
            @Kv("On Ground", (FlightState.LastSnapshot?.OnGround)?.ToString() ?? "—")
            @Kv("Engines Running", (FlightState.LastSnapshot?.AnyEngineRunning)?.ToString() ?? "—")
            @Kv("In Motion", FlightState.LastSnapshot is { } motion ? (motion.GroundSpeedKt > 0.5).ToString() : "—")
        </div>
    </section>

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">GSX</h3>
        <div class="section-body">
            @Indicator("GSX Running", GsxConnected)
            @Indicator("Couatl Vars", _gsx.Readiness == "Ready")
            @Kv("Couatl Started", _gsx.StartupSid ?? "—")
            @Kv("Menu State", _gsx.MenuShown ? (_gsx.MenuTitle ?? "shown") : "closed")
            @Kv("Pax Target", _gsx.BoardingCounters?.PaxTarget?.ToString() ?? "—")
            @Kv("Pax Total (B|D)", PaxTotals)
            @Kv("Cargo (B|D)", CargoTotals)
            @Kv("Departure Services", DepartureSummary)
            @Kv("Assigned Gate", _gsx.GateRequest ?? "—")
            @Kv("Last Handler Event", HandlerEvent)
        </div>
    </section>

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">Services</h3>
        <div class="section-body">
            @ServiceRow("Reposition", "Reposition")
            @ServiceRow("Refuel", "Refueling")
            @ServiceRow("Catering", "Catering")
            @ServiceRow("Lavatory", "Lavatory")
            @ServiceRow("Water", "Water")
            @ServiceRow("Cleaning", "Cleaning")
            @ServiceRow("GPU", "GPU")
            @ServiceRow("Boarding", "Boarding")
            @ServiceRow("Deboarding", "Deboarding")
            @ServiceRow("Pushback", "Pushback")
            @ServiceRow("Jetway", "Jetway")
            @ConnectedRow("Jetway Connected", "Jetway")
            @ServiceRow("Stairs", "Stairs")
            @ConnectedRow("Stairs Connected", "Stairs")
        </div>
    </section>

</div>

@code {
    private static readonly string[] BlockLabels =
        ["PREFLIGHT", "DEPARTURE", "PUSHBACK", "TAXI OUT", "FLIGHT", "TAXI IN", "ARRIVAL"];

    private IReadOnlyList<KeyValuePair<string, ConnectionState>> _connections = [];
    private GsxDiagnosticsSnapshot _gsx = GsxDiagnosticsSnapshot.Empty;

    private bool SimConnected => StateOf(Subsystems.SimConnect) == ConnectionState.Connected;
    private bool ProsimConnected => StateOf(Subsystems.Prosim) == ConnectionState.Connected;
    private bool GsxConnected => StateOf(Subsystems.Gsx) == ConnectionState.Connected;

    private ConnectionState StateOf(string subsystem)
        => _connections.FirstOrDefault(pair => pair.Key == subsystem).Value;

    private int ActiveBlock => FlightState.CurrentPhase switch
    {
        FlightPhase.Unknown or FlightPhase.ColdAndDark or FlightPhase.Preflight =>
            DepartureControl.Started && !DepartureControl.Complete ? 1 : 0,
        FlightPhase.PushbackAndStart => 2,
        FlightPhase.TaxiOut or FlightPhase.TakeoffRoll => 3,
        FlightPhase.InitialClimb or FlightPhase.Climb or FlightPhase.Cruise
            or FlightPhase.Descent or FlightPhase.Approach => 4,
        FlightPhase.LandingRollout or FlightPhase.TaxiIn => 5,
        FlightPhase.Shutdown => 6,
        _ => 0,
    };

    private string PhaseDisplay => ToSpacedUpper(FlightState.CurrentPhase.ToString());

    // Prosim2GSX row shapes: "boarded | deboarded" pax and "board% | deboard%" cargo.
    private string PaxTotals => _gsx.BoardingCounters is { } pax
        ? $"{pax.PaxBoarded?.ToString() ?? "—"} | {pax.PaxDeboarded?.ToString() ?? "—"}"
        : "—";

    private string CargoTotals => _gsx.BoardingCounters is { } cargo
        ? $"{FormatPercent(cargo.CargoBoardedPercent)} | {FormatPercent(cargo.CargoDeboardedPercent)}"
        : "—";

    private static string FormatPercent(double? value)
        => value is { } pct ? $"{pct:F0}%" : "—";

    // Two producers share this row: service lifecycle edges ("Boarding: Active") and the
    // in-sim handler script's events ("boardingRequested", "gateReset: user_changed").
    private string HandlerEvent => _gsx.LastHandlerEvent is { } evt
        ? $"{evt.Timestamp.ToLocalTime():HH:mm:ss} {evt.Service}{(evt.Event.Length > 0 ? $": {evt.Event}" : "")}"
        : "—";

    private string DepartureSummary =>
        DepartureControl.Complete ? "Complete"
        : DepartureControl.Started ? "Running"
        : "Not started";

    // ── Row renderers (mirror Prosim2GSX's Indicator / KV / ServiceRow components) ──

    private static RenderFragment Indicator(string label, bool ok) => @<div class="row">
        <span class="row-label">@label</span>
        <span class="dot @(ok ? "dot-ok" : "dot-bad")" aria-hidden="true"></span>
        <span class="row-value">@(ok ? "OK" : "—")</span>
    </div>;

    private static RenderFragment UntrackedIndicator(string label) => @<div class="row">
        <span class="row-label">@label</span>
        <span class="dot dot-neutral" aria-hidden="true"></span>
        <span class="row-value">—</span>
    </div>;

    private static RenderFragment Kv(string label, string value) => @<div class="row">
        <span class="row-label">@label</span>
        <span class="row-value-mono">@value</span>
    </div>;

    private RenderFragment ServiceRow(string label, string serviceId)
    {
        var view = ServiceView(serviceId);
        // Tone keys off the MAPPED protocol state: the semantic string is GSX's raw display
        // text ("available", "active (5)", …) and never matched the enum names, so the pills
        // stayed neutral forever. The semantic text is still what the pill SHOWS.
        var tone = view?.MappedState.ToLowerInvariant() switch
        {
            "completed" => "tone-ok",
            "active" => "tone-active",
            "requested" => "tone-warn",
            _ => "tone-neutral",
        };
        var text = view is null ? null : view.SemanticState ?? view.MappedState;
        return @<div class="row">
            <span class="row-label">@label</span>
            <span class="pill @tone">@(text ?? "—")</span>
        </div>;
    }

    private RenderFragment ConnectedRow(string label, string serviceId)
    {
        // Docked = the operate service mirrors Active or Completed — judged on the mapped
        // state for the same reason as ServiceRow.
        var view = ServiceView(serviceId);
        var connected = view?.MappedState.ToLowerInvariant() is "active" or "completed";
        return @<div class="row">
            <span class="row-label">@label</span>
            <span class="pill @(connected ? "tone-ok" : "tone-neutral")">@(connected ? "Connected" : "—")</span>
        </div>;
    }

    private GsxServiceView? ServiceView(string serviceId)
        => _gsx.Services.FirstOrDefault(service =>
            string.Equals(service.Id, serviceId, StringComparison.OrdinalIgnoreCase));

    private static string ToSpacedUpper(string pascal)
    {
        var result = new System.Text.StringBuilder(pascal.Length + 4);
        foreach (var ch in pascal)
        {
            if (char.IsUpper(ch) && result.Length > 0)
            {
                result.Append(' ');
            }
            result.Append(char.ToUpperInvariant(ch));
        }
        return result.ToString();
    }

    protected override void OnInitialized()
    {
        _connections = Status.Snapshot();
        _gsx = Diagnostics.Snapshot();

        Status.Changed += OnStatusChanged;
        Diagnostics.Changed += OnDiagnosticsChanged;
        FlightState.PhaseChanged += OnPhaseChanged;
        Profiles.Changed += OnDataChanged;
        Audio.Changed += OnDataChanged;
    }

    private void OnStatusChanged(object? sender, EventArgs e)
        // Store events fire on the writer's thread; marshal into the circuit.
        => _ = InvokeAsync(() =>
        {
            _connections = Status.Snapshot();
            StateHasChanged();
        });

    private void OnDiagnosticsChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(() =>
        {
            _gsx = Diagnostics.Snapshot();
            StateHasChanged();
        });

    private void OnDataChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private void OnPhaseChanged(object? sender, FlightPhaseChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Status.Changed -= OnStatusChanged;
        Diagnostics.Changed -= OnDiagnosticsChanged;
        FlightState.PhaseChanged -= OnPhaseChanged;
        Profiles.Changed -= OnDataChanged;
        Audio.Changed -= OnDataChanged;
    }
}
