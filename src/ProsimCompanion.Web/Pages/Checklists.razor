@page "/checklists"
@using Microsoft.Extensions.Options
@using ProsimCompanion.Core.Checklists
@using ProsimCompanion.Core.Configuration
@inherits StoreObserverComponent
@inject ChecklistService Engine
@using Microsoft.JSInterop
@inject IOptionsMonitor<ChecklistOptions> Options
@inject IJSRuntime JS

<PageTitle>Checklists — ProsimCompanion</PageTitle>
<h1 class="sr-only">Checklists</h1>

<ConfigProblemsBanner />

@*
    ECAM-style checklist surface, ported from Prosim2GSX's ChecklistsPanel (which mirrors the
    WPF ViewChecklist): the black instrument screen with dotted-leader rows is kept as-is (an
    Airbus emulation, never themed); the chrome around it follows the canvas "Checklists"
    page (ADR-0011): an active-checklist hero with a completion bar, the screen card with the
    RESET / C/L MENU / MSG LIST / C/L COMPLETE actions, and a checklist-sequence rail. The
    voice First Officer drives the same engine, so this page just re-renders on Engine.Changed.
*@
@{
    var normalItems = _view?.Items.Where(item => !IsFurniture(item)).ToList() ?? [];
    var doneCount = normalItems.Count(item => item.Status is ChecklistItemStatus.Done or ChecklistItemStatus.Skipped);
    var pct = normalItems.Count == 0 ? 0 : (int)Math.Round(100.0 * doneCount / normalItems.Count);
}
<div class="cl-page">

    <section class="section cl-hero">
        <div class="section-body cl-hero-body">
            <div class="cl-hero-main">
                <span class="label-caps">Active checklist</span>
                <span class="cl-hero-title">@(_view?.Name ?? "No checklist selected")</span>
                <div class="cl-selects">
                    <label class="cl-select-wrap">
                        <span class="label-caps">Set</span>
                        @* The per-phase folder set plus every Prosim2GSX-format file in config/checklists/sets. *@
                        <select class="select cl-select" aria-label="Checklist set" value="@_activeSet" @onchange="OnSetChanged">
                            @foreach (var set in _sets)
                            {
                                <option value="@set">@set</option>
                            }
                        </select>
                    </label>
                    <label class="cl-select-wrap">
                        <span class="label-caps">Checklist</span>
                        <select class="select cl-select" aria-label="Checklist section" @ref="_sectionSelect"
                                value="@(_view?.Name ?? string.Empty)" @onchange="OnSectionChanged">
                            @if (_catalog.Count == 0)
                            {
                                <option value="">(none available)</option>
                            }
                            else
                            {
                                @* selected must be explicit: browsers skip disabled options when defaulting,
                                   so the prerendered frame would otherwise display the first checklist name. *@
                                <option value="" disabled selected="@(_view is null)">(select checklist)</option>
                                @foreach (var entry in _catalog)
                                {
                                    <option value="@entry.Name">@entry.Name</option>
                                }
                            }
                        </select>
                    </label>
                </div>
            </div>
            <div class="cl-progress">
                <div class="cl-progress-head">
                    <span class="label-caps">Completion</span>
                    <span class="cl-progress-pct mono">@(_view is null ? "—" : $"{pct}%")</span>
                </div>
                <div class="cl-progress-track"><div class="cl-progress-fill" style="width:@pct%"></div></div>
                <span class="cl-progress-sub">@(_view is null ? "Pick a checklist" : $"{doneCount} of {normalItems.Count} lines")</span>
            </div>
        </div>
    </section>

    <div class="cl-grid">
        <section class="section cl-screen-card">
            <div class="section-header">
                <h3 class="section-title">C/L @(_view?.Name ?? "")</h3>
                <span class="pill @(_view is null ? "tone-neutral" : _view.IsComplete ? "tone-ok" : "tone-active")">
                    @(_view is null ? "standby" : _view.IsComplete ? "complete" : "in progress")
                </span>
            </div>

            <div class="ecamcl-body" role="list">
                @if (_view is null)
                {
                    <div class="ecamcl-empty">
                        @(_catalog.Count == 0
                            ? $"NO CHECKLIST FILES FOUND IN {Engine.Folder}"
                            : "NO C/L SELECTED — SELECT VIA C/L MENU")
                    </div>
                }
                else
                {
                    @foreach (var item in _view.Items)
                    {
                        @* Display-only rows from Prosim2GSX set files: the engine completes them
                           instantly, so they only ever render as furniture — never as a gate. *@
                        @if (string.Equals(item.Kind, "separator", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="ecamcl-item ecamcl-separator" role="separator">
                                <span></span>
                                <span class="ecamcl-sepline"></span>
                            </div>
                        }
                        else if (string.Equals(item.Kind, "note", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="ecamcl-item ecamcl-note" role="listitem">
                                <span></span>
                                <span>@item.Label</span>
                            </div>
                        }
                        else
                        {
                            @switch (item.Status)
                            {
                                case ChecklistItemStatus.Done:
                                    <div class="ecamcl-item ecamcl-checked" role="listitem">
                                        <span class="ecamcl-check">✓</span>
                                        <span>@item.Label</span>
                                        <span class="ecamcl-dots">@Dots</span>
                                        <span>@item.Response</span>
                                    </div>
                                    break;

                                case ChecklistItemStatus.Active:
                                    <div id="ecamcl-current" class="ecamcl-item ecamcl-current @(item.IsAuto && !AllowOverride ? "" : "ecamcl-clickable")"
                                         role="listitem"
                                         @onclick="() => OnCurrentRowClick(item)">
                                        <span class="ecamcl-check">□</span>
                                        <span>@item.Label</span>
                                        <span class="ecamcl-dots">@Dots</span>
                                        <span>@item.Response</span>
                                        <span class="ecamcl-aside">
                                            @if (item.IsAuto && !item.ConditionSatisfied && !AllowOverride)
                                            {
                                                <span class="ecamcl-hint">waiting for cockpit</span>
                                            }
                                            <button type="button" class="ecamcl-skip" title="Skip this line"
                                                    @onclick="SkipCurrent" @onclick:stopPropagation>skip</button>
                                        </span>
                                    </div>
                                    break;

                                case ChecklistItemStatus.Skipped:
                                    <div class="ecamcl-item ecamcl-skipped" role="listitem">
                                        <span class="ecamcl-check">–</span>
                                        <span>@item.Label</span>
                                        <span class="ecamcl-dots">@Dots</span>
                                        <span>@item.Response</span>
                                    </div>
                                    break;

                                default:
                                    <div class="ecamcl-item ecamcl-pending" role="listitem">
                                        <span></span>
                                        <span>@item.Label</span>
                                        <span class="ecamcl-dots">@Dots</span>
                                        <span>@item.Response</span>
                                    </div>
                                    break;
                            }
                        }
                    }
                }
            </div>

            <div class="cl-actions">
                <button type="button" class="btn secondary" @onclick="ResetClicked">Reset</button>
                <button type="button" class="btn secondary" @onclick="MenuClicked">C/L Menu</button>
                <button type="button" class="btn secondary" disabled>Msg List</button>
                <button type="button" class="btn @(_view?.IsComplete == true ? "cl-btn-complete" : "secondary")"
                        @onclick="CompleteClicked">
                    C/L Complete
                </button>
            </div>
        </section>

        <section class="section cl-sequence">
            <div class="section-header"><h3 class="section-title">Checklist sequence</h3></div>
            <div class="section-body">
                @if (_catalog.Count == 0)
                {
                    <div class="empty">No checklists in this set.</div>
                }
                else
                {
                    <ol class="cl-timeline">
                        @foreach (var entry in _catalog)
                        {
                            var active = entry.Name == _view?.Name;
                            <li id="@(active ? "cl-step-active" : null)" class="cl-step @(active ? "active" : null)">
                                <button type="button" class="cl-step-btn" @onclick="() => Engine.Select(entry.Name)">
                                    <span class="cl-step-dot" aria-hidden="true"></span>
                                    <span class="cl-step-text">
                                        <span class="cl-step-name">@entry.Name</span>
                                        <span class="cl-step-sub">@(active ? (_view!.IsComplete ? "Complete" : $"{doneCount} / {normalItems.Count}") : $"{entry.ItemCount} lines")</span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ol>
                }
            </div>
        </section>
    </div>

    @*
        Source-folder line (issue #55): the one place that answers "which files is the app
        actually reading, and did it see my last save?". Edits saved into this folder hot-reload
        within a second and bump the timestamp; a save that does NOT move the timestamp means the
        wrong copy was edited.
    *@
    <p class="ecamcl-source">
        Definitions load from <code>@Engine.Folder</code>
        @if (Engine.LastLoadedUtc is { } loaded)
        {
            <span> — last reloaded @loaded.ToLocalTime().ToString("HH:mm:ss") (edits saved there are picked up live)</span>
        }
    </p>
</div>

@code {
    // Fixed-length dotted leader; the 1fr grid column clips it, so every
    // row's dots stay aligned regardless of label/value width (same trick
    // as the WPF template's CharacterEllipsis-trimmed TextBlock).
    private const string Dots = "....................................................................................................";

    private IReadOnlyList<string> _sets = [];
    private string _activeSet = "";
    private IReadOnlyList<ChecklistCatalogEntry> _catalog = [];
    private ChecklistView? _view;
    private ElementReference _sectionSelect;

    // Auto-scroll (owner request 2026-09-20): the sequence rail follows the active checklist
    // and the ECAM screen follows the current line, but only when either actually moved —
    // every re-render otherwise would fight the user's own scrolling.
    private (string? Name, int Index) _scrolled = (null, -1);

    /// <summary>Separator and note rows are furniture — never counted toward completion.</summary>
    private static bool IsFurniture(ChecklistItemView item)
        => string.Equals(item.Kind, "separator", StringComparison.OrdinalIgnoreCase)
           || string.Equals(item.Kind, "note", StringComparison.OrdinalIgnoreCase);

    private bool AllowOverride => Options.CurrentValue.AllowManualOverride;

    protected override void OnInitialized()
        => WatchChanged(h => Engine.Changed += h, h => Engine.Changed -= h, Refresh);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var now = (Name: _view?.Name, Index: _view?.ActiveIndex ?? -1);
        if (now == _scrolled)
        {
            return;
        }

        var nameChanged = now.Name != _scrolled.Name;
        _scrolled = now;
        try
        {
            if (nameChanged)
            {
                await JS.InvokeVoidAsync("prosimCompanion.scrollIntoView", "cl-step-active");
            }

            await JS.InvokeVoidAsync("prosimCompanion.scrollIntoView", "ecamcl-current");
        }
        catch (JSException)
        {
            // Scrolling is cosmetic; a disconnected circuit must not surface as an error.
        }
    }

    private void Refresh()
    {
        _sets = Engine.Sets();
        _activeSet = Engine.ActiveSet;
        _catalog = Engine.Catalog();
        _view = Engine.ActiveView();
    }

    private void OnSetChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (!string.IsNullOrEmpty(name) && name != _activeSet)
        {
            Engine.SelectSet(name);
        }
    }

    private void OnSectionChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name) || name == _view?.Name)
        {
            return;
        }
        Engine.Select(name);
    }

    private void OnCurrentRowClick(ChecklistItemView item)
    {
        // checklists.allowManualOverride (Prosim2GSX parity): with the option
        // on, an auto item accepts a hand-tick — the engine completes it with
        // freeze semantics so the retreat pass cannot un-tick the crew's
        // decision. Off keeps the strict rule: dataref-verified lines wait for
        // the cockpit and the row shows "waiting for cockpit" instead.
        if (_view is null || (item.IsAuto && !AllowOverride))
        {
            return;
        }
        Engine.Check(_view.ActiveIndex);
    }

    private void SkipCurrent()
    {
        if (_view is not null)
        {
            Engine.Skip(_view.ActiveIndex);
        }
    }

    private void ResetClicked()
    {
        if (_view is not null)
        {
            Engine.Restart();
        }
    }

    private async Task MenuClicked() => await _sectionSelect.FocusAsync();

    private void CompleteClicked()
    {
        // Only acts when the open checklist is fully checked; then advances
        // to the next checklist in catalog order (if any).
        if (_view is not { IsComplete: true })
        {
            return;
        }
        var next = Engine.NextChecklistName();
        if (next is not null)
        {
            Engine.Select(next);
        }
    }
}
