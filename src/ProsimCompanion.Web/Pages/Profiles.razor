@page "/settings/profiles"
@page "/profiles"
@layout SettingsLayout
@using ProsimCompanion.Core.Profiles
@inherits SettingsPageBase
@inject AircraftProfileService ProfileService
@inject IOptionsMonitor<AircraftProfilesOptions> Options
@inject IStringLocalizer T

<PageTitle>@T["profiles.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["profiles.heading"]</h1>

<div class="panel">

    <Section Title="@T["profiles.current.title"]"
             Hint="@(ProfileService.AircraftTitle is null ? T["profiles.current.notConnected"].Value : null)">
        <div class="row"><span class="row-label">@T["profiles.current.titleLivery"]</span><span class="row-value-mono">@(ProfileService.AircraftTitle ?? "—")</span></div>
        <div class="row"><span class="row-label">@T["profiles.current.airline"]</span><span class="row-value-mono">@(ProfileService.AirlineIcao ?? "—")</span></div>
        <div class="row">
            <span class="row-label">@T["profiles.current.activeProfile"]</span>
            <span class="row-value-mono">@(ProfileService.ActiveProfile?.Name ?? T["profiles.current.defaults"].Value)</span>
            @if (ProfileService.ManualProfileId is not null)
            {
                <span class="pill tone-warn">@T["profiles.current.manual"]</span>
            }
        </div>
        @if (ProfileService.ManualProfileId is not null)
        {
            <div class="row">
                <button type="button" class="btn secondary" @onclick="() => ProfileService.SetManualActive(null)">
                    @T["profiles.current.returnToAutomatic"]
                </button>
            </div>
        }
    </Section>

    <Section Title="@T["profiles.list.title"]"
             Hint="@T["profiles.list.hint"]">
        <div class="info-banner" role="note">
            <span aria-hidden="true">ⓘ</span>
            <span>
                @T["profiles.list.bannerBefore"]
                <a href="settings/gsx">@T["profiles.list.bannerLink"]</a> @T["profiles.list.bannerAfter"]
            </span>
        </div>
        @for (var i = 0; i < DraftProfiles.Count; i++)
        {
            var index = i;
            var profile = DraftProfiles[index];
            var isActive = ProfileService.ActiveProfile?.Id == profile.Id;
            <div class="wx-card" style="margin-bottom:10px;">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <input type="text" class="cell-input" style="flex:1; min-width:180px;"
                           placeholder="@T["profiles.list.namePlaceholder"]" value="@profile.Name"
                           @onchange="e => profile.Name = e.Value?.ToString() ?? string.Empty" />
                    @if (isActive)
                    {
                        <span class="pill tone-ok">@T["profiles.list.active"]</span>
                    }
                    @if (profile.MatchType == ProfileMatchType.Default)
                    {
                        <span class="pill tone-neutral">@T["profiles.list.default"]</span>
                    }
                    @if (!isActive)
                    {
                        <button type="button" class="btn secondary"
                                @onclick="() => ProfileService.SetManualActive(profile.Id)">@T["profiles.list.setActive"]</button>
                    }
                    <button type="button" class="btn secondary" @onclick="() => Clone(index)">@T["profiles.list.clone"]</button>
                    <button type="button" class="btn danger" @onclick="() => DraftProfiles.RemoveAt(index)">@T["profiles.list.delete"]</button>
                </div>
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:8px;">
                    <span class="field-hint">@T["profiles.list.match"]</span>
                    <select class="select" style="max-width:220px"
                            value="@profile.MatchType"
                            @onchange="e => profile.MatchType = Enum.Parse<ProfileMatchType>(e.Value?.ToString() ?? nameof(ProfileMatchType.TitleContains))">
                        <option value="@ProfileMatchType.TitleContains">@T["profiles.list.matchContains"]</option>
                        <option value="@ProfileMatchType.TitleEquals">@T["profiles.list.matchExact"]</option>
                        <option value="@ProfileMatchType.Airline">@T["profiles.list.matchAirline"]</option>
                        <option value="@ProfileMatchType.Default">@T["profiles.list.matchDefault"]</option>
                    </select>
                    <input type="text" class="cell-input" style="flex:1; min-width:220px;"
                           placeholder="@T["profiles.list.fragmentPlaceholder"]" value="@profile.MatchString"
                           @onchange="e => profile.MatchString = e.Value?.ToString() ?? string.Empty" />
                    @if (ProfileService.AircraftTitle is { } title && Matches(profile, title))
                    {
                        <span class="pill tone-active">@T["profiles.list.matchesCurrent"]</span>
                    }
                </div>
            </div>
        }
        @if (DraftProfiles.Count == 0)
        {
            <div class="empty">@T["profiles.list.empty"]</div>
        }
        <button type="button" class="btn secondary" @onclick="Add">@T["profiles.list.add"]</button>
    </Section>

</div>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private OptionsDraft<AircraftProfilesOptions> _profiles = default!;
    private IDisposable? _optionsSubscription;

    /// <summary>The editable clone's profile list — the page owns the whole list, so the
    /// draft's <c>profiles</c> key writes as one unit when anything in it changed.</summary>
    private List<AircraftProfile> DraftProfiles => _profiles.Value.Profiles;

    protected override void OnInitialized()
    {
        _profiles = Draft(Options);
        // Markup reads ProfileService directly, so the watch only needs the base's re-render.
        WatchChanged(h => ProfileService.Changed += h, h => ProfileService.Changed -= h, () => { });
        // Not a store event — an IOptionsMonitor change token, so it stays hand-wired.
        _optionsSubscription = Options.OnChange(options => { _ = InvokeAsync(StateHasChanged); });
    }

    public override void Dispose()
    {
        _optionsSubscription?.Dispose();
        base.Dispose();
    }

    private static bool Matches(AircraftProfile profile, string title)
        => profile.MatchString.Length > 0 && profile.MatchType switch
        {
            ProfileMatchType.TitleEquals => title.Equals(profile.MatchString, StringComparison.OrdinalIgnoreCase),
            _ => title.Contains(profile.MatchString, StringComparison.OrdinalIgnoreCase),
        };

    private void Add() => DraftProfiles.Add(new AircraftProfile { Name = T["profiles.list.newName", DraftProfiles.Count + 1].Value });

    private void Clone(int index)
    {
        var source = DraftProfiles[index];
        DraftProfiles.Insert(index + 1, new AircraftProfile
        {
            Name = T["profiles.list.cloneName", source.Name].Value,
            MatchType = source.MatchType,
            MatchString = source.MatchString,
        });
    }

    protected override void OnBeforeSave()
    {
        // The pre-#84 save filtered unnamed profiles out of the write and trimmed the rest.
        DraftProfiles.RemoveAll(profile => string.IsNullOrWhiteSpace(profile.Name));
        foreach (var profile in DraftProfiles)
        {
            profile.Name = profile.Name.Trim();
            profile.MatchString = profile.MatchString.Trim();
        }
    }
}
