@page "/ofp"
@using ProsimCompanion.Core.Aircraft.Ofp
@using ProsimCompanion.Core.Airports.Parking
@using ProsimCompanion.Core.Deice
@using ProsimCompanion.Core.Gate
@using ProsimCompanion.Core.Weather
@inherits StoreObserverComponent
@inject OfpStore Ofp
@inject IOptionsMonitor<GsxOptions> GsxOptionsMonitor
@inject ArrivalGateCoordinator GateCoordinator
@inject GsxDiagnosticsStore GsxStore
@inject PushbackChoiceStore PushbackChoices
@inject WeatherStore Weather
@inject IWeatherControl WeatherControl
@inject DeiceHoldoverService Deice
@inject DisplayUnitService Units
@inject IStringLocalizer T

<PageTitle>@T["ofp.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["ofp.heading"]</h1>

@* Layout (ADR-0011, canvas "OFP" page): flight-plan hero + arrival gate on the first row,
   weather + (pushback, deice) on the second. *@
<div class="ofp-page">

    <section class="section ofp-hero">
        <div class="section-header"><h3 class="section-title">@T["ofp.plan.title"]</h3></div>
        @if (_ofp is null)
        {
            <div class="section-body">
                <div class="empty">@T["ofp.plan.empty"]</div>
            </div>
        }
        else
        {
            <div class="section-body ofp-hero-body">
                <div class="ofp-hero-top">
                    <div class="ofp-idents">
                        <div class="ofp-ident">
                            <span class="label-caps">@T["ofp.plan.callsign"]</span>
                            <span class="figure figure-lg">@(_ofp.Callsign.Length > 0 ? _ofp.Callsign : _ofp.Ident)</span>
                        </div>
                        <span class="ofp-ident-sep" aria-hidden="true"></span>
                        <div class="ofp-ident">
                            <span class="label-caps">@T["ofp.plan.flightNumber"]</span>
                            <span class="figure figure-lg gold">@(_ofp.FlightNumber.Length > 0 ? _ofp.FlightNumber : "—")</span>
                        </div>
                    </div>

                    <div class="ofp-route">
                        <div class="ofp-route-end">
                            <span class="label-caps">@T["ofp.plan.origin"]</span>
                            <span class="figure figure-lg">@_ofp.OriginIcao</span>
                        </div>
                        <div class="ofp-route-line" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
                            </svg>
                        </div>
                        <div class="ofp-route-end">
                            <span class="label-caps">@T["ofp.plan.destination"]</span>
                            <span class="figure figure-lg">@_ofp.DestinationIcao</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_ofp.AlternateIcao))
                        {
                            <span class="ofp-altn label-caps">ALTN: @_ofp.AlternateIcao</span>
                        }
                    </div>
                </div>

                <div class="ofp-data inset">
                    @Datum("ACFT", $"{_ofp.AircraftIcaoType}{(_ofp.AircraftReg.Length > 0 ? $" · {_ofp.AircraftReg}" : "")}")
                    @Datum("STD", _ofp.ScheduledOutUtc?.ToString("HH:mm'Z'") ?? "—")
                    @Datum("ETA", _ofp.ScheduledOutUtc is { } std && _ofp.EstimatedEnroute is { } enroute ? (std + enroute).ToString("HH:mm'Z'") : "—", "glow")
                    @Datum("CRZ FL", CruiseFl)
                    @Datum("RWY OUT/IN", RunwayOutIn)
                    @Datum("PAX", _ofp.PaxCount.ToString())
                    @Datum("CARGO", Units.Format(_ofp.CargoKg))
                    @Datum("ZFW", Units.Format(_ofp.EstZfwKg))
                    @Datum("BLOCK FUEL", Units.Format(_ofp.FuelPlanRampKg), "gold")
                    @Datum(T["ofp.plan.fetched"], _ofp.FetchedAtUtc.ToString("HH:mm:ss'Z'"))
                </div>
                <div class="ofp-hint">@T["ofp.plan.hint"]</div>
            </div>
        }
    </section>

    <section class="section ofp-gate">
        <div class="section-header"><h3 class="section-title">@T["ofp.gate.title"]</h3></div>
        <div class="section-body ofp-gate-body">
            @* After an in-flight app restart the OFP is normally not loaded again, but the
               persisted gate is (issue #102) — the card stays usable whenever a gate is pending
               so the pilot can see, re-send or cancel it. *@
            @if (_ofp is null && _gateAssignment.PendingGate is null)
            {
                <div class="empty">@T["ofp.gate.empty"]</div>
            }
            else
            {
                <div class="ofp-gate-row">
                    <span class="figure figure-lg">@(_ofp?.DestinationIcao ?? "----")</span>
                    <input class="text-input ofp-gate-input" placeholder="@T["ofp.gate.placeholder"]" @bind="_gate" @bind:after="OnGateTyped"
                           aria-label="@T["ofp.gate.aria"]" />
                </div>
                @if (_gateAssignment.Restored)
                {
                    <div class="field-hint ofp-gate-restored">@T["ofp.gate.restored"]</div>
                }
                @if (_typedStandInfo.Length > 0)
                {
                    <div class="field-hint ofp-gate-stand">@_typedStandInfo</div>
                }
                <div class="ofp-gate-buttons">
                    <button type="button" class="btn secondary" disabled="@(_gate.Trim().Length == 0)" @onclick="ConfirmGate">@T["ofp.gate.confirm"]</button>
                    <button type="button" class="btn secondary" @onclick="CancelGate">@T["ofp.gate.cancel"]</button>
                </div>
                <button type="button" class="btn primary" disabled="@(!CanSendNow)" @onclick="SendNowGate"
                        title="@T["ofp.gate.sendNow.title"]">@T["ofp.gate.sendNow"]</button>
                @if (_gateAssignment.PendingGate is { } pending)
                {
                    <div class="ofp-gate-status">
                        <span class="fs-chip-dot live" aria-hidden="true"></span>
                        <span>@(_gateAssignment.Sent ? T["ofp.gate.sent", pending].Value : T["ofp.gate.queued", pending].Value)</span>
                    </div>
                }
                @if (_gateAssignment.StandInfo.Length > 0)
                {
                    <div class="field-hint">@T["ofp.gate.stand", _gateAssignment.StandInfo]</div>
                }
                @if (_gateAssignment.AtcStatus.Length > 0)
                {
                    <div class="field-hint">@T["ofp.gate.atc", _gateAssignment.AtcStatus]</div>
                }
                @if (_gateAssignment.GsxStatus.Length > 0)
                {
                    <div class="field-hint">@T["ofp.gate.gsxSend", _gateAssignment.GsxStatus]</div>
                }
                @if (_gsx.GateRequest is { } request)
                {
                    <div class="field-hint">@T["ofp.gate.gsx", request]</div>
                }
                @* When GSX splits the gate into suffix variants (issue #156) the question shows
                   on the Captain's questions card in the side column — the pilot picks there, on
                   the Status card, or by telling the FO; the first goes at taxi-in otherwise. *@
                <div class="field-hint">@T["ofp.gate.hint"]</div>
            }
        </div>
    </section>

    <section class="section ofp-weather">
        <div class="section-header">
            <h3 class="section-title">METAR / TAF / ATIS</h3>
            <span class="section-hint">@T["ofp.weather.hint"]</span>
        </div>
        <div class="section-body ofp-weather-body">
            <div class="ofp-weather-tools">
                <button type="button" class="btn" disabled="@_weather.IsRefreshing" @onclick="RefreshWeather">
                    @(_weather.IsRefreshing ? T["ofp.weather.refreshing"].Value : T["ofp.weather.refresh"].Value)
                </button>
                <span class="pill @(_weather.CpdlcStation.Length > 0 ? "tone-ok" : "tone-neutral")">
                    CPDLC @(_weather.CpdlcStation.Length > 0 ? _weather.CpdlcStation : "—")
                </span>
                @if (!string.IsNullOrEmpty(_weather.Status))
                {
                    <span class="field-hint">@_weather.Status</span>
                }
            </div>
            <div class="ofp-wx-grid">
                @foreach (var (title, wx) in new[] { (T["ofp.weather.departure"].Value, _weather.Departure), (T["ofp.weather.arrival"].Value, _weather.Arrival) })
                {
                    <div class="ofp-wx">
                        <div class="ofp-wx-head">
                            <span class="ofp-wx-title">@(wx?.Airport ?? "") @title</span>
                            @if (wx is not null && (wx.ActiveRunway.Length > 0 || wx is { WindDirection: not null, WindSpeed: not null }))
                            {
                                <span class="ofp-wx-wind mono">RWY @(wx.ActiveRunway.Length > 0 ? wx.ActiveRunway : "—") · @(wx.WindDirection?.ToString("000") ?? "—")°/@(wx.WindSpeed?.ToString() ?? "—") KT</span>
                            }
                        </div>
                        @if (wx is null)
                        {
                            <div class="empty">@T["ofp.weather.noData"]</div>
                        }
                        else
                        {
                            @if (wx.Metar.Length > 0)
                            {
                                <span class="ofp-wx-label">METAR</span>
                                <div class="ofp-wx-box inset mono">@wx.Metar</div>
                            }
                            @* TAF moved here from the removed Weather tab (owner decision) so no
                               information was lost merging the two surfaces. *@
                            @if (wx.Taf.Length > 0)
                            {
                                <span class="ofp-wx-label">TAF</span>
                                <div class="ofp-wx-box inset mono">@wx.Taf</div>
                            }
                            @if (wx.Atis.Length > 0)
                            {
                                <span class="ofp-wx-label">ATIS</span>
                                <div class="ofp-wx-box inset">@wx.Atis</div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="ofp-side">
        @* Every open captain's question (de-icing, turnaround start, gate suffix, pushback
           direction) with its buttons — the same Core stores the FO's questions answer (C2).
           Shown only while a question stands. *@
        <OpenQuestionsCard Framed="true" Surface="OFP page" />

        <section class="section ofp-pushback">
            <div class="section-header"><h3 class="section-title">@T["ofp.pushback.title"]</h3></div>
            <div class="section-body">
                <div class="korry-group" role="group" aria-label="@T["ofp.pushback.aria"]">
                    <KorryPushbackButton Arrow="tailLeft" Label="@T["ofp.pushback.tailLeft"]" Subtitle="@T["ofp.pushback.tailLeft.sub"]"
                                         IsActive="@(ActiveWish == PushbackWish.TailLeft)"
                                         Title="@T["ofp.pushback.tailLeft.title"]"
                                         OnClick="@(() => Choose(PushbackWish.TailLeft))" />
                    <KorryPushbackButton Arrow="straight" Label="@T["ofp.pushback.straight"]" Subtitle="@T["ofp.pushback.straight.sub"]"
                                         IsActive="@(ActiveWish == PushbackWish.Straight)"
                                         Title="@T["ofp.pushback.straight.title"]"
                                         OnClick="@(() => Choose(PushbackWish.Straight))" />
                    <KorryPushbackButton Arrow="tailRight" Label="@T["ofp.pushback.tailRight"]" Subtitle="@T["ofp.pushback.tailRight.sub"]"
                                         IsActive="@(ActiveWish == PushbackWish.TailRight)"
                                         Title="@T["ofp.pushback.tailRight.title"]"
                                         OnClick="@(() => Choose(PushbackWish.TailRight))" />
                </div>
                @if (_pushback.Choice is { } chosen)
                {
                    <div class="ofp-gate-status">
                        <span class="fs-chip-dot live" aria-hidden="true"></span>
                        <span>@T["ofp.pushback.thisFlight", chosen.Spoken, chosen.Source]</span>
                        <button type="button" class="btn secondary btn-sm" @onclick="ClearChoice" title="@T["ofp.pushback.auto.title"]">@T["ofp.pushback.auto"]</button>
                    </div>
                }
                @if (_pushback.Suggestion is { } suggestion)
                {
                    <div class="field-hint">
                        @T["ofp.pushback.suggested"] <strong>@SuggestionWord(suggestion)</strong>@(suggestion.Confidence == PushbackConfidence.Low ? T["ofp.pushback.lean"].Value : "")
                        @(_pushback.Stand is { } st ? T["ofp.pushback.atStand", st].Value : "")@(_pushback.Runway is { } rw ? T["ofp.pushback.forRunway", rw].Value : "") — @suggestion.Reason
                    </div>
                }
                else if (_pushback.Stand is { } stand)
                {
                    <div class="field-hint">@T["ofp.pushback.noSuggestion", stand, _pushback.Runway is { } rw2 ? T["ofp.pushback.standRunway", rw2].Value : T["ofp.pushback.standNoRunway"].Value]</div>
                }
                @* While GSX asks which way, the Captain's questions card above shows the FO's
                   prompt with one button per menu line (C2). *@
                <div class="ofp-hint ofp-hint-center">@T["ofp.pushback.footer", ModeWord]</div>
                @* Issue #135: addon airports name up to three directions per stand and the
                   Korry preference cannot reach the third — the live menu card can. *@
                <GsxMenuCard Hint="@T["ofp.pushback.menuHint"]" />
            </div>
        </section>

        <section class="section ofp-deice">
            <div class="section-header"><h3 class="section-title">@T["ofp.deice.title"]</h3></div>
            <div class="section-body ofp-deice-body">
                <div class="ofp-deice-oat">
                    <span class="label-caps">OAT °C</span>
                    <input class="number-input ofp-deice-input" type="number" step="0.5" value="@_deiceOat"
                           @onchange="OnOatChanged" aria-label="@T["ofp.deice.oat.aria"]" />
                </div>
                <select class="select ofp-deice-select" value="@_deice.Precip" @onchange="OnPrecipChanged" aria-label="@T["ofp.deice.precip.aria"]">
                    <option value="@HotPrecip.None">@T["ofp.deice.precip.none"]</option>
                    <option value="@HotPrecip.ActiveFrost">@T["ofp.deice.precip.activeFrost"]</option>
                    <option value="@HotPrecip.FreezingFog">@T["ofp.deice.precip.freezingFog"]</option>
                    <option value="@HotPrecip.Snow">@T["ofp.deice.precip.snow"]</option>
                    <option value="@HotPrecip.FreezingDrizzleLight">@T["ofp.deice.precip.freezingDrizzleLight"]</option>
                    <option value="@HotPrecip.FreezingDrizzleModerate">@T["ofp.deice.precip.freezingDrizzleModerate"]</option>
                    <option value="@HotPrecip.LightFreezingRain">@T["ofp.deice.precip.lightFreezingRain"]</option>
                    <option value="@HotPrecip.RainOnColdSoakedWing">@T["ofp.deice.precip.rainOnColdSoakedWing"]</option>
                </select>
                <div class="ofp-deice-range inset">
                    <span class="label-caps">@T["ofp.deice.holdover"]</span>
                    <span class="figure figure-lg @(_deice.Expired ? "ofp-deice-expired" : "glow")">
                        @if (_deice.Active && _deice.RemainingHighSeconds > 0)
                        {
                            @($"{_deice.RemainingLowSeconds / 60}:{_deice.RemainingLowSeconds % 60:D2} – {_deice.RemainingHighSeconds / 60}:{_deice.RemainingHighSeconds % 60:D2}")
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </span>
                    <span class="ofp-deice-fluid" title="@(string.IsNullOrEmpty(_deice.FluidSource) ? null : T["ofp.deice.fluidFrom", _deice.FluidSource].Value)">@T["ofp.deice.fluid"] <span class="mono">@(_deice.Active || _deice.Expired ? _deice.FluidLabel : "—")</span>@if ((_deice.Active || _deice.Expired) && !string.IsNullOrEmpty(_deice.FluidSource)) { <span class="mono"> (@_deice.FluidSource)</span> }</span>
                    <span class="ofp-deice-status @(_deice.Expired ? "ofp-deice-expired" : null)">@_deice.Status</span>
                    <span class="ofp-deice-note">@T["ofp.deice.note"]</span>
                </div>
            </div>
        </section>
    </div>

</div>

@code {
    private OfpData? _ofp;
    private GsxDiagnosticsSnapshot _gsx = GsxDiagnosticsSnapshot.Empty;
    private ArrivalGateView _gateAssignment = ArrivalGateView.Empty;
    private WeatherSnapshot _weather = WeatherSnapshot.Empty;
    private DeiceHoldoverSnapshot _deice = new(false, false, "", HotPrecip.None, 0, 0, 0, "Awaiting GSX deicing…");
    private double _deiceOat;
    private string _gate = "";
    private string _typedStandInfo = "";
    private CancellationTokenSource? _standLookup;

    // One label/figure cell of the hero data grid (ADR-0011).
    private static RenderFragment Datum(string label, string value, string? tone = null) => @<div class="ofp-datum">
        <span class="label-caps">@label</span>
        <span class="figure @tone">@value</span>
    </div>;

    private PushbackChoiceSnapshot _pushback = PushbackChoiceSnapshot.Empty;

    // The lit button: the pilot's choice for this flight, else the confident suggestion.
    private PushbackWish ActiveWish => _pushback.Effective?.Wish ?? PushbackWish.None;

    private string ModeWord => GsxOptionsMonitor.CurrentValue.PushbackPreference switch
    {
        "ask" => T["ofp.pushback.mode.ask"].Value,
        "tailLeft" => T["ofp.pushback.mode.tailLeft"].Value,
        "tailRight" => T["ofp.pushback.mode.tailRight"].Value,
        "straight" => T["ofp.pushback.mode.straight"].Value,
        _ => T["ofp.pushback.mode.auto"].Value,
    };

    private string SuggestionWord(PushbackSuggestion suggestion) => suggestion.Option.Kind switch
    {
        PushbackOptionKind.Left => T["ofp.pushback.tailLeft"].Value,
        PushbackOptionKind.Right => T["ofp.pushback.tailRight"].Value,
        PushbackOptionKind.Straight => T["ofp.pushback.straight"].Value,
        _ => suggestion.Option.Label,
    };

    private void Choose(PushbackWish wish)
    {
        var choice = wish switch
        {
            PushbackWish.TailLeft => PushbackChoice.TailLeft("web", "OFP page Korry button"),
            PushbackWish.TailRight => PushbackChoice.TailRight("web", "OFP page Korry button"),
            _ => PushbackChoice.Straight("web", "OFP page Korry button"),
        };
        PushbackChoices.Choose(choice);
    }

    private void ClearChoice() => PushbackChoices.ClearChoice();

    // Predecessor formats: "{out} / {in}" with per-side "—", and FL350 / "FL---" sentinels.
    private string RunwayOutIn => _ofp is null
        ? "—"
        : $"{(_ofp.PlannedRunwayOut.Length > 0 ? _ofp.PlannedRunwayOut : "—")} / {(_ofp.PlannedRunwayIn.Length > 0 ? _ofp.PlannedRunwayIn : "—")}";

    private string CruiseFl => _ofp is { CruiseFlightLevel: > 0 }
        ? $"FL{_ofp.CruiseFlightLevel:D3}"
        : "FL---";

    private bool CanSendNow => _gate.Trim().Length > 0 || _gateAssignment.PendingGate is not null;

    protected override void OnInitialized()
    {
        Watch(GsxStore, snapshot => _gsx = snapshot);
        Watch(PushbackChoices, snapshot => _pushback = snapshot);
        Watch(Weather, snapshot => _weather = snapshot);
        WatchChanged(h => Ofp.Changed += h, h => Ofp.Changed -= h, () => _ofp = Ofp.Current);
        WatchChanged(h => GateCoordinator.Changed += h, h => GateCoordinator.Changed -= h,
            () => _gateAssignment = GateCoordinator.Snapshot());
        WatchChanged(h => Deice.Changed += h, h => Deice.Changed -= h, () => _deice = Deice.Snapshot());
        WatchChanged(h => Units.Changed += h, h => Units.Changed -= h, () => { });
        // Seed the OAT input once from the current snapshot — later Deice changes must not
        // clobber what the user is typing.
        _deiceOat = _deice.OatC;
    }

    private void ConfirmGate()
    {
        if (_gate.Trim().Length > 0)
        {
            GateCoordinator.Confirm(_gate);
        }
    }

    // Live hint under the input (2026-10-04): what the GSX profile / scenery call the typed
    // stand — "GSX knows it as Gate 40 (Apron 1W …)" — so a template-renamed gate is visible
    // before Confirm. Debounced; a newer keystroke cancels the older lookup.
    private async Task OnGateTyped()
    {
        _standLookup?.Cancel();
        var cts = _standLookup = new CancellationTokenSource();
        var typed = _gate;
        try
        {
            await Task.Delay(350, cts.Token);
            var info = await GateCoordinator.DescribeAsync(typed, cts.Token);
            if (!cts.IsCancellationRequested)
            {
                _typedStandInfo = info;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // superseded by a newer keystroke
        }
    }

    // Explicit input wins; with the box empty the queued gate is (re)sent.
    private void SendNowGate() => _ = GateCoordinator.SendNow(_gate.Trim().Length > 0 ? _gate : null);

    private void CancelGate() => GateCoordinator.Cancel();

    private async Task RefreshWeather() => await WeatherControl.RefreshAsync();

    private void OnPrecipChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<HotPrecip>(e.Value?.ToString(), out var precip))
        {
            Deice.SetPrecip(precip);
        }
    }

    private void OnOatChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var oat))
        {
            _deiceOat = oat;
            Deice.SetOat(oat);
        }
    }
}
