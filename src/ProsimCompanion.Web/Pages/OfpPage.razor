@page "/ofp"
@using ProsimCompanion.Core.Aircraft.Ofp
@using ProsimCompanion.Core.Deice
@using ProsimCompanion.Core.Gate
@using ProsimCompanion.Core.Weather
@inherits StoreObserverComponent
@inject OfpStore Ofp
@inject IOptionsMonitor<GsxOptions> GsxOptionsMonitor
@inject SettingsWriter Writer
@inject ArrivalGateCoordinator GateCoordinator
@inject GsxDiagnosticsStore GsxStore
@inject WeatherStore Weather
@inject IWeatherControl WeatherControl
@inject DeiceHoldoverService Deice
@inject DisplayUnitService Units

<PageTitle>OFP — ProsimCompanion</PageTitle>
<h1 class="sr-only">Operational Flight Plan</h1>

<div class="panel">

    <Section Title="Flight Plan">
        @if (_ofp is null)
        {
            <div class="empty">No flight plan loaded — enter origin/destination on the MCDU, or fetch an OFP from the INIT page.</div>
        }
        else
        {
            <div class="ofpfp-grid">
                @* Left column — routing / airframe. *@
                <div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">FLT NBR</span><span class="ofpfp-value">@(_ofp.FlightNumber.Length > 0 ? _ofp.FlightNumber : _ofp.Ident)</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">CALLSIGN</span><span class="ofpfp-value">@_ofp.Callsign</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">FROM/TO</span><span class="ofpfp-value">@_ofp.OriginIcao → @_ofp.DestinationIcao@(string.IsNullOrEmpty(_ofp.AlternateIcao) ? "" : $"  ALTN {_ofp.AlternateIcao}")</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">RWY OUT/IN</span><span class="ofpfp-value">@RunwayOutIn</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">ACFT</span><span class="ofpfp-value">@_ofp.AircraftIcaoType  REG @_ofp.AircraftReg</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">CRZ FL</span><span class="ofpfp-value">@CruiseFl</span></div>
                </div>

                @* Right column — times / weights. *@
                <div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">STD</span><span class="ofpfp-value">@(_ofp.ScheduledOutUtc?.ToString("HH:mm'Z'") ?? "—")</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">ETA</span><span class="ofpfp-value">@(_ofp.ScheduledOutUtc is { } std && _ofp.EstimatedEnroute is { } enroute ? (std + enroute).ToString("HH:mm'Z'") : "—")</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">ZFW</span><span class="ofpfp-value">@Units.Format(_ofp.EstZfwKg)</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">BLOCK FUEL</span><span class="ofpfp-value">@Units.Format(_ofp.FuelPlanRampKg)</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">PAX</span><span class="ofpfp-value">@_ofp.PaxCount</span></div>
                    <div class="ofpfp-kv"><span class="ofpfp-label">CARGO</span><span class="ofpfp-value">@Units.Format(_ofp.CargoKg)</span></div>
                </div>
            </div>

            <div class="ofpfp-footer">
                <span class="ofpfp-fetched">Fetched @_ofp.FetchedAtUtc.ToString("HH:mm:ss'Z'")</span>
                <span class="ofpfp-hint">Fetch &amp; overrides on the INIT page</span>
            </div>
        }
    </Section>

    <Section Title="Pushback Direction" Hint="Auto-answers GSX's direction menu; persisted in gsx.pushbackPreference">
        <div class="korry-group" role="group" aria-label="Pushback direction">
            <KorryPushbackButton Arrow="tailLeft" Label="TAIL LEFT" Subtitle="NOSE RIGHT"
                                 IsActive="@(CurrentPreference == "tailLeft")"
                                 Title="Auto-select 'Nose Right / Tail Left' when GSX shows the direction menu."
                                 OnClick="@(() => SetPreference("tailLeft"))" />
            <KorryPushbackButton Arrow="straight" Label="STRAIGHT" Subtitle="STRAIGHT BACK"
                                 IsActive="@(CurrentPreference == "straight")"
                                 Title="Auto-select 'Straight pushback' when GSX shows the direction menu."
                                 OnClick="@(() => SetPreference("straight"))" />
            <KorryPushbackButton Arrow="tailRight" Label="TAIL RIGHT" Subtitle="NOSE LEFT"
                                 IsActive="@(CurrentPreference == "tailRight")"
                                 Title="Auto-select 'Nose Left / Tail Right' when GSX shows the direction menu."
                                 OnClick="@(() => SetPreference("tailRight"))" />
        </div>
    </Section>

    <Section Title="Arrival Gate Assignment" Hint="Confirm queues for auto-send at cruise; Send Now pushes to GSX + SayIntentions ATC immediately">
        @if (_ofp is null)
        {
            <div class="empty">Load an OFP to enable gate assignment.</div>
        }
        else
        {
            <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
                <span class="mono">@_ofp.DestinationIcao</span>
                <input class="text-input" style="max-width:120px; text-transform:uppercase"
                       placeholder="GATE" @bind="_gate" />
                <button type="button" class="btn primary" disabled="@(_gate.Trim().Length == 0)" @onclick="ConfirmGate">Confirm</button>
                <button type="button" class="btn secondary" disabled="@(!CanSendNow)" @onclick="SendNowGate">Send Now</button>
                <button type="button" class="btn secondary" @onclick="CancelGate">Cancel</button>
            </div>
            @if (_gateAssignment.PendingGate is { } pending)
            {
                <div class="field-hint" style="margin-top:8px;">
                    @(_gateAssignment.Sent ? $"Sent {pending}" : $"Queued {pending} — sends at cruise (or Send Now)")
                </div>
            }
            @if (_gateAssignment.AtcStatus.Length > 0)
            {
                <div class="field-hint" style="margin-top:4px;">ATC: @_gateAssignment.AtcStatus</div>
            }
            @if (_gateAssignment.GsxStatus.Length > 0)
            {
                <div class="field-hint" style="margin-top:4px;">GSX send: @_gateAssignment.GsxStatus</div>
            }
            @if (_gsx.GateRequest is { } request)
            {
                <div class="field-hint" style="margin-top:4px;">GSX: @request</div>
            }
        }
    </Section>

    <Section Title="Weather" Hint="SayIntentions ATIS / METAR / TAF — cached 10 min">
        <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
            <button type="button" class="btn" disabled="@_weather.IsRefreshing" @onclick="RefreshWeather">
                @(_weather.IsRefreshing ? "Refreshing…" : "Refresh Weather")
            </button>
            <span class="pill @(_weather.CpdlcStation.Length > 0 ? "tone-ok" : "tone-neutral")">
                CPDLC @(_weather.CpdlcStation.Length > 0 ? _weather.CpdlcStation : "—")
            </span>
            @if (!string.IsNullOrEmpty(_weather.Status))
            {
                <span class="field-hint">@_weather.Status</span>
            }
        </div>
        <div class="wx-cards">
            @foreach (var (title, wx) in new[] { ("Departure", _weather.Departure), ("Arrival", _weather.Arrival) })
            {
                <div class="wx-card">
                    <div class="wx-title">@title @(wx?.Airport ?? "")</div>
                    @if (wx is null)
                    {
                        <div class="empty">No data.</div>
                    }
                    else
                    {
                        @if (wx.ActiveRunway.Length > 0 || wx is { WindDirection: not null, WindSpeed: not null })
                        {
                            <div class="mono">RWY @wx.ActiveRunway  Wind @(wx.WindDirection?.ToString("000") ?? "—")° / @(wx.WindSpeed?.ToString() ?? "—") kt</div>
                        }
                        @if (wx.Metar.Length > 0)
                        {
                            <div class="field-hint" style="margin-top:8px;">METAR</div>
                            <div class="mono" style="white-space:pre-wrap; overflow-wrap:anywhere;">@wx.Metar</div>
                        }
                        @* TAF moved here from the removed Weather tab (owner decision) so no
                           information was lost merging the two surfaces. *@
                        @if (wx.Taf.Length > 0)
                        {
                            <div class="field-hint" style="margin-top:8px;">TAF</div>
                            <div class="mono" style="white-space:pre-wrap; overflow-wrap:anywhere;">@wx.Taf</div>
                        }
                        @if (wx.Atis.Length > 0)
                        {
                            <div class="field-hint" style="margin-top:8px;">ATIS</div>
                            <div style="white-space:pre-wrap; overflow-wrap:anywhere;">@wx.Atis</div>
                        }
                    }
                </div>
            }
        </div>
    </Section>

    <Section Title="Deice Holdover (HOT)" Hint="Representative figures for immersion only — not for real-world dispatch">
        <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
            <select class="select" style="max-width:220px" value="@_deice.Precip" @onchange="OnPrecipChanged">
                <option value="@HotPrecip.None">No precipitation</option>
                <option value="@HotPrecip.ActiveFrost">Active frost</option>
                <option value="@HotPrecip.FreezingFog">Freezing fog</option>
                <option value="@HotPrecip.Snow">Snow / snow grains</option>
                <option value="@HotPrecip.FreezingDrizzleLight">Freezing drizzle (light)</option>
                <option value="@HotPrecip.FreezingDrizzleModerate">Freezing drizzle (moderate)</option>
                <option value="@HotPrecip.LightFreezingRain">Light freezing rain</option>
                <option value="@HotPrecip.RainOnColdSoakedWing">Rain on cold-soaked wing</option>
            </select>
            <span class="field-hint">OAT °C</span>
            <input class="number-input" type="number" step="0.5" value="@_deiceOat" @onchange="OnOatChanged" />
        </div>
        <div class="field-hint" style="margin-top:8px;">
            Fluid: <span class="mono">@(_deice.Active || _deice.Expired ? _deice.FluidLabel : "—")</span>
            @if (_deice.Active && _deice.RemainingHighSeconds > 0)
            {
                <span> · Holdover remaining <span class="mono">@($"{_deice.RemainingLowSeconds / 60}:{_deice.RemainingLowSeconds % 60:D2} – {_deice.RemainingHighSeconds / 60}:{_deice.RemainingHighSeconds % 60:D2}")</span></span>
            }
            <span style="@(_deice.Expired ? "color:var(--danger);font-weight:600" : "")"> · @_deice.Status</span>
        </div>
    </Section>

</div>

@code {
    private OfpData? _ofp;
    private GsxDiagnosticsSnapshot _gsx = GsxDiagnosticsSnapshot.Empty;
    private ArrivalGateView _gateAssignment = ArrivalGateView.Empty;
    private WeatherSnapshot _weather = WeatherSnapshot.Empty;
    private DeiceHoldoverSnapshot _deice = new(false, false, "", HotPrecip.None, 0, 0, 0, "Awaiting GSX deicing…");
    private double _deiceOat;
    private string _gate = "";

    private string CurrentPreference => GsxOptionsMonitor.CurrentValue.PushbackPreference;

    // Predecessor formats: "{out} / {in}" with per-side "—", and FL350 / "FL---" sentinels.
    private string RunwayOutIn => _ofp is null
        ? "—"
        : $"{(_ofp.PlannedRunwayOut.Length > 0 ? _ofp.PlannedRunwayOut : "—")} / {(_ofp.PlannedRunwayIn.Length > 0 ? _ofp.PlannedRunwayIn : "—")}";

    private string CruiseFl => _ofp is { CruiseFlightLevel: > 0 }
        ? $"FL{_ofp.CruiseFlightLevel:D3}"
        : "FL---";

    private bool CanSendNow => _gate.Trim().Length > 0 || _gateAssignment.PendingGate is not null;

    protected override void OnInitialized()
    {
        Watch(GsxStore, snapshot => _gsx = snapshot);
        Watch(Weather, snapshot => _weather = snapshot);
        WatchChanged(h => Ofp.Changed += h, h => Ofp.Changed -= h, () => _ofp = Ofp.Current);
        WatchChanged(h => GateCoordinator.Changed += h, h => GateCoordinator.Changed -= h,
            () => _gateAssignment = GateCoordinator.Snapshot());
        WatchChanged(h => Deice.Changed += h, h => Deice.Changed -= h, () => _deice = Deice.Snapshot());
        WatchChanged(h => Units.Changed += h, h => Units.Changed -= h, () => { });
        // Seed the OAT input once from the current snapshot — later Deice changes must not
        // clobber what the user is typing.
        _deiceOat = _deice.OatC;
    }

    private void SetPreference(string key)
        // Korry buttons persist immediately (Prosim2GSX behaviour) — no dirty bar.
        => Writer.Set<GsxOptions, string>(o => o.PushbackPreference, key);

    private void ConfirmGate()
    {
        if (_gate.Trim().Length > 0)
        {
            GateCoordinator.Confirm(_gate);
        }
    }

    // Explicit input wins; with the box empty the queued gate is (re)sent.
    private void SendNowGate() => _ = GateCoordinator.SendNow(_gate.Trim().Length > 0 ? _gate : null);

    private void CancelGate() => GateCoordinator.Cancel();

    private async Task RefreshWeather() => await WeatherControl.RefreshAsync();

    private void OnPrecipChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<HotPrecip>(e.Value?.ToString(), out var precip))
        {
            Deice.SetPrecip(precip);
        }
    }

    private void OnOatChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var oat))
        {
            _deiceOat = oat;
            Deice.SetOat(oat);
        }
    }
}
