@page "/perf"
@using System.Globalization
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Core.Aircraft.Gateway
@using ProsimCompanion.Core.Aircraft.Ofp
@implements IDisposable
@inject IProsimGateway Gateway
@inject IProsimDataRefs DataRefs
@inject OfpStore Ofp
@inject LoadsheetStore Loadsheets
@inject IFmsPerfUplink PerfUplink

<PageTitle>Performance — ProsimCompanion</PageTitle>
<h1 class="sr-only">Takeoff and Landing Performance</h1>

<div class="status-panel">

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">Takeoff — @(_toIcao == "" ? "airport" : _toIcao)</h3>
        <div class="section-body">
            <div class="row">
                <span class="row-label">Airport ICAO</span>
                <input class="text-input" style="max-width:110px" maxlength="4" @bind="_toIcao" @bind:after="() => _toRunways = null" />
                <button type="button" class="btn secondary" disabled="@_toLoading" @onclick="LoadTakeoffAirport">Load runways + METAR</button>
            </div>
            @if (_toRunways is not null)
            {
                <div class="row">
                    <span class="row-label">Runway</span>
                    <select class="select" style="max-width:160px" @bind="_toRunwayId" @bind:after="OnTakeoffRunwayChanged">
                        @foreach (var runway in _toRunways)
                        {
                            <option value="@runway.RunwayId">@runway.RunwayId (@runway.LengthFt ft)</option>
                        }
                    </select>
                </div>
                @if (SelectedTakeoffRunway()?.Intersections is { Length: > 0 } intersections)
                {
                    <div class="row">
                        <span class="row-label">Intersection</span>
                        <select class="select" style="max-width:160px" @bind="_toIntersection">
                            <option value="">Full length</option>
                            @foreach (var intersection in intersections)
                            {
                                <option value="@intersection.Name">@intersection.Name (TORA @intersection.ToraFt ft)</option>
                            }
                        </select>
                    </div>
                }
            }
            <div class="row">
                <span class="row-label">OAT °C / QNH</span>
                <input class="number-input" type="number" @bind="_toOat" />
                <input class="number-input" type="number" @bind="_toQnh" />
            </div>
            <div class="row">
                <span class="row-label">Wind dir / kt</span>
                <input class="number-input" @bind="_toWindDir" />
                <input class="number-input" type="number" @bind="_toWindKt" />
            </div>
            <div class="row">
                <span class="row-label">TOW kg / MAC%</span>
                <input class="number-input" type="number" @bind="_towKg" />
                <input class="number-input" type="number" step="0.1" @bind="_macTow" />
            </div>
            <div class="row">
                <span class="row-label">Engine / Flaps</span>
                <select class="select" style="max-width:160px" @bind="_engine">
                    <option>CFM</option>
                    <option>IAE</option>
                </select>
                <select class="select" style="max-width:160px" @bind="_flapVal">
                    <option value="opt">OPT</option>
                    <option value="1+F">1+F</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                </select>
            </div>
            <div class="row">
                <span class="row-label">Surface / Anti-ice</span>
                <select class="select" style="max-width:160px" @bind="_surf">
                    <option>DRY</option>
                    <option>WET</option>
                </select>
                <select class="select" style="max-width:160px" @bind="_iceVal">
                    <option>OFF</option>
                    <option>ENG</option>
                    <option>ENG+WING</option>
                </select>
            </div>
            <div class="row">
                <span class="row-label">Packs / Force TOGA</span>
                <select class="select" style="max-width:160px" @bind="_packsVal">
                    <option>ON</option>
                    <option>OFF</option>
                </select>
                <select class="select" style="max-width:160px" @bind="_togaVal">
                    <option>NO</option>
                    <option>YES</option>
                </select>
            </div>
            <div class="row">
                <button type="button" class="btn primary" disabled="@_toCalculating" @onclick="CalculateTakeoff">
                    @(_toCalculating ? "Calculating…" : "Calculate")
                </button>
                @if (_toError is not null)
                {
                    <span class="row-value">@_toError</span>
                }
            </div>
            @if (_toResult?.VSpeed is { } vspeed)
            {
                <div class="row"><span class="row-label">V1 / VR / V2</span><span class="row-value-mono">@Math.Round(vspeed.V1) / @Math.Round(vspeed.VR) / @Math.Round(vspeed.V2) kt</span></div>
                <div class="row"><span class="row-label">CONF / FLEX</span><span class="row-value-mono">CONF @ConfLabel(_toResult.FlapSettings) / @(_toResult.ForceToga || (_toResult.FlexOutput ?? 0) <= 0 ? "TOGA" : $"FLEX {_toResult.FlexOutput}")</span></div>
                <div class="row"><span class="row-label">THS</span><span class="row-value-mono">@(_toResult.TrimOutput?.ToString("F1", CultureInfo.InvariantCulture) ?? "—")@(_toResult.TrimDir == "" ? "" : $" {_toResult.TrimDir}")</span></div>
                <div class="row"><span class="row-label">TOPL / headwind</span><span class="row-value-mono">@($"{_toResult.Topl:F0} kg{(_toResult.ToplLimited ? " (LIMITED)" : "")} / {_toResult.HwComp:+0;-0;0} kt")</span></div>
                <div class="row">
                    <button type="button" class="btn primary" disabled="@_uplinking" @onclick="UplinkTakeoff">
                        @(_uplinking ? "Uplinking…" : "Uplink to FMS")
                    </button>
                    @if (_uplinkResult is not null)
                    {
                        <span class="row-value">@_uplinkResult</span>
                    }
                </div>
            }
        </div>
    </section>

    <section class="status-section">
        <h3 class="section-title" style="padding:9px 14px; border-bottom:1px solid var(--border);">Landing — @(_ldgIcao == "" ? "airport" : _ldgIcao)</h3>
        <div class="section-body">
            <div class="row">
                <span class="row-label">Airport ICAO</span>
                <input class="text-input" style="max-width:110px" maxlength="4" @bind="_ldgIcao" @bind:after="() => _ldgRunways = null" />
                <button type="button" class="btn secondary" disabled="@_ldgLoading" @onclick="LoadLandingAirport">Load runways + METAR</button>
            </div>
            @if (_ldgRunways is not null)
            {
                <div class="row">
                    <span class="row-label">Runway</span>
                    <select class="select" style="max-width:160px" @bind="_ldgRunwayId">
                        @foreach (var runway in _ldgRunways)
                        {
                            <option value="@runway.RunwayId">@runway.RunwayId (@runway.LengthFt ft)</option>
                        }
                    </select>
                </div>
            }
            <div class="row">
                <span class="row-label">OAT °C / QNH</span>
                <input class="number-input" type="number" @bind="_ldgOat" />
                <input class="number-input" type="number" @bind="_ldgQnh" />
            </div>
            <div class="row">
                <span class="row-label">Wind dir / kt</span>
                <input class="number-input" @bind="_ldgWindDir" />
                <input class="number-input" type="number" @bind="_ldgWindKt" />
            </div>
            <div class="row">
                <span class="row-label">Landing weight kg</span>
                <input class="number-input" type="number" @bind="_lawKg" />
            </div>
            <div class="row">
                <span class="row-label">VAPP override kt</span>
                <input class="number-input" type="number" @bind="_vappOverride" />
            </div>
            <div class="row">
                <span class="row-label">Runway condition</span>
                <select class="select" style="max-width:160px" @bind="_breakAction">
                    <option value="6">Dry</option>
                    <option value="5">Good</option>
                    <option value="4">Good–Medium</option>
                    <option value="3">Medium</option>
                    <option value="2">Medium–Poor</option>
                    <option value="1">Poor</option>
                </select>
            </div>
            <div class="row">
                <span class="row-label">Autobrake / Reversers</span>
                <select class="select" style="max-width:160px" @bind="_breakMode">
                    <option>LOW</option>
                    <option>MED</option>
                    <option>MAX</option>
                </select>
                <select class="select" style="max-width:160px" @bind="_rev">
                    <option value="idle">Idle</option>
                    <option value="max">Max</option>
                </select>
            </div>
            <div class="row">
                <span class="row-label">Flaps / Autoland / A-THR</span>
                <select class="select" style="max-width:160px" @bind="_ldgFlaps">
                    <option>FULL</option>
                    <option>3</option>
                </select>
                <select class="select" style="max-width:160px" @bind="_autoland">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                </select>
                <select class="select" style="max-width:160px" @bind="_athr">
                    <option value="0">Off</option>
                    <option value="1">On</option>
                </select>
            </div>
            <div class="row">
                <button type="button" class="btn primary" disabled="@_ldgCalculating" @onclick="CalculateLanding">
                    @(_ldgCalculating ? "Calculating…" : "Calculate")
                </button>
                @if (_ldgError is not null)
                {
                    <span class="row-value">@_ldgError</span>
                }
            </div>
            @if (_ldr is { } ldr)
            {
                <div class="row"><span class="row-label">LDR</span><span class="row-value-mono">@(ldr <= 0 ? "no data" : $"{ldr} m")</span></div>
                @if (ldr > 0 && SelectedLandingRunway() is { LengthFt: { } lengthFt } landingRunway)
                {
                    // LDA subtracts the displaced threshold (predecessor rule).
                    var displacedFt = ParseFeet(landingRunway.Dt);
                    var ldaMeters = (int)Math.Round((lengthFt - displacedFt) * MetersPerFoot);
                    var ldr15 = (int)Math.Round(1.15 * ldr);
                    <div class="row"><span class="row-label">LDR + 15%</span><span class="row-value-mono" style="@(ldaMeters < ldr15 ? "color:var(--warning)" : "")">@ldr15 m</span></div>
                    <div class="row">
                        <span class="row-label">LDA / margin</span>
                        <span class="row-value-mono">@ldaMeters m / <span style="@(ldaMeters - ldr < 0 ? "color:var(--danger);font-weight:600" : "")">@(ldaMeters - ldr) m</span></span>
                    </div>
                }
            }
        </div>
    </section>

</div>

@code {
    private const double MetersPerFoot = 0.3048;

    private IDataRefSubscription? _grossSub;
    private IDataRefSubscription? _cgSub;
    private IDataRefSubscription? _engineSub;

    // Takeoff state
    private string _toIcao = "";
    private IReadOnlyList<RunwayResponse>? _toRunways;
    private string? _toRunwayId;
    private string _toIntersection = "";
    private int _toOat;
    private int _toQnh = 1013;
    private string _toWindDir = "0";
    private int _toWindKt;
    private double _towKg;
    private double _macTow;
    private string _engine = "CFM";
    private string _flapVal = "opt";
    private string _surf = "DRY";
    private string _iceVal = "OFF";
    private string _packsVal = "ON";
    private string _togaVal = "NO";
    private bool _toLoading;
    private bool _toCalculating;
    private bool _uplinking;
    private string? _toError;
    private string? _uplinkResult;
    private CalcVSpeedResult? _toResult;

    // Landing state
    private string _ldgIcao = "";
    private IReadOnlyList<RunwayResponse>? _ldgRunways;
    private string? _ldgRunwayId;
    private int _ldgOat;
    private int _ldgQnh = 1013;
    private string _ldgWindDir = "0";
    private int _ldgWindKt;
    private double _lawKg;
    private int _breakAction = 6;
    private string _breakMode = "MED";
    private string _rev = "idle";
    private string _ldgFlaps = "FULL";
    private string _autoland = "0";
    private string _athr = "1";
    private int _vappOverride;
    private bool _ldgLoading;
    private bool _ldgCalculating;
    private string? _ldgError;
    private int? _ldr;

    protected override void OnInitialized()
    {
        _grossSub = DataRefs.Subscribe(ProsimDataRefNames.WeightGross, DataRefTier.Normal);
        _cgSub = DataRefs.Subscribe(ProsimDataRefNames.CenterOfGravity, DataRefTier.Normal);
        _engineSub = DataRefs.Subscribe(ProsimDataRefNames.ConfigEngineType, DataRefTier.Infrequent);

        // Seed from the flight context: airports from the OFP, weights from the best loadsheet
        // (final > prelim), falling back to live datarefs.
        var ofp = Ofp.Current;
        _toIcao = ofp?.OriginIcao ?? "";
        _ldgIcao = ofp?.DestinationIcao ?? "";

        var sheets = Loadsheets.Snapshot();
        var best = sheets.Final.Status == LoadsheetSlotStatus.Sent ? sheets.Final
            : sheets.Prelim.Status == LoadsheetSlotStatus.Sent ? sheets.Prelim
            : null;
        _towKg = best?.TowKg > 0 ? best.TowKg : _grossSub.GetValue(0.0);
        _macTow = best?.MacTow > 0 ? best.MacTow : _cgSub.GetValue(0.0);
        _lawKg = ofp?.EstLdwKg > 0 ? ofp.EstLdwKg : _towKg;

        // "CFM-Leap" shares the CFM lookup tables — only two wire buckets exist.
        var engine = _engineSub.GetValue("CFM");
        _engine = engine.Contains("IAE", StringComparison.OrdinalIgnoreCase) ? "IAE" : "CFM";
    }

    public void Dispose()
    {
        _grossSub?.Dispose();
        _cgSub?.Dispose();
        _engineSub?.Dispose();
    }

    private RunwayResponse? SelectedTakeoffRunway()
        => _toRunways?.FirstOrDefault(runway => runway.RunwayId == _toRunwayId);

    private RunwayResponse? SelectedLandingRunway()
        => _ldgRunways?.FirstOrDefault(runway => runway.RunwayId == _ldgRunwayId);

    private void OnTakeoffRunwayChanged() => _toIntersection = "";

    private static string ConfLabel(int flapSettings) => flapSettings switch
    {
        1 => "1+F",
        2 => "2",
        3 => "3",
        _ => flapSettings.ToString(),
    };

    /// <summary>Runway ident → numeric QDM: "27L" → 270 (the request wants heading, not the
    /// surveyed true heading).</summary>
    private static int RunwayQdm(string? runwayId)
    {
        var digits = new string((runwayId ?? "").TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, NumberStyles.Integer, CultureInfo.InvariantCulture, out var number)
            ? number * 10
            : 0;
    }

    private static int ParseFeet(string? text)
        => int.TryParse(text?.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? value : 0;

    private async Task LoadTakeoffAirport()
    {
        _toLoading = true;
        _toError = null;
        try
        {
            var icao = _toIcao.Trim().ToUpperInvariant();
            var runways = await Gateway.GetRunwaysAsync(icao, includeIntersections: true);
            if (runways is null || runways.Count == 0)
            {
                _toError = "No runway data for that airport.";
                return;
            }
            _toRunways = runways;
            _toRunwayId = runways[0].RunwayId;
            _toIntersection = "";
            ApplyMetar(await Gateway.GetMetarAsync(icao), takeoff: true);
        }
        finally
        {
            _toLoading = false;
        }
    }

    private async Task LoadLandingAirport()
    {
        _ldgLoading = true;
        _ldgError = null;
        try
        {
            var icao = _ldgIcao.Trim().ToUpperInvariant();
            var runways = await Gateway.GetRunwaysAsync(icao, includeIntersections: false);
            if (runways is null || runways.Count == 0)
            {
                _ldgError = "No runway data for that airport.";
                return;
            }
            _ldgRunways = runways;
            _ldgRunwayId = runways[0].RunwayId;
            ApplyMetar(await Gateway.GetMetarAsync(icao), takeoff: false);
        }
        finally
        {
            _ldgLoading = false;
        }
    }

    private void ApplyMetar(Metar? metar, bool takeoff)
    {
        if (metar is null)
        {
            return;
        }

        // Altim rides the gateway's ×100 hPa convention when large; plain hPa otherwise.
        var qnh = metar.Altim > 10000 ? (int)Math.Round(metar.Altim / 100.0) : metar.Altim;
        var windDir = string.IsNullOrWhiteSpace(metar.WindDir) ? "0" : metar.WindDir.Trim();
        _ = int.TryParse(metar.WindSpeed?.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var windKt);

        if (takeoff)
        {
            _toOat = metar.Temperature;
            if (qnh > 0)
            {
                _toQnh = qnh;
            }
            _toWindDir = windDir;
            _toWindKt = windKt;
        }
        else
        {
            _ldgOat = metar.Temperature;
            if (qnh > 0)
            {
                _ldgQnh = qnh;
            }
            _ldgWindDir = windDir;
            _ldgWindKt = windKt;
        }
    }

    /// <summary>TORA in metres for the selected runway/intersection; full length when no
    /// intersection is picked.</summary>
    private (int ToraMeters, double ShiftMeters) TakeoffTora()
    {
        var runway = SelectedTakeoffRunway();
        var fullFt = runway?.LengthFt ?? 0;
        var toraFt = fullFt;
        if (_toIntersection is not "" && runway?.Intersections is not null)
        {
            toraFt = runway.Intersections.FirstOrDefault(candidate => candidate.Name == _toIntersection)?.ToraFt ?? fullFt;
        }

        // Gateway caps TORA at 3600 m server-side; matching here keeps requests honest.
        var toraMeters = Math.Min(3600, (int)Math.Round(toraFt * MetersPerFoot));
        return (toraMeters, Math.Max(0, (fullFt - toraFt) * MetersPerFoot));
    }

    private async Task CalculateTakeoff()
    {
        _toCalculating = true;
        _toError = null;
        _toResult = null;
        _uplinkResult = null;
        try
        {
            var runway = SelectedTakeoffRunway();
            if (runway is null)
            {
                _toError = "Load an airport and pick a runway first.";
                return;
            }

            var (toraMeters, _) = TakeoffTora();
            var request = new CalcVSpeedRequest
            {
                EngineVariant = _engine,
                Tow = (int)Math.Round(_towKg / 100.0),      // tens-of-kg wire scale (70.5 t → 705)
                Mactow = (int)Math.Round(_macTow * 10.0),   // %MAC × 10
                RwyLen = toraMeters,
                RwyQDM = RunwayQdm(runway.RunwayId),
                FlapVal = _flapVal,
                Surf = _surf,
                IceVal = _iceVal,
                PacksVal = _packsVal,
                TogaVal = _togaVal,
                Elev = ParseFeet(runway.ElevationFt),
                Temp = _toOat,
                QnhVal = _toQnh.ToString(CultureInfo.InvariantCulture),
                WindDir = _toWindDir,
                WindMag = _toWindKt,
            };

            var result = await Gateway.CalculateVSpeedsAsync(request);
            if (result is null)
            {
                _toError = "Calculation request failed — is ProSim running?";
            }
            else if (!string.IsNullOrEmpty(result.CalculationError))
            {
                _toError = result.CalculationError;
            }
            else
            {
                _toResult = result;
            }
        }
        finally
        {
            _toCalculating = false;
        }
    }

    private async Task UplinkTakeoff()
    {
        if (_toResult?.VSpeed is not { } vspeed)
        {
            return;
        }

        _uplinking = true;
        try
        {
            var (_, shiftMeters) = TakeoffTora();
            var ths = (_toResult.TrimDir == "DN" ? -1 : 1) * (_toResult.TrimOutput ?? 0);
            var ok = await PerfUplink.UplinkTakeoffAsync(new TakeoffPerfUplink(
                _toResult.FlapSettings,
                _toResult.ForceToga ? 0 : _toResult.FlexOutput ?? 0,
                (int)Math.Round(vspeed.V1),
                (int)Math.Round(vspeed.VR),
                (int)Math.Round(vspeed.V2),
                ths,
                shiftMeters));
            _uplinkResult = ok ? "Uplinked to FMS." : "Uplink failed — see logs.";
        }
        finally
        {
            _uplinking = false;
        }
    }

    private async Task CalculateLanding()
    {
        _ldgCalculating = true;
        _ldgError = null;
        _ldr = null;
        try
        {
            var runway = SelectedLandingRunway();
            if (runway is null)
            {
                _ldgError = "Load an airport and pick a runway first.";
                return;
            }

            // Predecessor rule: a VRB wind goes to the LDR calc as the runway's reciprocal
            // heading — a conservative direct-tailwind assumption.
            var qdm = RunwayQdm(runway.RunwayId);
            var wireWindDir = string.Equals(_ldgWindDir.Trim(), "VRB", StringComparison.OrdinalIgnoreCase)
                ? (qdm > 180 ? qdm - 180 : qdm + 180).ToString(CultureInfo.InvariantCulture)
                : _ldgWindDir;

            var request = new CalcLdrRequest
            {
                Qdm = qdm,
                Elev = ParseFeet(runway.ElevationFt),
                WindDir = wireWindDir,
                WindSpeed = _ldgWindKt,
                Oat = _ldgOat,
                Slp = _ldgQnh,
                BreakAction = _breakAction,
                AircraftSpeed = _vappOverride > 0 ? _vappOverride : null,
                LdgW = (float)(_lawKg / 1000.0),            // tonnes wire scale
                BreakMode = _breakMode,
                Rev = _rev,
                Autoland = _autoland,
                FlapConfig = _ldgFlaps,
                Athr = _athr,
            };

            var result = await Gateway.CalculateLandingDistanceAsync(request);
            if (result is null)
            {
                _ldgError = "Calculation request failed — is ProSim running?";
            }
            else
            {
                _ldr = result.Ldr;
            }
        }
        finally
        {
            _ldgCalculating = false;
        }
    }
}
