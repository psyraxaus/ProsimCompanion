@page "/weather"
@using ProsimCompanion.Core.Weather
@implements IDisposable
@inject WeatherStore Store
@inject IWeatherControl Control

<PageTitle>Weather — ProsimCompanion</PageTitle>
<h1 class="sr-only">Weather</h1>

<div class="panel">

    <Section Title="SayIntentions Weather" Hint="ATIS / METAR / TAF for the OFP airports — cached 10 min, refresh debounced 30 s">
        <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
            <button type="button" class="btn" disabled="@_view.IsRefreshing" @onclick="RefreshAsync">
                @(_view.IsRefreshing ? "Refreshing…" : "Refresh")
            </button>
            <span class="pill @(_view.CpdlcStation.Length > 0 ? "tone-ok" : "tone-neutral")"
                  title="CPDLC logon for whatever station SayIntentions currently considers active">
                CPDLC @(_view.CpdlcStation.Length > 0 ? _view.CpdlcStation : "—")
            </span>
            @if (_view.FetchedAtUtc is { } fetched)
            {
                <span class="pill tone-neutral" title="@fetched.ToString("u")">Fetched @Age(fetched)</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(_view.Status))
        {
            <div class="field-hint" style="margin-top:8px;">@_view.Status</div>
        }
    </Section>

    @foreach (var (title, hint, wx) in Cards())
    {
        <Section Title="@title" Hint="@hint">
            @if (wx is null)
            {
                <div class="empty">No weather — refresh with an OFP loaded.</div>
            }
            else
            {
                <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
                    <span class="pill tone-active mono">@wx.Airport</span>
                    @if (AtisLetter.Extract(wx.Atis) is { } letter)
                    {
                        <span class="pill tone-ok">Information @letter</span>
                    }
                    @if (wx.ActiveRunway.Length > 0)
                    {
                        <span class="pill tone-ok">Active runway @wx.ActiveRunway</span>
                    }
                    @if (wx is { WindDirection: { } dir, WindSpeed: { } spd })
                    {
                        <span class="pill tone-neutral">Wind @dir.ToString("000")° / @spd kt</span>
                    }
                </div>
                @if (wx.Metar.Length > 0)
                {
                    <div class="field-hint" style="margin-top:10px;">METAR</div>
                    <div class="mono" style="white-space:pre-wrap; overflow-wrap:anywhere;">@wx.Metar</div>
                }
                @if (wx.Taf.Length > 0)
                {
                    <div class="field-hint" style="margin-top:10px;">TAF</div>
                    <div class="mono" style="white-space:pre-wrap; overflow-wrap:anywhere;">@wx.Taf</div>
                }
                @if (wx.Atis.Length > 0)
                {
                    <div class="field-hint" style="margin-top:10px;">ATIS</div>
                    <div style="white-space:pre-wrap; overflow-wrap:anywhere;">@wx.Atis</div>
                }
            }
        </Section>
    }

</div>

@code {
    private WeatherSnapshot _view = WeatherSnapshot.Empty;

    protected override void OnInitialized()
    {
        _view = Store.Snapshot();
        Store.Changed += OnChanged;
    }

    private IEnumerable<(string Title, string Hint, AirportWeather? Wx)> Cards()
    {
        yield return ("Departure", "OFP origin", _view.Departure);
        yield return ("Arrival", "OFP destination", _view.Arrival);
    }

    private async Task RefreshAsync()
        // Outcome (data or a reason string) always lands in the store — never an exception.
        => await Control.RefreshAsync();

    private static string Age(DateTimeOffset fetchedUtc)
    {
        var age = DateTimeOffset.UtcNow - fetchedUtc;
        return age.TotalSeconds < 60
            ? $"{Math.Max(0, (int)age.TotalSeconds)}s ago"
            : age.TotalMinutes < 60 ? $"{(int)age.TotalMinutes}m ago" : $"{(int)age.TotalHours}h ago";
    }

    private void OnChanged(object? sender, EventArgs e)
        // Store events fire on the writer's thread; marshal into the circuit.
        => _ = InvokeAsync(() =>
        {
            _view = Store.Snapshot();
            StateHasChanged();
        });

    public void Dispose() => Store.Changed -= OnChanged;
}
