@page "/settings/notifications"
@layout SettingsLayout
@inherits SettingsPageBase
@using ProsimCompanion.Core.Aircraft.Ofp
@using ProsimCompanion.Core.Notifications
@inject IOptionsMonitor<NotificationOptions> NotificationMonitor
@inject NotificationDispatcher Dispatcher
@inject OfpStore Ofp
@inject IStringLocalizer T

<PageTitle>@T["notifications.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["notifications.heading"]</h1>

@* Outbound event notifications (issue #151, design A — one card per target). The URL and the
   token of every target are DPAPI-protected at rest and never logged; the page shows the token
   as a password field and the result line carries the HTTP status only. *@

<Section Title="@T["notifications.main.title"]" Hint="@T["notifications.main.hint"]">
    <BoolField Label="@T["notifications.main.enabled.label"]"
               Hint="@T["notifications.main.enabled.hint"]"
               More="@T["notifications.main.enabled.more"]"
               @bind-Value="_options.Value.Enabled" />
    <AdvancedFields>
        <NumberField Label="@T["notifications.main.cooldown.label"]" Hint="@T["notifications.main.cooldown.hint"]" Suffix="s" Min="5" Max="3600"
                     @bind-Value="_options.Value.FailureCooldownSeconds"
                     Default="_options.Defaults.FailureCooldownSeconds" />
        <NumberField Label="@T["notifications.main.timeout.label"]" Hint="@T["notifications.main.timeout.hint"]" Suffix="s" Min="1" Max="30"
                     @bind-Value="_options.Value.SendTimeoutSeconds"
                     Default="_options.Defaults.SendTimeoutSeconds" />
        <NumberField Label="@T["notifications.main.holdover.label"]" Hint="@T["notifications.main.holdover.hint"]" Suffix="min" Min="1" Max="30"
                     @bind-Value="_options.Value.HoldoverExpiringMinutes"
                     Default="_options.Defaults.HoldoverExpiringMinutes" />
    </AdvancedFields>
</Section>

@for (var i = 0; i < _options.Value.Targets.Count; i++)
{
    var index = i;
    var target = _options.Value.Targets[index];
    var title = string.IsNullOrWhiteSpace(target.Name) ? T["notifications.target.defaultTitle", index + 1].Value : target.Name;
    <Section Title="@title" Hint="@KindHint(target.Kind)">
        <div class="field" style="align-items:center;">
            <label class="field-label">@T["notifications.target.status"]</label>
            <div class="field-control" style="display:flex; align-items:center; gap:10px; justify-content:flex-end;">
                <span class="pill @StatusTone(target)">@StatusLabel(target)</span>
                <button type="button" class="btn secondary" style="padding:4px 10px;" title="@T["notifications.target.removeTitle"]"
                        @onclick="() => _options.Value.Targets.RemoveAt(index)">@T["notifications.target.remove"]</button>
            </div>
        </div>
        <TextField Label="@T["notifications.target.name.label"]" Hint="@T["notifications.target.name.hint"]" Placeholder="@T["notifications.target.name.placeholder"]"
                   @bind-Value="target.Name" />
        <SelectField Label="@T["notifications.target.kind.label"]" Options="KindOptions"
                     Hint="@T["notifications.target.kind.hint"]"
                     Value="@target.Kind.ToString().ToLowerInvariant()"
                     ValueChanged="@(v => target.Kind = Enum.TryParse<NotificationTargetKind>(v, ignoreCase: true, out var k) ? k : NotificationTargetKind.Webhook)" />
        <TextField Label="@T["notifications.target.url.label"]" Hint="@UrlHint(target.Kind)" Kind="TextFieldKind.Url" Placeholder="@UrlPlaceholder(target.Kind)" Password="true"
                   @bind-Value="target.Url" />
        <SecretUnreadableHint Path="@($"notifications:targets:{index}:url")" />
        <TextField Label="@T["notifications.target.token.label"]" Hint="@T["notifications.target.token.hint"]" Password="true"
                   @bind-Value="target.Token" />
        <SecretUnreadableHint Path="@($"notifications:targets:{index}:token")" />
        <div class="field">
            <label class="field-label">
                @T["notifications.target.events.label"]
                <FieldHint Hint="@T["notifications.target.events.hint"]" />
            </label>
            <div class="field-control">
                <div class="notify-events">
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.RefuelComplete" /> @T["notifications.target.events.refuelComplete"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.BoardingComplete" /> @T["notifications.target.events.boardingComplete"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.FinalLoadsheetSent" /> @T["notifications.target.events.finalLoadsheetSent"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.ReadyForPushback" /> @T["notifications.target.events.readyForPushback"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.CabinSecure" /> @T["notifications.target.events.cabinSecure"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.DeiceHoldoverExpiring" /> @T["notifications.target.events.deiceHoldoverExpiring"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.TopOfDescentApproaching" /> @T["notifications.target.events.topOfDescentApproaching"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.Landed" /> @T["notifications.target.events.landed"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.OnBlocks" /> @T["notifications.target.events.onBlocks"]</label>
                    <label><input type="checkbox" class="checkbox" @bind="target.Events.DeboardingComplete" /> @T["notifications.target.events.deboardingComplete"]</label>
                </div>
            </div>
        </div>
        <div class="field" style="align-items:center;">
            <label class="field-label">
                @T["notifications.target.test.label"]
                <FieldHint Hint="@T["notifications.target.test.hint"]" />
            </label>
            <div class="field-control" style="display:flex; align-items:center; gap:10px; justify-content:flex-end; flex-wrap:wrap;">
                <span class="field-hint @ResultTone(target)" style="margin:0;">@ResultLine(target)</span>
                <button type="button" class="btn primary" style="padding:4px 12px;" disabled="@(_testing == index || string.IsNullOrWhiteSpace(target.Url))"
                        @onclick="() => SendTestAsync(index)">@(_testing == index ? T["notifications.target.test.sending"].Value : T["notifications.target.test.send"].Value)</button>
            </div>
        </div>
    </Section>
}

@if (_options.Value.Targets.Count == 0)
{
    <Section Title="@T["notifications.empty.title"]" Hint="@T["notifications.empty.hint"]">
        <div class="field-hint">@T["notifications.empty.text"]</div>
    </Section>
}

<div style="margin:4px 0 16px;">
    <button type="button" class="btn primary" @onclick="AddTarget">@T["notifications.add"]</button>
</div>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    // Service names, not prose — the same in every language.
    private static readonly IReadOnlyList<(string, string)> KindOptions =
        [("ntfy", "ntfy"), ("discord", "Discord"), ("webhook", "Webhook (JSON POST)")];

    private OptionsDraft<NotificationOptions> _options = default!;
    private int? _testing;
    private readonly Dictionary<int, NotificationSendResult> _testResults = [];

    protected override void OnInitialized()
    {
        _options = Draft(NotificationMonitor);
        // The dispatcher's result lines refresh through the observer base (#86), never a hand-wired event.
        WatchChanged(h => Dispatcher.Changed += h, h => Dispatcher.Changed -= h, () => { });
    }

    // The stored default name stays English: it is the label the log lines and the dispatcher's
    // result table carry, and the card title above reads it back whatever the language.
    private void AddTarget()
        => _options.Value.Targets.Add(new NotificationTarget { Name = $"Target {_options.Value.Targets.Count + 1}" });

    private async Task SendTestAsync(int index)
    {
        if (index >= _options.Value.Targets.Count)
        {
            return;
        }

        _testing = index;
        try
        {
            var ofp = Ofp.Current;
            var route = ofp is { OriginIcao.Length: > 0, DestinationIcao.Length: > 0 } ? $"{ofp.OriginIcao}–{ofp.DestinationIcao}" : null;
            _testResults[index] = await Dispatcher.SendTestAsync(_options.Value.Targets[index], ofp?.Callsign, route);
        }
        finally
        {
            _testing = null;
        }
    }

    private NotificationSendResult? LastResult(NotificationTarget target, int index)
    {
        if (_testResults.TryGetValue(index, out var test))
        {
            return test;
        }

        var key = string.IsNullOrWhiteSpace(target.Name) ? target.Kind.ToString() : target.Name.Trim();
        return Dispatcher.LastResults.TryGetValue(key, out var last) ? last : null;
    }

    private string StatusLabel(NotificationTarget target)
    {
        var index = _options.Value.Targets.IndexOf(target);
        var last = LastResult(target, index);
        return last is null ? T["notifications.target.neverSent"].Value : last.Ok ? T["notifications.target.ok"].Value : T["notifications.target.failed"].Value;
    }

    private string StatusTone(NotificationTarget target)
    {
        var last = LastResult(target, _options.Value.Targets.IndexOf(target));
        return last is null ? "tone-neutral" : last.Ok ? "tone-ok" : "tone-bad";
    }

    private string ResultLine(NotificationTarget target)
        => LastResult(target, _options.Value.Targets.IndexOf(target))?.Summary ?? "";

    private string ResultTone(NotificationTarget target)
        => LastResult(target, _options.Value.Targets.IndexOf(target)) is { } r ? (r.Ok ? "notify-ok" : "notify-bad") : "";

    private string KindHint(NotificationTargetKind kind) => kind switch
    {
        NotificationTargetKind.Ntfy => T["notifications.kindHint.ntfy"].Value,
        NotificationTargetKind.Discord => T["notifications.kindHint.discord"].Value,
        _ => T["notifications.kindHint.webhook"].Value,
    };

    private string UrlHint(NotificationTargetKind kind) => kind switch
    {
        NotificationTargetKind.Ntfy => T["notifications.urlHint.ntfy"].Value,
        NotificationTargetKind.Discord => T["notifications.urlHint.discord"].Value,
        _ => T["notifications.urlHint.webhook"].Value,
    };

    private static string UrlPlaceholder(NotificationTargetKind kind) => kind switch
    {
        NotificationTargetKind.Ntfy => "https://ntfy.sh/your-private-topic",
        NotificationTargetKind.Discord => "https://discord.com/api/webhooks/…",
        _ => "https://homeassistant.local:8123/api/webhook/prosim",
    };

}
