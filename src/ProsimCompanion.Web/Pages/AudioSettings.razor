@page "/settings/audio/{Section?}"
@page "/audio"
@layout SettingsLayout
@using System.Globalization
@using System.Reflection
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Web.Settings
@inherits SettingsPageBase
@inject IOptionsMonitor<AudioOptions> AudioMonitor
@inject IAudioControl AudioControl
@inject IAudioDeviceCatalog DeviceCatalog
@inject IOptionsMonitor<MixerOptions> MixerMonitor
@inject IMixerClients Mixers
@inject MixerStatusStore MixerStatus
@inject IStringLocalizer T

<PageTitle>@T["audioSettings.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["audioSettings.heading"]</h1>

@* Sections are URL-driven (settings/audio/{section}, ADR-0010); the rail lives in
   SettingsLayout. The audio master switch moved to Setup with the other pillar switches.
   Since C3 (2026-10-19) a field is one <OptionField Draft For /> line over its described
   property; the mapping tables and the strip/bus text bridges stay the page's own. *@

            @if (CurrentSection == "status")
            {
                <AudioStatusPanel />
            }
            else if (CurrentSection == "general")
            {
                <Section Title="@T["audioSettings.general.title"]" Hint="@T["audioSettings.general.hint"]">
                    <OptionField Draft="_audio" For="o => o.Backend" />
                    <OptionField Draft="_audio" For="o => o.DisableProsimNativeAudio" />
                    <OptionField Draft="_audio" For="o => o.RequireAcpPower" />
                </Section>
            }
            else if (CurrentSection == "coreaudio")
            {
                <Section Title="CoreAudio" Hint="@T["audioSettings.coreAudio.hint"]">
                    <OptionField Draft="_audio" For="o => o.CoreAudioAcp" />
                    <AdvancedFields Label="@T["audioSettings.coreAudio.troubleshooting"]">
                        <OptionField Draft="_audio" For="o => o.DeviceFilterFlow" />
                        <OptionField Draft="_audio" For="o => o.DeviceFilterState" />
                        <div style="margin-top:8px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                            <button type="button" class="btn secondary" disabled="@_debugDumpBusy" @onclick="WriteDebugDump">
                                @(_debugDumpBusy ? T["audioSettings.coreAudio.debugDump.writing"].Value : T["audioSettings.coreAudio.debugDump.write"].Value)
                            </button>
                            @if (_debugDumpResult is not null)
                            {
                                <span class="field-hint">@_debugDumpResult</span>
                            }
                        </div>
                    </AdvancedFields>
                </Section>

                <Section Title="@T["audioSettings.coreAudio.mappings.title"]" Hint="@T["audioSettings.coreAudio.mappings.hint"]">
                    @if (_audio.Value.AppMappings.Count == 0)
                    {
                        <div class="empty">@T["audioSettings.coreAudio.mappings.empty"]</div>
                    }
                    else
                    {
                        <div class="audio-map-header">
                            <span>@T["audioSettings.coreAudio.mappings.channel"]</span><span>@T["audioSettings.coreAudio.mappings.process"]</span><span>@T["audioSettings.coreAudio.mappings.device"]</span>
                            <span>@T["audioSettings.coreAudio.mappings.latch"]</span><span>@T["audioSettings.coreAudio.mappings.active"]</span><span></span>
                        </div>
                        @for (var i = 0; i < _audio.Value.AppMappings.Count; i++)
                        {
                            var index = i;
                            var row = _audio.Value.AppMappings[index];
                            <div class="audio-map-row">
                                <select class="cell-select" @bind="row.Channel">
                                    @foreach (var channel in Enum.GetValues<AudioChannel>())
                                    {
                                        <option value="@channel">@AudioPresentation.ChannelLabel(channel)</option>
                                    }
                                </select>
                                <input class="cell-input" placeholder="@T["audioSettings.coreAudio.mappings.processPlaceholder"]" list="audio-process-suggestions" @bind="row.Binary" />
                                <input class="cell-input" placeholder="@T["audioSettings.coreAudio.mappings.devicePlaceholder"]" list="audio-device-suggestions" @bind="row.Device" />
                                <input type="checkbox" class="audio-cell-check" title="@T["audioSettings.coreAudio.mappings.latchTitle"]"
                                       @bind="row.UseLatch" />
                                <input type="checkbox" class="audio-cell-check" title="@T["audioSettings.coreAudio.mappings.activeTitle"]"
                                       @bind="row.OnlyActive" />
                                <button type="button" class="remove-btn" title="@T["audioSettings.coreAudio.mappings.remove"]" aria-label="@T["audioSettings.coreAudio.mappings.remove"]"
                                        @onclick="() => _audio.Value.AppMappings.RemoveAt(index)">×</button>
                            </div>
                        }
                    }
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary"
                                @onclick="() => _audio.Value.AppMappings.Add(new AudioAppMapping())">@T["audioSettings.coreAudio.mappings.add"]</button>
                    </div>
                    <div class="field-hint" style="margin-top:8px; max-width:640px;">
                        @T["audioSettings.coreAudio.mappings.note"]
                        <details class="field-more">
                            <summary>@T["audioSettings.coreAudio.mappings.more"]</summary>
                            <span class="field-more-body">
                                @T["audioSettings.coreAudio.mappings.moreBody"]
                            </span>
                        </details>
                    </div>
                </Section>

                <Section Title="@T["audioSettings.coreAudio.blacklist.title"]" Hint="@T["audioSettings.coreAudio.blacklist.hint"]">
                    <div class="list-editor">
                        @for (var i = 0; i < _audio.Value.DeviceBlacklist.Count; i++)
                        {
                            var index = i;
                            <div class="list-row">
                                <input class="cell-input" placeholder="@T["audioSettings.coreAudio.blacklist.placeholder"]"
                                       list="audio-device-suggestions" @bind="_audio.Value.DeviceBlacklist[index]" />
                                <button type="button" class="remove-btn" title="@T["audioSettings.coreAudio.blacklist.remove"]" aria-label="@T["audioSettings.coreAudio.blacklist.remove"]"
                                        @onclick="() => _audio.Value.DeviceBlacklist.RemoveAt(index)">×</button>
                            </div>
                        }
                    </div>
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary"
                                @onclick="() => _audio.Value.DeviceBlacklist.Add(string.Empty)">@T["audioSettings.coreAudio.blacklist.add"]</button>
                    </div>
                </Section>
            }
            else if (CurrentSection == "voicemeeter")
            {
                <Section Title="VoiceMeeter" Hint="@T["audioSettings.voiceMeeter.hint"]">
                    <AdvancedFields>
                        <OptionField Draft="_audio" For="o => o.VoiceMeeterDllPath" />
                    </AdvancedFields>
                    <div style="margin:8px 0;">
                        <button type="button" class="btn secondary" @onclick="ReloadTargets">@T["audioSettings.voiceMeeter.reload"]</button>
                        <span class="field-hint" style="margin-left:8px;">
                            @(_vmTargets.Count > 0
                                ? T["audioSettings.voiceMeeter.found", _vmTargets.Count(t => !t.IsBus), _vmTargets.Count(t => t.IsBus)].Value
                                : T["audioSettings.voiceMeeter.notReachable"].Value)
                        </span>
                    </div>
                </Section>

                @foreach (var acp in Enum.GetValues<AcpSide>())
                {
                    <Section Title="@T["audioSettings.voiceMeeter.acpMappings", AudioPresentation.AcpLabel(acp)]">
                        <BoolField Label="@T["audioSettings.voiceMeeter.driveFrom", AudioPresentation.AcpLabel(acp)]"
                                   Value="_audio.Value.ActiveAcps.Contains(acp)"
                                   ValueChanged="active => SetAcpActive(acp, active)" />
                        @{ var list = VmList(acp); }
                        @if (list.Count > 0)
                        {
                            <div class="audio-vm-header">
                                <span>@T["audioSettings.voiceMeeter.channel"]</span><span>@T["audioSettings.voiceMeeter.target"]</span><span>@T["audioSettings.voiceMeeter.latch"]</span><span></span>
                            </div>
                            @for (var i = 0; i < list.Count; i++)
                            {
                                var index = i;
                                var row = list[index];
                                <div class="audio-vm-row">
                                    <select class="cell-select" @bind="row.Channel">
                                        @foreach (var channel in Enum.GetValues<AudioChannel>())
                                        {
                                            @* The observer has no loudspeaker dial. *@
                                            @if (channel.ExistsOn(acp))
                                            {
                                                <option value="@channel">@AudioPresentation.ChannelLabel(channel)</option>
                                            }
                                        }
                                    </select>
                                    <select class="cell-select" value="@TargetKey(row)"
                                            @onchange="e => SetTarget(row, e.Value as string)">
                                        @foreach (var (key, label) in TargetOptions())
                                        {
                                            <option value="@key">@label</option>
                                        }
                                    </select>
                                    @if (row.Channel.HasRecLatch())
                                    {
                                        <input type="checkbox" class="audio-cell-check"
                                               title="@T["audioSettings.voiceMeeter.latchTitle"]" @bind="row.UseLatch" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="audio-cell-check" checked disabled
                                               title="@T["audioSettings.voiceMeeter.noLatchTitle"]" />
                                    }
                                    <button type="button" class="remove-btn" title="@T["audioSettings.voiceMeeter.remove"]" aria-label="@T["audioSettings.voiceMeeter.remove"]"
                                            @onclick="() => list.RemoveAt(index)">×</button>
                                </div>
                            }
                        }
                        <div style="margin-top:8px;">
                            <button type="button" class="btn secondary"
                                    @onclick="() => VmList(acp).Add(new VoiceMeeterTargetMapping())">@T["audioSettings.voiceMeeter.add"]</button>
                        </div>
                    </Section>
                }

                @* #179: two rows on one strip/bus means one fader for two headsets — say so
                   while editing, not only after the binder refused the set. *@
                @foreach (var shared in VoiceMeeterSharedTargets())
                {
                    <div class="field-hint field-hint-warn" style="max-width:640px;">
                        @T["audioSettings.voiceMeeter.sharedTarget", VoiceMeeterTargetLabel(shared.IsBus, shared.Index), string.Join(", ", shared.Owners)]
                    </div>
                }
                <div class="field-hint" style="max-width:640px;">
                    @T["audioSettings.voiceMeeter.perHeadset"]
                    <details class="field-more">
                        <summary>@T["audioSettings.voiceMeeter.more"]</summary>
                        <span class="field-more-body">
                            @T["audioSettings.voiceMeeter.perHeadsetMore"]
                        </span>
                    </details>
                </div>
                <div class="field-hint" style="max-width:640px; margin-top:8px;">
                    @T["audioSettings.voiceMeeter.oncePerPanel"]
                    <details class="field-more">
                        <summary>@T["audioSettings.voiceMeeter.more"]</summary>
                        <span class="field-more-body">
                            @T["audioSettings.voiceMeeter.oncePerPanelMore"]
                        </span>
                    </details>
                </div>
                <div class="field-hint" style="max-width:640px; margin-top:8px;">
                    @T["audioSettings.voiceMeeter.loudspeaker"]
                    <details class="field-more">
                        <summary>@T["audioSettings.voiceMeeter.more"]</summary>
                        <span class="field-more-body">
                            @T["audioSettings.voiceMeeter.loudspeakerMore"]
                        </span>
                    </details>
                </div>
            }
            else if (CurrentSection == "mixer")
            {
                <Section Title="@T["audioSettings.mixer.title"]" Hint="@T["audioSettings.mixer.hint"]">
                    <OptionField Draft="_mixer" For="o => o.Enabled" />
                    @if (_mixerLifted)
                    {
                        <div class="field-hint field-hint-warn" style="max-width:640px;">@T["audioSettings.mixer.agent.lifted"]</div>
                    }
                    <div class="field-hint" style="max-width:640px;">@T["audioSettings.mixer.agent.twoPcs"]</div>
                    <AdvancedFields>
                        <OptionField Draft="_mixer" For="o => o.ReconnectDelayMs" />
                        <OptionField Draft="_mixer" For="o => o.ReconnectMaxDelayMs" />
                        <OptionField Draft="_mixer" For="o => o.SetTimeoutMs" />
                        <OptionField Draft="_mixer" For="o => o.GainMinDb" />
                        <OptionField Draft="_mixer" For="o => o.GainMaxDb" />
                    </AdvancedFields>
                </Section>

                @* One block per VoicemeeterBridge agent (#178): connection, Test, live pill,
                   and the strips/buses of THAT PC the Status card shows. *@
                @for (var a = 0; a < _mixer.Value.Agents.Count; a++)
                {
                    var agentIndex = a;
                    var agent = _mixer.Value.Agents[agentIndex];
                    var agentName = agent.Name.Trim();
                    var live = _mixerLive.Agent(agentName);
                    var client = Mixers.Find(agentName);
                    var channels = client?.Channels ?? [];
                    var kind = live?.Voicemeeter.Kind;
                    <Section Title="@T["audioSettings.mixer.agent.title", AgentTitle(agent)]" Hint="@T["audioSettings.mixer.agent.hint"]">
                        <OptionField Item="agent" ItemOf="_mixer" For="t => t.Name" Changed="() => OnAgentRenamed(agentIndex)" />
                        <OptionField Item="agent" ItemOf="_mixer" For="t => t.Enabled" />
                        <OptionField Item="agent" ItemOf="_mixer" For="t => t.Host" />
                        <OptionField Item="agent" ItemOf="_mixer" For="t => t.Port" />
                        <OptionField Item="agent" ItemOf="_mixer" For="t => t.Token" />
                        <SecretUnreadableHint Path="@($"mixer:agents:{agentIndex}:token")" />
                        <div class="row-actions" style="margin-top:8px; flex-wrap:wrap;">
                            <button type="button" class="btn secondary" disabled="@_agentTestBusy.Contains(agentIndex)" @onclick="() => TestAgent(agentIndex)"
                                    title="@T["audioSettings.mixer.testTitle"]">
                                @(_agentTestBusy.Contains(agentIndex) ? T["audioSettings.mixer.testing"].Value : T["audioSettings.mixer.test"].Value)
                            </button>
                            @if (_agentTestResults.TryGetValue(agentIndex, out var test))
                            {
                                <span class="pill @(test.Ok ? "tone-ok" : "tone-bad")">@test.Message</span>
                            }
                            <span class="pill @MixerStateTone(live?.State ?? MixerConnectionState.Disabled)" title="@T["audioSettings.mixer.liveTitle"]">
                                @MixerStateLabel(live)
                            </span>
                            <button type="button" class="btn secondary" style="margin-left:auto;" title="@T["audioSettings.mixer.agent.removeTitle"]"
                                    @onclick="() => RemoveAgent(agentIndex)">@T["audioSettings.mixer.agent.remove"]</button>
                        </div>

                        <div style="margin-top:14px;">
                            <span class="label-caps">@T["audioSettings.mixer.panel.title"]</span>
                            <span class="field-hint" style="margin-left:8px;">@T["audioSettings.mixer.panel.hint"]</span>
                        </div>
                        @if (channels.Count > 0)
                        {
                            <div class="mixer-channel-grid">
                                @foreach (var channel in channels)
                                {
                                    var picked = IsPanelChannel(agent, channel);
                                    <label class="mixer-channel-pick">
                                        <input type="checkbox" class="checkbox" checked="@picked"
                                               @onchange="e => SetPanelChannel(agentIndex, channel, e.Value is true)" />
                                        <span>@channel.DisplayName(kind)</span>
                                    </label>
                                }
                            </div>
                            <FieldHint Hint="@T["audioSettings.mixer.panel.pickHint"]" />
                        }
                        else
                        {
                            <TextField Label="@T["audioSettings.mixer.panel.strips.label"]" Hint="@T["audioSettings.mixer.panel.strips.hint"]" Kind="TextFieldKind.IntList"
                                       Value="@PanelText(_agentStripsText, agentIndex)" ValueChanged="text => SetAgentStrips(agentIndex, text)" />
                            <TextField Label="@T["audioSettings.mixer.panel.buses.label"]" Hint="@T["audioSettings.mixer.panel.buses.hint"]" Kind="TextFieldKind.IntList"
                                       Value="@PanelText(_agentBusesText, agentIndex)" ValueChanged="text => SetAgentBuses(agentIndex, text)" />
                            <FieldHint Hint="@T["audioSettings.mixer.panel.pendingHint"]" />
                        }
                        <div class="row-actions" style="margin-top:8px; flex-wrap:wrap;">
                            <button type="button" class="btn secondary" disabled="@(_agentReloadBusy.Contains(agentIndex) || client is null)" @onclick="() => ReloadAgentChannels(agentIndex)"
                                    title="@T["audioSettings.mixer.panel.reloadTitle"]">
                                @(_agentReloadBusy.Contains(agentIndex) ? T["audioSettings.mixer.panel.reading"].Value : T["audioSettings.mixer.panel.reload"].Value)
                            </button>
                            <span class="field-hint">@ChannelSummary(client, live)</span>
                        </div>
                    </Section>
                }

                <Section Title="@T["audioSettings.mixer.agent.untitled"]" Hint="@T["audioSettings.mixer.agent.hint"]">
                    @if (_mixer.Value.Agents.Count == 0)
                    {
                        <div class="empty">@T["audioSettings.mixer.agent.empty"]</div>
                    }
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary" @onclick="AddAgent">@T["audioSettings.mixer.agent.add"]</button>
                    </div>
                </Section>

                <Section Title="@T["audioSettings.mixer.mappings.title"]" Hint="@T["audioSettings.mixer.mappings.hint"]">
                    @if (_mixer.Value.Mappings.Count == 0)
                    {
                        <div class="empty">@T["audioSettings.mixer.mappings.empty"]</div>
                    }
                    else
                    {
                        <div class="mixer-map-header">
                            <span>@T["audioSettings.mixer.mappings.on"]</span><span>@T["audioSettings.mixer.mappings.panel"]</span><span>@T["audioSettings.mixer.mappings.channel"]</span><span>@T["audioSettings.mixer.mappings.target"]</span>
                            <span title="@T["audioSettings.mixer.mappings.latchTitle"]">@T["audioSettings.mixer.mappings.latch"]</span><span>@T["audioSettings.mixer.mappings.live"]</span><span></span>
                        </div>
                        @for (var i = 0; i < _mixer.Value.Mappings.Count; i++)
                        {
                            var index = i;
                            var row = _mixer.Value.Mappings[index];
                            var live = _mixerLive.Mappings.FirstOrDefault(m =>
                                m.Acp == row.Acp && m.Channel == row.Channel && m.IsBus == row.IsBus && m.StripIndex == row.StripIndex
                                && MixerAgentOptions.SameName(m.Agent, row.Agent));
                            <div class="mixer-map-row">
                                <input type="checkbox" class="audio-cell-check" title="@T["audioSettings.mixer.mappings.enabledTitle"]" @bind="row.Enabled" />
                                <select class="cell-select" @bind="row.Acp">
                                    @foreach (var acp in Enum.GetValues<AcpSide>())
                                    {
                                        <option value="@acp">@AudioPresentation.AcpLabel(acp)</option>
                                    }
                                </select>
                                <select class="cell-select" @bind="row.Channel">
                                    @foreach (var channel in Enum.GetValues<AudioChannel>())
                                    {
                                        @* The observer has no loudspeaker dial. *@
                                        @if (channel.ExistsOn(row.Acp))
                                        {
                                            <option value="@channel">@AudioPresentation.ChannelLabel(channel)</option>
                                        }
                                    }
                                </select>
                                <select class="cell-select" value="@TargetKey(row)" @onchange="e => SetTarget(row, e.Value as string)">
                                    @foreach (var (key, label) in ChannelOptions())
                                    {
                                        <option value="@key">@label</option>
                                    }
                                </select>
                                @if (row.Channel.HasRecLatch())
                                {
                                    <input type="checkbox" class="audio-cell-check" title="@T["audioSettings.mixer.mappings.latchTitle"]" @bind="row.UseLatch" />
                                }
                                else
                                {
                                    <input type="checkbox" class="audio-cell-check" checked disabled
                                           title="@T["audioSettings.mixer.mappings.noLatchTitle"]" />
                                }
                                <span class="mono" title="@T["audioSettings.mixer.mappings.liveTitle"]">@LiveText(live)</span>
                                <button type="button" class="remove-btn" title="@T["audioSettings.mixer.mappings.remove"]" aria-label="@T["audioSettings.mixer.mappings.remove"]"
                                        @onclick="() => _mixer.Value.Mappings.RemoveAt(index)">×</button>
                            </div>
                        }
                    }
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary" @onclick="AddMixerMapping">@T["audioSettings.mixer.mappings.add"]</button>
                    </div>
                    @foreach (var shared in MixerSharedTargets())
                    {
                        <div class="field-hint field-hint-warn" style="margin-top:8px; max-width:640px;">
                            @T["audioSettings.mixer.mappings.sharedTarget", MixerTargetLabel(shared.Agent, shared.IsBus, shared.Index), string.Join(", ", shared.Owners)]
                        </div>
                    }
                    <div class="field-hint" style="margin-top:8px; max-width:640px;">
                        @T["audioSettings.mixer.mappings.note"]
                        <details class="field-more">
                            <summary>@T["audioSettings.mixer.mappings.more"]</summary>
                            <span class="field-more-body">
                                @T["audioSettings.mixer.mappings.moreBody"]
                            </span>
                        </details>
                    </div>
                </Section>

            }
            else
            {
                <Section Title="@T["audioSettings.housekeeping.title"]" Hint="@T["audioSettings.housekeeping.hint"]" Advanced="true">
                    <OptionField Draft="_audio" For="o => o.RunIntervalMs" />
                    <OptionField Draft="_audio" For="o => o.ProcessCheckIntervalMs" />
                    <OptionField Draft="_audio" For="o => o.ProcessStartupDelayMs" />
                    <OptionField Draft="_audio" For="o => o.DeviceCheckIntervalMs" />
                    <OptionField Draft="_audio" For="o => o.ProcessMaxSearchCount" />
                </Section>
            }

@* Windowed-process suggestions for the mapping Binary inputs (Prosim2GSX parity) — the
   Blazor circuit runs on the sim PC, so a plain server-side enumeration suffices. *@
<datalist id="audio-process-suggestions">
    @foreach (var name in _processSuggestions)
    {
        <option value="@name" />
    }
</datalist>

@* Render-device names for the mapping Device filter and the blacklist — both are
   START-of-friendly-name matches, so picking a full name from the list always works. *@
<datalist id="audio-device-suggestions">
    @foreach (var name in _deviceSuggestions)
    {
        <option value="@name" />
    }
</datalist>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    [Parameter]
    public string? Section { get; set; }

    private string CurrentSection => SettingsNav.ResolveSection(SettingsNav.AudioSections, Section);

    private bool _debugDumpBusy;
    private string? _debugDumpResult;

    private async Task WriteDebugDump()
    {
        _debugDumpBusy = true;
        _debugDumpResult = null;
        try
        {
            var path = await AudioControl.WriteDebugDumpAsync();
            _debugDumpResult = path is not null ? T["audioSettings.coreAudio.debugDump.written", path].Value : T["audioSettings.coreAudio.debugDump.failed"].Value;
        }
        finally
        {
            _debugDumpBusy = false;
        }
    }

    private OptionsDraft<AudioOptions> _audio = default!;
    private IReadOnlyList<VoiceMeeterTargetView> _vmTargets = [];

    // ---- Remote mixer (VoicemeeterBridge, 2026-10-10; one block per agent since #178) ----

    private OptionsDraft<MixerOptions> _mixer = default!;
    private MixerStatusSnapshot _mixerLive = MixerStatusSnapshot.Empty;
    private bool _mixerLifted;
    private readonly HashSet<int> _agentTestBusy = [];
    private readonly Dictionary<int, MixerProbeResult> _agentTestResults = [];
    private readonly HashSet<int> _agentReloadBusy = [];
    private readonly Dictionary<int, string> _agentStripsText = [];
    private readonly Dictionary<int, string> _agentBusesText = [];
    /// <summary>The agent names as last seen, so a rename can re-point the rows that used the old one.</summary>
    private readonly List<string> _agentNames = [];
    private readonly List<IMixerClient> _channelWatched = [];

    private string AgentTitle(MixerAgentOptions agent) =>
        string.IsNullOrWhiteSpace(agent.Name) ? T["audioSettings.mixer.agent.untitled"].Value : agent.Name.Trim();

    private async Task TestAgent(int index)
    {
        if (index >= _mixer.Value.Agents.Count)
        {
            return;
        }

        var agent = _mixer.Value.Agents[index];
        _agentTestBusy.Add(index);
        _agentTestResults.Remove(index);
        try
        {
            _agentTestResults[index] = await Mixers.ProbeAsync(agent.Host.Trim(), agent.Port, agent.Token);
        }
        finally
        {
            _agentTestBusy.Remove(index);
        }
    }

    private void AddAgent()
    {
        var agents = _mixer.Value.Agents;
        var name = $"PC{agents.Count + 1}";
        while (agents.Any(a => MixerAgentOptions.SameName(a.Name, name)))
        {
            name += "x";
        }

        agents.Add(new MixerAgentOptions { Name = name });
        SyncAgentState();
    }

    private void RemoveAgent(int index)
    {
        if (index < _mixer.Value.Agents.Count)
        {
            _mixer.Value.Agents.RemoveAt(index);
        }

        _agentTestResults.Clear();
        SyncAgentState();
    }

    /// <summary>A renamed agent takes its mapping rows along (they store the name).</summary>
    private void OnAgentRenamed(int index)
    {
        if (index >= _mixer.Value.Agents.Count || index >= _agentNames.Count)
        {
            return;
        }

        var previous = _agentNames[index];
        var current = _mixer.Value.Agents[index].Name.Trim();
        if (!MixerAgentOptions.SameName(previous, current))
        {
            AudioPageRules.RenameAgent(_mixer.Value, previous, current);
            _agentNames[index] = current;
        }
    }

    private string ChannelSummary(IMixerClient? client, MixerAgentStatus? live) => client is { Channels.Count: > 0 }
        ? T["audioSettings.mixer.panel.summary", client.Channels.Count(c => !c.IsBus), client.Channels.Count(c => c.IsBus)].Value
        : live?.State == MixerConnectionState.Connected
            ? T["audioSettings.mixer.panel.summaryReading"].Value
            : T["audioSettings.mixer.panel.summaryOffline"].Value;

    /// <summary>The name a row's agent resolves to in the draft (empty = the first agent), so
    /// the target picker and the shared-target check speak of the same PC.</summary>
    private string ResolvedAgentName(string? rowAgent)
    {
        var agents = _mixer.Value.Agents;
        if (string.IsNullOrWhiteSpace(rowAgent))
        {
            return agents.Count > 0 ? agents[0].Name.Trim() : "";
        }

        return agents.FirstOrDefault(a => MixerAgentOptions.SameName(a.Name, rowAgent))?.Name.Trim() ?? rowAgent.Trim();
    }

    /// <summary>Targets to offer: every agent's remote inventory when known, else Potato-sized
    /// generic numbers (8 strips / 8 buses) so a mapping can be prepared before the first
    /// connect. With one agent the entries read exactly as before #178; with several they
    /// carry the PC's name ("PC1 · Strip 3 — vPilot").</summary>
    private IReadOnlyList<(string Key, string Label)> ChannelOptions()
    {
        var options = new List<(string, string)>();
        var agents = _mixer.Value.Agents;
        if (agents.Count == 0)
        {
            AddGenericTargets(options, "", null, "");
            return options;
        }

        var prefixed = agents.Count > 1;
        foreach (var agent in agents)
        {
            var name = agent.Name.Trim();
            var prefix = prefixed ? $"{AgentTitle(agent)} · " : "";
            var client = Mixers.Find(name);
            var kind = _mixerLive.Agent(name)?.Voicemeeter.Kind;
            if (client is { Channels.Count: > 0 })
            {
                foreach (var channel in client.Channels)
                {
                    options.Add((TargetKey(name, channel.IsBus, channel.Index), prefix + channel.DisplayName(kind)));
                }
            }
            else
            {
                AddGenericTargets(options, name, kind, prefix);
            }
        }

        return options;
    }

    private static void AddGenericTargets(List<(string, string)> options, string agent, string? kind, string prefix)
    {
        for (var i = 0; i < MixerChannelNames.MaxIndex; i++)
        {
            options.Add((TargetKey(agent, false, i), prefix + MixerChannelNames.Name(false, i, kind)));
        }

        for (var i = 0; i < MixerChannelNames.MaxIndex; i++)
        {
            options.Add((TargetKey(agent, true, i), prefix + MixerChannelNames.Name(true, i, kind)));
        }
    }

    /// <summary>"PC1|strip:2" — the agent name first; it is split at the last bar, so a name
    /// may contain one.</summary>
    private static string TargetKey(string agent, bool isBus, int index) => $"{agent}|{(isBus ? "bus" : "strip")}:{index}";

    private string TargetKey(MixerMapping row) => TargetKey(ResolvedAgentName(row.Agent), row.IsBus, row.StripIndex);

    private static void SetTarget(MixerMapping row, string? key)
    {
        var text = key ?? "";
        var bar = text.LastIndexOf('|');
        if (bar < 0)
        {
            return;
        }

        var parts = text[(bar + 1)..].Split(':');
        if (parts.Length == 2 && int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var index))
        {
            row.Agent = text[..bar];
            row.IsBus = parts[0] == "bus";
            row.StripIndex = index;
        }
    }

    /// <summary>The words for a target in the warning: the PC (when more than one) and the
    /// strip/bus by its remote label when known.</summary>
    private string MixerTargetLabel(string agent, bool isBus, int index)
    {
        var client = Mixers.Find(agent);
        var kind = _mixerLive.Agent(agent)?.Voicemeeter.Kind;
        var channel = client?.Channels.FirstOrDefault(c => c.IsBus == isBus && c.Index == index);
        var name = channel?.DisplayName(kind) ?? MixerChannelNames.Name(isBus, index, kind);
        return _mixer.Value.Agents.Count > 1 && agent.Length > 0 ? $"{agent} · {name}" : name;
    }

    /// <summary>#179: the strips/buses two enabled rows drive on the same PC.</summary>
    private IReadOnlyList<AudioPageRules.SharedTarget> MixerSharedTargets() =>
        AudioPageRules.SharedTargets(_mixer.Value.Mappings
            .Where(m => m.Enabled)
            .Select(m => new AudioPageRules.TargetRow(
                ResolvedAgentName(m.Agent), m.IsBus, m.StripIndex,
                $"{AudioPresentation.AcpLabel(m.Acp)} {AudioPresentation.ChannelLabel(m.Channel)}")));

    /// <summary>#179, local backend: the same check over the active panels' VoiceMeeter rows.</summary>
    private IReadOnlyList<AudioPageRules.SharedTarget> VoiceMeeterSharedTargets() =>
        AudioPageRules.SharedTargets(_audio.Value.VoiceMeeterMappings
            .Where(kv => Enum.TryParse<AcpSide>(kv.Key, ignoreCase: true, out var acp) && _audio.Value.ActiveAcps.Contains(acp))
            .SelectMany(kv => kv.Value.Select(m => new AudioPageRules.TargetRow(
                "", m.IsBus, m.StripIndex,
                $"{AudioPresentation.AcpLabel(Enum.Parse<AcpSide>(kv.Key, ignoreCase: true))} {AudioPresentation.ChannelLabel(m.Channel)}"))));

    private string VoiceMeeterTargetLabel(bool isBus, int index)
    {
        var wanted = $"{(isBus ? "bus" : "strip")}:{index}";
        return TargetOptions().FirstOrDefault(o => o.Key == wanted).Label ?? $"{(isBus ? "Bus" : "Strip")} {index + 1}";
    }

    /// <summary>A new row takes the first captain channel that is not mapped yet, onto the
    /// first strip of the first agent, Latch on — so nothing starts blank (owner feedback 2026-10-10).</summary>
    private void AddMixerMapping()
    {
        var taken = _mixer.Value.Mappings.Where(m => m.Acp == AcpSide.Captain).Select(m => m.Channel).ToHashSet();
        var channel = Enum.GetValues<AudioChannel>().FirstOrDefault(c => c.ExistsOn(AcpSide.Captain) && !taken.Contains(c), AudioChannel.Vhf1);
        var agent = _mixer.Value.Agents.Count > 0 ? _mixer.Value.Agents[0].Name.Trim() : "";
        _mixer.Value.Mappings.Add(new MixerMapping { Acp = AcpSide.Captain, Channel = channel, Agent = agent, StripIndex = 0, IsBus = false, UseLatch = true });
    }

    private string LiveText(MixerMappingStatus? live)
    {
        if (live is null || (live.GainDb is null && live.Muted is null))
        {
            return "—";
        }

        var gain = live.GainDb is { } g ? g.ToString("0.0", CultureInfo.InvariantCulture) + " dB" : "—";
        var mute = live.Muted is { } m ? " · " + (m ? T["audioSettings.mixer.mappings.liveMuted"].Value : T["audioSettings.mixer.mappings.liveOpen"].Value) : "";
        var result = live.LastResult is { } r && r != "ok" ? $" ({r})" : "";
        return gain + mute + result;
    }

    /// <summary>Re-reads the per-agent page state (names, panel text boxes) from the draft —
    /// after load, discard, add and remove.</summary>
    private void SyncAgentState()
    {
        _agentNames.Clear();
        _agentStripsText.Clear();
        _agentBusesText.Clear();
        for (var i = 0; i < _mixer.Value.Agents.Count; i++)
        {
            var agent = _mixer.Value.Agents[i];
            _agentNames.Add(agent.Name.Trim());
            _agentStripsText[i] = AudioPageRules.OneBasedText(agent.PanelStrips);
            _agentBusesText[i] = AudioPageRules.OneBasedText(agent.PanelBuses);
        }
    }

    private static string PanelText(Dictionary<int, string> texts, int index) => texts.TryGetValue(index, out var text) ? text : "";

    private void SetAgentStrips(int index, string text)
    {
        _agentStripsText[index] = text;
        if (index < _mixer.Value.Agents.Count)
        {
            _mixer.Value.Agents[index].PanelStrips = AudioPageRules.ParseOneBasedList(text);
        }
    }

    private void SetAgentBuses(int index, string text)
    {
        _agentBusesText[index] = text;
        if (index < _mixer.Value.Agents.Count)
        {
            _mixer.Value.Agents[index].PanelBuses = AudioPageRules.ParseOneBasedList(text);
        }
    }

    private static bool IsPanelChannel(MixerAgentOptions agent, MixerChannel channel) =>
        channel.IsBus ? agent.PanelBuses.Contains(channel.Index) : agent.PanelStrips.Contains(channel.Index);

    private void SetPanelChannel(int index, MixerChannel channel, bool picked)
    {
        if (index >= _mixer.Value.Agents.Count)
        {
            return;
        }

        var agent = _mixer.Value.Agents[index];
        var list = channel.IsBus ? agent.PanelBuses : agent.PanelStrips;
        list.Remove(channel.Index);
        if (picked)
        {
            list.Add(channel.Index);
            list.Sort();
        }

        _agentStripsText[index] = AudioPageRules.OneBasedText(agent.PanelStrips);
        _agentBusesText[index] = AudioPageRules.OneBasedText(agent.PanelBuses);
    }

    private async Task ReloadAgentChannels(int index)
    {
        if (index >= _mixer.Value.Agents.Count)
        {
            return;
        }

        var client = Mixers.Find(_mixer.Value.Agents[index].Name);
        if (client is null)
        {
            return;
        }

        _agentReloadBusy.Add(index);
        try
        {
            await client.RefreshChannelsAsync();
        }
        finally
        {
            _agentReloadBusy.Remove(index);
        }
    }

    /// <summary>The strip/bus names arrive after each connect (and on Reload) — re-render
    /// then. The client set changes with the options, so the handlers follow it.</summary>
    private void AttachChannelWatches()
    {
        foreach (var client in _channelWatched)
        {
            client.ChannelsChanged -= OnClientChannelsChanged;
        }

        _channelWatched.Clear();
        foreach (var client in Mixers.All)
        {
            client.ChannelsChanged += OnClientChannelsChanged;
            _channelWatched.Add(client);
        }
    }

    private void OnClientChannelsChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        foreach (var client in _channelWatched)
        {
            client.ChannelsChanged -= OnClientChannelsChanged;
        }

        _channelWatched.Clear();
        base.Dispose();
    }

    private string MixerStateLabel(MixerAgentStatus? live) => live?.State switch
    {
        MixerConnectionState.Connected => live.Voicemeeter.Connected
            ? T["audioSettings.mixer.state.connected", live.Voicemeeter.Kind ?? "", live.Voicemeeter.Version ?? ""].Value
            : T["audioSettings.mixer.state.connectedNoVoicemeeter"].Value,
        MixerConnectionState.Connecting => T["audioSettings.mixer.state.connecting"].Value,
        MixerConnectionState.Disconnected => live.LastError is { Length: > 0 } error
            ? T["audioSettings.mixer.state.unreachable", error].Value
            : T["audioSettings.mixer.state.unreachableRetrying"].Value,
        _ => live?.LastError == "no host configured" ? T["audioSettings.mixer.state.offNoHost"].Value : T["audioSettings.mixer.state.off"].Value,
    };

    private static string MixerStateTone(MixerConnectionState state) => state switch
    {
        MixerConnectionState.Connected => "tone-ok",
        MixerConnectionState.Connecting => "tone-active",
        MixerConnectionState.Disconnected => "tone-warn",
        _ => "tone-neutral",
    };

    private IReadOnlyList<string> _processSuggestions = [];
    private IReadOnlyList<string> _deviceSuggestions = [];

    protected override void OnInitialized()
    {
        _audio = Draft(AudioMonitor);
        _mixer = Draft(MixerMonitor);
        AudioPageRules.NormalizeVoiceMeeterAcpNames(_audio.Value);
        // Pre-#178 settings: the single host/port/token becomes agent block 1 in the draft
        // (the draft is dirty from here, so the pilot sees a Save).
        _mixerLifted = AudioPageRules.MigrateLegacyAgent(_mixer.Value);
        SyncAgentState();
        Watch(MixerStatus, snapshot => _mixerLive = snapshot);
        WatchChanged(h => Mixers.ClientsChanged += h, h => Mixers.ClientsChanged -= h, AttachChannelWatches);
        ReloadTargets();
        LoadProcessSuggestions();
        _deviceSuggestions = DeviceCatalog.GetRenderDeviceNames();
    }

    private void LoadProcessSuggestions()
    {
        try
        {
            var processes = System.Diagnostics.Process.GetProcesses();
            try
            {
                // Windowed processes only — the audio-session candidates a user would map.
                _processSuggestions = processes
                    .Where(p => p.MainWindowHandle != IntPtr.Zero)
                    .Select(p => p.ProcessName)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            finally
            {
                foreach (var process in processes)
                {
                    process.Dispose();
                }
            }
        }
        catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
        {
            // Suggestions are a convenience — an enumeration failure just leaves the list empty.
        }
    }

    private List<VoiceMeeterTargetMapping> VmList(AcpSide acp)
    {
        var name = AudioPageRules.AcpName(acp);
        if (!_audio.Value.VoiceMeeterMappings.TryGetValue(name, out var list))
        {
            list = [];
            _audio.Value.VoiceMeeterMappings[name] = list;
        }
        return list;
    }

    private void SetAcpActive(AcpSide acp, bool active)
    {
        _audio.Value.ActiveAcps.Remove(acp);
        if (active)
        {
            _audio.Value.ActiveAcps.Add(acp);
        }
    }

    private void ReloadTargets()
    {
        try
        {
            _vmTargets = AudioControl.GetVoiceMeeterTargets();
        }
        catch (Exception)
        {
            _vmTargets = [];
        }
    }

    private static string TargetKey(VoiceMeeterTargetMapping mapping) =>
        $"{(mapping.IsBus ? "bus" : "strip")}:{mapping.StripIndex}";

    private static void SetTarget(VoiceMeeterTargetMapping mapping, string? key)
    {
        var parts = (key ?? "").Split(':');
        if (parts.Length == 2 && int.TryParse(parts[1], out var index))
        {
            mapping.IsBus = parts[0] == "bus";
            mapping.StripIndex = index;
        }
    }

    private IReadOnlyList<(string Key, string Label)> TargetOptions()
    {
        var options = new List<(string, string)>();
        if (_vmTargets.Count > 0)
        {
            foreach (var target in _vmTargets)
            {
                var kind = target.IsBus ? "Bus" : "Strip";
                var label = string.IsNullOrWhiteSpace(target.Label) ? "" : $" — {target.Label}";
                options.Add(($"{(target.IsBus ? "bus" : "strip")}:{target.Index}", $"{kind} {target.Index + 1}{label}"));
            }
            return options;
        }

        // VoiceMeeter unreachable: offer the Potato-sized generic range (8 strips / 8 buses).
        for (var i = 0; i < 8; i++)
        {
            options.Add(($"strip:{i}", $"Strip {i + 1}"));
        }
        for (var i = 0; i < 8; i++)
        {
            options.Add(($"bus:{i}", $"Bus {i + 1}"));
        }
        return options;
    }

    /// <summary>The list editors' pruning (C3): the per-property trims ran on the drafts already.</summary>
    protected override void OnBeforeSave() => AudioPageRules.BeforeSave(_audio.Value, _mixer.Value);

    // A discard re-clones from the live options, so the name normalization must run again.
    protected override void OnDiscarded()
    {
        AudioPageRules.NormalizeVoiceMeeterAcpNames(_audio.Value);
        _mixerLifted = AudioPageRules.MigrateLegacyAgent(_mixer.Value);
        _agentTestResults.Clear();
        SyncAgentState();
    }

    protected override void OnAfterSave()
    {
        _mixerLifted = false;
        SyncAgentState();
    }
}
