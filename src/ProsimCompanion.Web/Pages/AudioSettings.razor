@page "/settings/audio/{Section?}"
@page "/audio"
@layout SettingsLayout
@using System.Globalization
@using System.Reflection
@using System.Text.Json
@using ProsimCompanion.Core.Aircraft
@inherits SettingsPageBase
@inject IOptionsMonitor<AudioOptions> AudioMonitor
@inject IAudioControl AudioControl
@inject IAudioDeviceCatalog DeviceCatalog
@inject IOptionsMonitor<MixerOptions> MixerMonitor
@inject IMixerClient Mixer
@inject MixerStatusStore MixerStatus

<PageTitle>Audio Control — ProsimCompanion</PageTitle>
<h1 class="sr-only">Audio Control</h1>

@* Sections are URL-driven (settings/audio/{section}, ADR-0010); the rail lives in
   SettingsLayout. The audio master switch moved to Setup with the other pillar switches. *@

            @if (CurrentSection == "status")
            {
                <AudioStatusPanel />
            }
            else if (CurrentSection == "general")
            {
                <Section Title="Volume Control" Hint="Audio panel knobs and latches set app volumes">
                    <SelectField Label="Backend" Hint="Windows app volumes, or VoiceMeeter strips and buses." More="Switching applies live. Windows volumes are restored, VoiceMeeter targets reset to 0 dB." Options="BackendOptions"
                                 @bind-Value="BackendKey" />
                    <BoolField Label="Disable ProSim native audio control" Hint="Turn off ProSim's own Windows volume control so the two never fight."
                               @bind-Value="_audio.Value.DisableProsimNativeAudio" />
                </Section>
            }
            else if (CurrentSection == "coreaudio")
            {
                <Section Title="CoreAudio" Hint="Windows per-app volumes">
                    <SelectField Label="ACP" Hint="Which audio control panel drives the app volumes." Options="AcpOptions"
                                 @bind-Value="CoreAudioAcpKey" />
                    <AdvancedFields Label="Troubleshooting filters hidden">
                        <SelectField Label="Device-filter DataFlow" Hint="Troubleshooting only. Change when asked." Options="DeviceFlowOptions"
                                     @bind-Value="_audio.Value.DeviceFilterFlow" />
                        <SelectField Label="Device-filter State" Hint="Troubleshooting only. Change when asked." Options="DeviceStateOptions"
                                     @bind-Value="_audio.Value.DeviceFilterState" />
                        <div style="margin-top:8px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                            <button type="button" class="btn secondary" disabled="@_debugDumpBusy" @onclick="WriteDebugDump">
                                @(_debugDumpBusy ? "Writing…" : "Write Debug Info")
                            </button>
                            @if (_debugDumpResult is not null)
                            {
                                <span class="field-hint">@_debugDumpResult</span>
                            }
                        </div>
                    </AdvancedFields>
                </Section>

                <Section Title="App Mappings" Hint="A channel may drive several processes">
                    @if (_audio.Value.AppMappings.Count == 0)
                    {
                        <div class="empty">No app mappings configured.</div>
                    }
                    else
                    {
                        <div class="audio-map-header">
                            <span>Channel</span><span>Process</span><span>Device</span>
                            <span>Latch</span><span>Active</span><span></span>
                        </div>
                        @for (var i = 0; i < _audio.Value.AppMappings.Count; i++)
                        {
                            var index = i;
                            var row = _audio.Value.AppMappings[index];
                            <div class="audio-map-row">
                                <select class="cell-select" @bind="row.Channel">
                                    @foreach (var channel in Enum.GetValues<AudioChannel>())
                                    {
                                        <option value="@channel">@AudioPresentation.ChannelLabel(channel)</option>
                                    }
                                </select>
                                <input class="cell-input" placeholder="Process name (no .exe)" list="audio-process-suggestions" @bind="row.Binary" />
                                <input class="cell-input" placeholder="All devices" list="audio-device-suggestions" @bind="row.Device" />
                                <input type="checkbox" class="audio-cell-check" title="Drive mute from the REC latch"
                                       @bind="row.UseLatch" />
                                <input type="checkbox" class="audio-cell-check" title="Only control active sessions"
                                       @bind="row.OnlyActive" />
                                <button type="button" class="remove-btn" title="Remove" aria-label="Remove"
                                        @onclick="() => _audio.Value.AppMappings.RemoveAt(index)">×</button>
                            </div>
                        }
                    }
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary"
                                @onclick="() => _audio.Value.AppMappings.Add(new AudioAppMapping())">Add mapping</button>
                    </div>
                    <div class="field-hint" style="margin-top:8px; max-width:640px;">
                        Process name without .exe, for example vPilot.
                        <details class="field-more">
                            <summary>More</summary>
                            <span class="field-more-body">
                                Latch off: mute is never written, so an app muted elsewhere stays muted.
                                An app run as administrator needs ProsimCompanion run as administrator
                                too; the Status section flags them. LOUDSPEAKER is the cockpit
                                loudspeaker dial (captain and first officer only); its Latch tick
                                mutes the app with the dial fully down.
                            </span>
                        </details>
                    </div>
                </Section>

                <Section Title="Device Blacklist" Hint="Matched on the start of the device name">
                    <div class="list-editor">
                        @for (var i = 0; i < _audio.Value.DeviceBlacklist.Count; i++)
                        {
                            var index = i;
                            <div class="list-row">
                                <input class="cell-input" placeholder="Device friendly name prefix"
                                       list="audio-device-suggestions" @bind="_audio.Value.DeviceBlacklist[index]" />
                                <button type="button" class="remove-btn" title="Remove" aria-label="Remove"
                                        @onclick="() => _audio.Value.DeviceBlacklist.RemoveAt(index)">×</button>
                            </div>
                        }
                    </div>
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary"
                                @onclick="() => _audio.Value.DeviceBlacklist.Add(string.Empty)">Add device</button>
                    </div>
                </Section>
            }
            else if (CurrentSection == "voicemeeter")
            {
                <Section Title="VoiceMeeter" Hint="Strips and buses through VoiceMeeter's remote API">
                    <AdvancedFields>
                        <TextField Label="VoicemeeterRemote64.dll path" Hint="Empty finds the installed VoiceMeeter by itself. Set only for an unusual install folder."
                                   @bind-Value="_audio.Value.VoiceMeeterDllPath" />
                    </AdvancedFields>
                    <div style="margin:8px 0;">
                        <button type="button" class="btn secondary" @onclick="ReloadTargets">Reload strips</button>
                        <span class="field-hint" style="margin-left:8px;">
                            @(_vmTargets.Count > 0
                                ? $"{_vmTargets.Count(t => !t.IsBus)} strips / {_vmTargets.Count(t => t.IsBus)} buses found"
                                : "VoiceMeeter not reachable — generic strip/bus numbers shown")
                        </span>
                    </div>
                </Section>

                @foreach (var acp in Enum.GetValues<AcpSide>())
                {
                    <Section Title="@($"{AudioPresentation.AcpLabel(acp)} Mappings")">
                        <BoolField Label="@($"Drive targets from the {AudioPresentation.AcpLabel(acp)} ACP")"
                                   Value="_audio.Value.ActiveAcps.Contains(acp)"
                                   ValueChanged="active => SetAcpActive(acp, active)" />
                        @{ var list = VmList(acp); }
                        @if (list.Count > 0)
                        {
                            <div class="audio-vm-header">
                                <span>Channel</span><span>Target</span><span>Latch</span><span></span>
                            </div>
                            @for (var i = 0; i < list.Count; i++)
                            {
                                var index = i;
                                var row = list[index];
                                <div class="audio-vm-row">
                                    <select class="cell-select" @bind="row.Channel">
                                        @foreach (var channel in Enum.GetValues<AudioChannel>())
                                        {
                                            @* The observer has no loudspeaker dial. *@
                                            @if (channel.ExistsOn(acp))
                                            {
                                                <option value="@channel">@AudioPresentation.ChannelLabel(channel)</option>
                                            }
                                        }
                                    </select>
                                    <select class="cell-select" value="@TargetKey(row)"
                                            @onchange="e => SetTarget(row, e.Value as string)">
                                        @foreach (var (key, label) in TargetOptions())
                                        {
                                            <option value="@key">@label</option>
                                        }
                                    </select>
                                    @if (row.Channel.HasRecLatch())
                                    {
                                        <input type="checkbox" class="audio-cell-check"
                                               title="Drive mute from the REC latch" @bind="row.UseLatch" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="audio-cell-check" checked disabled
                                               title="No REC latch on this dial. Fully down always mutes the target." />
                                    }
                                    <button type="button" class="remove-btn" title="Remove" aria-label="Remove"
                                            @onclick="() => list.RemoveAt(index)">×</button>
                                </div>
                            }
                        }
                        <div style="margin-top:8px;">
                            <button type="button" class="btn secondary"
                                    @onclick="() => VmList(acp).Add(new VoiceMeeterTargetMapping())">Add mapping</button>
                        </div>
                    </Section>
                }

                <div class="field-hint" style="max-width:640px;">
                    A channel may appear once per panel. A strip or bus may belong to one panel only.
                    <details class="field-more">
                        <summary>More</summary>
                        <span class="field-more-body">
                            Conflicting saves fall back to the captain's panel until fixed; the Status
                            section shows why. Knob travel maps to −60 dB … +12 dB; 0 dB sits near 83 %.
                        </span>
                    </details>
                </div>
                <div class="field-hint" style="max-width:640px; margin-top:8px;">
                    LOUDSPEAKER is the cockpit loudspeaker dial, on the captain's and first officer's lists.
                    <details class="field-more">
                        <summary>More</summary>
                        <span class="field-more-body">
                            Map it to the strip or bus that feeds your cockpit speakers. The dial has
                            no REC latch: fully down mutes the target. Manual chapter 8 (Loudspeaker
                            dial) shows the VoiceMeeter wiring that puts the headset sound on the
                            speakers.
                        </span>
                    </details>
                </div>
            }
            else if (CurrentSection == "mixer")
            {
                <Section Title="Remote Mixer" Hint="Voicemeeter on another PC, through the VoicemeeterBridge agent">
                    <BoolField Label="Enable remote mixer" Hint="Connects to the agent and drives the mappings below. Off opens no connection."
                               More="The local VoiceMeeter backend above drives the VoiceMeeter on this PC. This card drives a VoiceMeeter on another PC, for example the one running vPilot. Setup for both PCs: docs/integrations/voicemeeter-bridge.md."
                               @bind-Value="_mixer.Value.Enabled" />
                    <TextField Label="Host" Hint="Name or IP address of the PC running VoicemeeterBridge." Placeholder="192.168.1.20"
                               @bind-Value="_mixer.Value.Host" />
                    <NumberField Label="Port" Hint="The agent's port. 5088 unless you changed it there." Min="1" Max="65535"
                                 @bind-Value="_mixer.Value.Port" Default="_mixer.Defaults.Port" />
                    <TextField Label="Token" Hint="From the agent's tray menu, Copy token. Stored encrypted, never logged." Password="true"
                               @bind-Value="_mixer.Value.Token" />
                    <SecretUnreadableHint Path="mixer:token" />
                    <div class="row-actions" style="margin-top:8px; flex-wrap:wrap;">
                        <button type="button" class="btn secondary" disabled="@_mixerTestBusy" @onclick="TestMixer"
                                title="Open a connection with the values above, saved or not, and read the agent's welcome.">
                            @(_mixerTestBusy ? "Testing…" : "Test connection")
                        </button>
                        @if (_mixerTestResult is { } test)
                        {
                            <span class="pill @(test.Ok ? "tone-ok" : "tone-bad")">@test.Message</span>
                        }
                        <span class="pill @MixerStateTone(_mixerLive.State)" title="Live state of the saved connection">
                            @MixerStateLabel(_mixerLive)
                        </span>
                    </div>
                    <AdvancedFields>
                        <NumberField Label="Reconnect delay" Hint="First retry after a drop. Doubles up to the maximum." Suffix="ms" Min="500"
                                     @bind-Value="_mixer.Value.ReconnectDelayMs" Default="_mixer.Defaults.ReconnectDelayMs" />
                        <NumberField Label="Reconnect maximum" Suffix="ms" Min="1000"
                                     @bind-Value="_mixer.Value.ReconnectMaxDelayMs" Default="_mixer.Defaults.ReconnectMaxDelayMs" />
                        <NumberField Label="Write timeout" Hint="How long a write waits for the agent's answer." Suffix="ms" Min="250"
                                     @bind-Value="_mixer.Value.SetTimeoutMs" Default="_mixer.Defaults.SetTimeoutMs" />
                    </AdvancedFields>
                </Section>

                <Section Title="Status Panel" Hint="Which strips and buses the Status section shows, with mute buttons">
                    <TextField Label="Strips" Hint="Strip numbers as Voicemeeter shows them (1 = first), comma separated. Example: 1, 2, 3"
                               Value="@_mixerStripsText" ValueChanged="SetMixerStrips" />
                    <TextField Label="Buses" Hint="Bus numbers (1 = A1), comma separated. Example: 1, 4"
                               Value="@_mixerBusesText" ValueChanged="SetMixerBuses" />
                </Section>

                <Section Title="Mappings" Hint="A ProSim value drives one Voicemeeter parameter on the mixer PC">
                    @if (_mixer.Value.Mappings.Count == 0)
                    {
                        <div class="empty">No mappings yet. Add a knob or a latch below.</div>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table mixer-map-table">
                                <thead>
                                    <tr>
                                        <th title="Off keeps the row without using it">On</th>
                                        <th>ProSim source</th>
                                        <th>Parameter</th>
                                        <th>Type</th>
                                        <th title="Input value that maps to the minimum (level) — unused for a toggle">In min</th>
                                        <th title="Input value that maps to the maximum (level) — unused for a toggle">In max</th>
                                        <th title="Gain sent at the input minimum (level)">Out min dB</th>
                                        <th title="Gain sent at the input maximum (level)">Out max dB</th>
                                        <th title="Toggle: input at or above this sends 1">Threshold</th>
                                        <th title="Flip the result. A REC latch (1 = unmuted) driving a Mute parameter needs this.">Invert</th>
                                        <th>Last</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < _mixer.Value.Mappings.Count; i++)
                                    {
                                        var index = i;
                                        var row = _mixer.Value.Mappings[index];
                                        var isToggle = row.Kind == MixerMappingKind.Toggle;
                                        var live = _mixerLive.Mappings.FirstOrDefault(m => m.Source == row.Source && m.Parameter == row.Parameter);
                                        <tr>
                                            <td><input type="checkbox" class="audio-cell-check" @bind="row.Enabled" /></td>
                                            <td><input class="cell-input" style="min-width:230px;" placeholder="system.analog.A_ASP_VHF_1_VOLUME" list="mixer-source-suggestions" @bind="row.Source" /></td>
                                            <td><input class="cell-input" style="min-width:118px;" placeholder="Strip[2].Gain" @bind="row.Parameter" /></td>
                                            <td>
                                                <select class="cell-select" style="min-width:92px;" @bind="row.Kind">
                                                    <option value="@MixerMappingKind.Level">Level</option>
                                                    <option value="@MixerMappingKind.Toggle">Toggle</option>
                                                </select>
                                            </td>
                                            <td><input class="cell-input" type="number" step="any" style="width:68px;" disabled="@isToggle" @bind="row.InputMin" /></td>
                                            <td><input class="cell-input" type="number" step="any" style="width:68px;" disabled="@isToggle" @bind="row.InputMax" /></td>
                                            <td><input class="cell-input" type="number" step="any" style="width:68px;" disabled="@isToggle" @bind="row.OutputMinDb" /></td>
                                            <td><input class="cell-input" type="number" step="any" style="width:68px;" disabled="@isToggle" @bind="row.OutputMaxDb" /></td>
                                            <td><input class="cell-input" type="number" step="any" style="width:68px;" disabled="@(!isToggle)" @bind="row.Threshold" /></td>
                                            <td><input type="checkbox" class="audio-cell-check" @bind="row.Invert" /></td>
                                            <td class="mono" title="Last value in → out, and the agent's answer">
                                                @(live is null ? "—" : $"{Fmt(live.LastInput)} → {Fmt(live.LastOutput)}{(live.LastResult is { } r && r != "ok" ? $" ({r})" : "")}")
                                            </td>
                                            <td>
                                                <button type="button" class="remove-btn" title="Remove" aria-label="Remove"
                                                        @onclick="() => _mixer.Value.Mappings.RemoveAt(index)">×</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="row-actions" style="margin-top:8px; flex-wrap:wrap;">
                        <button type="button" class="btn secondary" @onclick="AddKnobMapping"
                                title="A volume knob (0–1024) onto a gain, −60 dB to +12 dB.">Add knob mapping</button>
                        <button type="button" class="btn secondary" @onclick="AddLatchMapping"
                                title="A REC latch (1 = unmuted) onto a Mute parameter, inverted.">Add latch mapping</button>
                    </div>
                    <div class="field-hint" style="margin-top:8px; max-width:640px;">
                        Source is a ProSim dataref name; the list offers the audio panel knobs and latches.
                        Parameter is a Voicemeeter Remote API name such as Strip[2].Gain or Bus[0].Mute.
                        <details class="field-more">
                            <summary>More</summary>
                            <span class="field-more-body">
                                Level: the input range maps onto the dB range, clamped; Invert runs it the
                                other way. Toggle: input at or above Threshold sends 1, else 0; Invert swaps
                                them — a REC latch reads 1 when open, so a Mute mapping needs Invert on.
                                Writes go out at most 20 times a second per parameter, latest value wins.
                                The knob value goes out whether the audio panel is powered or not. The
                                "Last" column shows the live values once the agent is connected.
                            </span>
                        </details>
                    </div>
                </Section>

                <datalist id="mixer-source-suggestions">
                    @foreach (var (name, label) in MixerSourceSuggestions)
                    {
                        <option value="@name">@label</option>
                    }
                </datalist>
            }
            else
            {
                <Section Title="Housekeeping" Hint="Proven timings. Rarely need changing" Advanced="true">
                    <NumberField Label="Run interval" Hint="Main check. Takes effect after an app restart." Suffix="ms" Min="250"
                                 @bind-Value="_audio.Value.RunIntervalMs"
                                 Default="_audio.Defaults.RunIntervalMs" />
                    <NumberField Label="Process check interval" Suffix="ms" Min="500"
                                 @bind-Value="_audio.Value.ProcessCheckIntervalMs"
                                 Default="_audio.Defaults.ProcessCheckIntervalMs" />
                    <NumberField Label="Process startup grace" Hint="Wait after a mapped app starts before looking for its sound." Suffix="ms" Min="0"
                                 @bind-Value="_audio.Value.ProcessStartupDelayMs"
                                 Default="_audio.Defaults.ProcessStartupDelayMs" />
                    <NumberField Label="Device rescan interval" Suffix="ms" Min="5000"
                                 @bind-Value="_audio.Value.DeviceCheckIntervalMs"
                                 Default="_audio.Defaults.DeviceCheckIntervalMs" />
                    <NumberField Label="Max session searches" Hint="Failed lookups before the devices are scanned again." Min="1"
                                 @bind-Value="_audio.Value.ProcessMaxSearchCount"
                                 Default="_audio.Defaults.ProcessMaxSearchCount" />
                </Section>
            }

@* Windowed-process suggestions for the mapping Binary inputs (Prosim2GSX parity) — the
   Blazor circuit runs on the sim PC, so a plain server-side enumeration suffices. *@
<datalist id="audio-process-suggestions">
    @foreach (var name in _processSuggestions)
    {
        <option value="@name" />
    }
</datalist>

@* Render-device names for the mapping Device filter and the blacklist — both are
   START-of-friendly-name matches, so picking a full name from the list always works. *@
<datalist id="audio-device-suggestions">
    @foreach (var name in _deviceSuggestions)
    {
        <option value="@name" />
    }
</datalist>

<DirtyBar Visible="@BarVisible"
          Message="@(BarMessage ?? "You have unsaved changes")"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    [Parameter]
    public string? Section { get; set; }

    private string CurrentSection => SettingsNav.ResolveSection(SettingsNav.AudioSections, Section);

    private static readonly IReadOnlyList<(string, string)> BackendOptions =
    [
        ("coreAudio", "CoreAudio (Windows app volumes)"),
        ("voiceMeeter", "VoiceMeeter (strips/buses)"),
    ];

    private static readonly IReadOnlyList<(string, string)> AcpOptions =
    [
        ("captain", "Captain (ACP1)"),
        ("firstOfficer", "First Officer (ACP2)"),
        ("observer", "Observer (ACP3)"),
    ];

    private static readonly IReadOnlyList<(string, string)> DeviceFlowOptions =
    [
        ("render", "Render"),
        ("capture", "Capture"),
        ("all", "All"),
    ];

    private static readonly IReadOnlyList<(string, string)> DeviceStateOptions =
    [
        ("active", "Active"),
        ("disabled", "Disabled"),
        ("notPresent", "Not present"),
        ("unplugged", "Unplugged"),
        ("all", "All (mask all)"),
    ];

    private bool _debugDumpBusy;
    private string? _debugDumpResult;

    private async Task WriteDebugDump()
    {
        _debugDumpBusy = true;
        _debugDumpResult = null;
        try
        {
            var path = await AudioControl.WriteDebugDumpAsync();
            _debugDumpResult = path is not null ? $"Written to {path}" : "Dump failed — see the app log";
        }
        finally
        {
            _debugDumpBusy = false;
        }
    }

    private OptionsDraft<AudioOptions> _audio = default!;
    private IReadOnlyList<VoiceMeeterTargetView> _vmTargets = [];

    // ---- Remote mixer (VoicemeeterBridge, 2026-10-10) ----

    private OptionsDraft<MixerOptions> _mixer = default!;
    private MixerStatusSnapshot _mixerLive = MixerStatusSnapshot.Empty;
    private bool _mixerTestBusy;
    private MixerProbeResult? _mixerTestResult;
    private string _mixerStripsText = "";
    private string _mixerBusesText = "";

    /// <summary>The ACP knob / REC-latch / loudspeaker dataref names from the catalog, as the
    /// source datalist: nothing here is invented, the names are the typed constants the
    /// audio pillar already subscribes to.</summary>
    private static readonly IReadOnlyList<(string Name, string Label)> MixerSourceSuggestions = BuildMixerSourceSuggestions();

    private static IReadOnlyList<(string, string)> BuildMixerSourceSuggestions()
    {
        var list = new List<(string, string)>();
        foreach (var field in typeof(ProsimDataRefNames).GetFields(BindingFlags.Public | BindingFlags.Static))
        {
            if (!field.Name.StartsWith("Acp", StringComparison.Ordinal) && !field.Name.StartsWith("MipLoudspeaker", StringComparison.Ordinal))
            {
                continue;
            }

            var value = field.GetValue(null);
            if (value?.GetType().GetProperty("Name")?.GetValue(value) is not string name)
            {
                continue;
            }

            var label = field.Name
                .Replace("Analog", " knob", StringComparison.Ordinal)
                .Replace("Latch", " REC latch", StringComparison.Ordinal)
                .Replace("Acp1", "Captain ", StringComparison.Ordinal)
                .Replace("Acp2", "First Officer ", StringComparison.Ordinal)
                .Replace("Acp3", "Observer ", StringComparison.Ordinal)
                .Replace("MipLoudspeaker", "Loudspeaker ", StringComparison.Ordinal);
            list.Add((name, label));
        }

        return list.OrderBy(entry => entry.Item1, StringComparer.Ordinal).ToList();
    }

    private async Task TestMixer()
    {
        _mixerTestBusy = true;
        _mixerTestResult = null;
        try
        {
            var draft = _mixer.Value;
            _mixerTestResult = await Mixer.ProbeAsync(draft.Host.Trim(), draft.Port, draft.Token);
        }
        finally
        {
            _mixerTestBusy = false;
        }
    }

    private void SyncMixerPanelText()
    {
        _mixerStripsText = string.Join(", ", _mixer.Value.PanelStrips.Select(i => i + 1));
        _mixerBusesText = string.Join(", ", _mixer.Value.PanelBuses.Select(i => i + 1));
    }

    private void SetMixerStrips(string text)
    {
        _mixerStripsText = text;
        _mixer.Value.PanelStrips = ParseOneBasedList(text);
    }

    private void SetMixerBuses(string text)
    {
        _mixerBusesText = text;
        _mixer.Value.PanelBuses = ParseOneBasedList(text);
    }

    /// <summary>"1, 2, 4" (as Voicemeeter numbers them) → [0, 1, 3]; junk is ignored.</summary>
    private static List<int> ParseOneBasedList(string text) =>
        text.Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(part => int.TryParse(part, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n - 1 : -1)
            .Where(n => n >= 0 && n < 64)
            .Distinct()
            .OrderBy(n => n)
            .ToList();

    private void AddKnobMapping() => _mixer.Value.Mappings.Add(new MixerMapping
    {
        Kind = MixerMappingKind.Level,
        InputMin = 0,
        InputMax = 1024,
        OutputMinDb = -60,
        OutputMaxDb = 12,
    });

    private void AddLatchMapping() => _mixer.Value.Mappings.Add(new MixerMapping
    {
        Kind = MixerMappingKind.Toggle,
        Threshold = 0.5,
        Invert = true,
    });

    private static string Fmt(double? value) => value is { } v ? v.ToString("0.#", CultureInfo.InvariantCulture) : "—";

    private static string MixerStateLabel(MixerStatusSnapshot live) => live.State switch
    {
        MixerConnectionState.Connected => live.Voicemeeter.Connected
            ? $"Connected — Voicemeeter {live.Voicemeeter.Kind} {live.Voicemeeter.Version}"
            : "Connected — Voicemeeter not running on the mixer PC",
        MixerConnectionState.Connecting => "Connecting…",
        MixerConnectionState.Disconnected => live.LastError is { Length: > 0 } error ? $"Unreachable — {error}" : "Unreachable — retrying",
        _ => live.Enabled ? "Off — no host" : "Off",
    };

    private static string MixerStateTone(MixerConnectionState state) => state switch
    {
        MixerConnectionState.Connected => "tone-ok",
        MixerConnectionState.Connecting => "tone-active",
        MixerConnectionState.Disconnected => "tone-warn",
        _ => "tone-neutral",
    };

    // The select works in camelCase-key terms; the draft stores the enum.
    private string BackendKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_audio.Value.Backend.ToString());
        set => _audio.Value.Backend = Enum.TryParse<AudioBackend>(value, ignoreCase: true, out var parsed)
            ? parsed : AudioBackend.CoreAudio;
    }

    private string CoreAudioAcpKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_audio.Value.CoreAudioAcp.ToString());
        set => _audio.Value.CoreAudioAcp = Enum.TryParse<AcpSide>(value, ignoreCase: true, out var parsed)
            ? parsed : AcpSide.Captain;
    }

    private IReadOnlyList<string> _processSuggestions = [];
    private IReadOnlyList<string> _deviceSuggestions = [];

    protected override void OnInitialized()
    {
        _audio = Draft(AudioMonitor);
        _mixer = Draft(MixerMonitor);
        NormalizeVoiceMeeterKeys();
        SyncMixerPanelText();
        Watch(MixerStatus, snapshot => _mixerLive = snapshot);
        ReloadTargets();
        LoadProcessSuggestions();
        _deviceSuggestions = DeviceCatalog.GetRenderDeviceNames();
    }

    private void LoadProcessSuggestions()
    {
        try
        {
            var processes = System.Diagnostics.Process.GetProcesses();
            try
            {
                // Windowed processes only — the audio-session candidates a user would map.
                _processSuggestions = processes
                    .Where(p => p.MainWindowHandle != IntPtr.Zero)
                    .Select(p => p.ProcessName)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            finally
            {
                foreach (var process in processes)
                {
                    process.Dispose();
                }
            }
        }
        catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
        {
            // Suggestions are a convenience — an enumeration failure just leaves the list empty.
        }
    }

    // Normalize dictionary keys to the canonical camelCase ACP names so the editor and
    // the save path address the same buckets regardless of hand-edited key casing.
    private void NormalizeVoiceMeeterKeys()
    {
        var normalized = new Dictionary<string, List<VoiceMeeterTargetMapping>>();
        foreach (var (key, mappings) in _audio.Value.VoiceMeeterMappings)
        {
            if (Enum.TryParse<AcpSide>(key, ignoreCase: true, out var acp))
            {
                normalized[AcpKey(acp)] = mappings;
            }
        }
        _audio.Value.VoiceMeeterMappings = normalized;
    }

    private static string AcpKey(AcpSide acp) => JsonNamingPolicy.CamelCase.ConvertName(acp.ToString());

    private List<VoiceMeeterTargetMapping> VmList(AcpSide acp)
    {
        var key = AcpKey(acp);
        if (!_audio.Value.VoiceMeeterMappings.TryGetValue(key, out var list))
        {
            list = [];
            _audio.Value.VoiceMeeterMappings[key] = list;
        }
        return list;
    }

    private void SetAcpActive(AcpSide acp, bool active)
    {
        _audio.Value.ActiveAcps.Remove(acp);
        if (active)
        {
            _audio.Value.ActiveAcps.Add(acp);
        }
    }

    private void ReloadTargets()
    {
        try
        {
            _vmTargets = AudioControl.GetVoiceMeeterTargets();
        }
        catch (Exception)
        {
            _vmTargets = [];
        }
    }

    private static string TargetKey(VoiceMeeterTargetMapping mapping) =>
        $"{(mapping.IsBus ? "bus" : "strip")}:{mapping.StripIndex}";

    private static void SetTarget(VoiceMeeterTargetMapping mapping, string? key)
    {
        var parts = (key ?? "").Split(':');
        if (parts.Length == 2 && int.TryParse(parts[1], out var index))
        {
            mapping.IsBus = parts[0] == "bus";
            mapping.StripIndex = index;
        }
    }

    private IReadOnlyList<(string Key, string Label)> TargetOptions()
    {
        var options = new List<(string, string)>();
        if (_vmTargets.Count > 0)
        {
            foreach (var target in _vmTargets)
            {
                var kind = target.IsBus ? "Bus" : "Strip";
                var label = string.IsNullOrWhiteSpace(target.Label) ? "" : $" — {target.Label}";
                options.Add(($"{(target.IsBus ? "bus" : "strip")}:{target.Index}", $"{kind} {target.Index + 1}{label}"));
            }
            return options;
        }

        // VoiceMeeter unreachable: offer the Potato-sized generic range (8 strips / 8 buses).
        for (var i = 0; i < 8; i++)
        {
            options.Add(($"strip:{i}", $"Strip {i + 1}"));
        }
        for (var i = 0; i < 8; i++)
        {
            options.Add(($"bus:{i}", $"Bus {i + 1}"));
        }
        return options;
    }

    protected override void OnBeforeSave()
    {
        var audio = _audio.Value;

        // Blank mapping rows never persist; process/device names save trimmed.
        audio.AppMappings.RemoveAll(m => string.IsNullOrWhiteSpace(m.Binary));
        foreach (var mapping in audio.AppMappings)
        {
            mapping.Binary = mapping.Binary.Trim();
            mapping.Device = mapping.Device.Trim();
        }

        audio.DeviceBlacklist.RemoveAll(string.IsNullOrWhiteSpace);
        for (var i = 0; i < audio.DeviceBlacklist.Count; i++)
        {
            audio.DeviceBlacklist[i] = audio.DeviceBlacklist[i].Trim();
        }

        audio.VoiceMeeterDllPath = audio.VoiceMeeterDllPath.Trim();
        audio.ActiveAcps = audio.ActiveAcps.Distinct().ToList();

        var mixer = _mixer.Value;
        mixer.Host = mixer.Host.Trim();
        mixer.Token = mixer.Token.Trim();
        // Rows with neither a source nor a parameter are blanks; the rest save trimmed.
        mixer.Mappings.RemoveAll(m => string.IsNullOrWhiteSpace(m.Source) && string.IsNullOrWhiteSpace(m.Parameter));
        foreach (var mapping in mixer.Mappings)
        {
            mapping.Source = mapping.Source.Trim();
            mapping.Parameter = mapping.Parameter.Trim();
        }
    }

    // A discard re-clones from the live options, so the key normalization must run again.
    protected override void OnDiscarded()
    {
        NormalizeVoiceMeeterKeys();
        SyncMixerPanelText();
    }
}
