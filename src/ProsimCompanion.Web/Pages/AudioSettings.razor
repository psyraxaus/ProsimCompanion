@page "/settings/audio/{Section?}"
@page "/audio"
@layout SettingsLayout
@using System.Text.Json
@inherits SettingsPageBase
@inject IOptionsMonitor<AudioOptions> AudioMonitor
@inject IAudioControl AudioControl
@inject IAudioDeviceCatalog DeviceCatalog

<PageTitle>Audio Control — ProsimCompanion</PageTitle>
<h1 class="sr-only">Audio Control</h1>

@* Sections are URL-driven (settings/audio/{section}, ADR-0010); the rail lives in
   SettingsLayout. The audio master switch moved to Setup with the other pillar switches. *@

            @if (CurrentSection == "status")
            {
                <AudioStatusPanel />
            }
            else if (CurrentSection == "general")
            {
                <Section Title="Volume Control" Hint="ACP knobs and REC latches drive app volumes">
                    <SelectField Label="Backend" Options="BackendOptions"
                                 Hint="Switching applies live: CoreAudio session volumes are restored, VoiceMeeter targets reset to 0 dB"
                                 @bind-Value="BackendKey" />
                    <BoolField Label="Disable ProSim native audio control"
                               Hint="Clears ProSim's aircraft.communication.windows.* bindings once per connection so both apps never fight over the same sessions"
                               @bind-Value="_audio.Value.DisableProsimNativeAudio" />
                </Section>
            }
            else if (CurrentSection == "coreaudio")
            {
                <Section Title="CoreAudio" Hint="Windows per-app session volumes">
                    <SelectField Label="ACP" Options="AcpOptions"
                                 Hint="Which Audio Control Panel the app mappings listen to"
                                 @bind-Value="CoreAudioAcpKey" />
                    <SelectField Label="Device-filter DataFlow" Options="DeviceFlowOptions"
                                 Hint="Only for troubleshooting — change as advised"
                                 @bind-Value="_audio.Value.DeviceFilterFlow" />
                    <SelectField Label="Device-filter State" Options="DeviceStateOptions"
                                 Hint="Only for troubleshooting — change as advised"
                                 @bind-Value="_audio.Value.DeviceFilterState" />
                    <div style="margin-top:8px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                        <button type="button" class="btn secondary" disabled="@_debugDumpBusy" @onclick="WriteDebugDump">
                            @(_debugDumpBusy ? "Writing…" : "Write Debug Info")
                        </button>
                        @if (_debugDumpResult is not null)
                        {
                            <span class="field-hint">@_debugDumpResult</span>
                        }
                    </div>
                </Section>

                <Section Title="App Mappings" Hint="A channel may drive several processes">
                    @if (_audio.Value.AppMappings.Count == 0)
                    {
                        <div class="empty">No app mappings configured.</div>
                    }
                    else
                    {
                        <div class="audio-map-header">
                            <span>Channel</span><span>Process</span><span>Device</span>
                            <span>Latch</span><span>Active</span><span></span>
                        </div>
                        @for (var i = 0; i < _audio.Value.AppMappings.Count; i++)
                        {
                            var index = i;
                            var row = _audio.Value.AppMappings[index];
                            <div class="audio-map-row">
                                <select class="cell-select" @bind="row.Channel">
                                    @foreach (var channel in Enum.GetValues<AudioChannel>())
                                    {
                                        <option value="@channel">@AudioPresentation.ChannelLabel(channel)</option>
                                    }
                                </select>
                                <input class="cell-input" placeholder="Process name (no .exe)" list="audio-process-suggestions" @bind="row.Binary" />
                                <input class="cell-input" placeholder="All devices" list="audio-device-suggestions" @bind="row.Device" />
                                <input type="checkbox" class="audio-cell-check" title="Drive mute from the REC latch"
                                       @bind="row.UseLatch" />
                                <input type="checkbox" class="audio-cell-check" title="Only control active sessions"
                                       @bind="row.OnlyActive" />
                                <button type="button" class="remove-btn" title="Remove" aria-label="Remove"
                                        @onclick="() => _audio.Value.AppMappings.RemoveAt(index)">×</button>
                            </div>
                        }
                    }
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary"
                                @onclick="() => _audio.Value.AppMappings.Add(new AudioAppMapping())">Add mapping</button>
                    </div>
                    <div class="field-hint" style="margin-top:8px; max-width:640px;">
                        Process name without extension (e.g. "vPilot"). When the latch box is off,
                        mute is never written — an app muted elsewhere stays muted. Apps running
                        elevated (as administrator) cannot be controlled unless ProsimCompanion
                        also runs elevated; the Audio page flags them.
                    </div>
                </Section>

                <Section Title="Device Blacklist" Hint="Matched on the START of the device name">
                    <div class="list-editor">
                        @for (var i = 0; i < _audio.Value.DeviceBlacklist.Count; i++)
                        {
                            var index = i;
                            <div class="list-row">
                                <input class="cell-input" placeholder="Device friendly name prefix"
                                       list="audio-device-suggestions" @bind="_audio.Value.DeviceBlacklist[index]" />
                                <button type="button" class="remove-btn" title="Remove" aria-label="Remove"
                                        @onclick="() => _audio.Value.DeviceBlacklist.RemoveAt(index)">×</button>
                            </div>
                        }
                    </div>
                    <div style="margin-top:8px;">
                        <button type="button" class="btn secondary"
                                @onclick="() => _audio.Value.DeviceBlacklist.Add(string.Empty)">Add device</button>
                    </div>
                </Section>
            }
            else if (CurrentSection == "voicemeeter")
            {
                <Section Title="VoiceMeeter" Hint="Strips/buses via VoicemeeterRemote64.dll">
                    <TextField Label="VoicemeeterRemote64.dll path"
                               Hint="Leave empty to auto-detect the installed VoiceMeeter (any edition); set only for non-standard install locations — never bundled, loaded at runtime"
                               @bind-Value="_audio.Value.VoiceMeeterDllPath" />
                    <div style="margin:8px 0;">
                        <button type="button" class="btn secondary" @onclick="ReloadTargets">Reload strips</button>
                        <span class="field-hint" style="margin-left:8px;">
                            @(_vmTargets.Count > 0
                                ? $"{_vmTargets.Count(t => !t.IsBus)} strips / {_vmTargets.Count(t => t.IsBus)} buses found"
                                : "VoiceMeeter not reachable — generic strip/bus numbers shown")
                        </span>
                    </div>
                </Section>

                @foreach (var acp in Enum.GetValues<AcpSide>())
                {
                    <Section Title="@($"{AudioPresentation.AcpLabel(acp)} Mappings")">
                        <BoolField Label="@($"Drive targets from the {AudioPresentation.AcpLabel(acp)} ACP")"
                                   Value="_audio.Value.ActiveAcps.Contains(acp)"
                                   ValueChanged="active => SetAcpActive(acp, active)" />
                        @{ var list = VmList(acp); }
                        @if (list.Count > 0)
                        {
                            <div class="audio-vm-header">
                                <span>Channel</span><span>Target</span><span>Latch</span><span></span>
                            </div>
                            @for (var i = 0; i < list.Count; i++)
                            {
                                var index = i;
                                var row = list[index];
                                <div class="audio-vm-row">
                                    <select class="cell-select" @bind="row.Channel">
                                        @foreach (var channel in Enum.GetValues<AudioChannel>())
                                        {
                                            <option value="@channel">@AudioPresentation.ChannelLabel(channel)</option>
                                        }
                                    </select>
                                    <select class="cell-select" value="@TargetKey(row)"
                                            @onchange="e => SetTarget(row, e.Value as string)">
                                        @foreach (var (key, label) in TargetOptions())
                                        {
                                            <option value="@key">@label</option>
                                        }
                                    </select>
                                    <input type="checkbox" class="audio-cell-check"
                                           title="Drive mute from the REC latch" @bind="row.UseLatch" />
                                    <button type="button" class="remove-btn" title="Remove" aria-label="Remove"
                                            @onclick="() => list.RemoveAt(index)">×</button>
                                </div>
                            }
                        }
                        <div style="margin-top:8px;">
                            <button type="button" class="btn secondary"
                                    @onclick="() => VmList(acp).Add(new VoiceMeeterTargetMapping())">Add mapping</button>
                        </div>
                    </Section>
                }

                <div class="field-hint" style="max-width:640px;">
                    A channel may appear once per ACP, and a strip/bus may be driven by only one
                    ACP. Conflicting saves fall back to CPT-only until fixed (the Audio page shows
                    the reason). Knob travel maps to −60 dB … +12 dB; 0 dB sits around 83 %.
                </div>
            }
            else
            {
                <Section Title="Housekeeping" Hint="Predecessor-proven cadences — rarely need changing">
                    <NumberField Label="Run interval" Suffix="ms" Min="250"
                                 Hint="Main housekeeping tick. Takes effect after restarting the application"
                                 @bind-Value="_audio.Value.RunIntervalMs" />
                    <NumberField Label="Process check interval" Suffix="ms" Min="500"
                                 @bind-Value="_audio.Value.ProcessCheckIntervalMs" />
                    <NumberField Label="Process startup grace" Suffix="ms" Min="0"
                                 Hint="Wait after a mapped app starts before looking for its audio session"
                                 @bind-Value="_audio.Value.ProcessStartupDelayMs" />
                    <NumberField Label="Device rescan interval" Suffix="ms" Min="5000"
                                 @bind-Value="_audio.Value.DeviceCheckIntervalMs" />
                    <NumberField Label="Max session searches" Min="1"
                                 Hint="Failed lookups for a running process before a forced device rescan"
                                 @bind-Value="_audio.Value.ProcessMaxSearchCount" />
                </Section>
            }

@* Windowed-process suggestions for the mapping Binary inputs (Prosim2GSX parity) — the
   Blazor circuit runs on the sim PC, so a plain server-side enumeration suffices. *@
<datalist id="audio-process-suggestions">
    @foreach (var name in _processSuggestions)
    {
        <option value="@name" />
    }
</datalist>

@* Render-device names for the mapping Device filter and the blacklist — both are
   START-of-friendly-name matches, so picking a full name from the list always works. *@
<datalist id="audio-device-suggestions">
    @foreach (var name in _deviceSuggestions)
    {
        <option value="@name" />
    }
</datalist>

<DirtyBar Visible="@BarVisible"
          Message="@(BarMessage ?? "You have unsaved changes")"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    [Parameter]
    public string? Section { get; set; }

    private string CurrentSection => SettingsNav.ResolveSection(SettingsNav.AudioSections, Section);

    private static readonly IReadOnlyList<(string, string)> BackendOptions =
    [
        ("coreAudio", "CoreAudio (Windows app volumes)"),
        ("voiceMeeter", "VoiceMeeter (strips/buses)"),
    ];

    private static readonly IReadOnlyList<(string, string)> AcpOptions =
    [
        ("captain", "Captain (ACP1)"),
        ("firstOfficer", "First Officer (ACP2)"),
        ("observer", "Observer (ACP3)"),
    ];

    private static readonly IReadOnlyList<(string, string)> DeviceFlowOptions =
    [
        ("render", "Render"),
        ("capture", "Capture"),
        ("all", "All"),
    ];

    private static readonly IReadOnlyList<(string, string)> DeviceStateOptions =
    [
        ("active", "Active"),
        ("disabled", "Disabled"),
        ("notPresent", "Not present"),
        ("unplugged", "Unplugged"),
        ("all", "All (mask all)"),
    ];

    private bool _debugDumpBusy;
    private string? _debugDumpResult;

    private async Task WriteDebugDump()
    {
        _debugDumpBusy = true;
        _debugDumpResult = null;
        try
        {
            var path = await AudioControl.WriteDebugDumpAsync();
            _debugDumpResult = path is not null ? $"Written to {path}" : "Dump failed — see the app log";
        }
        finally
        {
            _debugDumpBusy = false;
        }
    }

    private OptionsDraft<AudioOptions> _audio = default!;
    private IReadOnlyList<VoiceMeeterTargetView> _vmTargets = [];

    // The select works in camelCase-key terms; the draft stores the enum.
    private string BackendKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_audio.Value.Backend.ToString());
        set => _audio.Value.Backend = Enum.TryParse<AudioBackend>(value, ignoreCase: true, out var parsed)
            ? parsed : AudioBackend.CoreAudio;
    }

    private string CoreAudioAcpKey
    {
        get => JsonNamingPolicy.CamelCase.ConvertName(_audio.Value.CoreAudioAcp.ToString());
        set => _audio.Value.CoreAudioAcp = Enum.TryParse<AcpSide>(value, ignoreCase: true, out var parsed)
            ? parsed : AcpSide.Captain;
    }

    private IReadOnlyList<string> _processSuggestions = [];
    private IReadOnlyList<string> _deviceSuggestions = [];

    protected override void OnInitialized()
    {
        _audio = Draft(AudioMonitor);
        NormalizeVoiceMeeterKeys();
        ReloadTargets();
        LoadProcessSuggestions();
        _deviceSuggestions = DeviceCatalog.GetRenderDeviceNames();
    }

    private void LoadProcessSuggestions()
    {
        try
        {
            var processes = System.Diagnostics.Process.GetProcesses();
            try
            {
                // Windowed processes only — the audio-session candidates a user would map.
                _processSuggestions = processes
                    .Where(p => p.MainWindowHandle != IntPtr.Zero)
                    .Select(p => p.ProcessName)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            finally
            {
                foreach (var process in processes)
                {
                    process.Dispose();
                }
            }
        }
        catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
        {
            // Suggestions are a convenience — an enumeration failure just leaves the list empty.
        }
    }

    // Normalize dictionary keys to the canonical camelCase ACP names so the editor and
    // the save path address the same buckets regardless of hand-edited key casing.
    private void NormalizeVoiceMeeterKeys()
    {
        var normalized = new Dictionary<string, List<VoiceMeeterTargetMapping>>();
        foreach (var (key, mappings) in _audio.Value.VoiceMeeterMappings)
        {
            if (Enum.TryParse<AcpSide>(key, ignoreCase: true, out var acp))
            {
                normalized[AcpKey(acp)] = mappings;
            }
        }
        _audio.Value.VoiceMeeterMappings = normalized;
    }

    private static string AcpKey(AcpSide acp) => JsonNamingPolicy.CamelCase.ConvertName(acp.ToString());

    private List<VoiceMeeterTargetMapping> VmList(AcpSide acp)
    {
        var key = AcpKey(acp);
        if (!_audio.Value.VoiceMeeterMappings.TryGetValue(key, out var list))
        {
            list = [];
            _audio.Value.VoiceMeeterMappings[key] = list;
        }
        return list;
    }

    private void SetAcpActive(AcpSide acp, bool active)
    {
        _audio.Value.ActiveAcps.Remove(acp);
        if (active)
        {
            _audio.Value.ActiveAcps.Add(acp);
        }
    }

    private void ReloadTargets()
    {
        try
        {
            _vmTargets = AudioControl.GetVoiceMeeterTargets();
        }
        catch (Exception)
        {
            _vmTargets = [];
        }
    }

    private static string TargetKey(VoiceMeeterTargetMapping mapping) =>
        $"{(mapping.IsBus ? "bus" : "strip")}:{mapping.StripIndex}";

    private static void SetTarget(VoiceMeeterTargetMapping mapping, string? key)
    {
        var parts = (key ?? "").Split(':');
        if (parts.Length == 2 && int.TryParse(parts[1], out var index))
        {
            mapping.IsBus = parts[0] == "bus";
            mapping.StripIndex = index;
        }
    }

    private IReadOnlyList<(string Key, string Label)> TargetOptions()
    {
        var options = new List<(string, string)>();
        if (_vmTargets.Count > 0)
        {
            foreach (var target in _vmTargets)
            {
                var kind = target.IsBus ? "Bus" : "Strip";
                var label = string.IsNullOrWhiteSpace(target.Label) ? "" : $" — {target.Label}";
                options.Add(($"{(target.IsBus ? "bus" : "strip")}:{target.Index}", $"{kind} {target.Index + 1}{label}"));
            }
            return options;
        }

        // VoiceMeeter unreachable: offer the Potato-sized generic range (8 strips / 8 buses).
        for (var i = 0; i < 8; i++)
        {
            options.Add(($"strip:{i}", $"Strip {i + 1}"));
        }
        for (var i = 0; i < 8; i++)
        {
            options.Add(($"bus:{i}", $"Bus {i + 1}"));
        }
        return options;
    }

    protected override void OnBeforeSave()
    {
        var audio = _audio.Value;

        // Blank mapping rows never persist; process/device names save trimmed.
        audio.AppMappings.RemoveAll(m => string.IsNullOrWhiteSpace(m.Binary));
        foreach (var mapping in audio.AppMappings)
        {
            mapping.Binary = mapping.Binary.Trim();
            mapping.Device = mapping.Device.Trim();
        }

        audio.DeviceBlacklist.RemoveAll(string.IsNullOrWhiteSpace);
        for (var i = 0; i < audio.DeviceBlacklist.Count; i++)
        {
            audio.DeviceBlacklist[i] = audio.DeviceBlacklist[i].Trim();
        }

        audio.VoiceMeeterDllPath = audio.VoiceMeeterDllPath.Trim();
        audio.ActiveAcps = audio.ActiveAcps.Distinct().ToList();
    }

    // A discard re-clones from the live options, so the key normalization must run again.
    protected override void OnDiscarded() => NormalizeVoiceMeeterKeys();
}
