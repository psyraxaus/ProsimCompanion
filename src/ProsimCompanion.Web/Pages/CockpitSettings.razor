@page "/settings/cockpit"
@layout SettingsLayout
@using System.Globalization
@using ProsimCompanion.Core.Aircraft.Switches
@using ProsimCompanion.Web.Settings
@inherits SettingsPageBase
@inject IOptionsMonitor<CockpitSwitchesOptions> CockpitMonitor
@inject SwitchCatalogStore SwitchList
@inject CockpitSwitchStateStore SwitchStates
@inject ICockpitSwitchControl Control
@inject IStringLocalizer T

@* Cockpit switches (2026-10-24, owner option A): one grid line per switch the Stream Deck may
   press and show — picked from ProSim's own switch catalogue (shipped CSV, replaced by the live
   list when ProSim connects), drawn as a Korry button, toggle or knob by the plugin. The fields
   touched every time sit on the line (title, switch, look, press, lamp and bezel colours,
   state); the rare ones (id, legends, lamp indicators, upper colour, a test press) fold out
   under it (owner pick 2026-10-24 over one card per switch). The row's dataref is the ONLY
   thing that reaches the aircraft, and only through the write gate's configured-row hook
   (ADR-0015). *@

<PageTitle>@T["cockpit.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["cockpit.heading"]</h1>

<Section Title="@T["cockpit.general.title"]" Hint="@T["cockpit.general.hint"]">
    <OptionField Draft="_cockpit" For="o => o.Enabled" />
    <div class="field-hint" style="max-width:640px;">@T["cockpit.general.intro"]</div>
</Section>

<Section Title="@T["cockpit.list.title"]" Hint="@T["cockpit.list.hint"]">
    @if (_cockpit.Value.Rows.Count == 0)
    {
        <div class="empty">@T["cockpit.list.none"]</div>
    }
    else
    {
        <div class="cockpit-row-header">
            <span>@T["cockpit.row.name.label"]</span>
            <span>@T["cockpit.row.dataRef.label"]</span>
            <span>@T["cockpit.row.look.label"]</span>
            <span>@T["cockpit.row.press.label"]</span>
            <span title="@T["cockpit.row.lowerColorHint"]">@T["cockpit.row.lamp"]</span>
            <span title="@T["cockpit.row.bezelColorHint"]">@T["cockpit.row.bezelColor"]</span>
            <span title="@T["cockpit.row.stateHint"]">@T["cockpit.row.state"]</span>
            <span></span>
            <span></span>
        </div>
        @for (var i = 0; i < _cockpit.Value.Rows.Count; i++)
        {
            var index = i;
            var row = _cockpit.Value.Rows[index];
            var state = StateOf(row);
            var entry = _switches.Find(row.DataRef);
            var open = _open.Contains(row);
            <div class="cockpit-row">
                <input class="cell-input @(string.IsNullOrWhiteSpace(row.Name) ? "invalid" : "")" placeholder="LEAK MEAS B" @bind="row.Name" title="@T["cockpit.row.name.hint"]" />
                <select class="cell-select @(entry is null ? "invalid" : "")" value="@(entry?.Name ?? "")" @onchange="e => OnPicked(row, e.Value as string ?? string.Empty)" title="@T["cockpit.row.dataRef.hint"]">
                    <option value="">@T["cockpit.row.dataRef.pick"]</option>
                    @if (entry is null && !string.IsNullOrWhiteSpace(row.DataRef))
                    {
                        <option value="" selected>@row.DataRef</option>
                    }
                    @foreach (var group in PickGroups)
                    {
                        <optgroup label="@group.Label">
                            @foreach (var option in group.Options)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </optgroup>
                    }
                </select>
                <select class="cell-select" @bind="row.Look" title="@T["cockpit.row.look.hint"]">
                    <option value="@CockpitSwitchLook.Korry2">@T["cockpit.lookOptions.korry2"]</option>
                    <option value="@CockpitSwitchLook.Korry1">@T["cockpit.lookOptions.korry1"]</option>
                    <option value="@CockpitSwitchLook.Toggle">@T["cockpit.lookOptions.toggle"]</option>
                    <option value="@CockpitSwitchLook.Knob">@T["cockpit.lookOptions.knob"]</option>
                    <option value="@CockpitSwitchLook.Guarded">@T["cockpit.lookOptions.guarded"]</option>
                </select>
                <select class="cell-select" @bind="row.PressMode" title="@T["cockpit.row.press.hint"]">
                    <option value="@CockpitPressMode.Toggle">@T["cockpit.pressOptions.toggle"]</option>
                    <option value="@CockpitPressMode.Momentary">@T["cockpit.pressOptions.momentary"]</option>
                    <option value="@CockpitPressMode.Cycle">@T["cockpit.pressOptions.cycle"]</option>
                </select>
                <input type="color" class="cockpit-swatch" value="@Swatch(row.LowerColor, CockpitSwitchRow.DefaultLowerColor)" @onchange="e => SetColor(c => row.LowerColor = c, e)" title="@T["cockpit.row.lowerColorHint"]" aria-label="@T["cockpit.row.lowerColor"]" />
                <input type="color" class="cockpit-swatch @(string.IsNullOrWhiteSpace(row.BezelColor) ? "cockpit-swatch-none" : "")" value="@Swatch(row.BezelColor, "#3b4046")" @onchange="e => SetColor(c => row.BezelColor = c, e)" title="@T["cockpit.row.bezelColorHint"]" aria-label="@T["cockpit.row.bezelColor"]" />
                <span class="pill @StateTone(state)" title="@T["cockpit.row.stateHint"]">@StateLabel(state)</span>
                <button type="button" class="btn secondary cockpit-more" title="@(open ? T["cockpit.row.less"].Value : T["cockpit.row.more"].Value)" aria-expanded="@(open ? "true" : "false")"
                        @onclick="() => Toggle(row)">@(open ? "▾" : "▸")</button>
                <button type="button" class="remove-btn" title="@T["cockpit.row.removeTitle"]" aria-label="@T["cockpit.row.removeTitle"]"
                        @onclick="() => Remove(row)">×</button>
            </div>
            @if (open)
            {
                <div class="cockpit-row-more">
                    <label>@T["cockpit.row.id.label"] <FieldHint Hint="@T["cockpit.row.id.hint"]" /></label>
                    <input class="cell-input @(string.IsNullOrWhiteSpace(row.Id) ? "invalid" : "")" @bind="row.Id" />

                    <label>@T["cockpit.row.upperLegend.label"] <FieldHint Hint="@T["cockpit.row.upperLegend.hint"]" /></label>
                    <input class="cell-input" @bind="row.UpperLegend" disabled="@(row.Look != CockpitSwitchLook.Korry2)" />

                    <label>@T["cockpit.row.lowerLegend.label"] <FieldHint Hint="@T["cockpit.row.lowerLegend.hint"]" /></label>
                    <input class="cell-input" @bind="row.LowerLegend" disabled="@(row.Look is not (CockpitSwitchLook.Korry2 or CockpitSwitchLook.Korry1))" />

                    <label>@T["cockpit.row.upperIndicator.label"] <FieldHint Hint="@T["cockpit.row.upperIndicator.hint"]" /></label>
                    <input class="cell-input" list="cockpit-indicators" placeholder="system.indicators.I_…" @bind="row.UpperIndicator" disabled="@(row.Look != CockpitSwitchLook.Korry2)" />

                    <label>@T["cockpit.row.lowerIndicator.label"] <FieldHint Hint="@T["cockpit.row.lowerIndicator.hint"]" /></label>
                    <input class="cell-input" list="cockpit-indicators" placeholder="system.indicators.I_…" @bind="row.LowerIndicator" />

                    <label>@T["cockpit.row.showUnlitLegend.label"] <FieldHint Hint="@T["cockpit.row.showUnlitLegend.hint"]" /></label>
                    <label style="display:flex; align-items:center; gap:8px;">
                        <input type="checkbox" class="audio-cell-check" @bind="row.ShowUnlitLegend" />
                        <span class="field-hint" style="margin:0;">@(row.ShowUnlitLegend ? T["cockpit.row.unlitDim"].Value : T["cockpit.row.unlitHidden"].Value)</span>
                    </label>

                    <label>@T["cockpit.row.upperColor"] <FieldHint Hint="@T["cockpit.row.upperColorHint"]" /></label>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <input type="color" class="cockpit-swatch" value="@Swatch(row.UpperColor, CockpitSwitchRow.DefaultUpperColor)" @onchange="e => SetColor(c => row.UpperColor = c, e)" aria-label="@T["cockpit.row.upperColor"]" disabled="@(row.Look != CockpitSwitchLook.Korry2)" />
                        <input class="cell-input @(CockpitSwitchLogic.IsHexColor(row.UpperColor) ? "" : "invalid")" style="width:110px;" @bind="row.UpperColor" />
                        <span class="field-hint" style="margin:0;">@T["cockpit.row.lowerColor"]:</span>
                        <input class="cell-input @(CockpitSwitchLogic.IsHexColor(row.LowerColor) ? "" : "invalid")" style="width:110px;" @bind="row.LowerColor" />
                        <span class="field-hint" style="margin:0;">@T["cockpit.row.bezelColor"]:</span>
                        <input class="cell-input @(string.IsNullOrWhiteSpace(row.BezelColor) || CockpitSwitchLogic.IsHexColor(row.BezelColor) ? "" : "invalid")" style="width:110px;" placeholder="@T["cockpit.row.bezelNone"]" @bind="row.BezelColor" />
                    </div>

                    <label>@T["cockpit.row.positionsLabel"]</label>
                    <span class="field-hint" style="margin:0;">
                        @if (entry is null && !string.IsNullOrWhiteSpace(row.DataRef))
                        {
                            <span class="field-hint-warn">@T["cockpit.row.dataRef.unknown", row.DataRef]</span>
                        }
                        else if (entry is { Values.Count: > 0 })
                        {
                            @string.Join(", ", entry.Values.Select(v => v.Value.ToString(CultureInfo.InvariantCulture) + " = " + v.Label))
                        }
                        else
                        {
                            @T["cockpit.row.positionsNone"]
                        }
                    </span>

                    <label>@T["cockpit.row.pressNow"] <FieldHint Hint="@T["cockpit.row.pressHint"]" /></label>
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                        <button type="button" class="btn primary" style="padding:4px 12px;"
                                disabled="@(_pressing || _cockpit.IsDirty || entry is null)"
                                @onclick="() => PressAsync(row)">@T["cockpit.row.pressNow"]</button>
                        <span class="field-hint" style="margin:0;">@(_pressResults.TryGetValue(row, out var line) ? line : "")</span>
                    </div>
                </div>
            }
        }
    }

    <div style="margin-top:8px; display:flex; gap:10px; flex-wrap:wrap;">
        <button type="button" class="btn secondary" @onclick="AddRow">@T["cockpit.list.add"]</button>
        <button type="button" class="btn secondary" @onclick="AddLeakValves">@T["cockpit.list.addLeakValves"]</button>
    </div>
    @foreach (var duplicate in DuplicateIds())
    {
        <div class="field-hint field-hint-warn" style="margin-top:8px;">@T["cockpit.list.duplicate", duplicate]</div>
    }
    <div class="field-hint" style="margin-top:8px; max-width:640px;">
        @T["cockpit.list.sourceBefore"] @CatalogSource
        <details class="field-more">
            <summary>@T["cockpit.list.more"]</summary>
            <span class="field-more-body">@T["cockpit.list.moreBody"] <code>cockpit.press {"id":"oh_hyd_lmv_blue"}</code>, <code>cockpit.set {"id":"…","value":1}</code></span>
        </details>
    </div>
</Section>

<datalist id="cockpit-indicators">
    @foreach (var name in SwitchCatalog.ShippedIndicatorNames)
    {
        <option value="@name"></option>
    }
</datalist>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private OptionsDraft<CockpitSwitchesOptions> _cockpit = default!;
    private SwitchCatalogSnapshot _switches = default!;
    private CockpitSwitchesSnapshot _states = CockpitSwitchesSnapshot.Empty;
    private readonly HashSet<CockpitSwitchRow> _open = [];
    private readonly Dictionary<CockpitSwitchRow, string> _pressResults = [];
    private bool _pressing;

    protected override void OnInitialized()
    {
        _cockpit = Draft(CockpitMonitor);
        Watch(SwitchList, snapshot => _switches = snapshot);
        Watch(SwitchStates, snapshot => _states = snapshot);
    }

    // A discard replaces the draft's row objects: the fold-outs and press results die with them.
    protected override void OnDiscarded()
    {
        _open.Clear();
        _pressResults.Clear();
    }

    // ---- the catalogue picker (the smart-button picker's groups, GsxSettings) ----

    private IReadOnlyList<(string Label, IReadOnlyList<(string Value, string Label)> Options)> PickGroups
    {
        get
        {
            var groups = new List<(string, IReadOnlyList<(string, string)>)>();
            foreach (var group in SwitchCatalog.GroupOrder)
            {
                // Switches only (the S_ family): circuit breakers stay out of the relay for now.
                var rows = _switches.Switches
                    .Where(s => s.Group == group && s.ShortName.StartsWith("S_", StringComparison.Ordinal))
                    .Select(s => (s.Name, s.ShortName + " — " + s.Title))
                    .ToList();
                if (rows.Count > 0)
                {
                    groups.Add((T["gsxSettings.automation.switchGroups." + group].Value, rows));
                }
            }

            return groups;
        }
    }

    private string CatalogSource
        => _switches.Source == SwitchCatalogSource.Live && _switches.ReadAtUtc is { } readAt
            ? T["cockpit.row.dataRef.sourceLive", readAt.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)].Value
            : T["cockpit.row.dataRef.sourceShipped"].Value;

    /// <summary>A pick fills what the pilot would otherwise type: the id from the dataref, the
    /// title from the catalogue, and a sensible look — a knob with three or more positions
    /// cycles; everything else starts as a two-lamp Korry that toggles.</summary>
    private void OnPicked(CockpitSwitchRow row, string name)
    {
        var previous = row.DataRef;
        row.DataRef = name;
        var entry = _switches.Find(name);
        if (string.IsNullOrWhiteSpace(row.Id) || row.Id == CockpitSwitchLogic.SlugFor(previous))
        {
            row.Id = CockpitSwitchLogic.SlugFor(name);
        }

        if (entry is not null && string.IsNullOrWhiteSpace(row.Name))
        {
            row.Name = entry.Title.ToUpperInvariant();
        }

        if (entry is { Values.Count: > 2 })
        {
            row.Look = CockpitSwitchLook.Knob;
            row.PressMode = CockpitPressMode.Cycle;
        }

        _cockpit.MarkEdited();
    }

    private void AddRow()
    {
        var row = new CockpitSwitchRow();
        _cockpit.Value.Rows.Add(row);
        _open.Add(row);
    }

    private void Remove(CockpitSwitchRow row)
    {
        _cockpit.Value.Rows.Remove(row);
        _open.Remove(row);
        _pressResults.Remove(row);
    }

    private void Toggle(CockpitSwitchRow row)
    {
        if (!_open.Remove(row))
        {
            _open.Add(row);
        }
    }

    /// <summary>The owner's three leak measurement valves in one click (sets them, or resets
    /// existing rows to this preset): blue / green / yellow bezels, the lamp follows the
    /// switch itself (pushed = lit, no power needed), legend ON shown only while lit — a dark
    /// lamp is extinguished (owner request 2026-10-24).</summary>
    private void AddLeakValves()
    {
        foreach (var (letter, colour) in new[] { ("BLUE", "#5fb4ff"), ("GREEN", "#4fd18a"), ("YELLOW", "#f2cf4a") })
        {
            var dataRef = "system.switches.S_OH_HYD_LMV_" + letter;
            var row = _cockpit.Value.Rows.FirstOrDefault(r => string.Equals(r.DataRef, dataRef, StringComparison.OrdinalIgnoreCase));
            if (row is null)
            {
                row = new CockpitSwitchRow { DataRef = dataRef };
                _cockpit.Value.Rows.Add(row);
            }

            row.Id = CockpitSwitchLogic.SlugFor(dataRef);
            row.Name = "LEAK MEAS " + letter[0];
            row.Look = CockpitSwitchLook.Korry2;
            row.PressMode = CockpitPressMode.Toggle;
            row.UpperLegend = "";
            row.LowerLegend = "ON";
            row.UpperIndicator = "";
            row.LowerIndicator = "";
            row.ShowUnlitLegend = false;
            row.LowerColor = CockpitSwitchRow.DefaultLowerColor;
            row.BezelColor = colour;
        }

        _cockpit.MarkEdited();
    }

    private IEnumerable<string> DuplicateIds()
        => _cockpit.Value.Rows
            .Select(r => r.Id.Trim())
            .Where(id => id.Length > 0)
            .GroupBy(id => id, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key);

    // ---- live state + the Press button (saved rows only, through the real seam) ----

    private CockpitSwitchState? StateOf(CockpitSwitchRow row)
        => _states.Switches.FirstOrDefault(s => string.Equals(s.Id, row.Id.Trim(), StringComparison.OrdinalIgnoreCase));

    private string StateLabel(CockpitSwitchState? state) => state switch
    {
        null => T["cockpit.row.stateNone"].Value,
        { Value: null } => T["cockpit.row.stateWaiting"].Value,
        { Stale: true } => T["cockpit.row.stateStale"].Value,
        { Position: { Length: > 0 } position } => position.ToUpperInvariant(),
        { Value: { } value } => value.ToString(CultureInfo.InvariantCulture),
    };

    private static string StateTone(CockpitSwitchState? state) => state switch
    {
        null or { Value: null } => "tone-neutral",
        { Stale: true } => "tone-warn",
        { LowerLit: true } or { UpperLit: true } => "tone-ok",
        _ => "tone-neutral",
    };

    private async Task PressAsync(CockpitSwitchRow row)
    {
        _pressing = true;
        try
        {
            var result = await Control.PressAsync(row.Id, longPress: false);
            _pressResults[row] = result.Reason;
        }
        finally
        {
            _pressing = false;
        }
    }

    // ---- colour swatches (hex text + native picker, kept in step) ----

    private static string Swatch(string? value, string fallback)
        => CockpitSwitchLogic.IsHexColor(value) && value!.Trim().Length == 7 ? value.Trim() : fallback;

    private void SetColor(Action<string> assign, ChangeEventArgs e)
    {
        var picked = e.Value as string;
        if (CockpitSwitchLogic.IsHexColor(picked))
        {
            assign(picked!.Trim());
            _cockpit.MarkEdited();
        }
    }
}
