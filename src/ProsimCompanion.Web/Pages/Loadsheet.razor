@page "/loadsheet"
@using System.Globalization
@using ProsimCompanion.Core.Aircraft.Ofp
@using ProsimCompanion.Core.Aircraft.WeightAndBalance
@inherits StoreObserverComponent
@inject LoadsheetStore Loadsheets
@inject ILoadsheetControl LoadsheetControl
@inject OfpStore Ofp
@inject DisplayUnitService Units

@* Markup and styling ported from Prosim2GSX's web LoadsheetPanel
   (LoadsheetPanel.tsx / LoadsheetPanel.module.css); the store/control seams
   are ProsimCompanion's own. *@

<PageTitle>Loadsheet — ProsimCompanion</PageTitle>
<h1 class="sr-only">Loadsheet</h1>

<div class="ls-panel">
    <div class="ls-header">
        <h2 class="ls-title">LOADSHEET</h2>
        <div class="ls-actions">
            <button type="button" class="ls-btn" disabled="@(_busy is not null)" @onclick="ResendAsync">
                @(_busy == Busy.Resend ? "RESENDING…" : "RESEND")
            </button>
            <button type="button" class="ls-btn ls-btn-danger" disabled="@(_busy is not null)" @onclick="Reset">
                @(_busy == Busy.Reset ? "RESETTING…" : _armReset ? "CONFIRM RESET" : "RESET")
            </button>
        </div>
    </div>

    @* STD row — manual entry wins over the OFP (Prosim2GSX parity). The manual time also
       feeds the STD-offset prelim auto-trigger (flightData.autoPrelimAtStd). *@
    <div class="ls-std-row">
        <span class="ls-std-label">STD (UTC)</span>
        <span class="ls-std-value">@StdDisplay</span>
        <span class="ls-std-source">@StdSource</span>
        @* Prosim2GSX behaviour: the picker shows only when the OFP isn't supplying the time
           (no plan, or a manual override is in force). *@
        @if (_loadsheets.StdOverrideUtc is not null || Ofp.Current?.ScheduledOutUtc is null)
        {
            <input type="time" class="ls-std-input" @bind="_stdDraft" />
            <button type="button" class="ls-btn" disabled="@(_stdDraft is null)" @onclick="SetStd">SET</button>
            @if (_loadsheets.StdOverrideUtc is not null)
            {
                <button type="button" class="ls-btn" @onclick="ClearStd">CLEAR</button>
            }
        }
    </div>

    <div class="ls-cards">
        @foreach (var (label, slot, finalErrorBorder) in new[]
        {
            ("PRELIM", _loadsheets.Prelim, false),
            ("FINAL", _loadsheets.Final, true),
        })
        {
            var showData = slot.Status == LoadsheetSlotStatus.Sent;
            // Weight-dependent envelope limits (A320TrimEnvelope, digitized from the CG chart
            // artwork) — each card brackets against its OWN TOW instead of a fixed window.
            var (macMin, macMax) = A320TrimEnvelope.GrossWeightLimits(slot.TowKg);
            var macError = slot.MacTow < macMin || slot.MacTow > macMax;
            // Final card highlights with a red border when the MAC is out of
            // window; the prelim card just colours the value cell.
            var errBorder = finalErrorBorder && macError && showData;

            <section class="ls-card @(errBorder ? "ls-card-error" : "")">
                <div class="ls-card-head">
                    <div class="ls-card-label">@label</div>
                    <span class="ls-badge @BadgeClass(slot.Status)">@BadgeText(slot.Status)</span>
                </div>

                @if (!showData)
                {
                    <div class="ls-empty">
                        @(slot.Status == LoadsheetSlotStatus.Failed
                            ? (slot.Error ?? "Loadsheet generation failed. See log.")
                            : "Awaiting loadsheet from Dispatch.")
                    </div>
                }
                else
                {
                    <div class="ls-kv-grid">
                        <div class="ls-kv-label">MacTow</div>
                        <div class="ls-kv-value @(macError ? "ls-kv-value-bad" : "")">@($"{slot.MacTow:F1} %")</div>
                        <div class="ls-kv-label">TOW</div>
                        @* P2GSX behaviour: metric shows tonnes; pounds shows plain lb. *@
                        <div class="ls-kv-value">@(Units.IsPounds ? Units.Format(slot.TowKg) : $"{slot.TowKg / 1000.0:F1} t")</div>
                        <div class="ls-kv-label">Ident</div>
                        <div class="ls-kv-value">EDNO @slot.EditionNumber</div>
                        <div class="ls-kv-label">Received</div>
                        <div class="ls-kv-value">@(slot.SentAtUtc?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</div>
                    </div>

                    @* Range bar — min and max bracket the bar; the marker dot sits at
                       (value − min) / (max − min). When the value is out of range the
                       dot renders at the clamped edge but flags red so the operator
                       can see WHICH way it's out (high-side vs low-side). *@
                    <div class="ls-range">
                        <div class="ls-range-labels">
                            <span>@macMin.ToString("F1", CultureInfo.InvariantCulture)</span>
                            <span class="ls-range-mid">MAC%</span>
                            <span>@macMax.ToString("F1", CultureInfo.InvariantCulture)</span>
                        </div>
                        <div class="ls-range-bar" role="img"
                             aria-label="@($"MACTOW {slot.MacTow:F1} percent on a {macMin:F1} to {macMax:F1} percent scale")">
                            <div class="ls-range-marker @(macError ? "ls-range-marker-bad" : "")"
                                 style="left:@MacPercentCss(slot.MacTow, macMin, macMax)"></div>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private enum Busy { Resend, Reset }

    private LoadsheetSnapshot _loadsheets = LoadsheetSnapshot.Empty;
    private Busy? _busy;
    private bool _armReset;
    private TimeOnly? _stdDraft;

    private string StdDisplay => _loadsheets.StdOverrideUtc is { } manual
        ? manual.ToString("HH:mm") + "Z"
        : Ofp.Current?.ScheduledOutUtc?.ToString("HH:mm") is { } ofpStd ? ofpStd + "Z" : "—";

    private string StdSource => _loadsheets.StdOverrideUtc is not null ? "manual"
        : Ofp.Current?.ScheduledOutUtc is not null ? "from OFP" : "not set";

    private void SetStd()
    {
        if (_stdDraft is { } draft)
        {
            Loadsheets.SetStdOverride(draft);
        }
    }

    private void ClearStd()
    {
        Loadsheets.SetStdOverride(null);
        _stdDraft = null;
    }

    protected override void OnInitialized()
    {
        Watch(Loadsheets, snapshot => _loadsheets = snapshot);
        WatchChanged(h => Ofp.Changed += h, h => Ofp.Changed -= h, () => { });
        WatchChanged(h => Units.Changed += h, h => Units.Changed -= h, () => { });
    }

    private static string BadgeClass(LoadsheetSlotStatus status) => status switch
    {
        LoadsheetSlotStatus.Sent => "ls-badge-ok",
        LoadsheetSlotStatus.Failed => "ls-badge-bad",
        _ => "ls-badge-warn",
    };

    private static string BadgeText(LoadsheetSlotStatus status) => status switch
    {
        LoadsheetSlotStatus.Sent => "RECEIVED",
        LoadsheetSlotStatus.Failed => "ERROR",
        _ => "PENDING",
    };

    /// <summary>Marker position on the card's MAC window, clamped to the bar edges.</summary>
    private static string MacPercentCss(double mac, double macMin, double macMax)
    {
        var fraction = Math.Clamp((mac - macMin) / (macMax - macMin), 0, 1) * 100.0;
        return fraction.ToString("F1", CultureInfo.InvariantCulture) + "%";
    }

    // Resend the most-recent slot. Once the final has been sent, the
    // operationally meaningful action is to resend FINAL (it's the latest
    // authoritative loadsheet); otherwise we resend PRELIM. Mirrors
    // Prosim2GSX's OnResend logic.
    private async Task ResendAsync()
    {
        _armReset = false;
        _busy = Busy.Resend;
        try
        {
            if (_loadsheets.Final.Status == LoadsheetSlotStatus.Sent)
            {
                await LoadsheetControl.GenerateFinalAsync();
            }
            else
            {
                await LoadsheetControl.GeneratePreliminaryAsync();
            }
        }
        finally
        {
            _busy = null;
        }
    }

    private void Reset()
    {
        // Two-click arm mirrors Prosim2GSX's destructive-action pattern (no
        // browser confirm dialogs in Blazor Server without JS interop).
        if (!_armReset)
        {
            _armReset = true;
            return;
        }

        _busy = Busy.Reset;
        try
        {
            LoadsheetControl.ResetCycle();
        }
        finally
        {
            _busy = null;
            _armReset = false;
        }
    }
}
