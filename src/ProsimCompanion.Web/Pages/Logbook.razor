@page "/logbook"
@using Microsoft.Extensions.DependencyInjection
@using ProsimCompanion.Core.Logbook
@inherits StoreObserverComponent
@inject IServiceProvider Services
@inject IStringLocalizer T

<PageTitle>@T["logbook.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["logbook.heading"]</h1>

@* Layout (the Tech Log page's shape, ADR-0011): totals, the touchdown-rate trend and the
   flight table on the main card; the selected flight's detail drawer on the side card.
   Issue #146. *@
<div class="ops-page">

    <section class="section ops-card ops-main">
        <div class="section-header">
            <h3 class="section-title">@T["logbook.title"]</h3>
            @if (_logbook is not null)
            {
                <span class="ops-actions">
                    <button type="button" class="btn secondary" disabled="@_backfilling" @onclick="Backfill"
                            title="@T["logbook.backfill.title"]">
                        @(_backfilling ? T["logbook.backfill.reading"].Value : T["logbook.backfill.button"].Value)
                    </button>
                    <a class="btn primary" href="api/logbook/export.csv" download
                       title="@T["logbook.export.title"]">@T["logbook.export.button"]</a>
                </span>
            }
        </div>
        <div class="section-body ops-body">
            @if (_logbook is null)
            {
                <div class="empty">@T["logbook.notWired"]</div>
            }
            else
            {
                <div class="ops-figures lb-figures">
                    <div class="ops-figure">
                        <span class="label-caps">@T["logbook.figures.flights"]</span>
                        <span class="figure figure-lg">@_totals.TotalFlights</span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">@T["logbook.figures.blockHours"]</span>
                        <span class="figure figure-lg">@_totals.TotalBlockHours.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    </div>
                    <div class="ops-figure">
                        <span class="label-caps">@T["logbook.figures.landings"]</span>
                        <span class="figure figure-lg">@_totals.Landings</span>
                    </div>
                    <div class="ops-figure" title="@T["logbook.figures.stableTitle", _totals.StabilizedApproaches, _totals.JudgedApproaches]">
                        <span class="label-caps">@T["logbook.figures.stableApproaches"]</span>
                        <span class="figure figure-lg">@LogbookPresentation.Percent(_totals.StabilizedRatePct)</span>
                    </div>
                    <div class="ops-figure" title="@T["logbook.figures.otpTitle", _totals.OnTimeFlights, _totals.ScheduledFlights]">
                        <span class="label-caps">@T["logbook.figures.otp"]</span>
                        <span class="figure figure-lg">@LogbookPresentation.Percent(_totals.OnTimePct)</span>
                    </div>
                    <div class="ops-figure" title="@T["logbook.figures.avgTouchdownTitle", _totals.MeasuredTouchdowns]">
                        <span class="label-caps">@T["logbook.figures.avgTouchdown"]</span>
                        <span class="figure figure-lg">@LogbookPresentation.Rate(_totals.AverageTouchdownVerticalSpeedFpm)<span class="figure-unit">FPM</span></span>
                    </div>
                </div>

                <div class="lb-trend inset">
                    <span class="label-caps">@T["logbook.trend.title", _spark.Points.Count]</span>
                    @if (_spark.Points.Count == 0)
                    {
                        <span class="empty">@T["logbook.trend.empty"]</span>
                    }
                    else
                    {
                        <svg class="lb-spark" viewBox="0 0 @LogbookSparkline.Px(LogbookSparkline.Width) @LogbookSparkline.Px(LogbookSparkline.Height)"
                             role="img" aria-label="@SparkLabel">
                            @if (_spark.AverageY is { } averageY)
                            {
                                <line class="lb-spark-avg" x1="0" x2="@LogbookSparkline.Px(LogbookSparkline.Width)"
                                      y1="@LogbookSparkline.Px(averageY)" y2="@LogbookSparkline.Px(averageY)" />
                            }
                            @if (_spark.Path.Length > 0)
                            {
                                <path class="lb-spark-line" d="@_spark.Path" />
                            }
                            @for (var i = 0; i < _spark.Points.Count; i++)
                            {
                                var point = _spark.Points[i];
                                var last = i == _spark.Points.Count - 1;
                                <g>
                                    <title>@point.Label</title>
                                    @* The hit target is larger than the mark. *@
                                    <circle class="lb-spark-hit" cx="@LogbookSparkline.Px(point.X)" cy="@LogbookSparkline.Px(point.Y)" r="8" />
                                    <circle class="@(last ? "lb-spark-last" : "lb-spark-dot")" cx="@LogbookSparkline.Px(point.X)"
                                            cy="@LogbookSparkline.Px(point.Y)" r="@(last ? "4" : "2")" />
                                </g>
                            }
                        </svg>
                        <span class="lb-trend-note">
                            @T["logbook.trend.note"]
                        </span>
                    }
                </div>

                @if (_backfillNote is not null)
                {
                    <div class="ops-note">@_backfillNote</div>
                }

                @if (_rows.Count == 0)
                {
                    <div class="empty">@T["logbook.emptyBook"]</div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table lb-table">
                            <thead>
                                <tr>
                                    @SortHeader(T["logbook.table.date"], LogbookSort.Date)
                                    @SortHeader(T["logbook.table.route"], LogbookSort.Route)
                                    @SortHeader(T["logbook.table.block"], LogbookSort.Block)
                                    @SortHeader(T["logbook.table.flight"], LogbookSort.Flight)
                                    <th>@T["logbook.table.delay"]</th>
                                    @SortHeader(T["logbook.table.touchdownRate"], LogbookSort.TouchdownRate)
                                    @SortHeader(T["logbook.table.touchdownSpeed"], LogbookSort.TouchdownSpeed)
                                    @SortHeader(T["logbook.table.approach"], LogbookSort.Approach)
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var flight in _rows)
                                {
                                    var id = flight.SessionId;
                                    <tr class="lb-row @(id == _selectedId ? "selected" : null)" tabindex="0" role="button"
                                        aria-pressed="@(id == _selectedId ? "true" : "false")"
                                        @onclick="() => Select(id)" @onkeydown="e => OnRowKey(e, id)">
                                        <td class="mono">@(flight.Date.Length > 0 ? flight.Date : "—")</td>
                                        <td class="mono">@LogbookPresentation.Route(flight)</td>
                                        <td class="mono">@LogbookPresentation.Minutes(flight.BlockMinutes)</td>
                                        <td class="mono">@LogbookPresentation.Minutes(flight.FlightMinutes)</td>
                                        <td class="mono @(flight.OnTime == false ? "lb-late" : "")" title="@(flight.DelayCode is { } dc ? T["logbook.table.delayCodeTitle", dc].Value : null)">@LogbookPresentation.Delay(flight)</td>
                                        <td class="mono">
                                            @LogbookPresentation.Rate(flight.TouchdownVerticalSpeedFpm)
                                            @if (flight.Bounces is > 0)
                                            {
                                                <span class="pill tone-warn lb-bounce" title="@T["logbook.table.bounceTitle"]">@(flight.Bounces == 1 ? T["logbook.table.bounce", flight.Bounces].Value : T["logbook.table.bounces", flight.Bounces].Value)</span>
                                            }
                                        </td>
                                        <td class="mono">@LogbookPresentation.Knots(flight.TouchdownGroundSpeedKt)</td>
                                        <td>
                                            @if (flight.ApproachResult is { Length: > 0 } approach)
                                            {
                                                <span class="pill @LogbookPresentation.ApproachTone(approach)">@ApproachText(approach)</span>
                                            }
                                            else
                                            {
                                                <span class="mono">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="ops-note">
                        @T["logbook.table.note"]
                    </div>
                }
            }
        </div>
    </section>

    @if (_logbook is not null && Selected is { } detail)
    {
        <section class="section ops-card ops-side lb-drawer" aria-label="@T["logbook.detail.aria"]">
            <div class="section-header">
                <h3 class="section-title">@LogbookPresentation.Route(detail)</h3>
                <button type="button" class="btn secondary lb-close" @onclick="CloseDetail" aria-label="@T["logbook.detail.close"]">
                    <AppIcon Name="x" Size="14" />
                </button>
            </div>
            <div class="section-body lb-detail">
                @Detail(T["logbook.detail.date"], detail.Date.Length > 0 ? detail.Date : "—")
                @Detail(T["logbook.detail.runways"], $"{detail.DepartureRunway ?? "—"} / {detail.ArrivalRunway ?? "—"}")
                @Detail(T["logbook.detail.offBlocks"], LogbookPresentation.Stamp(detail.OffBlocksUtc))
                @Detail(T["logbook.detail.takeoff"], detail.TakeoffUnknown && detail.TakeoffUtc is null ? T["logbook.detail.takeoffUnknown"].Value : LogbookPresentation.Stamp(detail.TakeoffUtc))
                @Detail(T["logbook.detail.landing"], LogbookPresentation.Stamp(detail.LandingUtc))
                @Detail(T["logbook.detail.onBlocks"], LogbookPresentation.Stamp(detail.OnBlocksUtc))
                @Detail(T["logbook.detail.blockTime"], LogbookPresentation.Minutes(detail.BlockMinutes))
                @Detail(T["logbook.detail.flightTime"], LogbookPresentation.Minutes(detail.FlightMinutes))
                @Detail(T["logbook.detail.liftoffIas"], LogbookPresentation.Knots(detail.LiftoffIasKt) + " kt")

                <span class="label-caps lb-detail-head">@T["logbook.detail.landingHead"]</span>
                @Detail(T["logbook.detail.touchdownRate"], LogbookPresentation.Rate(detail.TouchdownVerticalSpeedFpm) + " fpm")
                @Detail(T["logbook.detail.touchdownIas"], LogbookPresentation.Knots(detail.TouchdownIasKt) + " kt")
                @Detail(T["logbook.detail.touchdownGroundSpeed"], LogbookPresentation.Knots(detail.TouchdownGroundSpeedKt) + " kt")
                @Detail(T["logbook.detail.pitch"], LogbookPresentation.Degrees(detail.TouchdownPitchDeg))
                @Detail(T["logbook.detail.bounces"], detail.Bounces is { } bounces ? bounces.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")
                @Detail(T["logbook.detail.approach"], detail.ApproachResult is { Length: > 0 } judged ? ApproachText(judged) : T["logbook.approach.notJudged"].Value)

                <span class="label-caps lb-detail-head">@T["logbook.detail.techLogHead"]</span>
                @Detail(T["logbook.detail.abnormals"], detail.Abnormals.Count == 0 ? T["logbook.detail.none"].Value : string.Join(", ", detail.Abnormals))
                @Detail(T["logbook.detail.defects"], T["logbook.detail.defectsLine", detail.DefectsRaised, detail.DefectsRectified, detail.DefectsCarried])
                @Detail(T["logbook.detail.session"], detail.SessionId)

                <div class="lb-delete">
                    <button type="button" class="btn danger" @onclick="() => Delete(detail.SessionId)">
                        @(_deleteArmed ? T["logbook.detail.confirmDelete"].Value : T["logbook.detail.deleteFlight"].Value)
                    </button>
                    <span class="ops-note">
                        @(_deleteArmed
                            ? T["logbook.detail.deleteArmedNote"].Value
                            : T["logbook.detail.deleteNote"].Value)
                    </span>
                </div>
            </div>
        </section>
    }

</div>

@code {
    private ILogbookService? _logbook;
    private IReadOnlyList<LogbookFlight> _flights = [];
    private IReadOnlyList<LogbookFlight> _rows = [];
    private LogbookAggregates _totals = LogbookAggregates.Empty;
    private LogbookSparkline _spark = new([], "", null);

    private LogbookSort _sort = LogbookSort.Date;
    private bool _descending = true;
    private string? _selectedId;

    private bool _deleteArmed;
    private System.Threading.Timer? _deleteDisarmTimer;
    private bool _backfilling;
    private string? _backfillNote;

    private LogbookFlight? Selected => _selectedId is null
        ? null
        : _flights.FirstOrDefault(f => string.Equals(f.SessionId, _selectedId, StringComparison.OrdinalIgnoreCase));

    private string SparkLabel => _spark.Points.Count == 0
        ? T["logbook.trend.ariaEmpty"].Value
        : T["logbook.trend.aria", _spark.Points.Count, _spark.Points[^1].Label].Value;

    // The service names the verdict in English ("stable" / "unstable" / "indeterminate" — the
    // CSV export and the debrief carry the same word); the pill shows the pack's.
    private string ApproachText(string approach) => approach switch
    {
        "stable" => T["logbook.approach.stable"].Value,
        "unstable" => T["logbook.approach.unstable"].Value,
        "indeterminate" => T["logbook.approach.indeterminate"].Value,
        _ => approach,
    };

    protected override void OnInitialized()
    {
        // Optional resolution, like the Tech Log page: a friendly notice instead of a DI
        // crash in a build without the post-flight pillar — degrade, not fail.
        _logbook = Services.GetService<ILogbookService>();
        if (_logbook is { } logbook)
        {
            WatchChanged(h => logbook.Changed += h, h => logbook.Changed -= h, Refresh);
        }
    }

    private void Refresh()
    {
        if (_logbook is null)
        {
            return;
        }

        _flights = _logbook.Flights;
        _totals = _logbook.GetAggregates();
        _spark = LogbookPresentation.Sparkline(_flights);
        _rows = LogbookPresentation.Sorted(_flights, _sort, _descending);
    }

    private RenderFragment SortHeader(string label, LogbookSort column) => @<th aria-sort="@(_sort == column ? (_descending ? "descending" : "ascending") : "none")">
        <button type="button" class="lb-sort @(_sort == column ? "active" : null)" @onclick="() => SortBy(column)">
            @label<span class="lb-sort-mark" aria-hidden="true">@(_sort == column ? (_descending ? "▼" : "▲") : "")</span>
        </button>
    </th>;

    private static RenderFragment Detail(string label, string value) => @<div class="row">
        <span class="row-label">@label</span>
        <span class="row-value-mono">@value</span>
    </div>;

    private void SortBy(LogbookSort column)
    {
        // A second click on the same column flips it; a new column starts descending
        // (newest, longest, …) except the route, which reads A → Z.
        _descending = _sort == column ? !_descending : column != LogbookSort.Route;
        _sort = column;
        _rows = LogbookPresentation.Sorted(_flights, _sort, _descending);
    }

    private void Select(string sessionId)
    {
        _selectedId = _selectedId == sessionId ? null : sessionId;
        Disarm();
    }

    private void OnRowKey(KeyboardEventArgs e, string sessionId)
    {
        if (e.Key is "Enter" or " ")
        {
            Select(sessionId);
        }
    }

    private void CloseDetail()
    {
        _selectedId = null;
        Disarm();
    }

    private void Delete(string sessionId)
    {
        // Two-click arm (the INIT page's RESET FLIGHT rule): the first press shows CONFIRM
        // DELETE and disarms itself after 3 s.
        if (!_deleteArmed)
        {
            _deleteArmed = true;
            _deleteDisarmTimer?.Dispose();
            _deleteDisarmTimer = new System.Threading.Timer(_ => _ = InvokeAsync(() =>
            {
                _deleteArmed = false;
                StateHasChanged();
            }), null, 3000, Timeout.Infinite);
            return;
        }

        Disarm();
        if (_logbook?.RemoveFlight(sessionId) == true)
        {
            _selectedId = null;
        }

        Refresh();
    }

    private void Disarm()
    {
        _deleteDisarmTimer?.Dispose();
        _deleteDisarmTimer = null;
        _deleteArmed = false;
    }

    private async Task Backfill()
    {
        if (_logbook is not { } logbook)
        {
            return;
        }

        _backfilling = true;
        try
        {
            // Reads every session file on disk: off the render thread.
            var added = await Task.Run(logbook.Backfill);
            _backfillNote = added == 0
                ? T["logbook.backfill.noneFound"].Value
                : T["logbook.backfill.added", added].Value;
        }
        finally
        {
            _backfilling = false;
        }

        Refresh();
    }

    public override void Dispose()
    {
        base.Dispose();
        _deleteDisarmTimer?.Dispose();
    }
}
