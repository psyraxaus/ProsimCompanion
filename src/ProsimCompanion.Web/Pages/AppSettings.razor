@page "/settings/app"
@layout SettingsLayout
@using ProsimCompanion.Web.Theming
@inherits SettingsPageBase
@inject IOptionsMonitor<WebUiOptions> WebUiMonitor
@inject IOptionsMonitor<FlightDataOptions> FlightDataMonitor
@inject IOptionsMonitor<ChecklistOptions> ChecklistMonitor
@inject ThemeCatalog Themes

<PageTitle>Display &amp; Flight Data — ProsimCompanion</PageTitle>
<h1 class="sr-only">Display and Flight Data</h1>

@* Settings UX pass 2026-09-19 (ADR-0010): connections, APIs and logging moved to Setup /
   Advanced; the cabin chimes and the SayIntentions switch were duplicates of the First
   Officer pages and live only there now. *@

<Section Title="Theme" Hint="Applies live on save">
    <SelectField Label="UI theme" Options="_themeOptions"
                 Hint="Built-in airline themes, plus any JSON theme in config/themes"
                 @bind-Value="_webUi.Value.Theme" />
</Section>

<Section Title="Display">
    <SelectField Label="Weight unit source" Options="UnitSourceOptions"
                 Hint="App = the unit below; Aircraft = follow ProSim's weight unit"
                 @bind-Value="_webUi.Value.UnitSource" />
    <SelectField Label="Weight unit" Options="UnitOptions"
                 Hint="Display only; values are stored in kg"
                 @bind-Value="_webUi.Value.Unit" />
    <BoolField Label="Split-flap animation"
               Hint="Animate the header displays; off snaps characters instantly"
               @bind-Value="_webUi.Value.SolariAnimation" />
</Section>

<Section Title="Loadsheets">
    <BoolField Label="Preliminary loadsheet when refuel starts"
               Hint="Generate and send the prelim as GSX refueling begins"
               @bind-Value="_flightData.Value.AutoPrelimOnRefuel" />
    <BoolField Label="Preliminary loadsheet before departure time"
               Hint="Also send the prelim at STD minus the offset below"
               @bind-Value="_flightData.Value.AutoPrelimAtStd" />
    <NumberField Label="Prelim offset before STD" Suffix="min" Min="0"
                 Disabled="@(!_flightData.Value.AutoPrelimAtStd)"
                 @bind-Value="_flightData.Value.PrelimStdOffsetMinutes" />
    <BoolField Label="Final loadsheet when boarding completes"
               @bind-Value="_flightData.Value.AutoFinalOnBoardingComplete" />
    <NumberField Label="Final loadsheet delay min" Suffix="s" Min="0"
                 Hint="Random dispatcher delay before the final goes out"
                 Disabled="@(!_flightData.Value.AutoFinalOnBoardingComplete)"
                 @bind-Value="_flightData.Value.FinalDelayMinSeconds" />
    <NumberField Label="Final loadsheet delay max" Suffix="s" Min="0"
                 Disabled="@(!_flightData.Value.AutoFinalOnBoardingComplete)"
                 @bind-Value="_flightData.Value.FinalDelayMaxSeconds" />
    <BoolField Label="Send final figures to the MCDU"
               Hint="Push ZFW, ZFWCG and block fuel into INIT B when the final is produced"
               @bind-Value="_flightData.Value.AutoSyncFmsOnFinal" />
</Section>

<Section Title="Checklists">
    <BoolField Label="Allow manual ticks"
               Hint="Hand-tick auto-detected items on the Checklists page"
               @bind-Value="_checklists.Value.AllowManualOverride" />
</Section>

<DirtyBar Visible="@BarVisible"
          Message="@(BarMessage ?? "You have unsaved changes")"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private static readonly IReadOnlyList<(string, string)> UnitSourceOptions =
        [("app", "App"), ("aircraft", "Aircraft")];

    private static readonly IReadOnlyList<(string, string)> UnitOptions =
        [("kg", "kg"), ("lb", "lb")];

    private IReadOnlyList<(string, string)> _themeOptions = [];

    private OptionsDraft<WebUiOptions> _webUi = default!;
    private OptionsDraft<FlightDataOptions> _flightData = default!;
    private OptionsDraft<ChecklistOptions> _checklists = default!;

    protected override void OnInitialized()
    {
        _themeOptions = Themes.ListNames().Select(name => (name, name)).ToList();
        _webUi = Draft(WebUiMonitor);
        _flightData = Draft(FlightDataMonitor);
        _checklists = Draft(ChecklistMonitor);
    }
}
