@page "/settings/app"
@layout SettingsLayout
@inherits SettingsPageBase
@using ProsimCompanion.Core.Flight
@inject IOptionsMonitor<WebUiOptions> WebUiMonitor
@inject IOptionsMonitor<FlightDataOptions> FlightDataMonitor
@inject IOptionsMonitor<AircraftLimitsOptions> AircraftLimitsMonitor
@inject IOptionsMonitor<FuelOptions> FuelMonitor
@inject IOptionsMonitor<ChecklistOptions> ChecklistMonitor
@inject IOptionsMonitor<FlightStatusOptions> FlightStatusMonitor
@inject IOptionsMonitor<FlightStateOptions> FlightStateMonitor
@inject IStringLocalizer T

<PageTitle>@T["appSettings.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["appSettings.heading"]</h1>

@* Settings UX pass 2026-09-19 (ADR-0010): connections, APIs and logging moved to Setup /
   Advanced; the cabin chimes and the SayIntentions switch were duplicates of the First
   Officer pages and live only there now. Since C3 (2026-10-19) a field is one
   <OptionField Draft For /> line over its described property. *@

<Section Title="@T["appSettings.theme.title"]" Hint="@T["appSettings.theme.hint"]">
    <div class="field-hint" style="max-width:640px;">
        @T["appSettings.theme.movedBefore"] <a href="settings/appearance">@T["appSettings.theme.movedLink"]</a> @T["appSettings.theme.movedAfter"]
    </div>
</Section>

<Section Title="@T["appSettings.display.title"]">
    <OptionField Draft="_webUi" For="o => o.UnitSource" />
    <OptionField Draft="_webUi" For="o => o.Unit" />
    <OptionField Draft="_webUi" For="o => o.SolariAnimation" />
</Section>

<Section Title="@T["appSettings.loadsheets.title"]">
    <OptionField Draft="_flightData" For="o => o.AutoPrelimOnRefuel" />
    <OptionField Draft="_flightData" For="o => o.AutoPrelimAtStd" />
    <OptionField Draft="_flightData" For="o => o.PrelimStdOffsetMinutes" />
    <OptionField Draft="_flightData" For="o => o.AutoFinalOnBoardingComplete" />
    <OptionField Draft="_flightData" For="o => o.FinalDelayMinSeconds" />
    <OptionField Draft="_flightData" For="o => o.AutoSyncFmsOnFinal" />
</Section>

<Section Title="@T["appSettings.loadsheets.lmcTitle"]" Hint="@T["appSettings.loadsheets.lmcHint"]">
    <OptionField Draft="_flightData" For="o => o.LmcEnabled" />
    <OptionField Draft="_flightData" For="o => o.LmcMaxPax" />
    <OptionField Draft="_flightData" For="o => o.LmcMaxWeightKg" />
    <OptionField Draft="_flightData" For="o => o.LmcMaxMacShift" />
    <OptionField Draft="_flightData" For="o => o.LmcAutoRevise" />
</Section>

@* Aircraft wind limits (issue #182): A320 published demonstrated values by default. *@
<Section Title="@T["appSettings.aircraftLimits.title"]" Hint="@T["appSettings.aircraftLimits.hint"]">
    <OptionField Draft="_limits" For="o => o.MaxCrosswindTakeoffKt" />
    <OptionField Draft="_limits" For="o => o.MaxCrosswindLandingKt" />
    <OptionField Draft="_limits" For="o => o.MaxCrosswindWetKt" />
    <OptionField Draft="_limits" For="o => o.MaxTailwindTakeoffKt" />
    <OptionField Draft="_limits" For="o => o.MaxTailwindLandingKt" />
    <AdvancedFields>
        <OptionField Draft="_limits" For="o => o.CrosswindRwycc5Kt" />
        <OptionField Draft="_limits" For="o => o.CrosswindRwycc4Kt" />
        <OptionField Draft="_limits" For="o => o.CrosswindRwycc3Kt" />
        <OptionField Draft="_limits" For="o => o.CrosswindRwycc2Kt" />
        <OptionField Draft="_limits" For="o => o.CrosswindRwycc1Kt" />
    </AdvancedFields>
    <div class="field-hint" style="max-width:640px;">@T["appSettings.aircraftLimits.demonstrated"]</div>
</Section>

@* The captain's fuel decision and the holding time (issue #183). *@
<Section Title="@T["appSettings.fuelDecision.title"]" Hint="@T["appSettings.fuelDecision.hint"]">
    <OptionField Draft="_fuel" For="o => o.DecisionAdvice" />
    <OptionField Draft="_fuel" For="o => o.HoldingBurnKgPerHour" />
    <AdvancedFields>
        <OptionField Draft="_fuel" For="o => o.ThunderstormHoldingMinutes" />
        <OptionField Draft="_fuel" For="o => o.MarginalHoldingMinutes" />
        <OptionField Draft="_fuel" For="o => o.BelowMinimaHoldingMinutes" />
    </AdvancedFields>
</Section>

<Section Title="@T["appSettings.flightStatus.title"]" Hint="@T["appSettings.flightStatus.hint"]">
    <OptionField Draft="_flightStatus" For="o => o.GateFinalCallPaxPercent" />
    <OptionField Draft="_flightStatus" For="o => o.GateFinalCallMinutesBeforeStd" />
    <OptionField Draft="_flightStatus" For="o => o.WeatherRefreshMinutes" />
    <OptionField Draft="_flightStatus" For="o => o.TodLeadMinutes" />
    @* Tile order (issue #160): the control is the Flight Status page itself (Edit layout —
       drag or arrows); this row shows what is saved and puts the default back. *@
    <div class="field">
        <label class="field-label">
            @T["appSettings.flightStatus.tileLayout.label"]
            <FieldHint Hint="@T["appSettings.flightStatus.tileLayout.hint"]" />
        </label>
        <div class="field-control" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <span class="row-value-mono">@TileOrderText</span>
            <button type="button" class="btn secondary" @onclick="ResetTileOrder"
                    disabled="@FlightStatusTiles.IsDefault(_flightStatus.Value.TileOrder)">@T["appSettings.flightStatus.tileLayout.reset"]</button>
        </div>
    </div>
</Section>

<Section Title="@T["appSettings.restart.title"]" Hint="@T["appSettings.restart.hint"]">
    <OptionField Draft="_flightState" For="o => o.SnapshotEnabled" />
    <OptionField Draft="_flightState" For="o => o.SnapshotMaxAgeHours" />
</Section>

<Section Title="@T["appSettings.checklists.title"]">
    <OptionField Draft="_checklists" For="o => o.AllowManualOverride" />
</Section>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private OptionsDraft<WebUiOptions> _webUi = default!;
    private OptionsDraft<FlightDataOptions> _flightData = default!;
    private OptionsDraft<AircraftLimitsOptions> _limits = default!;
    private OptionsDraft<FuelOptions> _fuel = default!;
    private OptionsDraft<ChecklistOptions> _checklists = default!;
    private OptionsDraft<FlightStatusOptions> _flightStatus = default!;
    // The flightState section is also edited on the Flight phases page (thresholds); the
    // writer saves changed top-level keys only, so the two pages never clobber each other.
    private OptionsDraft<FlightStateOptions> _flightState = default!;

    protected override void OnInitialized()
    {
        _webUi = Draft(WebUiMonitor);
        _flightData = Draft(FlightDataMonitor);
        _limits = Draft(AircraftLimitsMonitor);
        _fuel = Draft(FuelMonitor);
        _checklists = Draft(ChecklistMonitor);
        _flightStatus = Draft(FlightStatusMonitor);
        _flightState = Draft(FlightStateMonitor);
    }

    // The tile names are the FlightStatusTiles identifiers the setting stores, so they read
    // the same in every language; only the "default order" word is pack text.
    private string TileOrderText => FlightStatusTiles.IsDefault(_flightStatus.Value.TileOrder)
        ? T["appSettings.flightStatus.tileLayout.defaultOrder"].Value
        : string.Join(" → ", FlightStatusTiles.Normalize(_flightStatus.Value.TileOrder));

    private void ResetTileOrder() => _flightStatus.Value.TileOrder = [];
}
