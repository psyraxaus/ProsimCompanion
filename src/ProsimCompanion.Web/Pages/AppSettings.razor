@page "/settings/app"
@layout SettingsLayout
@inherits SettingsPageBase
@using ProsimCompanion.Core.Flight
@inject IOptionsMonitor<WebUiOptions> WebUiMonitor
@inject IOptionsMonitor<FlightDataOptions> FlightDataMonitor
@inject IOptionsMonitor<ChecklistOptions> ChecklistMonitor
@inject IOptionsMonitor<FlightStatusOptions> FlightStatusMonitor
@inject IOptionsMonitor<FlightStateOptions> FlightStateMonitor
@inject IStringLocalizer T

<PageTitle>@T["appSettings.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["appSettings.heading"]</h1>

@* Settings UX pass 2026-09-19 (ADR-0010): connections, APIs and logging moved to Setup /
   Advanced; the cabin chimes and the SayIntentions switch were duplicates of the First
   Officer pages and live only there now. *@

<Section Title="@T["appSettings.theme.title"]" Hint="@T["appSettings.theme.hint"]">
    <div class="field-hint" style="max-width:640px;">
        @T["appSettings.theme.movedBefore"] <a href="settings/appearance">@T["appSettings.theme.movedLink"]</a> @T["appSettings.theme.movedAfter"]
    </div>
</Section>

<Section Title="@T["appSettings.display.title"]">
    <SelectField Label="@T["appSettings.display.unitSource.label"]" Options="UnitSourceOptions"
                 Hint="@T["appSettings.display.unitSource.hint"]"
                 @bind-Value="_webUi.Value.UnitSource" />
    <SelectField Label="@T["appSettings.display.unit.label"]" Options="UnitOptions"
                 Hint="@T["appSettings.display.unit.hint"]"
                 @bind-Value="_webUi.Value.Unit" />
    <BoolField Label="@T["appSettings.display.splitFlap.label"]"
               Hint="@T["appSettings.display.splitFlap.hint"]"
               @bind-Value="_webUi.Value.SolariAnimation" />
</Section>

<Section Title="@T["appSettings.loadsheets.title"]">
    <BoolField Label="@T["appSettings.loadsheets.prelimOnRefuel.label"]"
               Hint="@T["appSettings.loadsheets.prelimOnRefuel.hint"]"
               @bind-Value="_flightData.Value.AutoPrelimOnRefuel" />
    <BoolField Label="@T["appSettings.loadsheets.prelimAtStd.label"]"
               Hint="@T["appSettings.loadsheets.prelimAtStd.hint"]"
               @bind-Value="_flightData.Value.AutoPrelimAtStd" />
    <NumberField Label="@T["appSettings.loadsheets.prelimOffset.label"]" Suffix="min" Min="0"
                 Disabled="@(!_flightData.Value.AutoPrelimAtStd)"
                 @bind-Value="_flightData.Value.PrelimStdOffsetMinutes"
                 Default="_flightData.Defaults.PrelimStdOffsetMinutes" />
    <BoolField Label="@T["appSettings.loadsheets.finalOnBoarding.label"]"
               @bind-Value="_flightData.Value.AutoFinalOnBoardingComplete" />
    <RangeField Label="@T["appSettings.loadsheets.finalDelay.label"]" Suffix="s" Min="0"
                Hint="@T["appSettings.loadsheets.finalDelay.hint"]"
                Disabled="@(!_flightData.Value.AutoFinalOnBoardingComplete)"
                @bind-From="_flightData.Value.FinalDelayMinSeconds" @bind-To="_flightData.Value.FinalDelayMaxSeconds"
                DefaultFrom="_flightData.Defaults.FinalDelayMinSeconds" DefaultTo="_flightData.Defaults.FinalDelayMaxSeconds" />
    <BoolField Label="@T["appSettings.loadsheets.syncFms.label"]"
               Hint="@T["appSettings.loadsheets.syncFms.hint"]"
               @bind-Value="_flightData.Value.AutoSyncFmsOnFinal" />
</Section>

<Section Title="@T["appSettings.flightStatus.title"]" Hint="@T["appSettings.flightStatus.hint"]">
    <NumberField Label="@T["appSettings.flightStatus.finalCallPax.label"]" Suffix="%" Min="1" Max="100"
                 Hint="@T["appSettings.flightStatus.finalCallPax.hint"]"
                 @bind-Value="_flightStatus.Value.GateFinalCallPaxPercent"
                 Default="_flightStatus.Defaults.GateFinalCallPaxPercent" />
    <NumberField Label="@T["appSettings.flightStatus.finalCallStd.label"]" Suffix="min" Min="0"
                 Hint="@T["appSettings.flightStatus.finalCallStd.hint"]"
                 @bind-Value="_flightStatus.Value.GateFinalCallMinutesBeforeStd"
                 Default="_flightStatus.Defaults.GateFinalCallMinutesBeforeStd" />
    <NumberField Label="@T["appSettings.flightStatus.weatherRefresh.label"]" Suffix="min" Min="1" Max="120"
                 Hint="@T["appSettings.flightStatus.weatherRefresh.hint"]"
                 @bind-Value="_flightStatus.Value.WeatherRefreshMinutes"
                 Default="_flightStatus.Defaults.WeatherRefreshMinutes" />
    <NumberField Label="@T["appSettings.flightStatus.todNotice.label"]" Suffix="min" Min="0" Max="60"
                 Hint="@T["appSettings.flightStatus.todNotice.hint"]"
                 @bind-Value="_flightStatus.Value.TodLeadMinutes"
                 Default="_flightStatus.Defaults.TodLeadMinutes" />
    @* Tile order (issue #160): the control is the Flight Status page itself (Edit layout —
       drag or arrows); this row shows what is saved and puts the default back. *@
    <div class="field">
        <label class="field-label">
            @T["appSettings.flightStatus.tileLayout.label"]
            <FieldHint Hint="@T["appSettings.flightStatus.tileLayout.hint"]" />
        </label>
        <div class="field-control" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <span class="row-value-mono">@TileOrderText</span>
            <button type="button" class="btn secondary" @onclick="ResetTileOrder"
                    disabled="@FlightStatusTiles.IsDefault(_flightStatus.Value.TileOrder)">@T["appSettings.flightStatus.tileLayout.reset"]</button>
        </div>
    </div>
</Section>

<Section Title="@T["appSettings.restart.title"]" Hint="@T["appSettings.restart.hint"]">
    <BoolField Label="@T["appSettings.restart.remember.label"]"
               Hint="@T["appSettings.restart.remember.hint"]"
               @bind-Value="_flightState.Value.SnapshotEnabled" />
    <NumberField Label="@T["appSettings.restart.maxAge.label"]" Suffix="h" Min="1" Max="72"
                 Hint="@T["appSettings.restart.maxAge.hint"]"
                 Disabled="@(!_flightState.Value.SnapshotEnabled)"
                 @bind-Value="_flightState.Value.SnapshotMaxAgeHours"
                 Default="_flightState.Defaults.SnapshotMaxAgeHours" />
</Section>

<Section Title="@T["appSettings.checklists.title"]">
    <BoolField Label="@T["appSettings.checklists.manualTicks.label"]"
               Hint="@T["appSettings.checklists.manualTicks.hint"]"
               @bind-Value="_checklists.Value.AllowManualOverride" />
</Section>

<DirtyBar Visible="@BarVisible"
          Message="@BarMessage"
          Tone="BarTone"
          OnSave="Save"
          OnDiscard="Discard" />

@code {
    private IReadOnlyList<(string, string)> UnitSourceOptions =>
        [("app", T["appSettings.display.unitSource.app"].Value), ("aircraft", T["appSettings.display.unitSource.aircraft"].Value)];

    // Units, not prose — the same in every language.
    private static readonly IReadOnlyList<(string, string)> UnitOptions =
        [("kg", "kg"), ("lb", "lb")];


    private OptionsDraft<WebUiOptions> _webUi = default!;
    private OptionsDraft<FlightDataOptions> _flightData = default!;
    private OptionsDraft<ChecklistOptions> _checklists = default!;
    private OptionsDraft<FlightStatusOptions> _flightStatus = default!;
    // The flightState section is also edited on the Flight phases page (thresholds); the
    // writer saves changed top-level keys only, so the two pages never clobber each other.
    private OptionsDraft<FlightStateOptions> _flightState = default!;

    protected override void OnInitialized()
    {
        _webUi = Draft(WebUiMonitor);
        _flightData = Draft(FlightDataMonitor);
        _checklists = Draft(ChecklistMonitor);
        _flightStatus = Draft(FlightStatusMonitor);
        _flightState = Draft(FlightStateMonitor);
    }

    // The tile names are the FlightStatusTiles identifiers the setting stores, so they read
    // the same in every language; only the "default order" word is pack text.
    private string TileOrderText => FlightStatusTiles.IsDefault(_flightStatus.Value.TileOrder)
        ? T["appSettings.flightStatus.tileLayout.defaultOrder"].Value
        : string.Join(" → ", FlightStatusTiles.Normalize(_flightStatus.Value.TileOrder));

    private void ResetTileOrder() => _flightStatus.Value.TileOrder = [];
}
