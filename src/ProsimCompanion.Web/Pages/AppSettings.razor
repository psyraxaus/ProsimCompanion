@page "/settings/app"
@using ProsimCompanion.Web.Theming
@implements IDisposable
@inject IOptionsMonitor<ProsimOptions> ProsimMonitor
@inject IOptionsMonitor<WebUiOptions> WebUiMonitor
@inject IOptionsMonitor<LoggingOptions> LoggingMonitor
@inject IOptionsMonitor<SayIntentionsOptions> SayIntentionsMonitor
@inject IOptionsMonitor<FlightDataOptions> FlightDataMonitor
@inject IOptionsMonitor<CabinOptions> CabinMonitor
@inject IOptionsMonitor<ChecklistOptions> ChecklistMonitor
@inject JsonSettingsFile SettingsFile
@inject ThemeCatalog Themes

<PageTitle>App Settings — ProsimCompanion</PageTitle>
<h1 class="sr-only">App Settings</h1>

<div class="panel" style="padding-bottom:96px;">

    <Section Title="Theme" Hint="Applies live on save">
        <SelectField Label="UI theme" Options="_themeOptions"
                     Hint="Built-in airline themes, plus any JSON in config/themes (Prosim2GSX theme format)"
                     @bind-Value="_theme" />
    </Section>

    <Section Title="Display">
        <BoolField Label="Solari animation"
                   Hint="Animate the split-flap header displays; off snaps characters instantly"
                   @bind-Value="_solari" />
    </Section>

    <Section Title="Audio Cues">
        <BoolField Label="Ding on startup"
                   Hint="Cabin chime when the application starts"
                   @bind-Value="_dingStartup" />
        <BoolField Label="Ding on final loadsheet"
                   Hint="Cabin chime when the final loadsheet is transmitted"
                   @bind-Value="_dingFinal" />
    </Section>

    <Section Title="ProSim">
        <TextField Label="Host" Placeholder="localhost"
                   Hint="Hostname or IP of the machine running ProSim System"
                   @bind-Value="_prosimHost" />
        <TextField Label="SDK path"
                   Hint="Folder containing ProSimSDK.dll (loaded at runtime, never bundled). Empty = ProSim subsystem disabled"
                   @bind-Value="_prosimSdkPath" />
        <TextField Label="API key" Password="true"
                   Hint="Optional — newer ProSim builds only; leave empty when not used"
                   @bind-Value="_prosimApiKey" />
        <NumberField Label="Reconnect interval" Suffix="ms" Min="500"
                     @bind-Value="_prosimReconnectMs" />
    </Section>

    <Section Title="Web Interface" Hint="Bind/port also editable in the desktop app (lockout prevention)">
        <NumberField Label="Port" Min="1024" Max="65535"
                     Hint="Takes effect after restarting the application"
                     @bind-Value="_webPort" />
        <BoolField Label="Expose to LAN"
                   Hint="Bind all interfaces so tablets / a second PC can connect. Non-local devices authenticate via the QR code in the desktop app"
                   @bind-Value="_webLan" />
        <div class="field-hint" style="max-width:560px;">
            The access token and onboarding QR code live in the desktop app's web-server card —
            they are deliberately not shown here.
        </div>
    </Section>

    <Section Title="Integrations">
        <BoolField Label="Use SayIntentions"
                   Hint="ATIS/METAR/TAF weather, CPDLC station display, and arrival-gate send"
                   @bind-Value="_sayIntentions" />
        <BoolField Label="Auto prelim loadsheet on refuel"
                   Hint="Generate + send the preliminary loadsheet when GSX refueling starts"
                   @bind-Value="_autoPrelim" />
        <BoolField Label="Auto final loadsheet on boarding complete"
                   @bind-Value="_autoFinal" />
        <NumberField Label="Final loadsheet delay min" Suffix="s" Min="0"
                     Hint="Randomized dispatcher delay before the final goes out"
                     @bind-Value="_finalDelayMin" />
        <NumberField Label="Final loadsheet delay max" Suffix="s" Min="0"
                     @bind-Value="_finalDelayMax" />
        <BoolField Label="Auto-sync FMS on final loadsheet"
                   Hint="Push ZFW/ZFWCG/block into the MCDU INIT B when the final is produced"
                   @bind-Value="_autoSyncFms" />
        <BoolField Label="Allow manual checklist override"
                   Hint="Hand-tick auto-detected checklist items on the Checklists page (Prosim2GSX behaviour)"
                   @bind-Value="_allowChecklistOverride" />
        <BoolField Label="Auto prelim at STD offset"
                   Hint="Also generate the prelim at STD minus the offset below (Prosim2GSX timing; STD from the OFP or the Loadsheet page)"
                   @bind-Value="_autoPrelimAtStd" />
        <NumberField Label="Prelim STD offset" Suffix="min" Min="0"
                     @bind-Value="_prelimStdOffset" />
    </Section>

    <Section Title="Logging" Hint="Applies live, no restart">
        <SelectField Label="Capture level" Options="LevelOptions"
                     Hint="Minimum level recorded to the log file and the Logs page"
                     @bind-Value="_logLevel" />
        <BoolField Label="Wire trace"
                   Hint="Raw GSX / gateway frames to a separate CMTrace file — verbose by design"
                   @bind-Value="_wireTrace" />
    </Section>

</div>

<DirtyBar Visible="@(IsDirty || _barMessage is not null)"
          Message="@(_barMessage ?? "You have unsaved changes")"
          Tone="_barTone"
          OnSave="Save"
          OnDiscard="LoadDraft" />

@code {
    private static readonly IReadOnlyList<(string, string)> LevelOptions =
    [
        ("Verbose", "Verbose"),
        ("Debug", "Debug"),
        ("Information", "Information"),
        ("Warning", "Warning"),
        ("Error", "Error"),
        ("Fatal", "Fatal"),
    ];

    private IReadOnlyList<(string, string)> _themeOptions = [];

    private string _theme = "Default";
    private string _prosimHost = "";
    private string _prosimSdkPath = "";
    private string _prosimApiKey = "";
    private int _prosimReconnectMs;
    private int _webPort;
    private bool _webLan;
    private string _logLevel = "Information";
    private bool _wireTrace;
    private bool _sayIntentions;
    private bool _autoPrelim;
    private bool _autoFinal;
    private int _finalDelayMin;
    private int _finalDelayMax;
    private bool _autoSyncFms;
    private bool _autoPrelimAtStd;
    private int _prelimStdOffset;
    private bool _solari;
    private bool _dingStartup;
    private bool _dingFinal;
    private bool _allowChecklistOverride;

    // The draft grew past tuple sanity — a joined string is an adequate dirty fingerprint.
    private string _baseline = "";
    private string? _barMessage;
    private DirtyBar.MessageTone _barTone = DirtyBar.MessageTone.Unsaved;
    private Timer? _savedMessageTimer;

    private bool IsDirty => Snapshot() != _baseline;

    private string Snapshot() => string.Join("|",
        _theme, _prosimHost, _prosimSdkPath, _prosimApiKey, _prosimReconnectMs,
        _webPort, _webLan, _logLevel, _wireTrace,
        _sayIntentions, _autoPrelim, _autoFinal, _finalDelayMin, _finalDelayMax, _autoSyncFms,
        _autoPrelimAtStd, _prelimStdOffset, _solari, _dingStartup, _dingFinal, _allowChecklistOverride);

    protected override void OnInitialized()
    {
        _themeOptions = Themes.ListNames().Select(name => (name, name)).ToList();
        LoadDraft();
    }

    private void LoadDraft()
    {
        var prosim = ProsimMonitor.CurrentValue;
        var webUi = WebUiMonitor.CurrentValue;
        var logging = LoggingMonitor.CurrentValue;

        _theme = webUi.Theme;
        _prosimHost = prosim.Host;
        _prosimSdkPath = prosim.SdkPath;
        _prosimApiKey = prosim.ApiKey ?? "";
        _prosimReconnectMs = prosim.ReconnectIntervalMs;
        _webPort = webUi.Port;
        _webLan = webUi.BindToAllInterfaces;
        _logLevel = logging.DefaultLevel;
        _wireTrace = logging.WireTrace;

        var sayIntentions = SayIntentionsMonitor.CurrentValue;
        var flightData = FlightDataMonitor.CurrentValue;
        _sayIntentions = sayIntentions.Enabled;
        _autoPrelim = flightData.AutoPrelimOnRefuel;
        _autoFinal = flightData.AutoFinalOnBoardingComplete;
        _finalDelayMin = flightData.FinalDelayMinSeconds;
        _finalDelayMax = flightData.FinalDelayMaxSeconds;
        _autoSyncFms = flightData.AutoSyncFmsOnFinal;
        _autoPrelimAtStd = flightData.AutoPrelimAtStd;
        _prelimStdOffset = flightData.PrelimStdOffsetMinutes;
        _solari = WebUiMonitor.CurrentValue.SolariAnimation;
        var cabin = CabinMonitor.CurrentValue;
        _dingStartup = cabin.DingOnStartup;
        _dingFinal = cabin.DingOnFinal;
        _allowChecklistOverride = ChecklistMonitor.CurrentValue.AllowManualOverride;

        _baseline = Snapshot();
        _barMessage = null;
    }

    private void Save()
    {
        try
        {
            SettingsFile.Update(root =>
            {
                var prosim = JsonSettingsFile.GetOrCreateSection(root, ProsimOptions.SectionName);
                prosim["host"] = _prosimHost.Trim();
                prosim["sdkPath"] = _prosimSdkPath.Trim();
                prosim["apiKey"] = _prosimApiKey.Length == 0 ? null : _prosimApiKey;
                prosim["reconnectIntervalMs"] = _prosimReconnectMs;

                var webUi = JsonSettingsFile.GetOrCreateSection(root, WebUiOptions.SectionName);
                webUi["port"] = _webPort;
                webUi["bindToAllInterfaces"] = _webLan;
                webUi["theme"] = _theme;
                webUi["solariAnimation"] = _solari;

                var logging = JsonSettingsFile.GetOrCreateSection(root, LoggingOptions.SectionName);
                logging["defaultLevel"] = _logLevel;
                logging["wireTrace"] = _wireTrace;

                var sayIntentions = JsonSettingsFile.GetOrCreateSection(root, SayIntentionsOptions.SectionName);
                sayIntentions["enabled"] = _sayIntentions;

                var flightData = JsonSettingsFile.GetOrCreateSection(root, FlightDataOptions.SectionName);
                flightData["autoPrelimOnRefuel"] = _autoPrelim;
                flightData["autoFinalOnBoardingComplete"] = _autoFinal;
                flightData["finalDelayMinSeconds"] = _finalDelayMin;
                flightData["finalDelayMaxSeconds"] = _finalDelayMax;
                flightData["autoSyncFmsOnFinal"] = _autoSyncFms;
                flightData["autoPrelimAtStd"] = _autoPrelimAtStd;
                flightData["prelimStdOffsetMinutes"] = _prelimStdOffset;

                var cabin = JsonSettingsFile.GetOrCreateSection(root, CabinOptions.SectionName);
                cabin["dingOnStartup"] = _dingStartup;
                cabin["dingOnFinal"] = _dingFinal;

                var checklists = JsonSettingsFile.GetOrCreateSection(root, ChecklistOptions.SectionName);
                checklists["allowManualOverride"] = _allowChecklistOverride;
            });

            _baseline = Snapshot();
            _barMessage = "Saved.";
            _barTone = DirtyBar.MessageTone.Info;
            _savedMessageTimer?.Dispose();
            _savedMessageTimer = new Timer(_ => _ = InvokeAsync(() =>
            {
                _barMessage = null;
                _barTone = DirtyBar.MessageTone.Unsaved;
                StateHasChanged();
            }), null, TimeSpan.FromSeconds(1.5), Timeout.InfiniteTimeSpan);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _barMessage = $"Save failed: {ex.Message}";
            _barTone = DirtyBar.MessageTone.Error;
        }
    }

    public void Dispose() => _savedMessageTimer?.Dispose();
}
