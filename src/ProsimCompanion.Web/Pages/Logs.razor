@page "/settings/logs"
@page "/logs"
@layout SettingsLayout
@using System.Text.Json
@using Microsoft.JSInterop
@using ProsimCompanion.Core.Logging
@implements IDisposable
@inject LogBufferStore Buffer
@inject IOptionsMonitor<LoggingOptions> LoggingMonitor
@inject IOptionsMonitor<TelemetryApiOptions> TelemetryMonitor
@inject IOptionsMonitor<DiagnosticsOptions> DiagnosticsMonitor
@inject ProsimCompanion.Core.Diagnostics.IAppBuildInfo Build
@inject IJSRuntime JS
@inject SettingsWriter Writer
@inject IStringLocalizer T

<PageTitle>@T["logs.pageTitle"]</PageTitle>
<h1 class="sr-only">@T["logs.heading"]</h1>

@* Only the page's own labels, hints and buttons are pack text (ADR-0014): the log lines, the
   level names and the source names render exactly as logged — the probes grep them. *@

<div class="panel">

    <Section Title="@T["logs.capture.title"]" Hint="@T["logs.capture.hint"]">
        <SelectField Label="@T["logs.capture.level"]"
                     Options="LevelOptions"
                     Value="@LoggingMonitor.CurrentValue.DefaultLevel"
                     ValueChanged="SetCaptureLevel" />
        <BoolField Label="@T["logs.capture.wireTrace.label"]"
                   Hint="@T["logs.capture.wireTrace.hint"]"
                   Value="@LoggingMonitor.CurrentValue.WireTrace"
                   ValueChanged="SetWireTrace" />
        <SelectField Label="@T["logs.capture.mirror.label"]"
                     Hint="@T["logs.capture.mirror.hint"]"
                     Options="MirrorOptions"
                     Value="@MirrorValue"
                     ValueChanged="SetMirrorToSession" />
        <BoolField Label="@T["logs.capture.telemetry.label"]"
                   Hint="@T["logs.capture.telemetry.hint"]"
                   Value="@TelemetryMonitor.CurrentValue.Enabled"
                   ValueChanged="SetTelemetryApi" />
        <div class="field-hint" style="margin-top:4px;">
            @T["logs.capture.totals", Buffer.WarningCount, Buffer.ErrorCount]
            @T["logs.capture.filesBefore"] <code>%LOCALAPPDATA%\ProsimCompanion\logs</code> @T["logs.capture.filesAfter"]
        </div>
    </Section>

    <Section Title="@T["logs.support.title"]" Hint="@T["logs.support.hint"]">
        <NumberField Label="@T["logs.support.sessions.label"]"
                     Hint="@T["logs.support.sessions.hint"]"
                     TValue="int" Min="@DiagnosticsOptions.MinSessions.ToString()" Max="@DiagnosticsOptions.MaxSessions.ToString()" Step="1"
                     Value="@DiagnosticsMonitor.CurrentValue.BundleSessionCount"
                     ValueChanged="SetBundleSessions" />
        <NumberField Label="@T["logs.support.days.label"]"
                     Hint="@T["logs.support.days.hint"]"
                     TValue="int" Min="@DiagnosticsOptions.MinLogDays.ToString()" Max="@DiagnosticsOptions.MaxLogDays.ToString()" Step="1"
                     Value="@DiagnosticsMonitor.CurrentValue.BundleLogDays"
                     ValueChanged="SetBundleLogDays" />
        <BoolField Label="@T["logs.support.wire.label"]"
                   Hint="@T["logs.support.wire.hint"]"
                   Value="@DiagnosticsMonitor.CurrentValue.IncludeWireTrace"
                   ValueChanged="SetIncludeWireTrace" />
        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:10px;">
            <a class="btn primary" href="@BundleUrl" download>@T["logs.support.export"]</a>
            <button type="button" class="btn secondary" @onclick="CopyVersionAsync">@CopyLabel</button>
        </div>
        <div class="field-hint" style="margin-top:6px;">
            @T["logs.support.bundleBefore"] <code>@Build.Describe()</code> @T["logs.support.bundleAfter"]
        </div>
    </Section>

    <Section Title="@T["logs.log.title"]" Hint="@T["logs.log.hint"]">
        <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-bottom:10px;">
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary);">
                @T["logs.log.minLevel"]
                <select class="select" style="max-width:140px;" @bind="_minLevel">
                    <option>Verbose</option>
                    <option>Debug</option>
                    <option>Information</option>
                    <option>Warning</option>
                    <option>Error</option>
                </select>
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary);">
                @T["logs.log.text"]
                <input type="text" class="text-input" style="width:220px;" placeholder="@T["logs.log.filterPlaceholder"]"
                       autocomplete="off" spellcheck="false"
                       @bind="_filter" @bind:event="oninput" />
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary);">
                <input type="checkbox" class="checkbox" @bind="_paused" /> @T["logs.log.pause"]
            </label>
        </div>

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>@T["logs.log.time"]</th><th>@T["logs.log.level"]</th><th>@T["logs.log.source"]</th><th>@T["logs.log.message"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in _visible)
                    {
                        <tr>
                            <td class="mono" style="white-space:nowrap;">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                            <td><span class="pill @LevelTone(entry.Level)">@entry.Level</span></td>
                            <td class="mono" style="white-space:nowrap;">@ShortSource(entry.Source)</td>
                            <td class="mono">
                                @entry.Message
                                @if (entry.Exception is not null)
                                {
                                    <pre style="white-space:pre-wrap; margin:4px 0 0 0; opacity:0.8;">@entry.Exception</pre>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Section>

</div>

@code {
    private const int MaxRows = 300;

    // Serilog level names as the log carries them — never translated.
    private static readonly IReadOnlyList<(string, string)> LevelOptions =
    [
        ("Verbose", "Verbose"),
        ("Debug", "Debug"),
        ("Information", "Information"),
        ("Warning", "Warning"),
        ("Error", "Error"),
        ("Fatal", "Fatal"),
    ];

    private static readonly Dictionary<string, int> LevelRank = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Verbose"] = 0,
        ["Debug"] = 1,
        ["Information"] = 2,
        ["Warning"] = 3,
        ["Error"] = 4,
        ["Fatal"] = 5,
    };

    private IReadOnlyList<LogEntry> _visible = [];
    private string _minLevel = "Information";
    private string _filter = "";
    private bool _paused;
    private Timer? _timer;

    private void SetCaptureLevel(string level)
    {
        if (!string.IsNullOrWhiteSpace(level))
        {
            Writer.Set<LoggingOptions, string>(o => o.DefaultLevel, level);
        }
    }

    private void SetWireTrace(bool enabled)
        => Writer.Set<LoggingOptions, bool>(o => o.WireTrace, enabled);

    private IReadOnlyList<(string, string)> MirrorOptions =>
    [
        ("warningAndAbove", T["logs.capture.mirror.warningAndAbove"].Value),
        ("errorAndAbove", T["logs.capture.mirror.errorAndAbove"].Value),
        ("off", T["logs.capture.mirror.off"].Value),
    ];

    private string MirrorValue
        => JsonNamingPolicy.CamelCase.ConvertName(LoggingMonitor.CurrentValue.MirrorToSession.ToString());

    private void SetMirrorToSession(string value)
    {
        if (Enum.TryParse<LogMirrorLevel>(value, ignoreCase: true, out var level))
        {
            Writer.Set<LoggingOptions, LogMirrorLevel>(o => o.MirrorToSession, level);
        }
    }

    // Moved here from App Settings (ADR-0010): it is a log-serving switch, and this page is
    // the no-dirty-bar page, so it applies live like the other capture controls.
    private void SetTelemetryApi(bool enabled)
        => Writer.Set<TelemetryApiOptions, bool>(o => o.Enabled, enabled);

    private void SetBundleSessions(int count)
        => Writer.Set<DiagnosticsOptions, int>(
            o => o.BundleSessionCount, Math.Clamp(count, DiagnosticsOptions.MinSessions, DiagnosticsOptions.MaxSessions));

    private void SetBundleLogDays(int days)
        => Writer.Set<DiagnosticsOptions, int>(
            o => o.BundleLogDays, Math.Clamp(days, DiagnosticsOptions.MinLogDays, DiagnosticsOptions.MaxLogDays));

    private void SetIncludeWireTrace(bool include)
        => Writer.Set<DiagnosticsOptions, bool>(o => o.IncludeWireTrace, include);

    // Relative so the onboarded browser cookie authenticates — no token in the URL, and
    // the link works through whichever host name the tablet used to reach us.
    private string BundleUrl
    {
        get
        {
            var o = DiagnosticsMonitor.CurrentValue;
            return $"api/diagnostics/bundle?sessions={o.BundleSessionCount}&days={o.BundleLogDays}&wire={(o.IncludeWireTrace ? "true" : "false")}";
        }
    }

    private enum CopyState { Idle, Copied, Failed }

    private CopyState _copyState;

    // Resolved at render so the button follows a language change while the result shows.
    private string CopyLabel => _copyState switch
    {
        CopyState.Copied => T["logs.support.copied"].Value,
        CopyState.Failed => T["logs.support.copyFailed"].Value,
        _ => T["logs.support.copyVersion"].Value,
    };

    private async Task CopyVersionAsync()
    {
        bool ok;
        try
        {
            ok = await JS.InvokeAsync<bool>("prosimCompanion.copyText", Build.Describe());
        }
        catch (JSException)
        {
            ok = false;
        }

        _copyState = ok ? CopyState.Copied : CopyState.Failed;
        StateHasChanged();
        await Task.Delay(1500);
        _copyState = CopyState.Idle;
    }

    protected override void OnInitialized()
    {
        Refresh();
        // The log buffer intentionally has no per-event fan-out (logging must stay cheap),
        // so this page polls — the only page that still does.
        _timer = new Timer(_ =>
        {
            if (!_paused)
            {
                _ = InvokeAsync(() =>
                {
                    Refresh();
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
    }

    public void Dispose() => _timer?.Dispose();

    private void Refresh()
    {
        var minRank = LevelRank.GetValueOrDefault(_minLevel, 2);
        var filter = _filter.Trim();

        _visible = Buffer.Snapshot()
            .Where(entry => LevelRank.GetValueOrDefault(entry.Level, 2) >= minRank)
            .Where(entry => filter.Length == 0
                || entry.Message.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || entry.Source.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .Take(MaxRows)
            .ToList();
    }

    private static string ShortSource(string source)
    {
        var lastDot = source.LastIndexOf('.');
        return lastDot >= 0 && lastDot < source.Length - 1 ? source[(lastDot + 1)..] : source;
    }

    private static string LevelTone(string level) => level switch
    {
        "Warning" => "tone-warn",
        "Error" or "Fatal" => "tone-bad",
        "Information" => "tone-ok",
        _ => "tone-neutral",
    };
}
