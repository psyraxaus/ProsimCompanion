@page "/logs"
@using ProsimCompanion.Core.Logging
@implements IDisposable
@inject LogBufferStore Buffer
@inject IOptionsMonitor<LoggingOptions> LoggingMonitor
@inject JsonSettingsFile SettingsFile

<PageTitle>Logs — ProsimCompanion</PageTitle>
<h1 class="sr-only">Logs</h1>

<div class="panel">

    <Section Title="Capture" Hint="What gets recorded — applies live, no restart">
        <SelectField Label="Capture level"
                     Options="LevelOptions"
                     Value="@LoggingMonitor.CurrentValue.DefaultLevel"
                     ValueChanged="SetCaptureLevel" />
        <BoolField Label="Wire trace"
                   Hint="Raw GSX / gateway frames to a separate CMTrace file"
                   Value="@LoggingMonitor.CurrentValue.WireTrace"
                   ValueChanged="SetWireTrace" />
        <div class="field-hint" style="margin-top:4px;">
            Session totals — warnings: @Buffer.WarningCount · errors: @Buffer.ErrorCount.
            The rolling files in <code>%LOCALAPPDATA%\ProsimCompanion\logs</code> are CMTrace
            format for live viewing in CMTrace.
        </div>
    </Section>

    <Section Title="Log" Hint="View filter of captured entries">
        <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-bottom:10px;">
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary);">
                Min level
                <select class="select" style="max-width:140px;" @bind="_minLevel">
                    <option>Verbose</option>
                    <option>Debug</option>
                    <option>Information</option>
                    <option>Warning</option>
                    <option>Error</option>
                </select>
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary);">
                Text
                <input type="text" class="text-input" style="width:220px;" placeholder="text or source…"
                       autocomplete="off" spellcheck="false"
                       @bind="_filter" @bind:event="oninput" />
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary);">
                <input type="checkbox" class="checkbox" @bind="_paused" /> Pause
            </label>
        </div>

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>Time</th><th>Level</th><th>Source</th><th>Message</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in _visible)
                    {
                        <tr>
                            <td class="mono" style="white-space:nowrap;">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                            <td><span class="pill @LevelTone(entry.Level)">@entry.Level</span></td>
                            <td class="mono" style="white-space:nowrap;">@ShortSource(entry.Source)</td>
                            <td class="mono">
                                @entry.Message
                                @if (entry.Exception is not null)
                                {
                                    <pre style="white-space:pre-wrap; margin:4px 0 0 0; opacity:0.8;">@entry.Exception</pre>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Section>

</div>

@code {
    private const int MaxRows = 300;

    private static readonly IReadOnlyList<(string, string)> LevelOptions =
    [
        ("Verbose", "Verbose"),
        ("Debug", "Debug"),
        ("Information", "Information"),
        ("Warning", "Warning"),
        ("Error", "Error"),
        ("Fatal", "Fatal"),
    ];

    private static readonly Dictionary<string, int> LevelRank = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Verbose"] = 0,
        ["Debug"] = 1,
        ["Information"] = 2,
        ["Warning"] = 3,
        ["Error"] = 4,
        ["Fatal"] = 5,
    };

    private IReadOnlyList<LogEntry> _visible = [];
    private string _minLevel = "Information";
    private string _filter = "";
    private bool _paused;
    private Timer? _timer;

    private void SetCaptureLevel(string level)
    {
        if (!string.IsNullOrWhiteSpace(level))
        {
            SettingsFile.Update(root =>
                JsonSettingsFile.GetOrCreateSection(root, LoggingOptions.SectionName)["defaultLevel"] = level);
        }
    }

    private void SetWireTrace(bool enabled)
        => SettingsFile.Update(root =>
            JsonSettingsFile.GetOrCreateSection(root, LoggingOptions.SectionName)["wireTrace"] = enabled);

    protected override void OnInitialized()
    {
        Refresh();
        // The log buffer intentionally has no per-event fan-out (logging must stay cheap),
        // so this page polls — the only page that still does.
        _timer = new Timer(_ =>
        {
            if (!_paused)
            {
                _ = InvokeAsync(() =>
                {
                    Refresh();
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
    }

    public void Dispose() => _timer?.Dispose();

    private void Refresh()
    {
        var minRank = LevelRank.GetValueOrDefault(_minLevel, 2);
        var filter = _filter.Trim();

        _visible = Buffer.Snapshot()
            .Where(entry => LevelRank.GetValueOrDefault(entry.Level, 2) >= minRank)
            .Where(entry => filter.Length == 0
                || entry.Message.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || entry.Source.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .Take(MaxRows)
            .ToList();
    }

    private static string ShortSource(string source)
    {
        var lastDot = source.LastIndexOf('.');
        return lastDot >= 0 && lastDot < source.Length - 1 ? source[(lastDot + 1)..] : source;
    }

    private static string LevelTone(string level) => level switch
    {
        "Warning" => "tone-warn",
        "Error" or "Fatal" => "tone-bad",
        "Information" => "tone-ok",
        _ => "tone-neutral",
    };
}
