@inherits LayoutComponentBase
@using ProsimCompanion.Core.Aircraft
@implements IDisposable
@inject ConnectionStatusStore Status
@inject IProsimDataRefs DataRefs

<ThemeStyle />

<div class="app">
    <header class="header">
        <div class="brand">
            <span class="brand-name">PROSIMCOMPANION</span>
            <span class="brand-tag">WEB</span>
        </div>
        <div class="flap-center">
            <split-flap text="@_flightNumber" count="8"></split-flap>
            <span class="flap-label">FLT NO</span>
        </div>
        <div class="flap-right">
            <div class="flap-block">
                <split-flap mode="utc-time" count="6"></split-flap>
                <span class="flap-label">UTC</span>
            </div>
            <div class="flap-block">
                <split-flap mode="utc-date" count="5"></split-flap>
                <span class="flap-label">DATE</span>
            </div>
            <span class="conn-indicator" title="ProSim connection">
                <span class="conn-dot @ProsimDotClass"></span>
                <span class="conn-label">ProSim</span>
            </span>
        </div>
    </header>

    @* Two-tier nav (declutter pass): six primary groups; the second row appears only for
       groups with more than one page. The active group is derived from the current URL so
       deep links land with the right rows lit. *@
    <div class="tabbar-wrap">
        <button type="button" class="chevron chevron-left" aria-label="Scroll tabs left">‹</button>
        <nav class="tabbar">
            @foreach (var group in Groups)
            {
                <a class="tab @(group == ActiveGroup ? "active" : null)"
                   href="@group.Items[0].Href">@group.Name</a>
            }
        </nav>
        <button type="button" class="chevron chevron-right" aria-label="Scroll tabs right">›</button>
    </div>
    @if (ActiveGroup is { Items.Count: > 1 } active)
    {
        <nav class="tabbar subtabs">
            @foreach (var (label, href) in active.Items)
            {
                <NavLink class="tab" href="@href"
                         Match="@(href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">@label</NavLink>
            }
        </nav>
    }

    <main class="main">
        @Body
    </main>
</div>

@code {
    private sealed record NavGroup(string Name, IReadOnlyList<(string Label, string Href)> Items);

    private static readonly NavGroup[] Groups =
    [
        new("FLIGHT", [("Flight Status", "")]),
        new("EFB", [("Flight Data", "flight"), ("INIT", "init"), ("Performance", "perf"),
            ("W&B", "wnb"), ("Weather", "weather")]),
        new("GSX", [("Status", "gsx"), ("Settings", "settings/gsx")]),
        new("FO", [("Speech", "speech"), ("Checklists", "checklists"), ("Tech Log", "techlog"),
            ("Duty Day", "day"), ("Settings", "settings/speech")]),
        new("AUDIO", [("Status", "audio"), ("Settings", "settings/audio")]),
        new("SYSTEM", [("Logs", "logs"), ("App Settings", "settings/app")]),
    ];

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private NavGroup ActiveGroup
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            var query = path.IndexOf('?');
            if (query >= 0)
            {
                path = path[..query];
            }

            path = path.TrimEnd('/');
            // Longest matching href wins so "settings/gsx" beats "" and lands in GSX, not FLIGHT.
            return Groups
                .SelectMany(g => g.Items.Select(i => (Group: g, i.Href)))
                .Where(x => x.Href.Length == 0
                    ? path.Length == 0
                    : path.Equals(x.Href, StringComparison.OrdinalIgnoreCase)
                        || path.StartsWith(x.Href + "/", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(x => x.Href.Length)
                .Select(x => x.Group)
                .FirstOrDefault() ?? Groups[0];
        }
    }

    private IDataRefSubscription? _flightNumberSub;
    private string _flightNumber = "";

    private string ProsimDotClass => Status.Snapshot()
        .FirstOrDefault(pair => pair.Key == Subsystems.Prosim).Value switch
    {
        ConnectionState.Connected => "open",
        ConnectionState.Connecting => "reconnecting",
        ConnectionState.Disabled => "connecting",
        _ => "closed",
    };

    protected override void OnInitialized()
    {
        Status.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
        _flightNumberSub = DataRefs.Subscribe("efb.cids.flightNumber", DataRefTier.Infrequent);
        _flightNumberSub.ValueChanged += OnChanged;
        _flightNumber = _flightNumberSub.GetValue("");
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private void OnChanged(object? sender, EventArgs e)
        // Store/SDK events fire on the writer's thread; marshal into the circuit.
        => _ = InvokeAsync(() =>
        {
            _flightNumber = _flightNumberSub?.GetValue("") ?? "";
            StateHasChanged();
        });

    public void Dispose()
    {
        Status.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        if (_flightNumberSub is not null)
        {
            _flightNumberSub.ValueChanged -= OnChanged;
            _flightNumberSub.Dispose();
        }
    }
}
