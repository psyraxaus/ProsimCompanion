@inherits StoreObserverLayout
@using System.Reflection
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Core.Aircraft.Ofp
@using ProsimCompanion.Core.Configuration
@using ProsimCompanion.Core.Profiles
@using ProsimCompanion.Core.Theming
@using ProsimCompanion.Web.Theming
@inject ConnectionStatusStore Status
@inject SpeechStatusStore Speech
@inject IProsimDataRefs DataRefs
@inject IOptionsMonitor<WebUiOptions> WebUi
@inject UpdateStore Updates
@inject ThemeCatalog Themes
@inject ThemeLogoStore Logos
@inject AircraftProfileService Profiles
@inject OfpStore Ofp

<ThemeStyle />

<div class="app">
    @* Header (ADR-0011, canvas EFBHeader): brand badge · aircraft block · FLT NO flap ·
       SIM/UTC clock (split-flap stays on the clock — owner decision) · the theme's uploaded
       airline logo (Settings → Appearance) · ProSim connection dot. *@
    <header class="header">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"><AppIcon Name="plane" Size="20" /></span>
            <span class="brand-text">
                <span class="brand-name">PROSIM<span class="gold">COMPANION</span></span>
                <span class="brand-tag">Electronic Flight Bag</span>
            </span>
        </div>

        <div class="header-aircraft">
            <span class="header-block">
                <span class="label-caps">Aircraft</span>
                <span class="header-value mono">@AircraftType</span>
            </span>
            <span class="header-block">
                <span class="label-caps">Registration</span>
                <span class="header-value mono">@AircraftReg</span>
            </span>
        </div>

        <div class="flap-center">
            <split-flap text="@_flightNumber" count="8" animate="@SolariMode"></split-flap>
            <span class="flap-label">FLT NO</span>
        </div>

        <div class="flap-right">
            @* Sim-time clock (issue #71): while ProSim streams a fresh simulator.zuluTime the
               flap is text-driven from the server (label SIM); on disconnect/staleness the
               mode attribute returns and app.js resumes the browser-side UTC self-tick.
               Owner decision 2026-09-20: the date flap and the header theme picker are gone
               (the picker lives on Settings → Appearance); the theme's own logo, when the
               pilot has uploaded one, takes their place. *@
            <div class="flap-block">
                <split-flap mode="@(_simClockActive ? null : "utc-time")"
                            text="@(_simClockActive ? _simTimeText : null)"
                            count="6" animate="@SolariMode"></split-flap>
                <span class="flap-label">@(_simClockActive ? "SIM" : "UTC")</span>
            </div>

            @if (LogoSlug is { } logoSlug)
            {
                <img class="brand-logo" src="api/theme-logo/@(logoSlug)?v=@Logos.Version"
                     alt="@ThemeName" title="@ThemeName" />
            }

            <span class="conn-indicator" title="ProSim connection">
                <span class="conn-dot @ProsimDotClass"></span>
                <span class="conn-label">ProSim</span>
            </span>
        </div>
    </header>

    @* Update-available banner (Prosim2GSX parity, #6): under the header, dismissible for the
       run; re-announces only for a NEWER release. *@
    @if (_update.UpdateAvailable && !_update.Dismissed)
    {
        <div class="update-banner" role="status">
            <span>
                New Stable Version
                <a href="@_update.ReleaseUrl" target="_blank" rel="noopener">@_update.LatestVersion</a>
                available! (running @_update.CurrentVersion)
            </span>
            <button type="button" class="update-banner-close" aria-label="Dismiss update notice"
                    @onclick="Updates.Dismiss">×</button>
        </div>
    }

    <div class="app-body">
        @* Icon sidebar (ADR-0011, canvas EFBSidebar; owner decision 2026-09-20 replacing the
           tab strip): the fly-the-flight pages in flight order plus Settings pinned at the
           bottom. Every configuration page still hangs off the settings hub's own rail. *@
        <nav class="sidebar" aria-label="Pages">
            @foreach (var (label, href, icon) in Tabs)
            {
                <NavLink class="side-item" href="@href"
                         Match="@(href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         ActiveClass="active" title="@label">
                    <span class="side-icon"><AppIcon Name="@icon" Size="22" /></span>
                    <span class="side-label">@label</span>
                </NavLink>
            }
            <span class="side-spacer" aria-hidden="true"></span>
            <NavLink class="side-item side-settings" href="settings" Match="NavLinkMatch.Prefix"
                     ActiveClass="active" title="Settings">
                <span class="side-icon"><AppIcon Name="settings" Size="22" /></span>
                <span class="side-label">Settings</span>
            </NavLink>
        </nav>

        <main class="main">
            @Body
        </main>
    </div>

    @* Status footer (ADR-0011): the canvas footer carried fake CPU/MEM/wifi widgets; ours
       shows the real connections (aircraft, sim, ground services, the two LAN voice
       services) and the running version. Hidden on phones. *@
    <footer class="footer">
        <div class="footer-links">
            @foreach (var (label, subsystem) in FooterLinks)
            {
                <span class="footer-link" title="@FooterTitle(label, subsystem)">
                    <span class="conn-dot @DotClass(subsystem)"></span>
                    <span>@label</span>
                </span>
            }
        </div>
        <div class="footer-version mono">v@(Version)</div>
    </footer>
</div>

@code {
    // The fly-the-flight pages only (ADR-0010). Settings, profiles, the phase engine and the
    // log viewer are reached through the Settings tab's rail (SettingsNav); the old /gsx,
    // /audio, /speech, /profiles and /logs routes still resolve there.
    // 2026-08-08 (owner decision): the Weather tab is gone (the OFP page carries the same
    // cards, TAF included) and Takeoff/Landing live under one Performance tab with sub-tabs
    // (old /takeoff and /landing routes still resolve).
    private static readonly (string Label, string Href, string Icon)[] Tabs =
    [
        ("Flight Status", "", "layout-dashboard"),
        ("INIT", "init", "file-input"),
        ("OFP", "ofp", "file-text"),
        ("Loadsheet", "loadsheet", "clipboard-list"),
        ("W&B", "wnb", "scale"),
        ("Fuel", "fuel", "fuel"),
        ("Performance", "performance", "gauge"),
        ("Checklists", "checklists", "list-checks"),
        ("Tech Log", "techlog", "wrench"),
        ("Duty Day", "day", "clock-4"),
    ];

    // Header aircraft block: the OFP is the authoritative type/registration for the flight;
    // before an OFP the sim title stands in for the type.
    private string AircraftType => Ofp.Current?.AircraftIcaoType is { Length: > 0 } type ? type
        : Profiles.AircraftTitle is { Length: > 0 } title ? title
        : "—";

    private string AircraftReg => Ofp.Current?.AircraftReg is { Length: > 0 } reg ? reg : "—";

    // Resolved name, not the raw setting: a legacy "Default" (or a typo) must still show the
    // theme that is actually applied.
    private string ThemeName => Themes.Get(WebUi.CurrentValue.Theme).Name;

    /// <summary>Slug of the active theme's uploaded logo, or null when the pilot has none.</summary>
    private string? LogoSlug => Logos.FindFile(ThemeName) is null ? null : ThemeLogoStore.Slug(ThemeName);

    private IDisposable? _themeSubscription;

    private IDataRefSubscription<string>? _flightNumberSub;
    private string _flightNumber = "";
    private UpdateSnapshot _update = UpdateSnapshot.Empty;

    // ── Sim-time clock (issue #71) ────────────────────────────────────────────────────
    // simulator.zuluTime (TimeSpan per the A322 catalog) drives the time flap; the date
    // comes from simulator.time (DateTime) when it carries one. A 1 s server timer decides
    // what SHOULD be displayed, but StateHasChanged only fires when the rendered strings
    // actually change — i.e. once per minute boundary plus SIM/UTC flips — so the circuit
    // never sees per-second chatter.
    private static readonly TimeSpan SimTimeStaleAfter = TimeSpan.FromSeconds(10);
    private IDataRefSubscription<TimeSpan>? _zuluTimeSub;
    private System.Threading.Timer? _simClockTimer;
    private bool _simClockActive;
    private string? _simTimeText;

    private string? SolariMode => WebUi.CurrentValue.SolariAnimation ? null : "off";

    private string ProsimDotClass => DotClass(Subsystems.Prosim);

    // Footer order: the aircraft link first, then the sim, then ground services, then the
    // two LAN voice services (owner request 2026-09-20: the voice box came up late after a
    // macOS update and nothing on the page said the FO was on the offline engine).
    private static readonly (string Label, string Subsystem)[] FooterLinks =
    [
        ("ProSim", Subsystems.Prosim),
        ("SimConnect", Subsystems.SimConnect),
        ("GSX", Subsystems.Gsx),
        ("ASR", Subsystems.Asr),
        ("TTS", Subsystems.Tts),
    ];

    /// <summary>Hover text per dot: the voice dots carry the engine reality the speech
    /// pillar publishes ("offline engine covering — retrying …"); the others name the link.</summary>
    private string FooterTitle(string label, string subsystem) => subsystem switch
    {
        Subsystems.Asr => $"Speech recognition (LAN whisper): {(_speech.RecognizerDetail.Length > 0 ? _speech.RecognizerDetail : "unknown")}",
        Subsystems.Tts => $"Voice (Kokoro): {NetworkVoiceDetail()}",
        _ => $"{label} connection",
    };

    private string NetworkVoiceDetail()
    {
        var kokoro = _speech.Providers.FirstOrDefault(p => p.Name.Equals("kokoro", StringComparison.OrdinalIgnoreCase));
        if (kokoro is null)
        {
            return "not in the chain";
        }

        var health = kokoro.Health switch
        {
            TtsProviderHealth.Healthy => "healthy",
            TtsProviderHealth.Failed => "cooling down after a failure",
            TtsProviderHealth.Disabled => "disabled",
            _ => "configured, not yet used",
        };
        return kokoro.Detail.Length > 0 ? $"{health} ({kokoro.Detail})" : health;
    }

    private SpeechStatusSnapshot _speech = SpeechStatusSnapshot.Empty;

    // The running version without the "+sha" build metadata — what the release tag reads.
    private static readonly string Version = (typeof(MainLayout).Assembly
            .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?
            .InformationalVersion ?? "")
        .Split('+')[0];

    private string DotClass(string subsystem) => Status.Snapshot()
        .FirstOrDefault(pair => pair.Key == subsystem).Value switch
    {
        ConnectionState.Connected => "open",
        ConnectionState.Connecting => "reconnecting",
        ConnectionState.Disabled => "connecting",
        _ => "closed",
    };

    protected override void OnInitialized()
    {
        Watch(Updates, snapshot => _update = snapshot);
        Watch(Speech, snapshot => _speech = snapshot);
        WatchChanged(h => Ofp.Changed += h, h => Ofp.Changed -= h, () => { });
        WatchChanged(h => Profiles.Changed += h, h => Profiles.Changed -= h, () => { });
        WatchChanged(h => Status.Changed += h, h => Status.Changed -= h, () => { });
        var flightNumberSub = DataRefs.Subscribe(ProsimDataRefNames.CidsFlightNumber);
        _flightNumberSub = flightNumberSub;
        WatchChanged(
            h => flightNumberSub.ValueChanged += h,
            h => flightNumberSub.ValueChanged -= h,
            () => _flightNumber = flightNumberSub.Value);

        // Infrequent (2 s) is plenty for a minute-resolution clock and keeps the 10 s
        // staleness check meaningful (zulu time changes every sim second, so pushes keep
        // arriving while ProSim is alive and the sim is unpaused).
        _zuluTimeSub = DataRefs.Subscribe(ProsimDataRefNames.ZuluTime);
        _simClockTimer = new System.Threading.Timer(_ => EvaluateSimClock(), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        EvaluateSimClock();

        // The header logo follows the theme (Appearance page) and the logo store (uploads).
        WatchChanged(h => Logos.Changed += h, h => Logos.Changed -= h, () => { });
        _themeSubscription = WebUi.OnChange(options => _ = InvokeAsync(StateHasChanged));
    }

    /// <summary>Recomputes the sim-clock display; re-renders only when it actually changed
    /// (minute boundary or SIM/UTC source flip).</summary>
    private void EvaluateSimClock()
    {
        var prosimConnected = Status.Snapshot()
            .FirstOrDefault(pair => pair.Key == Subsystems.Prosim).Value == ConnectionState.Connected;
        var zulu = _zuluTimeSub;
        var fresh = zulu?.LastUpdatedUtc is { } updated
            && DateTimeOffset.UtcNow - updated <= SimTimeStaleAfter;
        var timeText = fresh ? SimClockFormat.TryFormatZuluTime(zulu!.RawValue) : null;
        var active = prosimConnected && timeText is not null;

        if (active == _simClockActive && timeText == _simTimeText)
        {
            return;
        }

        _simClockActive = active;
        _simTimeText = timeText;
        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        base.Dispose();
        _themeSubscription?.Dispose();
        _flightNumberSub?.Dispose();
        _simClockTimer?.Dispose();
        _zuluTimeSub?.Dispose();
    }
}
