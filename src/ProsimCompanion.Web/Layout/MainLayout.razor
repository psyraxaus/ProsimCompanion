@inherits StoreObserverLayout
@using System.Reflection
@using ProsimCompanion.Core.Aircraft
@using ProsimCompanion.Core.Configuration
@inject ConnectionStatusStore Status
@inject IProsimDataRefs DataRefs
@inject IOptionsMonitor<WebUiOptions> WebUi
@inject UpdateStore Updates

<ThemeStyle />

<div class="app">
    <header class="header">
        <div class="brand">
            @* Lucide "plane" (ISC) inline — no icon CDN (ADR-0011). *@
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
                </svg>
            </span>
            <span class="brand-text">
                <span class="brand-name">PROSIM<span class="gold">COMPANION</span></span>
                <span class="brand-tag">Electronic Flight Bag</span>
            </span>
        </div>
        <div class="flap-center">
            <split-flap text="@_flightNumber" count="8" animate="@SolariMode"></split-flap>
            <span class="flap-label">FLT NO</span>
        </div>
        <div class="flap-right">
            @* Sim-time clock (issue #71): while ProSim streams a fresh simulator.zuluTime the
               flap is text-driven from the server (label SIM); on disconnect/staleness the
               mode attribute returns and app.js resumes the browser-side UTC self-tick. *@
            <div class="flap-block">
                <split-flap mode="@(_simClockActive ? null : "utc-time")"
                            text="@(_simClockActive ? _simTimeText : null)"
                            count="6" animate="@SolariMode"></split-flap>
                <span class="flap-label">@(_simClockActive ? "SIM" : "UTC")</span>
            </div>
            <div class="flap-block">
                <split-flap mode="@(_simClockActive && _simDateText is not null ? null : "utc-date")"
                            text="@(_simClockActive ? _simDateText : null)"
                            count="5" animate="@SolariMode"></split-flap>
                <span class="flap-label">DATE</span>
            </div>
            <span class="conn-indicator" title="ProSim connection">
                <span class="conn-dot @ProsimDotClass"></span>
                <span class="conn-label">ProSim</span>
            </span>
        </div>
    </header>

    @* Update-available banner (Prosim2GSX parity, #6): between header and tab strip,
       dismissible for the run; re-announces only for a NEWER release. *@
    @if (_update.UpdateAvailable && !_update.Dismissed)
    {
        <div class="update-banner" role="status">
            <span>
                New Stable Version
                <a href="@_update.ReleaseUrl" target="_blank" rel="noopener">@_update.LatestVersion</a>
                available! (running @_update.CurrentVersion)
            </span>
            <button type="button" class="update-banner-close" aria-label="Dismiss update notice"
                    @onclick="Updates.Dismiss">×</button>
        </div>
    }

    @* Tab strip. Originally a flat mirror of Prosim2GSX's web EFB order; 2026-08-08 (#18)
       folded each pillar's status page into its settings tab; 2026-09-19 (ADR-0010) the
       strip carries only the fly-the-flight pages plus one right-aligned Settings entry —
       every configuration page now hangs off the settings hub's own rail. Overflow scrolls
       with the chevron buttons wired up in app.js. *@
    <div class="tabbar-wrap">
        <button type="button" class="chevron chevron-left" aria-label="Scroll tabs left">‹</button>
        <nav class="tabbar">
            @foreach (var (label, href) in Tabs)
            {
                <NavLink class="tab" href="@href"
                         Match="@(href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">@label</NavLink>
            }
            <span class="tab-spacer" aria-hidden="true"></span>
            <NavLink class="tab tab-settings" href="settings" Match="NavLinkMatch.Prefix"
                     ActiveClass="active">
                <span aria-hidden="true">⚙</span> Settings
            </NavLink>
        </nav>
        <button type="button" class="chevron chevron-right" aria-label="Scroll tabs right">›</button>
    </div>

    <main class="main">
        @Body
    </main>

    @* Status footer (ADR-0011): the canvas footer carried fake CPU/MEM/wifi widgets; ours
       shows the three real connections and the running version. Hidden on phones. *@
    <footer class="footer">
        <div class="footer-links">
            @foreach (var (label, subsystem) in FooterLinks)
            {
                <span class="footer-link" title="@label connection">
                    <span class="conn-dot @DotClass(subsystem)"></span>
                    <span>@label</span>
                </span>
            }
        </div>
        <div class="footer-version mono">v@(Version)</div>
    </footer>
</div>

@code {
    // The fly-the-flight pages only (ADR-0010). Settings, profiles, the phase engine and the
    // log viewer are reached through the Settings tab's rail (SettingsNav); the old /gsx,
    // /audio, /speech, /profiles and /logs routes still resolve there.
    // 2026-08-08 (owner decision): the Weather tab is gone (the OFP page carries the same
    // cards, TAF included) and Takeoff/Landing live under one Performance tab with sub-tabs
    // (old /takeoff and /landing routes still resolve).
    private static readonly (string Label, string Href)[] Tabs =
    [
        ("Flight Status", ""),
        ("INIT", "init"),
        ("OFP", "ofp"),
        ("Loadsheet", "loadsheet"),
        ("W&B", "wnb"),
        ("Fuel", "fuel"),
        ("Performance", "performance"),
        ("Checklists", "checklists"),
        ("Tech Log", "techlog"),
        ("Duty Day", "day"),
    ];

    private IDataRefSubscription<string>? _flightNumberSub;
    private string _flightNumber = "";
    private UpdateSnapshot _update = UpdateSnapshot.Empty;

    // ── Sim-time clock (issue #71) ────────────────────────────────────────────────────
    // simulator.zuluTime (TimeSpan per the A322 catalog) drives the time flap; the date
    // comes from simulator.time (DateTime) when it carries one. A 1 s server timer decides
    // what SHOULD be displayed, but StateHasChanged only fires when the rendered strings
    // actually change — i.e. once per minute boundary plus SIM/UTC flips — so the circuit
    // never sees per-second chatter.
    private static readonly TimeSpan SimTimeStaleAfter = TimeSpan.FromSeconds(10);
    private IDataRefSubscription<TimeSpan>? _zuluTimeSub;
    private IDataRefSubscription<DateTime>? _simTimeSub;
    private System.Threading.Timer? _simClockTimer;
    private bool _simClockActive;
    private string? _simTimeText;
    private string? _simDateText;

    private string? SolariMode => WebUi.CurrentValue.SolariAnimation ? null : "off";

    private string ProsimDotClass => DotClass(Subsystems.Prosim);

    // Footer order: the aircraft link first, then the sim, then ground services.
    private static readonly (string Label, string Subsystem)[] FooterLinks =
    [
        ("ProSim", Subsystems.Prosim),
        ("SimConnect", Subsystems.SimConnect),
        ("GSX", Subsystems.Gsx),
    ];

    // The running version without the "+sha" build metadata — what the release tag reads.
    private static readonly string Version = (typeof(MainLayout).Assembly
            .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?
            .InformationalVersion ?? "")
        .Split('+')[0];

    private string DotClass(string subsystem) => Status.Snapshot()
        .FirstOrDefault(pair => pair.Key == subsystem).Value switch
    {
        ConnectionState.Connected => "open",
        ConnectionState.Connecting => "reconnecting",
        ConnectionState.Disabled => "connecting",
        _ => "closed",
    };

    protected override void OnInitialized()
    {
        Watch(Updates, snapshot => _update = snapshot);
        WatchChanged(h => Status.Changed += h, h => Status.Changed -= h, () => { });
        var flightNumberSub = DataRefs.Subscribe(ProsimDataRefNames.CidsFlightNumber);
        _flightNumberSub = flightNumberSub;
        WatchChanged(
            h => flightNumberSub.ValueChanged += h,
            h => flightNumberSub.ValueChanged -= h,
            () => _flightNumber = flightNumberSub.Value);

        // Infrequent (2 s) is plenty for a minute-resolution clock and keeps the 10 s
        // staleness check meaningful (zulu time changes every sim second, so pushes keep
        // arriving while ProSim is alive and the sim is unpaused).
        _zuluTimeSub = DataRefs.Subscribe(ProsimDataRefNames.ZuluTime);
        _simTimeSub = DataRefs.Subscribe(ProsimDataRefNames.SimulatorTime);
        _simClockTimer = new System.Threading.Timer(_ => EvaluateSimClock(), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        EvaluateSimClock();
    }

    /// <summary>Recomputes the sim-clock display; re-renders only when it actually changed
    /// (minute boundary or SIM/UTC source flip).</summary>
    private void EvaluateSimClock()
    {
        var prosimConnected = Status.Snapshot()
            .FirstOrDefault(pair => pair.Key == Subsystems.Prosim).Value == ConnectionState.Connected;
        var zulu = _zuluTimeSub;
        var fresh = zulu?.LastUpdatedUtc is { } updated
            && DateTimeOffset.UtcNow - updated <= SimTimeStaleAfter;
        var timeText = fresh ? SimClockFormat.TryFormatZuluTime(zulu!.RawValue) : null;
        var active = prosimConnected && timeText is not null;
        var dateText = active ? SimClockFormat.TryFormatDate(_simTimeSub?.RawValue) : null;

        if (active == _simClockActive && timeText == _simTimeText && dateText == _simDateText)
        {
            return;
        }

        _simClockActive = active;
        _simTimeText = timeText;
        _simDateText = dateText;
        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        base.Dispose();
        _flightNumberSub?.Dispose();
        _simClockTimer?.Dispose();
        _zuluTimeSub?.Dispose();
        _simTimeSub?.Dispose();
    }
}
