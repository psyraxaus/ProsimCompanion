@inherits LayoutComponentBase
@using ProsimCompanion.Core.Aircraft
@implements IDisposable
@inject ConnectionStatusStore Status
@inject IProsimDataRefs DataRefs

<ThemeStyle />

<div class="app">
    <header class="header">
        <div class="brand">
            <span class="brand-name">PROSIMCOMPANION</span>
            <span class="brand-tag">WEB</span>
        </div>
        <div class="flap-center">
            <split-flap text="@_flightNumber" count="8"></split-flap>
            <span class="flap-label">FLT NO</span>
        </div>
        <div class="flap-right">
            <div class="flap-block">
                <split-flap mode="utc-time" count="6"></split-flap>
                <span class="flap-label">UTC</span>
            </div>
            <div class="flap-block">
                <split-flap mode="utc-date" count="5"></split-flap>
                <span class="flap-label">DATE</span>
            </div>
            <span class="conn-indicator" title="ProSim connection">
                <span class="conn-dot @ProsimDotClass"></span>
                <span class="conn-label">ProSim</span>
            </span>
        </div>
    </header>

    @* Single flat tab strip mirroring Prosim2GSX's web EFB: the first 13 tabs match its
       order exactly so migrating users land in a familiar layout; ProsimCompanion-only
       pages (voice FO, tech log, duty day, diagnostics) follow after. Overflow scrolls
       with the chevron buttons wired up in app.js. *@
    <div class="tabbar-wrap">
        <button type="button" class="chevron chevron-left" aria-label="Scroll tabs left">‹</button>
        <nav class="tabbar">
            @foreach (var (label, href) in Tabs)
            {
                <NavLink class="tab" href="@href"
                         Match="@(href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">@label</NavLink>
            }
        </nav>
        <button type="button" class="chevron chevron-right" aria-label="Scroll tabs right">›</button>
    </div>

    <main class="main">
        @Body
    </main>
</div>

@code {
    // Prosim2GSX web EFB tab order (13, verbatim) followed by ProsimCompanion-only pages.
    private static readonly (string Label, string Href)[] Tabs =
    [
        ("Flight Status", ""),
        ("INIT", "init"),
        ("OFP", "ofp"),
        ("Loadsheet", "loadsheet"),
        ("W&B", "wnb"),
        ("Fuel", "fuel"),
        ("Takeoff", "takeoff"),
        ("Landing", "landing"),
        ("Checklists", "checklists"),
        ("GSX Settings", "settings/gsx"),
        ("Aircraft Profiles", "profiles"),
        ("Audio Settings", "settings/audio"),
        ("App Settings", "settings/app"),
        ("Speech", "speech"),
        ("FO Settings", "settings/speech"),
        ("Tech Log", "techlog"),
        ("Duty Day", "day"),
        ("Weather", "weather"),
        ("GSX Status", "gsx"),
        ("Audio Status", "audio"),
        ("Logs", "logs"),
    ];

    private IDataRefSubscription? _flightNumberSub;
    private string _flightNumber = "";

    private string ProsimDotClass => Status.Snapshot()
        .FirstOrDefault(pair => pair.Key == Subsystems.Prosim).Value switch
    {
        ConnectionState.Connected => "open",
        ConnectionState.Connecting => "reconnecting",
        ConnectionState.Disabled => "connecting",
        _ => "closed",
    };

    protected override void OnInitialized()
    {
        Status.Changed += OnChanged;
        _flightNumberSub = DataRefs.Subscribe("efb.cids.flightNumber", DataRefTier.Infrequent);
        _flightNumberSub.ValueChanged += OnChanged;
        _flightNumber = _flightNumberSub.GetValue("");
    }

    private void OnChanged(object? sender, EventArgs e)
        // Store/SDK events fire on the writer's thread; marshal into the circuit.
        => _ = InvokeAsync(() =>
        {
            _flightNumber = _flightNumberSub?.GetValue("") ?? "";
            StateHasChanged();
        });

    public void Dispose()
    {
        Status.Changed -= OnChanged;
        if (_flightNumberSub is not null)
        {
            _flightNumberSub.ValueChanged -= OnChanged;
            _flightNumberSub.Dispose();
        }
    }
}
