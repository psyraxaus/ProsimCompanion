<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- THE version: single source of truth (docs/VERSIONING.md). The update banner, the
         installer build and the release tag all derive from this value — bump it here,
         nowhere else, then tag v<Version> and publish the GitHub release. -->
    <Version>0.5.0-beta.1</Version>
    <Company>Protovision</Company>
    <Product>ProsimCompanion</Product>
    <!-- Native SimConnect.dll is x64-only; pin the whole solution so it can never be loaded
         into a 32-bit process. -->
    <PlatformTarget>x64</PlatformTarget>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873: LoggerMessage source-gen delegates are not worth the ceremony at this
         app's log volumes; structured template logging is the project convention. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

</Project>
